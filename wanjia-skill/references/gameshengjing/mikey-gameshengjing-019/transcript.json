      "text": "就是快速拿到微信",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00051"
    },
    {
      "start": 83.26,
      "end": 84.96,
      "text": "那么整个流程非常简单",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00052"
    },
    {
      "start": 84.96,
      "end": 85.98,
      "text": "也就是建立好",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00053"
    },
    {
      "start": 85.98,
      "end": 87.34,
      "text": "我之前讲的逢觉心态",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00054"
    },
    {
      "start": 87.34,
      "end": 89.28,
