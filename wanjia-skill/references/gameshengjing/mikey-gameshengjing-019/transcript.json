      "end": 58.98,
      "text": "感情就会自然而然建立起来",
      "avg_logprob": -0.08615860532758371,
      "no_speech_prob": 0.0,
      "segment_id": "S00032"
    },
    {
      "start": 58.98,
      "end": 60.0,
      "text": "但是我要告诉你",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00033"
    },
    {
      "start": 60.0,
      "end": 60.84,
      "text": "这个思路呢",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00034"
    },
    {
      "start": 60.84,
      "end": 62.0,
      "text": "在你还是新手的时候",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00035"
    },
    {
      "start": 62.0,
      "end": 63.38,
      "text": "它是完全错误的",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00036"
    },
    {
