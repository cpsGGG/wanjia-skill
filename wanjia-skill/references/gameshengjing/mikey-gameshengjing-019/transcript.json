      "end": 98.54,
      "text": "我想过来跟你认识一下",
      "avg_logprob": -0.09311868600321538,
      "no_speech_prob": 0.0,
      "segment_id": "S00061"
    },
    {
      "start": 98.54,
      "end": 99.68,
      "text": "我想加一下你的微信",
      "avg_logprob": -0.09311868600321538,
      "no_speech_prob": 0.0,
      "segment_id": "S00062"
    },
    {
      "start": 99.68,
