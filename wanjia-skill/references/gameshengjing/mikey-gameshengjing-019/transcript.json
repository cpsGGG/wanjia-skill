      "text": "好",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00049"
    },
    {
      "start": 80.6,
      "end": 81.76,
      "text": "那么第一套流程呢",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00050"
    },
    {
      "start": 81.76,
