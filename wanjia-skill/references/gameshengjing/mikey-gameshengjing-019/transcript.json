      "text": "然后离开",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00046"
    },
    {
      "start": 77.64,
      "end": 78.38,
      "text": "那么我认为",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00047"
    },
    {
      "start": 78.38,
      "end": 80.28,
      "text": "这才是新手最正确的策略",
      "avg_logprob": -0.10733695644975284,
      "no_speech_prob": 0.0,
      "segment_id": "S00048"
    },
    {
      "start": 80.28,
