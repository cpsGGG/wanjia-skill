      "no_speech_prob": 0.0,
      "segment_id": "S00017"
    },
    {
      "start": 25.68,
      "end": 27.32,
      "text": "那么很多人遇到这种情况",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00018"
    },
    {
      "start": 27.32,
      "end": 29.36,
      "text": "他的第一反应是觉得自己不够帅",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00019"
    },
    {
      "start": 29.36,
      "end": 30.14,
      "text": "不够有钱",
      "avg_logprob": -0.09594298507037916,
      "no_speech_prob": 0.0,
      "segment_id": "S00020"
    },
    {
      "start": 30.14,
      "end": 30.98,
      "text": "不够有魅力",
      "avg_logprob": -0.09594298507037916,
      "no_speech_prob": 0.0,
      "segment_id": "S00021"
    },
    {
      "start": 30.98,
      "end": 32.02,
      "text": "但是我告诉你啊",
      "avg_logprob": -0.09594298507037916,
      "no_speech_prob": 0.0,
      "segment_id": "S00022"
    },
    {
