  "segments": [
    {
      "start": 0.0,
      "end": 3.56,
      "text": "好 那么我们今天来聊一个大部分人都绕不开的话题",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00001"
    },
    {
      "start": 3.56,
      "end": 5.16,
      "text": "及搭讪的心态问题",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00002"
    },
    {
      "start": 5.16,
      "end": 7.12,
      "text": "我不知道你们有没有遇到过这种情况",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00003"
    },
    {
      "start": 7.12,
      "end": 10.42,
      "text": "就比如说你在商场里看到一个长得非常正的女生",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00004"
    },
    {
      "start": 10.42,
      "end": 11.98,
      "text": "你明明特别的心动",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00005"
    },
    {
      "start": 11.98,
      "end": 13.14,
      "text": "你很想走过去",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00006"
    },
    {
      "start": 13.14,
      "end": 14.34,
      "text": "问她要联系方式",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00007"
    },
    {
      "start": 14.34,
      "end": 15.5,
      "text": "但是你的脚呢",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00008"
    },
    {
      "start": 15.5,
      "end": 17.04,
      "text": "就像是灌了水泥一样",
