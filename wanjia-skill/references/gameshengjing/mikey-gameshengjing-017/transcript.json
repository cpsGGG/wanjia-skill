      "no_speech_prob": 0.0,
      "segment_id": "S00009"
    },
    {
      "start": 17.04,
      "end": 17.84,
      "text": "卖不出去",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00010"
    },
    {
      "start": 17.84,
      "end": 18.84,
      "text": "又或者是呢",
