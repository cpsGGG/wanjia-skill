      "no_speech_prob": 0.0,
      "segment_id": "S00013"
    },
    {
      "start": 20.96,
      "end": 22.14,
      "text": "话还没有说两句",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00014"
    },
    {
