      "no_speech_prob": 0.0,
      "segment_id": "S00011"
    },
    {
      "start": 18.84,
      "end": 19.8,
      "text": "你鼓起了勇气",
      "avg_logprob": -0.08831188630531817,
      "no_speech_prob": 0.0,
      "segment_id": "S00012"
    },
    {
