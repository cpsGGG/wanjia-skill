      "no_speech_prob": 0.0,
      "segment_id": "S00029"
    },
    {
      "start": 45.98,
      "end": 49.34,
      "text": "但这个信念几乎刻在每个男人的骨子里",
      "avg_logprob": -0.09594298507037916,
      "no_speech_prob": 0.0,
      "segment_id": "S00030"
    },
