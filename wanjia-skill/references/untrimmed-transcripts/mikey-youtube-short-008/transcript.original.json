{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-008",
  "youtube_id": "jOgZRlESuv0",
  "media_sha256": "d1ce14c74934e74bcd4da8801fccffc249e9a8a6cbbfa2a9f2af92583362524f",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.18,
      "end": 1.86,
      "text": "麦哥人生的意义是什么"
    },
    {
      "sid": "S00002",
      "start": 1.86,
      "end": 10.8,
      "text": "人生的意义就是在这个世界里不断的留下你的本地历史记录"
    },
    {
      "sid": "S00003",
      "start": 10.8,
      "end": 15.28,
      "text": "不断吩咐你的本地历史记录"
    },
    {
      "sid": "S00004",
      "start": 15.28,
      "end": 18.58,
      "text": "就拿我买车这个点来讲吧"
    },
    {
      "sid": "S00005",
      "start": 18.58,
      "end": 21.08,
      "text": "我之前很多朋友问我"
    },
    {
      "sid": "S00006",
      "start": 21.08,
      "end": 27.22,
      "text": "他问你为什么会拿你资产的40%去买一台福尔瑞"
    },
    {
      "sid": "S00007",
      "start": 27.22,
      "end": 29.3,
      "text": "他想不明白"
    },
    {
      "sid": "S00008",
      "start": 29.3,
      "end": 32.22,
      "text": "他觉得去做投资是最正确的选择"
    },
    {
      "sid": "S00009",
      "start": 32.22,
      "end": 34.56,
      "text": "说实话他说的是非常正确的"
    },
    {
      "sid": "S00010",
      "start": 34.56,
      "end": 36.1,
      "text": "他说的是很对的"
    },
    {
      "sid": "S00011",
      "start": 36.1,
      "end": 37.46,
      "text": "但我为什么要这么做"
    },
    {
      "sid": "S00012",
      "start": 37.46,
      "end": 46.87,
      "text": "你要清楚20多岁开他开发阿里和你30多岁开发阿里"
    },
    {
      "sid": "S00013",
      "start": 46.87,
      "end": 48.69,
      "text": "他的心境是不一样的"
    },
    {
      "sid": "S00014",
      "start": 48.69,
      "end": 49.45,
      "text": "他问我为什么"
    },
    {
      "sid": "S00015",
      "start": 49.45,
      "end": 50.59,
      "text": "我告诉他"
    },
    {
      "sid": "S00016",
      "start": 50.59,
      "end": 59.16,
      "text": "我说我想让我的人生本地历史记录更加的丰富多彩"
    },
    {
      "sid": "S00017",
      "start": 59.16,
      "end": 62.3,
      "text": "未来我的孙子跟我聊天的时候"
    },
    {
      "sid": "S00018",
      "start": 62.3,
      "end": 63.46,
      "text": "我可以直接告诉他"
    },
    {
      "sid": "S00019",
      "start": 63.46,
      "end": 66.96,
      "text": "我说你20多岁就开发阿里了"
    },
    {
      "sid": "S00020",
      "start": 66.96,
      "end": 68.14,
      "text": "我说你20多岁就开发阿里了"
    },
    {
      "sid": "S00021",
      "start": 68.14,
      "end": 72.04,
      "text": "我约着你20多岁就开发阿里"
    },
    {
      "sid": "S00022",
      "start": 72.04,
      "end": 72.66,
      "text": "但你推荐一下"
    },
    {
      "sid": "S00023",
      "start": 72.66,
      "end": 73.6,
      "text": "我说你10多岁就开发阿里"
    },
    {
      "sid": "S00024",
      "start": 73.6,
      "end": 74.16,
      "text": "那都会推荐了"
    },
    {
      "sid": "S00025",
      "start": 74.16,
      "end": 75.94,
      "text": "为了你30多岁就开发阿里"
    },
    {
      "sid": "S00026",
      "start": 75.94,
      "end": 78.12,
      "text": "就要了"
    },
    {
      "sid": "S00027",
      "start": 78.12,
      "end": 79.08,
      "text": "我说我真的dar了"
    }
  ]
}
