  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.69,
      "end": 4.17,
      "text": "如果女生说她明天明天明确有事情"
    },
    {
      "sid": "S00002",
      "start": 4.17,
      "end": 5.09,
      "text": "必须几点几点回"
    },
    {
      "sid": "S00003",
      "start": 5.09,
      "end": 6.11,
      "text": "这种还要约会吗"
    },
    {
      "sid": "S00004",
      "start": 6.11,
      "end": 7.11,
      "text": "还是改天再约"
    },
    {
      "sid": "S00005",
      "start": 7.11,
      "end": 9.33,
      "text": "当然可以约会啊"
    },
    {
      "sid": "S00006",
      "start": 9.33,
      "end": 10.87,
      "text": "又没关系啊"
    },
    {
      "sid": "S00007",
      "start": 10.87,
      "end": 11.73,
      "text": "这我发现兄弟们"
    },
    {
      "sid": "S00008",
      "start": 11.73,
      "end": 13.65,
      "text": "你们就非得第一次见面就吃"
    },
    {
      "sid": "S00009",
      "start": 13.65,
      "end": 14.95,
      "text": "就得吃对方是不是"
    },
    {
      "sid": "S00010",
      "start": 14.95,
      "end": 19.03,
      "text": "你能不能享受就是跟女生约会的过程"
    },
    {
      "sid": "S00011",
      "start": 19.03,
      "end": 22.45,
      "text": "就能不能目的性不要这么强"
    },
    {
      "sid": "S00012",
      "start": 22.45,
      "end": 24.53,
      "text": "你可以第一次约会"
    },
    {
      "sid": "S00013",
      "start": 24.53,
      "end": 27.01,
      "text": "你就跟他就正常聊就行了"
    },
    {
      "sid": "S00014",
      "start": 27.01,
      "end": 29.13,
      "text": "第一次约会你给他吸引到了"
    },
    {
      "sid": "S00015",
      "start": 29.13,
      "end": 30.65,
      "text": "你即便没有睡他"
    },
    {
      "sid": "S00016",
      "start": 30.65,
      "end": 32.37,
      "text": "他也会回去主动找你"
    },
    {
      "sid": "S00017",
      "start": 32.37,
      "end": 33.51,
      "text": "然后想跟你约第二次的"
    },
    {
      "sid": "S00018",
      "start": 33.51,
      "end": 35.11,
      "text": "不是说每一场约会"
    },
    {
      "sid": "S00019",
      "start": 35.11,
      "end": 36.75,
      "text": "你都一定要睡的对方的"
    },
    {
      "sid": "S00020",
      "start": 36.75,
      "end": 38.13,
      "text": "能不能懂兄弟们"
    },
    {
      "sid": "S00021",
      "start": 38.13,
      "end": 40.99,
      "text": "要回归本心"
    },
    {
      "sid": "S00022",
      "start": 40.99,
      "end": 45.03,
      "text": "我一约得吃是为了我是纯粹炫技"
    },
    {
      "sid": "S00023",
      "start": 45.03,
      "end": 47.21,
      "text": "但是说实话我在早期"
    },
    {
      "sid": "S00024",
      "start": 47.21,
      "end": 49.87,
      "text": "很早之前我刚开始学情感的时候"
    },
    {
      "sid": "S00025",
      "start": 49.87,
      "end": 51.95,
      "text": "我的主要需求就是"
    },
    {
      "sid": "S00026",
      "start": 51.95,
      "end": 53.47,
      "text": "我不要说一约得吃了"
    },
    {
      "sid": "S00027",
      "start": 53.47,
      "end": 54.85,
      "text": "我三十约得吃"
    },
    {
      "sid": "S00028",
      "start": 54.85,
      "end": 56.51,
      "text": "我就很满足啊"
    },
    {
      "sid": "S00029",
      "start": 56.51,
      "end": 59.19,
      "text": "后面变成了就是三次"
    },
    {
      "sid": "S00030",
      "start": 59.19,
      "end": 60.63,
      "text": "再到后面变成了一次"
    },
    {
      "sid": "S00031",
      "start": 60.63,
      "end": 63.39,
      "text": "再到后面接是零次"
    },
    {
      "sid": "S00032",
      "start": 63.39,
      "end": 64.53,
      "text": "就是都不需要约会"
    },
    {
      "sid": "S00033",
      "start": 64.53,
      "end": 65.55,
      "text": "就把他约到家里了"
    },
    {
      "sid": "S00034",
      "start": 65.55,
      "end": 66.55,
      "text": "我们下期再见"
    },
    {
      "sid": "S00035",
      "start": 66.55,
      "end": 67.21,
      "text": "我们下期再见"
    },
    {
      "sid": "S00036",
      "start": 67.21,
      "end": 67.71,
      "text": "我们下期再见"
    },
    {
      "sid": "S00037",
      "start": 67.71,
      "end": 68.95,
      "text": "我们下期再见"
    }
  ]
}
