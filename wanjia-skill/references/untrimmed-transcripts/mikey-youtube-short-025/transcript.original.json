{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-025",
  "youtube_id": "0yq9ZVn7Cmc",
  "media_sha256": "76a848abe7d510554af0b93b32c34cfb7a196b91ecc657825c31dbaebc0e1b31",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 1.0,
      "end": 4.26,
      "text": "你需要把活在当下当成一个习惯去做"
    },
    {
      "sid": "S00002",
      "start": 4.26,
      "end": 6.52,
      "text": "当成一个习惯去做"
    },
    {
      "sid": "S00003",
      "start": 6.52,
      "end": 8.42,
      "text": "包括我前面有讲的三秒原则"
    },
    {
      "sid": "S00004",
      "start": 8.42,
      "end": 11.28,
      "text": "三秒原则本质上就是防止你脱离当下了"
    },
    {
      "sid": "S00005",
      "start": 11.28,
      "end": 13.08,
      "text": "比如说你当下你想做一件事情"
    },
    {
      "sid": "S00006",
      "start": 13.08,
      "end": 14.66,
      "text": "然后你脱脱脱脱脱脱"
    },
    {
      "sid": "S00007",
      "start": 14.66,
      "end": 16.0,
      "text": "然后你就脱离当下了"
    },
    {
      "sid": "S00008",
      "start": 16.0,
      "end": 19.02,
      "text": "你平时是一个什么样的人"
    },
    {
      "sid": "S00009",
      "start": 19.02,
      "end": 19.56,
      "text": "对吧"
    },
    {
      "sid": "S00010",
      "start": 19.56,
      "end": 20.46,
      "text": "然后呢"
    },
    {
      "sid": "S00011",
      "start": 20.46,
      "end": 22.2,
      "text": "你平时是一个很优秀的人"
    },
    {
      "sid": "S00012",
      "start": 22.2,
      "end": 24.06,
      "text": "但是为什么平时是一个很优秀的人"
    },
    {
      "sid": "S00013",
      "start": 24.06,
      "end": 25.12,
      "text": "在跟女生约会的时候"
    },
    {
      "sid": "S00014",
      "start": 25.12,
      "end": 27.94,
      "text": "反而会变得不是自己呢"
    },
    {
      "sid": "S00015",
      "start": 27.94,
      "end": 29.22,
      "text": "就没有办法做自己了"
    },
    {
      "sid": "S00016",
      "start": 29.22,
      "end": 30.66,
      "text": "就有一部分人啊"
    },
    {
      "sid": "S00017",
      "start": 30.66,
      "end": 32.14,
      "text": "他们平时是很优秀的"
    },
    {
      "sid": "S00018",
      "start": 32.14,
      "end": 33.24,
      "text": "但是他跟女生约会的时候"
    },
    {
      "sid": "S00019",
      "start": 33.24,
      "end": 34.0,
      "text": "他容易紧张"
    },
    {
      "sid": "S00020",
      "start": 34.0,
      "end": 34.76,
      "text": "他容易慌"
    },
    {
      "sid": "S00021",
      "start": 34.76,
      "end": 35.96,
      "text": "他容易害怕"
    },
    {
      "sid": "S00022",
      "start": 35.96,
      "end": 38.2,
      "text": "他容易就是害怕这个女生不喜欢她"
    },
    {
      "sid": "S00023",
      "start": 38.2,
      "end": 39.82,
      "text": "或者是害怕这个女生不给她注意力"
    },
    {
      "sid": "S00024",
      "start": 39.82,
      "end": 40.44,
      "text": "好"
    },
    {
      "sid": "S00025",
      "start": 40.44,
      "end": 42.86,
      "text": "那这个时候他大脑就不在当下了"
    },
    {
      "sid": "S00026",
      "start": 42.86,
      "end": 45.4,
      "text": "他大脑都一直在担心这"
    },
    {
      "sid": "S00027",
      "start": 45.4,
      "end": 45.84,
      "text": "担心那"
    },
    {
      "sid": "S00028",
      "start": 45.84,
      "end": 47.44,
      "text": "都在焦虑未来"
    },
    {
      "sid": "S00029",
      "start": 47.44,
      "end": 48.66,
      "text": "还未发生的事情"
    },
    {
      "sid": "S00030",
      "start": 48.66,
      "end": 49.76,
      "text": "那这个时候呢"
    },
    {
      "sid": "S00031",
      "start": 49.76,
      "end": 50.8,
      "text": "他的操作就变形"
    },
    {
      "sid": "S00032",
      "start": 50.8,
      "end": 52.6,
      "text": "他说话的感觉都不一样"
    },
    {
      "sid": "S00033",
      "start": 52.6,
      "end": 53.58,
      "text": "他可能会接吧"
    },
    {
      "sid": "S00034",
      "start": 53.58,
      "end": 56.34,
      "text": "他可能会倒水的时候"
    },
    {
      "sid": "S00035",
      "start": 56.34,
      "end": 57.86,
      "text": "不小心直接倒在桌子旁边"
    },
    {
      "sid": "S00036",
      "start": 57.86,
      "end": 60.64,
      "text": "反而各种出岔子"
    },
    {
      "sid": "S00037",
      "start": 60.64,
      "end": 61.98,
      "text": "那这个时候你的吸引力就是"
    },
    {
      "sid": "S00038",
      "start": 61.98,
      "end": 63.08,
      "text": "本来还挺高的"
    },
    {
      "sid": "S00039",
      "start": 63.08,
      "end": 63.24,
      "text": "然后"
    },
    {
      "sid": "S00040",
      "start": 63.24,
      "end": 65.08,
      "text": "没了"
    },
    {
      "sid": "S00041",
      "start": 65.08,
      "end": 66.72,
      "text": "直接就没了"
    },
    {
      "sid": "S00042",
      "start": 66.72,
      "end": 70.74,
      "text": "我们死是可以一瞬间就死的"
    },
    {
      "sid": "S00043",
      "start": 70.74,
      "end": 72.92,
      "text": "就是我们建立吸引"
    },
    {
      "sid": "S00044",
      "start": 72.92,
      "end": 75.18,
      "text": "男人对一个女人建立吸引"
    },
    {
      "sid": "S00045",
      "start": 75.18,
      "end": 76.28,
      "text": "他可能需要个"
    },
    {
      "sid": "S00046",
      "start": 76.28,
      "end": 77.66,
      "text": "10到20分钟时间"
    },
    {
      "sid": "S00047",
      "start": 77.66,
      "end": 80.18,
      "text": "但是我们从把吸引从"
    },
    {
      "sid": "S00048",
      "start": 80.18,
      "end": 82.48,
      "text": "80分的吸引掉到0"
    },
    {
      "sid": "S00049",
      "start": 82.48,
      "end": 84.24,
      "text": "只需要几秒钟"
    },
    {
      "sid": "S00050",
      "start": 84.24,
      "end": 85.9,
      "text": "非常非常的夸张"
    },
    {
      "sid": "S00051",
      "start": 85.9,
      "end": 86.94,
      "text": "这就是为什么女人讲"
    },
    {
      "sid": "S00052",
      "start": 86.94,
      "end": 88.5,
      "text": "我对你这个男的突然上头了"
    },
    {
      "sid": "S00053",
      "start": 88.5,
      "end": 89.42,
      "text": "又突然下头了"
    },
    {
      "sid": "S00054",
      "start": 89.42,
      "end": 91.16,
      "text": "就是我对你突然就是上头"
    },
    {
      "sid": "S00055",
      "start": 91.16,
      "end": 92.5,
      "text": "哦"
    },
    {
      "sid": "S00056",
      "start": 92.5,
      "end": 93.9,
      "text": "然后过一会儿你放了个醋"
    },
    {
      "sid": "S00057",
      "start": 93.9,
      "end": 94.82,
      "text": "一瞬间下头"
    },
    {
      "sid": "S00058",
      "start": 94.82,
      "end": 95.74,
      "text": "就算下头了"
    },
    {
      "sid": "S00059",
      "start": 95.74,
      "end": 95.9,
      "text": "这个时候"
    },
    {
      "sid": "S00060",
      "start": 95.9,
      "end": 96.08,
      "text": "就算下头了"
    },
    {
      "sid": "S00061",
      "start": 96.08,
      "end": 96.24,
      "text": "你可以立自住里的"
    },
    {
      "sid": "S00062",
      "start": 96.24,
      "end": 98.06,
      "text": "就算下头了"
    },
    {
      "sid": "S00063",
      "start": 98.06,
      "end": 99.18,
      "text": "还可以打他"
    },
    {
      "sid": "S00064",
      "start": 99.18,
      "end": 99.82,
      "text": "你这么久了"
    },
    {
      "sid": "S00065",
      "start": 99.82,
      "end": 100.72,
      "text": "怎么走"
    },
    {
      "sid": "S00066",
      "start": 100.72,
      "end": 101.42,
      "text": "这时还要过来"
    },
    {
      "sid": "S00067",
      "start": 101.42,
      "end": 101.88,
      "text": "我们现在去教会"
    },
    {
      "sid": "S00068",
      "start": 101.88,
      "end": 103.12,
      "text": "这个时候"
    },
    {
      "sid": "S00069",
      "start": 103.12,
      "end": 103.48,
      "text": "坐下头了"
    },
    {
      "sid": "S00070",
      "start": 103.48,
      "end": 104.3,
      "text": "我们现在在来"
    },
    {
      "sid": "S00071",
      "start": 104.3,
      "end": 107.2,
      "text": "我们现在对你"
    },
    {
      "sid": "S00072",
      "start": 107.2,
      "end": 108.6,
      "text": "他能处理你"
    },
    {
      "sid": "S00073",
      "start": 108.6,
      "end": 110.44,
      "text": "我们现在已经接入"
    }
  ]
}
