{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-016",
  "youtube_id": "cIE63w6uJXs",
  "media_sha256": "10b039651727f9c261c040ecb8c0eb608e1c6e1bc00e117e33bd425538f4fbc0",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.96,
      "text": "麦哥可不可以講一講怎麼培養主體性"
    },
    {
      "sid": "S00002",
      "start": 2.96,
      "end": 8.94,
      "text": "首先你得先認識到這個世界是一個遊戲"
    },
    {
      "sid": "S00003",
      "start": 8.94,
      "end": 12.14,
      "text": "我現在問兄弟們一個問題"
    },
    {
      "sid": "S00004",
      "start": 12.14,
      "end": 14.88,
      "text": "就這個時候如果你突然死了"
    },
    {
      "sid": "S00005",
      "start": 14.88,
      "end": 16.08,
      "text": "你閉眼了"
    },
    {
      "sid": "S00006",
      "start": 16.08,
      "end": 20.24,
      "text": "你能確保或是確認"
    },
    {
      "sid": "S00007",
      "start": 20.24,
      "end": 22.52,
      "text": "這個世界依然存在嗎"
    },
    {
      "sid": "S00008",
      "start": 22.52,
      "end": 26.22,
      "text": "其實很多時候這個東西無法確認"
    },
    {
      "sid": "S00009",
      "start": 26.22,
      "end": 31.42,
      "text": "你死後這個世界就直接消失了"
    },
    {
      "sid": "S00010",
      "start": 31.42,
      "end": 34.42,
      "text": "那麼這個世界既然直接就消失了"
    },
    {
      "sid": "S00011",
      "start": 34.42,
      "end": 39.42,
      "text": "那麼有沒有種可能這個世界它就是你的"
    },
    {
      "sid": "S00012",
      "start": 39.42,
      "end": 42.42,
      "text": "它就是維持零磚的"
    },
    {
      "sid": "S00013",
      "start": 42.42,
      "end": 48.42,
      "text": "然後周圍的人比如說聽得王是NPC"
    },
    {
      "sid": "S00014",
      "start": 48.42,
      "end": 53.42,
      "text": "然後被我給捕捉過來了變成我的徒弟"
    },
    {
      "sid": "S00015",
      "start": 53.42,
      "end": 57.42,
      "text": "那麼你們也是NPC所有人都是NPC"
    },
    {
      "sid": "S00016",
      "start": 57.42,
      "end": 58.42,
      "text": "只有我一個人是主角"
    },
    {
      "sid": "S00017",
      "start": 58.42,
      "end": 61.42,
      "text": "那麼這個時候你自然而然就會有主體性"
    },
    {
      "sid": "S00018",
      "start": 61.42,
      "end": 63.42,
      "text": "就比如說這個世界本上是一個遊樂園"
    },
    {
      "sid": "S00019",
      "start": 63.42,
      "end": 64.42,
      "text": "然後你父母給了你張門票"
    },
    {
      "sid": "S00020",
      "start": 64.42,
      "end": 66.42,
      "text": "然後你過來遊玩"
    },
    {
      "sid": "S00021",
      "start": 66.42,
      "end": 69.42,
      "text": "然後NPC的存在就是給你提供一些線索價值的"
    },
    {
      "sid": "S00022",
      "start": 69.42,
      "end": 70.42,
      "text": "就包括我"
    },
    {
      "sid": "S00023",
      "start": 70.42,
      "end": 73.42,
      "text": "我在你們的世界裡也是一個NPC"
    },
    {
      "sid": "S00024",
      "start": 73.42,
      "end": 74.42,
      "text": "禮貝旦"
    },
    {
      "sid": "S00025",
      "start": 74.42,
      "end": 75.42,
      "text": "然後你們就能夠並秽古"
    },
    {
      "sid": "S00026",
      "start": 75.42,
      "end": 89.42,
      "text": "在我之前就穿過"
    },
    {
      "sid": "S00027",
      "start": 89.42,
      "end": 90.42,
      "text": "到你怎麼看"
    },
    {
      "sid": "S00028",
      "start": 90.42,
      "end": 91.42,
      "text": "台灣有的"
    },
    {
      "sid": "S00029",
      "start": 91.42,
      "end": 92.42,
      "text": "也是相對"
    },
    {
      "sid": "S00030",
      "start": 92.42,
      "end": 93.42,
      "text": "地人之間"
    },
    {
      "sid": "S00031",
      "start": 93.42,
      "end": 95.42,
      "text": "非常聰明"
    },
    {
      "sid": "S00032",
      "start": 95.42,
      "end": 96.42,
      "text": "那麼有些有的"
    },
    {
      "sid": "S00033",
      "start": 96.42,
      "end": 98.42,
      "text": "抱歉"
    }
  ]
}
