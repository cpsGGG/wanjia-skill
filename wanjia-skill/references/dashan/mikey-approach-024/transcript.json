      "segment_id": "S00015"
    },
    {
      "start": 35.11,
      "end": 36.11,
      "text": "一个人也无聊了",
      "avg_logprob": -0.3392175499719518,
      "no_speech_prob": 0.0,
      "segment_id": "S00016"
    },
    {
      "start": 36.11,
      "end": 38.07,
      "text": "一个人啊 我们一起吗",
