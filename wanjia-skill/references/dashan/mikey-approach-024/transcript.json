      "text": "没有 觉得你长得很帅",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00002"
    },
    {
      "start": 5.51,
      "end": 8.51,
      "text": "哦 没有 我是来搭讪你 广西人",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00003"
    },
    {
      "start": 8.51,
      "end": 10.31,
      "text": "你是坐",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00004"
    },
    {
      "start": 10.31,
      "end": 13.31,
      "text": "没有 她是我朋友 她在等我",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00005"
    },
    {
      "start": 13.31,
      "end": 14.91,
      "text": "你过来旅游的吗",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00006"
    },
    {
      "start": 14.91,
      "end": 18.31,
      "text": "我江苏无锡的 我来这边工作",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00007"
    },
    {
      "start": 18.31,
      "end": 21.51,
      "text": "我下个月要去苏州",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00008"
    },
    {
      "start": 21.51,
      "end": 22.91,
      "text": "下个星期五",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00009"
    },
    {
      "start": 22.91,
      "end": 24.51,
      "text": "好近啊",
      "avg_logprob": -0.24812499618530273,
      "no_speech_prob": 0.0,
      "segment_id": "S00010"
    },
    {
      "start": 24.51,
      "end": 27.51,
      "text": "但是我不在苏州 我在无锡 苏州旁边",
