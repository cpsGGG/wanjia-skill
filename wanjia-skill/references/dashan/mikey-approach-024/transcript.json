      "no_speech_prob": 0.0,
      "segment_id": "S00011"
    },
    {
      "start": 27.51,
      "end": 30.71,
      "text": "有机会的话可以去无锡的南长街玩",
      "avg_logprob": -0.3392175499719518,
      "no_speech_prob": 0.0,
      "segment_id": "S00012"
    },
    {
      "start": 30.71,
      "end": 31.55,
      "text": "那边很好玩",
      "avg_logprob": -0.3392175499719518,
      "no_speech_prob": 0.0,
      "segment_id": "S00013"
    },
    {
      "start": 31.55,
      "end": 32.51,
      "text": "你这边干嘛",
      "avg_logprob": -0.3392175499719518,
      "no_speech_prob": 0.0,
      "segment_id": "S00014"
    },
    {
      "start": 32.51,
      "end": 35.11,
      "text": "过街啊 没人就准备回去了",
      "avg_logprob": -0.3392175499719518,
