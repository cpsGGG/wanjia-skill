      "end": 16.0,
      "text": "可以啊",
      "avg_logprob": -0.29790295836956876,
      "no_speech_prob": 0.0,
      "segment_id": "S00010"
    },
    {
      "start": 16.0,
      "end": 17.0,
      "text": "那我留你一线",
      "avg_logprob": -0.29790295836956876,
      "no_speech_prob": 0.0,
      "segment_id": "S00011"
    },
    {
      "start": 17.0,
      "end": 19.0,
      "text": "我刚刚在和我的朋友在",
