      "no_speech_prob": 0.0,
      "segment_id": "S00022"
    },
    {
      "start": 38.44,
      "end": 39.72,
      "text": "你就在成都是吧",
      "avg_logprob": -0.27636717399582267,
      "no_speech_prob": 0.0,
      "segment_id": "S00023"
    },
    {
      "start": 39.72,
      "end": 41.98,
      "text": "那我有机会的话我约你好吧",
      "avg_logprob": -0.27636717399582267,
      "no_speech_prob": 0.0,
      "segment_id": "S00024"
    },
    {
      "start": 41.98,
      "end": 44.3,
