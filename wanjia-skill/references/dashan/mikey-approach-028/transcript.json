      "no_speech_prob": 0.0,
      "segment_id": "S00019"
    },
    {
      "start": 32.3,
      "end": 34.38,
      "text": "没有大学研究生意",
      "avg_logprob": -0.27636717399582267,
      "no_speech_prob": 0.0,
      "segment_id": "S00020"
    },
    {
      "start": 34.38,
      "end": 36.68,
      "text": "你最近在成都玩还是什么",
