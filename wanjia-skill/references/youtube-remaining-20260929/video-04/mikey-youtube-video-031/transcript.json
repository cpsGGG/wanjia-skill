{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-031",
  "youtube_id": "kwMvehGwOU8",
  "media_sha256": "9b2fc2b968efd3c7c3e5cd5798da39a5b688b30f6cff861d5ac1bdc31576200f",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.24,
      "text": "在两性关系中呢"
    },
    {
      "sid": "S00002",
      "start": 1.24,
      "end": 2.7,
      "text": "没有自我就没有吸引力"
    },
    {
      "sid": "S00003",
      "start": 2.7,
      "end": 3.34,
      "text": "哈喽大家好"
    },
    {
      "sid": "S00004",
      "start": 3.34,
      "end": 4.0,
      "text": "我是Mike"
    },
    {
      "sid": "S00005",
      "start": 4.0,
      "end": 5.82,
      "text": "今天我来给兄弟们讲"
    },
    {
      "sid": "S00006",
      "start": 5.82,
      "end": 8.12,
      "text": "在炮妞中的王牌概念"
    },
    {
      "sid": "S00007",
      "start": 8.12,
      "end": 8.58,
      "text": "自我"
    },
    {
      "sid": "S00008",
      "start": 8.58,
      "end": 14.62,
      "text": "我之前给兄弟们分享了"
    },
    {
      "sid": "S00009",
      "start": 14.62,
      "end": 15.86,
      "text": "吸引力的三大谬误"
    },
    {
      "sid": "S00010",
      "start": 15.86,
      "end": 17.14,
      "text": "讲了女本位主义"
    },
    {
      "sid": "S00011",
      "start": 17.14,
      "end": 19.02,
      "text": "以及衍生出来的一系列问题"
    },
    {
      "sid": "S00012",
      "start": 19.02,
      "end": 20.58,
      "text": "很多兄弟在评论区"
    },
    {
      "sid": "S00013",
      "start": 20.58,
      "end": 21.84,
      "text": "分享了自己的观点"
    },
    {
      "sid": "S00014",
      "start": 21.84,
      "end": 23.66,
      "text": "我听到的最多的声音就是"
    },
    {
      "sid": "S00015",
      "start": 23.66,
      "end": 24.46,
      "text": "我误了"
    },
    {
      "sid": "S00016",
      "start": 24.46,
      "end": 25.48,
      "text": "我非常开心"
    },
    {
      "sid": "S00017",
      "start": 25.48,
      "end": 26.96,
      "text": "可以让大家了解到一些"
    },
    {
      "sid": "S00018",
      "start": 26.96,
      "end": 28.2,
      "text": "关于世界的真相"
    },
    {
      "sid": "S00019",
      "start": 28.2,
      "end": 29.18,
      "text": "但同时呢"
    },
    {
      "sid": "S00020",
      "start": 29.18,
      "end": 30.78,
      "text": "我也见到了很多兄弟们"
    },
    {
      "sid": "S00021",
      "start": 30.78,
      "end": 33.04,
      "text": "分享说自己依然一知半解"
    },
    {
      "sid": "S00022",
      "start": 33.04,
      "end": 34.84,
      "text": "不知道怎么样让自己迈出"
    },
    {
      "sid": "S00023",
      "start": 34.84,
      "end": 36.0,
      "text": "蜕变的那一步"
    },
    {
      "sid": "S00024",
      "start": 36.0,
      "end": 37.42,
      "text": "开悟的过程一定是"
    },
    {
      "sid": "S00025",
      "start": 37.42,
      "end": 38.82,
      "text": "曲折且痛苦的"
    },
    {
      "sid": "S00026",
      "start": 38.82,
      "end": 39.7,
      "text": "今天这期视频"
    },
    {
      "sid": "S00027",
      "start": 39.7,
      "end": 40.86,
      "text": "我给大家讲一个"
    },
    {
      "sid": "S00028",
      "start": 40.86,
      "end": 42.0,
      "text": "困扰了我许久"
    },
    {
      "sid": "S00029",
      "start": 42.0,
      "end": 44.02,
      "text": "也困扰了很多男性的一个问题"
    },
    {
      "sid": "S00030",
      "start": 44.02,
      "end": 45.38,
      "text": "人的主体性"
    },
    {
      "sid": "S00031",
      "start": 45.38,
      "end": 46.84,
      "text": "用更通俗的话来讲"
    },
    {
      "sid": "S00032",
      "start": 46.84,
      "end": 47.64,
      "text": "就是自我"
    },
    {
      "sid": "S00033",
      "start": 47.64,
      "end": 56.98,
      "text": "最近我的一个玩路啊路的朋友"
    },
    {
      "sid": "S00034",
      "start": 56.98,
      "end": 57.64,
      "text": "跟我讲"
    },
    {
      "sid": "S00035",
      "start": 57.64,
      "end": 59.54,
      "text": "有一个英雄联盟的主播"
    },
    {
      "sid": "S00036",
      "start": 59.54,
      "end": 60.46,
      "text": "小明建模"
    },
    {
      "sid": "S00037",
      "start": 60.46,
      "end": 61.96,
      "text": "被晋升出户了"
    },
    {
      "sid": "S00038",
      "start": 61.96,
      "end": 63.18,
      "text": "我大概看了一下"
    },
    {
      "sid": "S00039",
      "start": 63.18,
      "end": 65.46,
      "text": "他的妻子拿走了他的40万存款"
    },
    {
      "sid": "S00040",
      "start": 65.46,
      "end": 67.32,
      "text": "并用最点钟点的口吻说"
    },
    {
      "sid": "S00041",
      "start": 67.32,
      "end": 68.36,
      "text": "你不爱我了"
    },
    {
      "sid": "S00042",
      "start": 68.36,
      "end": 69.32,
      "text": "那些钱呢"
    },
    {
      "sid": "S00043",
      "start": 69.32,
      "end": 71.02,
      "text": "是你自愿赠予我的"
    },
    {
      "sid": "S00044",
      "start": 71.02,
      "end": 73.12,
      "text": "他说我现在"
    },
    {
      "sid": "S00045",
      "start": 73.12,
      "end": 74.32,
      "text": "不爱他"
    },
    {
      "sid": "S00046",
      "start": 74.32,
      "end": 75.7,
      "text": "所以我赚他的钱"
    },
    {
      "sid": "S00047",
      "start": 75.7,
      "end": 76.62,
      "text": "他也不给我了"
    },
    {
      "sid": "S00048",
      "start": 76.62,
      "end": 78.9,
      "text": "就这样子"
    },
    {
      "sid": "S00049",
      "start": 78.9,
      "end": 82.04,
      "text": "来你自己说"
    },
    {
      "sid": "S00050",
      "start": 82.04,
      "end": 84.34,
      "text": "你现在又不说了"
    },
    {
      "sid": "S00051",
      "start": 84.34,
      "end": 85.24,
      "text": "我也不是你"
    },
    {
      "sid": "S00052",
      "start": 85.24,
      "end": 86.74,
      "text": "你刚刚说"
    },
    {
      "sid": "S00053",
      "start": 86.74,
      "end": 88.12,
      "text": "因为我现在不爱你了"
    },
    {
      "sid": "S00054",
      "start": 88.12,
      "end": 89.04,
      "text": "你怎么说就好了"
    },
    {
      "sid": "S00055",
      "start": 89.04,
      "end": 89.66,
      "text": "不是我的群"
    },
    {
      "sid": "S00056",
      "start": 89.66,
      "end": 90.12,
      "text": "是你的群"
    },
    {
      "sid": "S00057",
      "start": 90.12,
      "end": 90.74,
      "text": "然后你打算"
    },
    {
      "sid": "S00058",
      "start": 90.74,
      "end": 92.0,
      "text": "你不把钱都还我了"
    },
    {
      "sid": "S00059",
      "start": 92.0,
      "end": 93.28,
      "text": "这就会先讲好了"
    },
    {
      "sid": "S00060",
      "start": 93.28,
      "end": 94.62,
      "text": "你又不敢说了"
    },
    {
      "sid": "S00061",
      "start": 94.62,
      "end": 95.58,
      "text": "没有敢不敢"
    },
    {
      "sid": "S00062",
      "start": 95.58,
      "end": 96.46,
      "text": "我不是你"
    },
    {
      "sid": "S00063",
      "start": 96.46,
      "end": 98.46,
      "text": "我不会把这放到台面上讲"
    },
    {
      "sid": "S00064",
      "start": 98.46,
      "end": 99.96,
      "text": "你把钱还我"
    },
    {
      "sid": "S00065",
      "start": 99.96,
      "end": 102.22,
      "text": "我不会像你一样把这种放到台面上讲"
    },
    {
      "sid": "S00066",
      "start": 102.22,
      "end": 103.56,
      "text": "哪怕下午跟你说了这么多"
    },
    {
      "sid": "S00067",
      "start": 103.56,
      "end": 104.56,
      "text": "但我的钱在那里"
    },
    {
      "sid": "S00068",
      "start": 104.56,
      "end": 106.44,
      "text": "还是会第一时间发在群里面"
    },
    {
      "sid": "S00069",
      "start": 106.44,
      "end": 107.16,
      "text": "爱着所有人"
    },
    {
      "sid": "S00070",
      "start": 107.16,
      "end": 108.0,
      "text": "我的钱在你那里"
    },
    {
      "sid": "S00071",
      "start": 108.0,
      "end": 112.25,
      "text": "你还我钱了"
    },
    {
      "sid": "S00072",
      "start": 112.25,
      "end": 114.11,
      "text": "你都不爱我了"
    },
    {
      "sid": "S00073",
      "start": 114.11,
      "end": 115.87,
      "text": "我钱是我的"
    },
    {
      "sid": "S00074",
      "start": 115.87,
      "end": 117.75,
      "text": "那也是你自愿给我的"
    },
    {
      "sid": "S00075",
      "start": 117.75,
      "end": 121.13,
      "text": "你40多万"
    },
    {
      "sid": "S00076",
      "start": 121.13,
      "end": 121.81,
      "text": "嗯"
    },
    {
      "sid": "S00077",
      "start": 121.81,
      "end": 123.01,
      "text": "那也是你自愿给我的"
    },
    {
      "sid": "S00078",
      "start": 123.01,
      "end": 124.55,
      "text": "你现在花生就"
    },
    {
      "sid": "S00079",
      "start": 124.55,
      "end": 126.13,
      "text": "就剩一点点了"
    },
    {
      "sid": "S00080",
      "start": 126.13,
      "end": 127.67,
      "text": "是你自愿给我的"
    },
    {
      "sid": "S00081",
      "start": 127.67,
      "end": 130.8,
      "text": "你不能这样的"
    },
    {
      "sid": "S00082",
      "start": 130.8,
      "end": 132.06,
      "text": "嗯"
    },
    {
      "sid": "S00083",
      "start": 132.06,
      "end": 132.92,
      "text": "原话送给你"
    },
    {
      "sid": "S00084",
      "start": 132.92,
      "end": 136.24,
      "text": "人就在嘴硬发来高能弹幕"
    },
    {
      "sid": "S00085",
      "start": 136.24,
      "end": 137.54,
      "text": "各位不要发了"
    },
    {
      "sid": "S00086",
      "start": 137.54,
      "end": 139.22,
      "text": "你们发的每一笔钱"
    },
    {
      "sid": "S00087",
      "start": 139.22,
      "end": 140.5,
      "text": "那个女的都有分成"
    },
    {
      "sid": "S00088",
      "start": 140.5,
      "end": 142.06,
      "text": "想象有点恶心"
    },
    {
      "sid": "S00089",
      "start": 142.06,
      "end": 144.42,
      "text": "但钱在我手上呀"
    },
    {
      "sid": "S00090",
      "start": 144.42,
      "end": 148.3,
      "text": "勇爱哈维发来高能弹幕"
    },
    {
      "sid": "S00091",
      "start": 148.3,
      "end": 150.84,
      "text": "忙到现在一口热饭都吃不上"
    },
    {
      "sid": "S00092",
      "start": 150.84,
      "end": 154.26,
      "text": "人家现在可是拿你的钱吃热的呢"
    },
    {
      "sid": "S00093",
      "start": 154.26,
      "end": 156.74,
      "text": "哎呀不会的"
    },
    {
      "sid": "S00094",
      "start": 156.74,
      "end": 158.42,
      "text": "就算是离婚吧"
    },
    {
      "sid": "S00095",
      "start": 158.42,
      "end": 160.52,
      "text": "虽然说法律上是吧"
    },
    {
      "sid": "S00096",
      "start": 160.52,
      "end": 162.06,
      "text": "你已经发来高能弹幕"
    },
    {
      "sid": "S00097",
      "start": 162.06,
      "end": 164.2,
      "text": "你每个月给妈妈那么多钱"
    },
    {
      "sid": "S00098",
      "start": 164.2,
      "end": 166.74,
      "text": "妈妈会忍心看你吃外卖吗"
    },
    {
      "sid": "S00099",
      "start": 166.74,
      "end": 168.1,
      "text": "不会心痛吗"
    },
    {
      "sid": "S00100",
      "start": 168.1,
      "end": 171.02,
      "text": "小明他最招牌的英雄"
    },
    {
      "sid": "S00101",
      "start": 171.02,
      "end": 173.12,
      "text": "是暗逸剑魔亚托克斯"
    },
    {
      "sid": "S00102",
      "start": 173.12,
      "end": 175.14,
      "text": "一个被囚禁了无数个世纪"
    },
    {
      "sid": "S00103",
      "start": 175.14,
      "end": 176.8,
      "text": "如今渴望着复仇"
    },
    {
      "sid": "S00104",
      "start": 176.8,
      "end": 178.08,
      "text": "不可阻挡的战士"
    },
    {
      "sid": "S00105",
      "start": 178.08,
      "end": 179.28,
      "text": "而在游戏外呢"
    },
    {
      "sid": "S00106",
      "start": 179.28,
      "end": 182.12,
      "text": "他的召唤师依然是一个被囚禁着的人"
    },
    {
      "sid": "S00107",
      "start": 182.12,
      "end": 184.2,
      "text": "这又是一个令人多么悲伤的"
    },
    {
      "sid": "S00108",
      "start": 184.2,
      "end": 185.5,
      "text": "关于归男的故事"
    },
    {
      "sid": "S00109",
      "start": 185.5,
      "end": 186.96,
      "text": "那么这类故事呢"
    },
    {
      "sid": "S00110",
      "start": 186.96,
      "end": 188.28,
      "text": "这些年层出不穷"
    },
    {
      "sid": "S00111",
      "start": 188.28,
      "end": 189.52,
      "text": "大家看完后呢"
    },
    {
      "sid": "S00112",
      "start": 189.52,
      "end": 190.38,
      "text": "有的是嘲弄"
    },
    {
      "sid": "S00113",
      "start": 190.38,
      "end": 191.36,
      "text": "有的是悲伤"
    },
    {
      "sid": "S00114",
      "start": 191.36,
      "end": 192.36,
      "text": "有的是愤怒"
    },
    {
      "sid": "S00115",
      "start": 192.36,
      "end": 193.58,
      "text": "但大家有没有想过"
    },
    {
      "sid": "S00116",
      "start": 193.58,
      "end": 194.62,
      "text": "为什么胖猫"
    },
    {
      "sid": "S00117",
      "start": 194.62,
      "end": 195.14,
      "text": "奶亮"
    },
    {
      "sid": "S00118",
      "start": 195.14,
      "end": 196.18,
      "text": "小明这样的人"
    },
    {
      "sid": "S00119",
      "start": 196.18,
      "end": 197.84,
      "text": "会落得这般结局呢"
    },
    {
      "sid": "S00120",
      "start": 197.84,
      "end": 198.84,
      "text": "有的人会说"
    },
    {
      "sid": "S00121",
      "start": 198.84,
      "end": 200.08,
      "text": "是他们遇人不输"
    },
    {
      "sid": "S00122",
      "start": 200.08,
      "end": 201.06,
      "text": "遇到坏女人了"
    },
    {
      "sid": "S00123",
      "start": 201.06,
      "end": 202.14,
      "text": "那如果我告诉你"
    },
    {
      "sid": "S00124",
      "start": 202.14,
      "end": 203.42,
      "text": "女人都是坏的呢"
    },
    {
      "sid": "S00125",
      "start": 203.42,
      "end": 204.78,
      "text": "如果我再告诉你"
    },
    {
      "sid": "S00126",
      "start": 204.78,
      "end": 205.92,
      "text": "无论多好的女人"
    },
    {
      "sid": "S00127",
      "start": 205.92,
      "end": 207.2,
      "text": "遇到了这类男人"
    },
    {
      "sid": "S00128",
      "start": 207.2,
      "end": 209.24,
      "text": "都会变成坏女人了"
    },
    {
      "sid": "S00129",
      "start": 209.24,
      "end": 211.58,
      "text": "今天迈克要告诉你们的真相是"
    },
    {
      "sid": "S00130",
      "start": 211.58,
      "end": 213.0,
      "text": "如果你是个龟男"
    },
    {
      "sid": "S00131",
      "start": 213.0,
      "end": 214.92,
      "text": "你就会遇到所谓的渣女"
    },
    {
      "sid": "S00132",
      "start": 214.92,
      "end": 215.52,
      "text": "捞女"
    },
    {
      "sid": "S00133",
      "start": 215.52,
      "end": 217.8,
      "text": "一系列不把你当人的坏女"
    },
    {
      "sid": "S00134",
      "start": 217.8,
      "end": 219.0,
      "text": "为什么胖猫"
    },
    {
      "sid": "S00135",
      "start": 219.0,
      "end": 219.68,
      "text": "奶亮"
    },
    {
      "sid": "S00136",
      "start": 219.68,
      "end": 220.48,
      "text": "小明"
    },
    {
      "sid": "S00137",
      "start": 220.48,
      "end": 222.88,
      "text": "这样的人会落得这样的结局呢"
    },
    {
      "sid": "S00138",
      "start": 222.88,
      "end": 224.32,
      "text": "最重要的原因是"
    },
    {
      "sid": "S00139",
      "start": 224.32,
      "end": 225.9,
      "text": "他们没有人的主体性"
    },
    {
      "sid": "S00140",
      "start": 225.9,
      "end": 227.44,
      "text": "他们没有自我"
    },
    {
      "sid": "S00141",
      "start": 227.44,
      "end": 259.54,
      "text": "有这样一种人"
    },
    {
      "sid": "S00142",
      "start": 259.54,
      "end": 260.88,
      "text": "他们的一切行为"
    },
    {
      "sid": "S00143",
      "start": 260.88,
      "end": 263.12,
      "text": "都是为了寻求外部的认可"
    },
    {
      "sid": "S00144",
      "start": 263.12,
      "end": 264.44,
      "text": "我们经常讲的是"
    },
    {
      "sid": "S00145",
      "start": 264.44,
      "end": 265.52,
      "text": "要创造价值"
    },
    {
      "sid": "S00146",
      "start": 265.52,
      "end": 266.54,
      "text": "要自我提升"
    },
    {
      "sid": "S00147",
      "start": 266.54,
      "end": 268.4,
      "text": "自我提升的关键点"
    },
    {
      "sid": "S00148",
      "start": 268.4,
      "end": 269.88,
      "text": "首先在于自我"
    },
    {
      "sid": "S00149",
      "start": 269.88,
      "end": 271.72,
      "text": "很多学员会走的弯路是"
    },
    {
      "sid": "S00150",
      "start": 271.72,
      "end": 272.78,
      "text": "我要变帅哥"
    },
    {
      "sid": "S00151",
      "start": 272.78,
      "end": 274.42,
      "text": "因为女人喜欢帅哥"
    },
    {
      "sid": "S00152",
      "start": 274.42,
      "end": 275.5,
      "text": "我要去健身房"
    },
    {
      "sid": "S00153",
      "start": 275.5,
      "end": 276.5,
      "text": "练出一身肌肉"
    },
    {
      "sid": "S00154",
      "start": 276.5,
      "end": 278.08,
      "text": "因为女人喜欢肌肉奶"
    },
    {
      "sid": "S00155",
      "start": 278.08,
      "end": 279.22,
      "text": "我要努力赚钱"
    },
    {
      "sid": "S00156",
      "start": 279.22,
      "end": 280.14,
      "text": "我要买车"
    },
    {
      "sid": "S00157",
      "start": 280.14,
      "end": 280.98,
      "text": "买房"
    },
    {
      "sid": "S00158",
      "start": 280.98,
      "end": 281.82,
      "text": "因为这样做"
    },
    {
      "sid": "S00159",
      "start": 281.82,
      "end": 283.04,
      "text": "能获得别人"
    },
    {
      "sid": "S00160",
      "start": 283.04,
      "end": 284.6,
      "text": "尤其是女人的认可"
    },
    {
      "sid": "S00161",
      "start": 284.6,
      "end": 286.58,
      "text": "这种思维方式的出发点是"
    },
    {
      "sid": "S00162",
      "start": 286.58,
      "end": 287.86,
      "text": "只有通过这些"
    },
    {
      "sid": "S00163",
      "start": 287.86,
      "end": 289.12,
      "text": "女人才会喜欢我"
    },
    {
      "sid": "S00164",
      "start": 289.12,
      "end": 290.28,
      "text": "出发点是女人"
    },
    {
      "sid": "S00165",
      "start": 290.28,
      "end": 291.04,
      "text": "而不是我"
    },
    {
      "sid": "S00166",
      "start": 291.04,
      "end": 292.58,
      "text": "这会陷入结果正确"
    },
    {
      "sid": "S00167",
      "start": 292.58,
      "end": 294.52,
      "text": "而过程错误的思维误区"
    },
    {
      "sid": "S00168",
      "start": 294.52,
      "end": 297.16,
      "text": "贾乃亮汪小飞们给予了李小璐"
    },
    {
      "sid": "S00169",
      "start": 297.16,
      "end": 297.88,
      "text": "大S们"
    },
    {
      "sid": "S00170",
      "start": 297.88,
      "end": 299.32,
      "text": "他们能给予的一切"
    },
    {
      "sid": "S00171",
      "start": 299.32,
      "end": 301.26,
      "text": "但他们没有收获真正的吸引"
    },
    {
      "sid": "S00172",
      "start": 301.26,
      "end": 304.38,
      "text": "没有收获他们应得的爱和尊重"
    },
    {
      "sid": "S00173",
      "start": 304.38,
      "end": 306.7,
      "text": "小明建模造出了一系列热梗"
    },
    {
      "sid": "S00174",
      "start": 306.7,
      "end": 309.0,
      "text": "赢得了网友们的好感和关注"
    },
    {
      "sid": "S00175",
      "start": 309.0,
      "end": 310.06,
      "text": "赢得了流量"
    },
    {
      "sid": "S00176",
      "start": 310.06,
      "end": 311.86,
      "text": "但他做的这一切的出发点"
    },
    {
      "sid": "S00177",
      "start": 311.86,
      "end": 314.16,
      "text": "使他老婆希望他赚更多的钱"
    },
    {
      "sid": "S00178",
      "start": 314.16,
      "end": 315.5,
      "text": "我们可以回顾一下"
    },
    {
      "sid": "S00179",
      "start": 315.5,
      "end": 316.7,
      "text": "以前读书的时候"
    },
    {
      "sid": "S00180",
      "start": 316.7,
      "end": 318.44,
      "text": "班上总有这样的一类人"
    },
    {
      "sid": "S00181",
      "start": 318.44,
      "end": 319.76,
      "text": "他们喜欢扮小丑"
    },
    {
      "sid": "S00182",
      "start": 319.76,
      "end": 321.12,
      "text": "讲一些俏皮话"
    },
    {
      "sid": "S00183",
      "start": 321.12,
      "end": 322.18,
      "text": "来取悦别人"
    },
    {
      "sid": "S00184",
      "start": 322.18,
      "end": 323.32,
      "text": "尤其是取悦女生"
    },
    {
      "sid": "S00185",
      "start": 323.32,
      "end": 325.72,
      "text": "我们在无聊的时候会听他们讲笑话"
    },
    {
      "sid": "S00186",
      "start": 325.72,
      "end": 328.54,
      "text": "但我们不会发自内心的去尊重他们"
    },
    {
      "sid": "S00187",
      "start": 328.54,
      "end": 330.5,
      "text": "女生也往往不会选择这类人"
    },
    {
      "sid": "S00188",
      "start": 330.5,
      "end": 331.5,
      "text": "做他们的男朋友"
    },
    {
      "sid": "S00189",
      "start": 331.5,
      "end": 333.52,
      "text": "在工作中也有这么一类人"
    },
    {
      "sid": "S00190",
      "start": 333.52,
      "end": 335.24,
      "text": "他们往往会在开会的时候"
    },
    {
      "sid": "S00191",
      "start": 335.24,
      "end": 336.84,
      "text": "本能的去附和别人"
    },
    {
      "sid": "S00192",
      "start": 336.84,
      "end": 337.84,
      "text": "在团结的时候"
    },
    {
      "sid": "S00193",
      "start": 337.84,
      "end": 339.16,
      "text": "选择去干什么"
    },
    {
      "sid": "S00194",
      "start": 339.16,
      "end": 340.92,
      "text": "永远都是我都OK"
    },
    {
      "sid": "S00195",
      "start": 340.92,
      "end": 341.98,
      "text": "聚餐的时候"
    },
    {
      "sid": "S00196",
      "start": 341.98,
      "end": 343.84,
      "text": "主动会帮别人拿饮料"
    },
    {
      "sid": "S00197",
      "start": 343.84,
      "end": 344.62,
      "text": "拿调料"
    },
    {
      "sid": "S00198",
      "start": 344.62,
      "end": 346.62,
      "text": "扮演着知心大哥的角色"
    },
    {
      "sid": "S00199",
      "start": 346.62,
      "end": 348.2,
      "text": "当你想跟别人换班的时候"
    },
    {
      "sid": "S00200",
      "start": 348.2,
      "end": 349.78,
      "text": "你会第一个考虑他"
    },
    {
      "sid": "S00201",
      "start": 349.78,
      "end": 351.54,
      "text": "因为你觉得他肯定会同意"
    },
    {
      "sid": "S00202",
      "start": 351.54,
      "end": 352.82,
      "text": "哪怕他会不爽"
    },
    {
      "sid": "S00203",
      "start": 352.82,
      "end": 353.94,
      "text": "你也没有那么的在意"
    },
    {
      "sid": "S00204",
      "start": 353.94,
      "end": 355.32,
      "text": "谁让他是好人呢"
    },
    {
      "sid": "S00205",
      "start": 355.32,
      "end": 357.5,
      "text": "难道好人就不该被尊重吗"
    },
    {
      "sid": "S00206",
      "start": 357.5,
      "end": 358.04,
      "text": "不"
    },
    {
      "sid": "S00207",
      "start": 358.04,
      "end": 359.44,
      "text": "发自内心的善意呢"
    },
    {
      "sid": "S00208",
      "start": 359.44,
      "end": 361.12,
      "text": "从自我出发的好"
    },
    {
      "sid": "S00209",
      "start": 361.12,
      "end": 362.12,
      "text": "会赢得吸引"
    },
    {
      "sid": "S00210",
      "start": 362.12,
      "end": 363.38,
      "text": "那么真正的原因是"
    },
    {
      "sid": "S00211",
      "start": 363.38,
      "end": 365.28,
      "text": "他们的出发点并不是物欲"
    },
    {
      "sid": "S00212",
      "start": 365.28,
      "end": 366.58,
      "text": "他们没有自我"
    },
    {
      "sid": "S00213",
      "start": 366.58,
      "end": 368.16,
      "text": "一个人之所以被人尊重"
    },
    {
      "sid": "S00214",
      "start": 368.16,
      "end": 369.34,
      "text": "之所以有吸引力"
    },
    {
      "sid": "S00215",
      "start": 369.34,
      "end": 371.54,
      "text": "并不在于他让多少人开心了"
    },
    {
      "sid": "S00216",
      "start": 371.54,
      "end": 373.2,
      "text": "并不在于他赚到了多少钱"
    },
    {
      "sid": "S00217",
      "start": 373.2,
      "end": 375.4,
      "text": "而是在于他是否值得被尊重"
    },
    {
      "sid": "S00218",
      "start": 375.4,
      "end": 376.9,
      "text": "是否真正有吸引力"
    },
    {
      "sid": "S00219",
      "start": 376.9,
      "end": 379.3,
      "text": "给女人花钱并不能证明他多爱你"
    },
    {
      "sid": "S00220",
      "start": 379.3,
      "end": 380.76,
      "text": "只能证明你愿意花钱"
    },
    {
      "sid": "S00221",
      "start": 380.76,
      "end": 383.52,
      "text": "而一个愿意花钱又不值得被爱的男人"
    },
    {
      "sid": "S00222",
      "start": 383.52,
      "end": 384.48,
      "text": "只有一种负名"
    },
    {
      "sid": "S00223",
      "start": 384.48,
      "end": 458.76,
      "text": "无论你多有钱"
    },
    {
      "sid": "S00224",
      "start": 458.76,
      "end": 459.88,
      "text": "无论你多帅"
    },
    {
      "sid": "S00225",
      "start": 459.88,
      "end": 461.4,
      "text": "只要你的思维模式"
    },
    {
      "sid": "S00226",
      "start": 461.4,
      "end": 463.64,
      "text": "还是这种寻求外部认可的思维"
    },
    {
      "sid": "S00227",
      "start": 463.64,
      "end": 465.06,
      "text": "没有真正自我的人"
    },
    {
      "sid": "S00228",
      "start": 465.06,
      "end": 467.26,
      "text": "你的结局都逃不过被利用"
    },
    {
      "sid": "S00229",
      "start": 467.26,
      "end": 468.34,
      "text": "被人当成工具"
    },
    {
      "sid": "S00230",
      "start": 468.34,
      "end": 469.9,
      "text": "被律的工具人命运"
    },
    {
      "sid": "S00231",
      "start": 469.9,
      "end": 470.72,
      "text": "现在社会"
    },
    {
      "sid": "S00232",
      "start": 470.72,
      "end": 472.72,
      "text": "大部分男性都被磁化"
    },
    {
      "sid": "S00233",
      "start": 472.72,
      "end": 474.08,
      "text": "被精神阉割了"
    },
    {
      "sid": "S00234",
      "start": 474.08,
      "end": 474.5,
      "text": "是的"
    },
    {
      "sid": "S00235",
      "start": 474.5,
      "end": 476.3,
      "text": "我们不需要去攻击归男"
    },
    {
      "sid": "S00236",
      "start": 476.3,
      "end": 478.88,
      "text": "因为他们是一群从小被原生家庭"
    },
    {
      "sid": "S00237",
      "start": 478.88,
      "end": 479.68,
      "text": "被学校"
    },
    {
      "sid": "S00238",
      "start": 479.68,
      "end": 483.3,
      "text": "被社会价值观归训成归男的一群人"
    },
    {
      "sid": "S00239",
      "start": 483.3,
      "end": 485.36,
      "text": "在电影青春派的开头"
    },
    {
      "sid": "S00240",
      "start": 485.36,
      "end": 487.56,
      "text": "男主角暗恋了女主角三年"
    },
    {
      "sid": "S00241",
      "start": 487.56,
      "end": 489.58,
      "text": "却选择在毕业的时候才表白"
    },
    {
      "sid": "S00242",
      "start": 489.58,
      "end": 490.7,
      "text": "因为他被教育"
    },
    {
      "sid": "S00243",
      "start": 490.7,
      "end": 491.98,
      "text": "早恋是不好的"
    },
    {
      "sid": "S00244",
      "start": 491.98,
      "end": 493.52,
      "text": "他只能选择离开学校"
    },
    {
      "sid": "S00245",
      "start": 493.52,
      "end": 495.08,
      "text": "这个框架之际"
    },
    {
      "sid": "S00246",
      "start": 495.08,
      "end": 496.24,
      "text": "才敢迈出这一步"
    },
    {
      "sid": "S00247",
      "start": 496.24,
      "end": 497.34,
      "text": "而他的表白呢"
    },
    {
      "sid": "S00248",
      "start": 497.34,
      "end": 498.42,
      "text": "被母亲发现了"
    },
    {
      "sid": "S00249",
      "start": 498.42,
      "end": 500.1,
      "text": "母亲选择把他关在家里"
    },
    {
      "sid": "S00250",
      "start": 500.1,
      "end": 500.42,
      "text": "是的"
    },
    {
      "sid": "S00251",
      "start": 500.42,
      "end": 502.3,
      "text": "还有家庭这么一个框架"
    },
    {
      "sid": "S00252",
      "start": 502.3,
      "end": 503.1,
      "text": "在约束他"
    },
    {
      "sid": "S00253",
      "start": 503.1,
      "end": 504.26,
      "text": "他不敢忤逆母亲"
    },
    {
      "sid": "S00254",
      "start": 504.26,
      "end": 505.42,
      "text": "但又想去找女主"
    },
    {
      "sid": "S00255",
      "start": 505.42,
      "end": 507.62,
      "text": "只敢选择在半夜跳窗出去"
    },
    {
      "sid": "S00256",
      "start": 507.62,
      "end": 509.36,
      "text": "最终摔断了尾椎骨"
    },
    {
      "sid": "S00257",
      "start": 509.36,
      "end": 510.62,
      "text": "导致了高考落榜"
    },
    {
      "sid": "S00258",
      "start": 510.62,
      "end": 512.12,
      "text": "那么电影放到这呢"
    },
    {
      "sid": "S00259",
      "start": 512.12,
      "end": 513.64,
      "text": "后面我已经不想看了"
    },
    {
      "sid": "S00260",
      "start": 513.64,
      "end": 515.6,
      "text": "男主反映了大部分男人的宿命"
    },
    {
      "sid": "S00261",
      "start": 515.6,
      "end": 516.56,
      "text": "从小在家庭"
    },
    {
      "sid": "S00262",
      "start": 516.56,
      "end": 518.72,
      "text": "在学校被归训成一个乖小孩"
    },
    {
      "sid": "S00263",
      "start": 518.72,
      "end": 519.68,
      "text": "被精神阉割"
    },
    {
      "sid": "S00264",
      "start": 519.68,
      "end": 521.24,
      "text": "那么出了社会之后呢"
    },
    {
      "sid": "S00265",
      "start": 521.24,
      "end": 522.12,
      "text": "不敢越界"
    },
    {
      "sid": "S00266",
      "start": 522.12,
      "end": 523.08,
      "text": "本能的讨好"
    },
    {
      "sid": "S00267",
      "start": 523.08,
      "end": 524.18,
      "text": "在性压抑之下"
    },
    {
      "sid": "S00268",
      "start": 524.18,
      "end": 526.36,
      "text": "被迫娶了一个不爱自己的女人"
    },
    {
      "sid": "S00269",
      "start": 526.36,
      "end": 526.76,
      "text": "被绿"
    },
    {
      "sid": "S00270",
      "start": 526.76,
      "end": 527.84,
      "text": "被噤声出户"
    },
    {
      "sid": "S00271",
      "start": 527.84,
      "end": 529.9,
      "text": "在只要我不断的迎合世俗"
    },
    {
      "sid": "S00272",
      "start": 529.9,
      "end": 531.28,
      "text": "女人就能爱上我"
    },
    {
      "sid": "S00273",
      "start": 531.28,
      "end": 533.34,
      "text": "别人就能尊重我的患闷之下"
    },
    {
      "sid": "S00274",
      "start": 534.26,
      "end": 535.72,
      "text": "用外部的虚假认可"
    },
    {
      "sid": "S00275",
      "start": 535.72,
      "end": 537.42,
      "text": "来满足自己可怜的自尊"
    },
    {
      "sid": "S00276",
      "start": 537.42,
      "end": 538.36,
      "text": "所以兄弟们"
    },
    {
      "sid": "S00277",
      "start": 538.36,
      "end": 540.06,
      "text": "如果你们不想成为这样的人"
    },
    {
      "sid": "S00278",
      "start": 540.06,
      "end": 542.72,
      "text": "你必须拥有你人生的主体性"
    },
    {
      "sid": "S00279",
      "start": 542.72,
      "end": 543.64,
      "text": "拥有自我"
    },
    {
      "sid": "S00280",
      "start": 543.64,
      "end": 544.4,
      "text": "自我是什么"
    },
    {
      "sid": "S00281",
      "start": 544.4,
      "end": 546.5,
      "text": "自我是一个大写的我"
    },
    {
      "sid": "S00282",
      "start": 546.5,
      "end": 547.72,
      "text": "我想怎样"
    },
    {
      "sid": "S00283",
      "start": 547.72,
      "end": 548.44,
      "text": "我要什么"
    },
    {
      "sid": "S00284",
      "start": 548.44,
      "end": 549.7,
      "text": "我的感受是什么"
    },
    {
      "sid": "S00285",
      "start": 549.7,
      "end": 550.6,
      "text": "当你去健身"
    },
    {
      "sid": "S00286",
      "start": 550.6,
      "end": 552.0,
      "text": "是因为你真的喜欢"
    },
    {
      "sid": "S00287",
      "start": 552.0,
      "end": 553.46,
      "text": "你想拥有这样的身材"
    },
    {
      "sid": "S00288",
      "start": 553.46,
      "end": 555.3,
      "text": "而不是你想要通过身材"
    },
    {
      "sid": "S00289",
      "start": 555.3,
      "end": 556.7,
      "text": "来获得别人的认可"
    },
    {
      "sid": "S00290",
      "start": 556.7,
      "end": 557.9,
      "text": "当你去努力工作"
    },
    {
      "sid": "S00291",
      "start": 557.9,
      "end": 560.08,
      "text": "是因为你真的热爱你在做的事情"
    },
    {
      "sid": "S00292",
      "start": 560.08,
      "end": 561.7,
      "text": "而不是你想通过赚钱"
    },
    {
      "sid": "S00293",
      "start": 561.7,
      "end": 562.98,
      "text": "来获得别人的尊重"
    },
    {
      "sid": "S00294",
      "start": 562.98,
      "end": 564.16,
      "text": "当你去搭讪的时候"
    },
    {
      "sid": "S00295",
      "start": 564.16,
      "end": 565.5,
      "text": "你的出发点是"
    },
    {
      "sid": "S00296",
      "start": 565.5,
      "end": 566.7,
      "text": "我想认识你"
    },
    {
      "sid": "S00297",
      "start": 566.7,
      "end": 568.52,
      "text": "而不是这个女生会怎么看我"
    },
    {
      "sid": "S00298",
      "start": 568.52,
      "end": 569.82,
      "text": "你去对一个人好"
    },
    {
      "sid": "S00299",
      "start": 569.82,
      "end": 571.4,
      "text": "只是因为你是一个好人"
    },
    {
      "sid": "S00300",
      "start": 571.4,
      "end": 572.24,
      "text": "你对他好"
    },
    {
      "sid": "S00301",
      "start": 572.24,
      "end": 573.92,
      "text": "而不是我对你好的目的"
    },
    {
      "sid": "S00302",
      "start": 573.92,
      "end": 574.9,
      "text": "是为了从你身上"
    },
    {
      "sid": "S00303",
      "start": 574.9,
      "end": 576.04,
      "text": "获得我想要的东西"
    },
    {
      "sid": "S00304",
      "start": 576.04,
      "end": 577.34,
      "text": "当你在一场约会中"
    },
    {
      "sid": "S00305",
      "start": 577.34,
      "end": 578.4,
      "text": "关注的不再是"
    },
    {
      "sid": "S00306",
      "start": 578.4,
      "end": 580.0,
      "text": "这个女生会怎么看我"
    },
    {
      "sid": "S00307",
      "start": 580.0,
      "end": 581.84,
      "text": "怎么样才能让她喜欢上我"
    },
    {
      "sid": "S00308",
      "start": 581.84,
      "end": 583.96,
      "text": "而是你真的在享受这场约会"
    },
    {
      "sid": "S00309",
      "start": 583.96,
      "end": 585.08,
      "text": "当她迟到的时候"
    },
    {
      "sid": "S00310",
      "start": 585.08,
      "end": 587.24,
      "text": "你也可以很大方的去质疑她"
    },
    {
      "sid": "S00311",
      "start": 587.24,
      "end": 588.74,
      "text": "你怎么迟到了"
    },
    {
      "sid": "S00312",
      "start": 588.74,
      "end": 590.08,
      "text": "迟到的人记得买单"
    },
    {
      "sid": "S00313",
      "start": 590.08,
      "end": 591.56,
      "text": "有的兄弟会总是问我"
    },
    {
      "sid": "S00314",
      "start": 591.56,
      "end": 592.68,
      "text": "我不会推开女生"
    },
    {
      "sid": "S00315",
      "start": 592.68,
      "end": 594.02,
      "text": "我也不敢筛选女人"
    },
    {
      "sid": "S00316",
      "start": 594.02,
      "end": 595.56,
      "text": "一个真正拥有自我的人"
    },
    {
      "sid": "S00317",
      "start": 595.56,
      "end": 597.68,
      "text": "在女生做了不好的行为的时候"
    },
    {
      "sid": "S00318",
      "start": 597.68,
      "end": 599.4,
      "text": "就会本能的去推开她"
    },
    {
      "sid": "S00319",
      "start": 599.4,
      "end": 600.24,
      "text": "去筛选她"
    },
    {
      "sid": "S00320",
      "start": 600.24,
      "end": 600.96,
      "text": "拥有自我"
    },
    {
      "sid": "S00321",
      "start": 600.96,
      "end": 602.64,
      "text": "这才是真正的自我提升"
    },
    {
      "sid": "S00322",
      "start": 602.64,
      "end": 603.96,
      "text": "一个自我的男人"
    },
    {
      "sid": "S00323",
      "start": 603.96,
      "end": 605.76,
      "text": "是不会把自己因为热爱"
    },
    {
      "sid": "S00324",
      "start": 605.76,
      "end": 606.9,
      "text": "努力挣到的钱"
    },
    {
      "sid": "S00325",
      "start": 606.9,
      "end": 608.56,
      "text": "交给一个不工作的女人"
    },
    {
      "sid": "S00326",
      "start": 608.56,
      "end": 609.26,
      "text": "来管理的"
    },
    {
      "sid": "S00327",
      "start": 609.26,
      "end": 617.98,
      "text": "在泰泰尼克号里"
    },
    {
      "sid": "S00328",
      "start": 617.98,
      "end": 620.36,
      "text": "杰克被Rose带去了富人的聚会"
    },
    {
      "sid": "S00329",
      "start": 620.36,
      "end": 623.06,
      "text": "Rose的未婚夫以及那些富人们"
    },
    {
      "sid": "S00330",
      "start": 623.06,
      "end": 624.4,
      "text": "正在关注自己的形象"
    },
    {
      "sid": "S00331",
      "start": 624.4,
      "end": 625.64,
      "text": "关注自己的女伴"
    },
    {
      "sid": "S00332",
      "start": 625.64,
      "end": 626.58,
      "text": "自己的生意"
    },
    {
      "sid": "S00333",
      "start": 626.58,
      "end": 628.8,
      "text": "是否会迎来他人羡慕的目光"
    },
    {
      "sid": "S00334",
      "start": 628.8,
      "end": 629.76,
      "text": "而杰克呢"
    },
    {
      "sid": "S00335",
      "start": 629.76,
      "end": 631.16,
      "text": "他只在关注他自己"
    },
    {
      "sid": "S00336",
      "start": 631.16,
      "end": 633.26,
      "text": "他会因为自己不懂得用刀叉"
    },
    {
      "sid": "S00337",
      "start": 633.26,
      "end": 635.52,
      "text": "而大方的去询问旁边的人"
    },
    {
      "sid": "S00338",
      "start": 635.52,
      "end": 637.44,
      "text": "会因为被Rose的母亲质疑"
    },
    {
      "sid": "S00339",
      "start": 637.44,
      "end": 638.74,
      "text": "而大方的阐述"
    },
    {
      "sid": "S00340",
      "start": 638.74,
      "end": 640.48,
      "text": "我的船票是我迎来的"
    },
    {
      "sid": "S00341",
      "start": 640.48,
      "end": 641.16,
      "text": "那很棒"
    },
    {
      "sid": "S00342",
      "start": 641.16,
      "end": 642.78,
      "text": "我很热爱我的绘画事业"
    },
    {
      "sid": "S00343",
      "start": 642.78,
      "end": 644.32,
      "text": "他给我带来了快乐"
    },
    {
      "sid": "S00344",
      "start": 644.32,
      "end": 645.9,
      "text": "他不在意别人怎么看他"
    },
    {
      "sid": "S00345",
      "start": 645.9,
      "end": 646.82,
      "text": "而这么做呢"
    },
    {
      "sid": "S00346",
      "start": 646.82,
      "end": 649.36,
      "text": "也为他赢得了真正的尊重与吸引"
    },
    {
      "sid": "S00347",
      "start": 649.36,
      "end": 651.2,
      "text": "回到我们之前聊过的话题"
    },
    {
      "sid": "S00348",
      "start": 651.2,
      "end": 653.48,
      "text": "为什么那些精神小伙会有吸引力"
    },
    {
      "sid": "S00349",
      "start": 653.48,
      "end": 654.9,
      "text": "在某种程度来说"
    },
    {
      "sid": "S00350",
      "start": 654.9,
      "end": 657.06,
      "text": "杰克就是那个时代的精神小伙"
    },
    {
      "sid": "S00351",
      "start": 657.06,
      "end": 658.8,
      "text": "除了之前视频里提到的"
    },
    {
      "sid": "S00352",
      "start": 658.8,
      "end": 660.28,
      "text": "他们拥有猎人基因以外"
    },
    {
      "sid": "S00353",
      "start": 660.28,
      "end": 661.42,
      "text": "还有一个答案是"
    },
    {
      "sid": "S00354",
      "start": 661.42,
      "end": 662.48,
      "text": "他们拥有自我"
    },
    {
      "sid": "S00355",
      "start": 662.48,
      "end": 664.14,
      "text": "当一个没有自我的男人"
    },
    {
      "sid": "S00356",
      "start": 664.14,
      "end": 665.12,
      "text": "去跟女神约会"
    },
    {
      "sid": "S00357",
      "start": 665.12,
      "end": 666.98,
      "text": "他会关注女人的一切行为"
    },
    {
      "sid": "S00358",
      "start": 666.98,
      "end": 669.74,
      "text": "会解释女人的各种废策和筛选"
    },
    {
      "sid": "S00359",
      "start": 669.74,
      "end": 670.42,
      "text": "会讨好"
    },
    {
      "sid": "S00360",
      "start": 670.42,
      "end": 671.1,
      "text": "会迎合"
    },
    {
      "sid": "S00361",
      "start": 671.1,
      "end": 673.38,
      "text": "当这个女神和这样的男人约会完呢"
    },
    {
      "sid": "S00362",
      "start": 673.38,
      "end": 675.38,
      "text": "他会给他的闺蜜发消息说"
    },
    {
      "sid": "S00363",
      "start": 675.38,
      "end": 676.8,
      "text": "这个男生还蛮好的"
    },
    {
      "sid": "S00364",
      "start": 676.8,
      "end": 678.38,
      "text": "而一个有自我的男人"
    },
    {
      "sid": "S00365",
      "start": 678.38,
      "end": 679.6,
      "text": "去和女神约会完"
    },
    {
      "sid": "S00366",
      "start": 679.6,
      "end": 681.36,
      "text": "女生回去会给闺蜜分享"
    },
    {
      "sid": "S00367",
      "start": 681.36,
      "end": 682.86,
      "text": "这个男生有点坏坏的"
    },
    {
      "sid": "S00368",
      "start": 682.86,
      "end": 684.52,
      "text": "但我好像对他蛮有感觉的"
    },
    {
      "sid": "S00369",
      "start": 684.52,
      "end": 686.2,
      "text": "女人口中的感觉呢"
    },
    {
      "sid": "S00370",
      "start": 686.2,
      "end": 687.58,
      "text": "就是真正的吸引力"
    },
    {
      "sid": "S00371",
      "start": 687.58,
      "end": 690.12,
      "text": "最近我的学员会经常问我一个问题"
    },
    {
      "sid": "S00372",
      "start": 690.12,
      "end": 691.68,
      "text": "我很需要确定性"
    },
    {
      "sid": "S00373",
      "start": 691.68,
      "end": 693.0,
      "text": "我很需要正反馈"
    },
    {
      "sid": "S00374",
      "start": 693.0,
      "end": 694.78,
      "text": "当我在约会过程中呢"
    },
    {
      "sid": "S00375",
      "start": 694.78,
      "end": 695.74,
      "text": "我能拿到女生"
    },
    {
      "sid": "S00376",
      "start": 695.74,
      "end": 697.82,
      "text": "对我喜欢的这个确定性时"
    },
    {
      "sid": "S00377",
      "start": 697.82,
      "end": 699.3,
      "text": "或者是这条线索时"
    },
    {
      "sid": "S00378",
      "start": 699.3,
      "end": 701.08,
      "text": "我的状态就会变得非常好"
    },
    {
      "sid": "S00379",
      "start": 701.08,
      "end": 702.36,
      "text": "但我一旦不确定"
    },
    {
      "sid": "S00380",
      "start": 702.36,
      "end": 703.68,
      "text": "这个女生是否喜欢我"
    },
    {
      "sid": "S00381",
      "start": 703.68,
      "end": 705.12,
      "text": "我一旦拿不到这个确定性"
    },
    {
      "sid": "S00382",
      "start": 705.12,
      "end": 706.0,
      "text": "我就搞不定"
    },
    {
      "sid": "S00383",
      "start": 706.0,
      "end": 706.86,
      "text": "我就不自信"
    },
    {
      "sid": "S00384",
      "start": 706.86,
      "end": 709.02,
      "text": "这个问题的本质依然是自我"
    },
    {
      "sid": "S00385",
      "start": 709.02,
      "end": 710.94,
      "text": "你需要获得对方的认可"
    },
    {
      "sid": "S00386",
      "start": 710.94,
      "end": 712.48,
      "text": "你才能够觉得"
    },
    {
      "sid": "S00387",
      "start": 712.48,
      "end": 713.7,
      "text": "哦我可以了"
    },
    {
      "sid": "S00388",
      "start": 713.7,
      "end": 714.18,
      "text": "我行了"
    },
    {
      "sid": "S00389",
      "start": 714.18,
      "end": 716.06,
      "text": "你的不配得感才会消失"
    },
    {
      "sid": "S00390",
      "start": 716.06,
      "end": 717.24,
      "text": "你才敢操作"
    },
    {
      "sid": "S00391",
      "start": 717.24,
      "end": 719.06,
      "text": "你并没有把自己的感觉"
    },
    {
      "sid": "S00392",
      "start": 719.06,
      "end": 719.84,
      "text": "放在第一位"
    },
    {
      "sid": "S00393",
      "start": 719.84,
      "end": 720.98,
      "text": "你的动力呢"
    },
    {
      "sid": "S00394",
      "start": 720.98,
      "end": 722.46,
      "text": "依然是对方的认可"
    },
    {
      "sid": "S00395",
      "start": 722.46,
      "end": 723.26,
      "text": "你没有自我"
    },
    {
      "sid": "S00396",
      "start": 723.26,
      "end": 725.64,
      "text": "弗洛伊德在《闷的解析》里提到的"
    },
    {
      "sid": "S00397",
      "start": 725.64,
      "end": 726.12,
      "text": "本我"
    },
    {
      "sid": "S00398",
      "start": 726.12,
      "end": 726.64,
      "text": "自我"
    },
    {
      "sid": "S00399",
      "start": 726.64,
      "end": 727.32,
      "text": "与超我"
    },
    {
      "sid": "S00400",
      "start": 727.32,
      "end": 729.84,
      "text": "无数哲人都在探讨过的这个问题"
    },
    {
      "sid": "S00401",
      "start": 729.84,
      "end": 730.76,
      "text": "我是谁"
    },
    {
      "sid": "S00402",
      "start": 730.76,
      "end": 731.86,
      "text": "Mikey在这里呢"
    },
    {
      "sid": "S00403",
      "start": 731.86,
      "end": 735.18,
      "text": "不想探讨过多的心理学和哲学层面的问题"
    },
    {
      "sid": "S00404",
      "start": 735.18,
      "end": 736.42,
      "text": "我想告诉你的是"
    },
    {
      "sid": "S00405",
      "start": 736.42,
      "end": 737.44,
      "text": "我就是我"
    },
    {
      "sid": "S00406",
      "start": 737.44,
      "end": 738.4,
      "text": "你就是你"
    },
    {
      "sid": "S00407",
      "start": 738.4,
      "end": 740.5,
      "text": "我是一个值得被任何人尊重"
    },
    {
      "sid": "S00408",
      "start": 740.5,
      "end": 741.5,
      "text": "被任何人爱"
    },
    {
      "sid": "S00409",
      "start": 741.5,
      "end": 743.72,
      "text": "值得去敢于表达自己的"
    },
    {
      "sid": "S00410",
      "start": 743.72,
      "end": 746.32,
      "text": "值得去敢于探索自己的本能"
    },
    {
      "sid": "S00411",
      "start": 746.32,
      "end": 748.68,
      "text": "值得去感受生命中的一切"
    },
    {
      "sid": "S00412",
      "start": 748.68,
      "end": 750.46,
      "text": "值得去为自己而活的"
    },
    {
      "sid": "S00413",
      "start": 750.46,
      "end": 750.76,
      "text": "我"
    },
    {
      "sid": "S00414",
      "start": 750.76,
      "end": 754.06,
      "text": "我是值得在这样的一个被精神阉割"
    },
    {
      "sid": "S00415",
      "start": 754.06,
      "end": 754.88,
      "text": "被词化"
    },
    {
      "sid": "S00416",
      "start": 754.88,
      "end": 755.64,
      "text": "被矮化"
    },
    {
      "sid": "S00417",
      "start": 755.64,
      "end": 756.78,
      "text": "被女本位主义"
    },
    {
      "sid": "S00418",
      "start": 756.78,
      "end": 757.68,
      "text": "被基因"
    },
    {
      "sid": "S00419",
      "start": 757.68,
      "end": 758.32,
      "text": "字号"
    },
    {
      "sid": "S00420",
      "start": 758.32,
      "end": 759.42,
      "text": "封锁的时代里"
    },
    {
      "sid": "S00421",
      "start": 759.42,
      "end": 759.98,
      "text": "觉醒"
    },
    {
      "sid": "S00422",
      "start": 759.98,
      "end": 760.82,
      "text": "探寻"
    },
    {
      "sid": "S00423",
      "start": 760.82,
      "end": 761.56,
      "text": "开悟"
    },
    {
      "sid": "S00424",
      "start": 761.56,
      "end": 762.56,
      "text": "提升的"
    },
    {
      "sid": "S00425",
      "start": 762.56,
      "end": 763.06,
      "text": "我"
    },
    {
      "sid": "S00426",
      "start": 763.06,
      "end": 764.72,
      "text": "我与你们无数个我"
    },
    {
      "sid": "S00427",
      "start": 764.72,
      "end": 765.88,
      "text": "一起共勉"
    },
    {
      "sid": "S00428",
      "start": 765.88,
      "end": 767.06,
      "text": "纪伯伦说过"
    },
    {
      "sid": "S00429",
      "start": 767.06,
      "end": 768.08,
      "text": "如果有一天"
    },
    {
      "sid": "S00430",
      "start": 768.08,
      "end": 769.58,
      "text": "你不再去寻找爱情"
    },
    {
      "sid": "S00431",
      "start": 769.58,
      "end": 770.64,
      "text": "你只是去爱"
    },
    {
      "sid": "S00432",
      "start": 770.64,
      "end": 772.14,
      "text": "你不再渴望成功"
    },
    {
      "sid": "S00433",
      "start": 772.14,
      "end": 773.22,
      "text": "你只是去做"
    },
    {
      "sid": "S00434",
      "start": 773.22,
      "end": 775.26,
      "text": "你不再追求空泛的成长"
    },
    {
      "sid": "S00435",
      "start": 775.26,
      "end": 777.4,
      "text": "只是开始修养自己的性情"
    },
    {
      "sid": "S00436",
      "start": 777.4,
      "end": 778.84,
      "text": "你的人生的一切"
    },
    {
      "sid": "S00437",
      "start": 778.84,
      "end": 780.44,
      "text": "才真正开始"
    }
  ]
}
