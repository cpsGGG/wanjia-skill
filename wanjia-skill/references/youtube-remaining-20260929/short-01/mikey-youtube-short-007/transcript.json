  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.52,
      "text": "有意图羞耻怎么办"
    },
    {
      "sid": "S00002",
      "start": 1.52,
      "end": 2.8,
      "text": "有意图羞耻"
    },
    {
      "sid": "S00003",
      "start": 2.8,
      "end": 4.04,
      "text": "说明"
    },
    {
      "sid": "S00004",
      "start": 4.04,
      "end": 6.2,
      "text": "说明你在装逼"
    },
    {
      "sid": "S00005",
      "start": 6.2,
      "end": 7.86,
      "text": "因为你前面一直在装逼"
    },
    {
      "sid": "S00006",
      "start": 7.86,
      "end": 9.96,
      "text": "然后呢这回你突然得变坏人了"
    },
    {
      "sid": "S00007",
      "start": 9.96,
      "end": 11.22,
      "text": "你就有意图羞耻了"
    },
    {
      "sid": "S00008",
      "start": 11.22,
      "end": 13.02,
      "text": "你如果一开始表现的就不现"
    },
    {
      "sid": "S00009",
      "start": 13.02,
      "end": 14.5,
      "text": "你一开始就没有装逼"
    },
    {
      "sid": "S00010",
      "start": 14.5,
      "end": 15.88,
      "text": "那么你就不会有意图羞耻"
    },
    {
      "sid": "S00011",
      "start": 15.88,
      "end": 17.46,
      "text": "反正我是这样子的"
    },
    {
      "sid": "S00012",
      "start": 17.46,
      "end": 19.36,
      "text": "如果我前面一直在当好人"
    },
    {
      "sid": "S00013",
      "start": 19.36,
      "end": 20.98,
      "text": "这个时候呢我要当坏人了"
    },
    {
      "sid": "S00014",
      "start": 20.98,
      "end": 23.02,
      "text": "我会有一种一致性断裂的不舒适性"
    },
    {
      "sid": "S00015",
      "start": 23.02,
      "end": 23.96,
      "text": "不舒适感"
    },
    {
      "sid": "S00016",
      "start": 23.96,
      "end": 25.26,
      "text": "但是我如果一开始"
    },
    {
      "sid": "S00017",
      "start": 25.26,
      "end": 25.96,
      "text": "我就不决"
    },
    {
      "sid": "S00018",
      "start": 25.96,
      "end": 27.28,
      "text": "我就没把自己当好人"
    },
    {
      "sid": "S00019",
      "start": 28.28,
      "end": 29.68,
      "text": "我就没把自己当好人"
    },
    {
      "sid": "S00020",
      "start": 29.68,
      "end": 31.6,
      "text": "结果你猜什么着"
    },
    {
      "sid": "S00021",
      "start": 31.6,
      "end": 33.62,
      "text": "我那个我真的是无敌啊"
    },
    {
      "sid": "S00022",
      "start": 33.62,
      "end": 36.26,
      "text": "人党杀佛党杀佛"
    },
    {
      "sid": "S00023",
      "start": 36.26,
      "end": 38.38,
      "text": "然后变得非常强"
    },
    {
      "sid": "S00024",
      "start": 38.38,
      "end": 38.9,
      "text": "你懂不懂"
    },
    {
      "sid": "S00025",
      "start": 38.9,
      "end": 39.984762,
      "text": "你懂不懂"
    }
  ]
