{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-002",
  "youtube_id": "Z2sgjH3FmeU",
  "media_sha256": "c20a418401d43aae98ad6b49f5849b883a845fed88528faaf24c42842b9d6746",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.56,
      "text": "早期你像Sam这些来他没钱"
    },
    {
      "sid": "S00002",
      "start": 1.56,
      "end": 3.1,
      "text": "他不可能像我一样去沉淀三年"
    },
    {
      "sid": "S00003",
      "start": 3.1,
      "end": 4.12,
      "text": "我自己当情感导师"
    },
    {
      "sid": "S00004",
      "start": 4.12,
      "end": 6.02,
      "text": "我是沉淀了三年才可以去当情感导师"
    },
    {
      "sid": "S00005",
      "start": 6.02,
      "end": 7.54,
      "text": "他没有那么多时间去当一个导师"
    },
    {
      "sid": "S00006",
      "start": 7.54,
      "end": 8.36,
      "text": "你的意思是"
    },
    {
      "sid": "S00007",
      "start": 8.36,
      "end": 10.6,
      "text": "你旗下的导师还只是学徒是吗"
    },
    {
      "sid": "S00008",
      "start": 10.6,
      "end": 12.16,
      "text": "因为他们全是我教出来的"
    },
    {
      "sid": "S00009",
      "start": 12.16,
      "end": 13.48,
      "text": "既然是你教出来的"
    },
    {
      "sid": "S00010",
      "start": 13.48,
      "end": 14.94,
      "text": "你说你沉淀三年"
    },
    {
      "sid": "S00011",
      "start": 14.94,
      "end": 18.22,
      "text": "为什么你旗下导师实战经验比你还丰富"
    },
    {
      "sid": "S00012",
      "start": 18.22,
      "end": 20.34,
      "text": "所以说我需要帮他去制造一些流量"
    },
    {
      "sid": "S00013",
      "start": 20.34,
      "end": 22.56,
      "text": "能把团队造假说得这么高大上"
    },
    {
      "sid": "S00014",
      "start": 22.56,
      "end": 23.8,
      "text": "兄弟你无敌了"
    },
    {
      "sid": "S00015",
      "start": 23.8,
      "end": 24.84,
      "text": "对我就允许他们去演"
    },
    {
      "sid": "S00016",
      "start": 24.84,
      "end": 26.22,
      "text": "我还会给钱去支持他们"
    },
    {
      "sid": "S00017",
      "start": 26.22,
      "end": 27.9,
      "text": "不仅不懂得迷途之反"
    },
    {
      "sid": "S00018",
      "start": 27.9,
      "end": 29.36,
      "text": "还支持导师造假"
    },
    {
      "sid": "S00019",
      "start": 29.36,
      "end": 31.28,
      "text": "团队含金量可想而知"
    },
    {
      "sid": "S00020",
      "start": 31.28,
      "end": 31.9,
      "text": "FM造假也好"
    },
    {
      "sid": "S00021",
      "start": 31.9,
      "end": 32.64,
      "text": "ZK造假也好"
    },
    {
      "sid": "S00022",
      "start": 32.64,
      "end": 33.56,
      "text": "还是Hank造假也好"
    },
    {
      "sid": "S00023",
      "start": 33.56,
      "end": 34.1,
      "text": "这都无所谓"
    },
    {
      "sid": "S00024",
      "start": 34.1,
      "end": 35.04,
      "text": "他们无论放什么材料"
    },
    {
      "sid": "S00025",
      "start": 35.04,
      "end": 36.96,
      "text": "都只能证明Jackson是个好人"
    },
    {
      "sid": "S00026",
      "start": 36.96,
      "end": 40.38,
      "text": "来来来兄弟"
    },
    {
      "sid": "S00027",
      "start": 40.38,
      "end": 42.3,
      "text": "我倒要听听你要放什么屁"
    },
    {
      "sid": "S00028",
      "start": 42.3,
      "end": 44.14,
      "text": "好到允许你们去造假"
    },
    {
      "sid": "S00029",
      "start": 44.14,
      "end": 45.86,
      "text": "因为我想让旗下的兄弟们"
    },
    {
      "sid": "S00030",
      "start": 45.86,
      "end": 46.76,
      "text": "快速的起号"
    },
    {
      "sid": "S00031",
      "start": 46.76,
      "end": 47.72,
      "text": "快速的挣到钱"
    }
  ]
}
