    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.6,
      "text": "就是我旗下的人确实造假了"
    },
    {
      "sid": "S00002",
      "start": 1.6,
      "end": 4.16,
      "text": "我们没日没夜的去总结"
