      "text": "却要能受这么大的恶意"
    },
    {
      "sid": "S00016",
      "start": 21.8,
      "end": 25.24,
      "text": "去门Terry导师急割带走骚骚夫啊"
    },
    {
      "sid": "S00017",
      "start": 25.24,
      "end": 26.4,
      "text": "不看"
    },
    {
      "sid": "S00018",
      "start": 26.4,
      "end": 27.44,
      "text": "不看也不看"
    },
    {
      "sid": "S00019",
      "start": 27.44,
      "end": 28.2,
      "text": "这些人了"
    },
    {
      "sid": "S00020",
      "start": 28.2,
      "end": 28.8,
      "text": "确实造假了"
    },
    {
      "sid": "S00021",
      "start": 28.8,
      "end": 29.16,
      "text": "确实造假了"
    },
    {
      "sid": "S00022",
      "start": 29.16,
      "end": 29.76,
      "text": "确实造假了"
    },
    {
      "sid": "S00023",
      "start": 29.76,
      "end": 31.12,
      "text": "谁造假谁就滚"
    },
    {
      "sid": "S00024",
      "start": 31.12,
      "end": 35.19,
      "text": "SYM这些人美前请演员的"
