      "text": "冒着风险去实战"
    },
    {
      "sid": "S00005",
      "start": 6.2,
      "end": 6.8,
      "text": "确实造假了"
    },
    {
      "sid": "S00006",
      "start": 6.8,
      "end": 8.3,
      "text": "就是为了把最真实"
    },
    {
      "sid": "S00007",
      "start": 8.3,
      "end": 8.8,
      "text": "确实造假了"
    },
    {
      "sid": "S00008",
