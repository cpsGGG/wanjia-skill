    {
      "sid": "S00026",
      "start": 36.15,
      "end": 36.71,
      "text": "让他去请"
    },
    {
      "sid": "S00027",
      "start": 36.71,
      "end": 41.54,
      "text": "我是允许HANK他们造假了"
    },
    {
      "sid": "S00028",
      "start": 41.54,
      "end": 46.05,
      "text": "这里可能做了很多人的蛋糕了"
    },
    {
      "sid": "S00029",
      "start": 46.05,
      "end": 46.61,
      "text": "但是无所谓"
