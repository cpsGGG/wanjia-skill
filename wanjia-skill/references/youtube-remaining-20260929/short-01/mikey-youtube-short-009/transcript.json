  "media_sha256": "4b23f35eaaf3abca0a9cb05364509c98db76f79d26ad3c45f09e45183de0ae56",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 0.72,
      "text": "你一场"
    },
    {
      "sid": "S00002",
      "start": 0.72,
      "end": 5.16,
      "text": "外哥怎么做到自我和认真投入一段感情不充足"
    },
    {
      "sid": "S00003",
      "start": 5.16,
      "end": 7.14,
      "text": "自我是本来的"
    },
    {
      "sid": "S00004",
      "start": 7.14,
      "end": 9.3,
      "text": "自我是你的本来面目"
    },
    {
      "sid": "S00005",
      "start": 9.3,
      "end": 10.84,
      "text": "它是你的这个人的本身"
    },
    {
      "sid": "S00006",
      "start": 10.84,
      "end": 12.98,
      "text": "你这个人你来到这个世界上"
    },
    {
      "sid": "S00007",
      "start": 12.98,
      "end": 14.32,
      "text": "你就应该是有主体性的"
    },
    {
      "sid": "S00008",
      "start": 14.32,
      "end": 15.94,
      "text": "你没有主体性你就不是一个人"
    },
    {
      "sid": "S00009",
      "start": 15.94,
      "end": 18.0,
      "text": "你没有主体性你就是一条狗"
    },
    {
      "sid": "S00010",
      "start": 18.0,
      "end": 19.48,
      "text": "你懂吗"
    },
    {
      "sid": "S00011",
      "start": 19.48,
      "end": 20.16,
      "text": "你是一条狗"
    },
    {
      "sid": "S00012",
      "start": 20.16,
      "end": 21.76,
      "text": "然后你又去投入一段管情"
    },
    {
      "sid": "S00013",
      "start": 21.76,
      "end": 22.9,
      "text": "那你就是舔狗"
    },
    {
      "sid": "S00014",
      "start": 22.9,
      "end": 25.06,
      "text": "那你如果你是一个有主体性的人"
    },
    {
      "sid": "S00015",
      "start": 25.06,
      "end": 28.0,
      "text": "那么这个时候你是有选择权的"
    },
    {
      "sid": "S00016",
      "start": 28.0,
      "end": 30.2,
      "text": "你想投入和不投入"
    },
    {
      "sid": "S00017",
      "start": 30.2,
      "end": 32.4,
      "text": "那都在于你能懂吗"
    },
    {
      "sid": "S00018",
      "start": 32.4,
      "end": 33.84,
      "text": "只是你投入感情"
    },
    {
      "sid": "S00019",
      "start": 33.84,
      "end": 35.18,
      "text": "这段关系会更长"
    },
    {
      "sid": "S00020",
      "start": 35.18,
      "end": 36.64,
      "text": "你不投入感情的这段关系"
    },
    {
      "sid": "S00021",
      "start": 36.64,
      "end": 38.36,
      "text": "它可能就是一夜情"
    },
    {
      "sid": "S00022",
      "start": 38.36,
      "end": 39.98,
      "text": "能理解吧"
    },
    {
      "sid": "S00023",
      "start": 39.98,
      "end": 42.5,
      "text": "但是有主体性是吸引力的"
    },
    {
      "sid": "S00024",
      "start": 42.5,
      "end": 44.8,
      "text": "本来吸引力的根源"
    }
  ]
}
