{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-010",
  "youtube_id": "5zGlhGJloA0",
  "media_sha256": "a6f10f34ba728c235cfb82e16385a10bfa732b7b2b88001ab8fc94846fbf6807",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.1,
      "text": "为什么你对女人好"
    },
    {
      "sid": "S00002",
      "start": 1.1,
      "end": 2.6,
      "text": "然后女人并不会爱你"
    },
    {
      "sid": "S00003",
      "start": 2.6,
      "end": 4.18,
      "text": "并不是说你对女人"
    },
    {
      "sid": "S00004",
      "start": 4.18,
      "end": 5.5,
      "text": "坏女人就会爱上你"
    },
    {
      "sid": "S00005",
      "start": 5.5,
      "end": 6.7,
      "text": "其实不是这样子的"
    },
    {
      "sid": "S00006",
      "start": 6.7,
      "end": 8.72,
      "text": "本质上是你这个人要"
    },
    {
      "sid": "S00007",
      "start": 8.72,
      "end": 10.34,
      "text": "拥有自我"
    },
    {
      "sid": "S00008",
      "start": 10.34,
      "end": 13.3,
      "text": "但是我们大多数时候"
    },
    {
      "sid": "S00009",
      "start": 13.3,
      "end": 14.24,
      "text": "我们在社会上"
    },
    {
      "sid": "S00010",
      "start": 14.24,
      "end": 15.46,
      "text": "一个拥有自我的男人"
    },
    {
      "sid": "S00011",
      "start": 15.46,
      "end": 17.3,
      "text": "就会被别人骂做渣男"
    },
    {
      "sid": "S00012",
      "start": 17.3,
      "end": 18.76,
      "text": "或者是不受控制的人"
    },
    {
      "sid": "S00013",
      "start": 18.76,
      "end": 20.1,
      "text": "然后女生会给他"
    },
    {
      "sid": "S00014",
      "start": 20.1,
      "end": 22.42,
      "text": "就是一些负面的评价"
    },
    {
      "sid": "S00015",
      "start": 22.42,
      "end": 24.06,
      "text": "但是从结果来讲"
    },
    {
      "sid": "S00016",
      "start": 24.06,
      "end": 25.26,
      "text": "最后女生都会喜欢上"
    },
    {
      "sid": "S00017",
      "start": 25.26,
      "end": 27.06,
      "text": "这类比较自我的男生"
    },
    {
      "sid": "S00018",
      "start": 27.06,
      "end": 28.44,
      "text": "因为他们有能有脚"
    },
    {
      "sid": "S00019",
      "start": 28.44,
      "end": 29.66,
      "text": "他们是一个人"
    },
    {
      "sid": "S00020",
      "start": 29.66,
      "end": 31.96,
      "text": "你说我教泡妞这个东西"
    },
    {
      "sid": "S00021",
      "start": 31.96,
      "end": 32.4,
      "text": "我很多时候"
    },
    {
      "sid": "S00022",
      "start": 32.4,
      "end": 33.9,
      "text": "我是在教那种泡妞吗"
    },
    {
      "sid": "S00023",
      "start": 33.9,
      "end": 34.62,
      "text": "不是啊"
    },
    {
      "sid": "S00024",
      "start": 34.62,
      "end": 35.08,
      "text": "我也没有"
    },
    {
      "sid": "S00025",
      "start": 35.08,
      "end": 36.18,
      "text": "我更多的是"
    },
    {
      "sid": "S00026",
      "start": 36.18,
      "end": 37.98,
      "text": "教你们怎么样成为一个"
    },
    {
      "sid": "S00027",
      "start": 37.98,
      "end": 38.92,
      "text": "拥有自我"
    },
    {
      "sid": "S00028",
      "start": 38.92,
      "end": 39.98,
      "text": "拥有吸引力的人"
    },
    {
      "sid": "S00029",
      "start": 39.98,
      "end": 41.54,
      "text": "因为大多数没有"
    },
    {
      "sid": "S00030",
      "start": 41.54,
      "end": 43.46,
      "text": "太多人没有主体性了"
    },
    {
      "sid": "S00031",
      "start": 43.46,
      "end": 45.02,
      "text": "他们没有任何主体性"
    },
    {
      "sid": "S00032",
      "start": 45.02,
      "end": 45.76,
      "text": "他们来到这个世界上"
    },
    {
      "sid": "S00033",
      "start": 45.76,
      "end": 47.1,
      "text": "他不知道自己是来干什么的"
    },
    {
      "sid": "S00034",
      "start": 47.1,
      "end": 48.78,
      "text": "他跟女生约会"
    },
    {
      "sid": "S00035",
      "start": 48.78,
      "end": 49.28,
      "text": "说实话"
    },
    {
      "sid": "S00036",
      "start": 49.28,
      "end": 51.06,
      "text": "他脑袋里全都是"
    },
    {
      "sid": "S00037",
      "start": 51.06,
      "end": 53.4,
      "text": "这女生不喜欢我"
    },
    {
      "sid": "S00038",
      "start": 53.4,
      "end": 54.88,
      "text": "我要怎么去证明"
    },
    {
      "sid": "S00039",
      "start": 54.88,
      "end": 56.1,
      "text": "自己这女生才会爱上我"
    },
    {
      "sid": "S00040",
      "start": 56.1,
      "end": 57.56,
      "text": "他把自己放在低位"
    },
    {
      "sid": "S00041",
      "start": 57.56,
      "end": 59.14,
      "text": "把女人当成了一个就是"
    },
    {
      "sid": "S00042",
      "start": 59.14,
      "end": 60.8,
      "text": "可以审视她价值的人"
    },
    {
      "sid": "S00043",
      "start": 60.8,
      "end": 61.72,
      "text": "就是你"
    },
    {
      "sid": "S00044",
      "start": 61.72,
      "end": 63.4,
      "text": "在这个世界上"
    },
    {
      "sid": "S00045",
      "start": 63.4,
      "end": 64.76,
      "text": "除你之外的任何人"
    },
    {
      "sid": "S00046",
      "start": 64.76,
      "end": 65.64,
      "text": "都没有那么重要"
    },
    {
      "sid": "S00047",
      "start": 65.64,
      "end": 66.44,
      "text": "不管你的父母"
    },
    {
      "sid": "S00048",
      "start": 66.44,
      "end": 67.88,
      "text": "还是你的老婆"
    },
    {
      "sid": "S00049",
      "start": 67.88,
      "end": 69.3,
      "text": "还是你正在约会的对象"
    },
    {
      "sid": "S00050",
      "start": 69.3,
      "end": 69.92,
      "text": "你的女朋友"
    },
    {
      "sid": "S00051",
      "start": 69.92,
      "end": 71.06,
      "text": "都不重要"
    },
    {
      "sid": "S00052",
      "start": 71.06,
      "end": 72.7,
      "text": "这个世界是你自己的"
    },
    {
      "sid": "S00053",
      "start": 72.7,
      "end": 74.1,
      "text": "你是最重要的"
    },
    {
      "sid": "S00054",
      "start": 74.1,
      "end": 76.44,
      "text": "你不需要去讨好任何人"
    },
    {
      "sid": "S00055",
      "start": 76.44,
      "end": 77.94,
      "text": "但你不去讨好任何人的时候"
    },
    {
      "sid": "S00056",
      "start": 77.94,
      "end": 79.42,
      "text": "你不再去渴求"
    },
    {
      "sid": "S00057",
      "start": 79.42,
      "end": 80.3,
      "text": "别人喜欢你的时候"
    },
    {
      "sid": "S00058",
      "start": 80.3,
      "end": 81.18,
      "text": "你就自由了"
    },
    {
      "sid": "S00059",
      "start": 81.18,
      "end": 82.68,
      "text": "你就会拥有自我"
    },
    {
      "sid": "S00060",
      "start": 82.68,
      "end": 83.42,
      "text": "那这个时候"
    },
    {
      "sid": "S00061",
      "start": 83.42,
      "end": 84.36,
      "text": "你跟女人相处的时候"
    },
    {
      "sid": "S00062",
      "start": 84.36,
      "end": 85.2,
      "text": "你随便放个屁"
    },
    {
      "sid": "S00063",
      "start": 85.2,
      "end": 86.34,
      "text": "它其实都很有吸引力"
    },
    {
      "sid": "S00064",
      "start": 86.34,
      "end": 86.81941,
      "text": "我就是别人了"
    }
  ]
}
