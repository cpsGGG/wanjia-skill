{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-005",
  "youtube_id": "7oqg4ft8AGs",
  "media_sha256": "09a67387318dac0f024719533de0e51aa875ec749045e46ac99b6eb89411d1c3",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.3,
      "end": 2.32,
      "text": "如何让自己真的自信"
    },
    {
      "sid": "S00002",
      "start": 2.32,
      "end": 5.02,
      "text": "是要接纳自己的胆小吗"
    },
    {
      "sid": "S00003",
      "start": 5.02,
      "end": 7.38,
      "text": "我觉得"
    },
    {
      "sid": "S00004",
      "start": 7.38,
      "end": 10.94,
      "text": "就是你得接受我是一个胆小的这个"
    },
    {
      "sid": "S00005",
      "start": 10.94,
      "end": 14.18,
      "text": "就我当下胆小的这个状态能懂吗"
    },
    {
      "sid": "S00006",
      "start": 14.18,
      "end": 16.86,
      "text": "然后呢依然勇敢的去做事情"
    },
    {
      "sid": "S00007",
      "start": 16.86,
      "end": 18.48,
      "text": "依然做勇敢的事"
    },
    {
      "sid": "S00008",
      "start": 18.48,
      "end": 20.58,
      "text": "比如说你很胆小"
    },
    {
      "sid": "S00009",
      "start": 20.58,
      "end": 22.68,
      "text": "然后呢你又不接受自己的胆小"
    },
    {
      "sid": "S00010",
      "start": 22.68,
      "end": 24.76,
      "text": "你又说我不能胆小我不能胆小"
    },
    {
      "sid": "S00011",
      "start": 24.76,
      "end": 26.78,
      "text": "我不是一个胆小的人"
    },
    {
      "sid": "S00012",
      "start": 26.78,
      "end": 28.44,
      "text": "然后呢你会开始自我内好"
    },
    {
      "sid": "S00013",
      "start": 28.44,
      "end": 29.98,
      "text": "好"
    },
    {
      "sid": "S00014",
      "start": 29.98,
      "end": 31.82,
      "text": "这会导致什么"
    },
    {
      "sid": "S00015",
      "start": 31.82,
      "end": 34.38,
      "text": "这会导致你反而变得更加的胆小"
    },
    {
      "sid": "S00016",
      "start": 34.38,
      "end": 38.36,
      "text": "所以说我觉得治疗心理异地的方法呢"
    },
    {
      "sid": "S00017",
      "start": 38.36,
      "end": 42.72,
      "text": "就是不要太想着去证明自己了"
    },
    {
      "sid": "S00018",
      "start": 42.72,
      "end": 44.12,
      "text": "话说回来"
    },
    {
      "sid": "S00019",
      "start": 44.12,
      "end": 45.3,
      "text": "胆小"
    },
    {
      "sid": "S00020",
      "start": 45.3,
      "end": 47.18,
      "text": "这个东西怎么接纳自己呢"
    },
    {
      "sid": "S00021",
      "start": 47.18,
      "end": 49.66,
      "text": "你就允许自己胆小呗"
    },
    {
      "sid": "S00022",
      "start": 49.66,
      "end": 51.1,
      "text": "胆小是既定事实"
    },
    {
      "sid": "S00023",
      "start": 51.1,
      "end": 53.42,
      "text": "你不允许它对你没有任何的好处"
    },
    {
      "sid": "S00024",
      "start": 53.42,
      "end": 57.06,
      "text": "你允许它反而可以获得一些新的勇气"
    },
    {
      "sid": "S00025",
      "start": 57.06,
      "end": 60.16,
      "text": "然后呢去驱使你做继续做正确的事情"
    },
    {
      "sid": "S00026",
      "start": 60.44,
      "end": 61.0,
      "text": "谢谢大家"
    },
    {
      "sid": "S00027",
      "start": 61.0,
      "end": 62.0,
      "text": "谢谢大家"
    }
  ]
}
