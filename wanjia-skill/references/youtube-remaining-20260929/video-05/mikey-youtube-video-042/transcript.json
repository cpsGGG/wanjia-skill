{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-042",
  "youtube_id": "ZPqbKTYMsuc",
  "media_sha256": "efb5a671b3d638a932d496f2afd158d44be9adf5c323bdb8f6ba98b448105dc9",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.0,
      "text": "我是Mikey 这里是搭讪玩家TV"
    },
    {
      "sid": "S00002",
      "start": 2.0,
      "end": 4.0,
      "text": "今天我要和你们探讨的是"
    },
    {
      "sid": "S00003",
      "start": 4.0,
      "end": 7.5,
      "text": "搭讪过程中如何识别有效搭讪和无效搭讪"
    },
    {
      "sid": "S00004",
      "start": 7.5,
      "end": 9.0,
      "text": "等一下 我想认识你"
    },
    {
      "sid": "S00005",
      "start": 9.0,
      "end": 11.0,
      "text": "可以吗"
    },
    {
      "sid": "S00006",
      "start": 11.0,
      "end": 13.0,
      "text": "可以 加微信是吧"
    },
    {
      "sid": "S00007",
      "start": 13.0,
      "end": 14.0,
      "text": "我叫Mikey"
    },
    {
      "sid": "S00008",
      "start": 14.0,
      "end": 16.0,
      "text": "之前男生过来搭讪你都是会很慌"
    },
    {
      "sid": "S00009",
      "start": 16.0,
      "end": 18.0,
      "text": "还是他们过来跟你讲话就是直接加微信"
    },
    {
      "sid": "S00010",
      "start": 18.0,
      "end": 21.0,
      "text": "就一般都是加微信吧"
    },
    {
      "sid": "S00011",
      "start": 21.0,
      "end": 23.0,
      "text": "我以为你这个是一个就太阳镜"
    },
    {
      "sid": "S00012",
      "start": 23.0,
      "end": 24.0,
      "text": "没有 不是"
    },
    {
      "sid": "S00013",
      "start": 24.0,
      "end": 26.0,
      "text": "你下周忙吗"
    },
    {
      "sid": "S00014",
      "start": 26.0,
      "end": 28.0,
      "text": "我下周 我下周肯定要上课吧"
    },
    {
      "sid": "S00015",
      "start": 28.0,
      "end": 31.0,
      "text": "没事到时候是细节的话可以到时候说"
    },
    {
      "sid": "S00016",
      "start": 31.0,
      "end": 32.0,
      "text": "行 那我走了"
    },
    {
      "sid": "S00017",
      "start": 32.0,
      "end": 33.0,
      "text": "没信你了"
    },
    {
      "sid": "S00018",
      "start": 33.0,
      "end": 34.0,
      "text": "OK"
    },
    {
      "sid": "S00019",
      "start": 34.0,
      "end": 36.0,
      "text": "兄弟们要知道在搭讪结束后"
    },
    {
      "sid": "S00020",
      "start": 36.0,
      "end": 39.0,
      "text": "能马上知道自己的搭讪是否奏效"
    },
    {
      "sid": "S00021",
      "start": 39.0,
      "end": 41.0,
      "text": "能够帮助兄弟们节约很多精力"
    },
    {
      "sid": "S00022",
      "start": 41.0,
      "end": 45.0,
      "text": "从而避免在那些对你不感兴趣的女人上面浪费太多时间"
    },
    {
      "sid": "S00023",
      "start": 45.0,
      "end": 48.0,
      "text": "同时可以弄清楚自己的搭讪所存在的问题"
    },
    {
      "sid": "S00024",
      "start": 48.0,
      "end": 50.0,
      "text": "OK 那我们下面进入正题"
    },
    {
      "sid": "S00025",
      "start": 50.0,
      "end": 55.62,
      "text": "首先我们先来了解一下什么是有效搭讪与无效搭讪"
    },
    {
      "sid": "S00026",
      "start": 55.62,
      "end": 58.62,
      "text": "有效搭讪就是女人给你注意力的同时"
    },
    {
      "sid": "S00027",
      "start": 58.62,
      "end": 60.62,
      "text": "她对你有一个积极正面的印象"
    },
    {
      "sid": "S00028",
      "start": 60.62,
      "end": 61.62,
      "text": "女人愿意和你第二次见面"
    },
    {
      "sid": "S00029",
      "start": 61.62,
      "end": 64.62,
      "text": "相反 无效搭讪就是女人压根没有给你任何注意力"
    },
    {
      "sid": "S00030",
      "start": 64.62,
      "end": 67.62,
      "text": "女人对你的印象仅仅是一个陌生人或者是销售"
    },
    {
      "sid": "S00031",
      "start": 67.62,
      "end": 70.62,
      "text": "甚至她还觉得你是一个屌丝的负面印象"
    },
    {
      "sid": "S00032",
      "start": 70.62,
      "end": 72.62,
      "text": "你没有任何再见到女人的机会"
    },
    {
      "sid": "S00033",
      "start": 72.62,
      "end": 74.62,
      "text": "但是遗憾的是国内很多人一提到搭讪"
    },
    {
      "sid": "S00034",
      "start": 74.62,
      "end": 76.62,
      "text": "对她的定义也仅仅是加个微信"
    },
    {
      "sid": "S00035",
      "start": 76.62,
      "end": 79.62,
      "text": "而她们不知道这这样家道的微信没有任何的原因"
    },
    {
      "sid": "S00036",
      "start": 79.62,
      "end": 81.62,
      "text": "因为女人对你一无所知"
    },
    {
      "sid": "S00037",
      "start": 81.62,
      "end": 83.62,
      "text": "你在她眼里只是一个要微信的人"
    },
    {
      "sid": "S00038",
      "start": 83.62,
      "end": 84.62,
      "text": "甚至还会被当成微伤"
    },
    {
      "sid": "S00039",
      "start": 84.62,
      "end": 86.62,
      "text": "这样的搭讪注定属于无效搭讪"
    },
    {
      "sid": "S00040",
      "start": 86.62,
      "end": 88.62,
      "text": "当女人在微信上根本不鸟它时"
    },
    {
      "sid": "S00041",
      "start": 88.62,
      "end": 90.62,
      "text": "她甚至还会自我怀疑"
    },
    {
      "sid": "S00042",
      "start": 90.62,
      "end": 92.62,
      "text": "是不是我太丑了 我不够帅"
    },
    {
      "sid": "S00043",
      "start": 92.62,
      "end": 93.62,
      "text": "或者是我朋友圈的展示面"
    },
    {
      "sid": "S00044",
      "start": 93.62,
      "end": 95.62,
      "text": "我的朋友圈的装逼罩不够好"
    },
    {
      "sid": "S00045",
      "start": 95.62,
      "end": 96.62,
      "text": "她觉得搭讪仅仅仅是加个微信"
    },
    {
      "sid": "S00046",
      "start": 96.62,
      "end": 98.62,
      "text": "然后让女生看自己的朋友圈里的装逼罩"
    },
    {
      "sid": "S00047",
      "start": 98.62,
      "end": 100.62,
      "text": "那么你这样的搭讪我想告诉你就是"
    },
    {
      "sid": "S00048",
      "start": 100.62,
      "end": 102.62,
      "text": "无论你出手多少次"
    },
    {
      "sid": "S00049",
      "start": 102.62,
      "end": 103.62,
      "text": "哪怕出手一万次"
    },
    {
      "sid": "S00050",
      "start": 103.62,
      "end": 105.62,
      "text": "你依然得不到任何提升"
    },
    {
      "sid": "S00051",
      "start": 105.62,
      "end": 107.62,
      "text": "因为你仅仅停留在敢出手而已"
    },
    {
      "sid": "S00052",
      "start": 107.62,
      "end": 108.62,
      "text": "如果game其他的能力"
    },
    {
      "sid": "S00053",
      "start": 108.62,
      "end": 110.62,
      "text": "你得不到任何锻炼上钩共振"
    },
    {
      "sid": "S00054",
      "start": 110.62,
      "end": 112.62,
      "text": "其实你都没有得到锻炼的话"
    },
    {
      "sid": "S00055",
      "start": 112.62,
      "end": 115.62,
      "text": "那么你的搭讪水平永远就停留在入门的水平"
    },
    {
      "sid": "S00056",
      "start": 115.62,
      "end": 117.62,
      "text": "那么在和女人搭讪过程中"
    },
    {
      "sid": "S00057",
      "start": 117.62,
      "end": 120.62,
      "text": "哪些信号是告诉你这场搭讪是属于有效搭讪的"
    },
    {
      "sid": "S00058",
      "start": 120.62,
      "end": 122.62,
      "text": "信号1 女人停下来跟你讲话"
    },
    {
      "sid": "S00059",
      "start": 122.62,
      "end": 124.62,
      "text": "只有女人停下来跟你讲话"
    },
    {
      "sid": "S00060",
      "start": 124.62,
      "end": 125.62,
      "text": "才代表注意力是给到你"
    },
    {
      "sid": "S00061",
      "start": 125.62,
      "end": 127.62,
      "text": "她才能够体验到你这个人"
    },
    {
      "sid": "S00062",
      "start": 127.62,
      "end": 129.62,
      "text": "你是第一次穿高竿鞋吗"
    },
    {
      "sid": "S00063",
      "start": 129.62,
      "end": 130.62,
      "text": "没有"
    },
    {
      "sid": "S00064",
      "start": 130.62,
      "end": 131.62,
      "text": "等一下"
    },
    {
      "sid": "S00065",
      "start": 131.62,
      "end": 133.62,
      "text": "就是我想认识你"
    },
    {
      "sid": "S00066",
      "start": 133.62,
      "end": 135.62,
      "text": "我想过来认识你"
    },
    {
      "sid": "S00067",
      "start": 135.62,
      "end": 137.62,
      "text": "可以啊"
    },
    {
      "sid": "S00068",
      "start": 137.62,
      "end": 139.62,
      "text": "你眼睛好有神"
    },
    {
      "sid": "S00069",
      "start": 139.62,
      "end": 140.62,
      "text": "我带了美童的"
    },
    {
      "sid": "S00070",
      "start": 140.62,
      "end": 141.62,
      "text": "真的吗"
    },
    {
      "sid": "S00071",
      "start": 141.62,
      "end": 143.62,
      "text": "每个行走的人他都有自己的事情和目的"
    },
    {
      "sid": "S00072",
      "start": 143.62,
      "end": 145.62,
      "text": "有效搭讪的第一个信号就是女人被你截停"
    },
    {
      "sid": "S00073",
      "start": 145.62,
      "end": 147.62,
      "text": "这代表他暂时对你产生了好奇"
    },
    {
      "sid": "S00074",
      "start": 147.62,
      "end": 149.62,
      "text": "他想知道你是谁 你想干什么"
    },
    {
      "sid": "S00075",
      "start": 149.62,
      "end": 151.62,
      "text": "我觉得被你搭讪还挺好玩的"
    },
    {
      "sid": "S00076",
      "start": 151.62,
      "end": 153.62,
      "text": "如果你搭讪一直跟着女人走"
    },
    {
      "sid": "S00077",
      "start": 153.62,
      "end": 155.62,
      "text": "女人不停下来跟你讲话"
    },
    {
      "sid": "S00078",
      "start": 155.62,
      "end": 156.62,
      "text": "那基本宣告这是一次无效搭讪"
    },
    {
      "sid": "S00079",
      "start": 156.62,
      "end": 158.62,
      "text": "因为这意味着你像一个舔狗"
    },
    {
      "sid": "S00080",
      "start": 158.62,
      "end": 159.62,
      "text": "或者是跟踪狂一样"
    },
    {
      "sid": "S00081",
      "start": 159.62,
      "end": 160.62,
      "text": "跟着女生去她想要去的地方"
    },
    {
      "sid": "S00082",
      "start": 160.62,
      "end": 162.62,
      "text": "你在女人的眼里没有任何价值"
    },
    {
      "sid": "S00083",
      "start": 162.62,
      "end": 164.62,
      "text": "女人只会觉得你是一个很猥琐的屌丝"
    },
    {
      "sid": "S00084",
      "start": 164.62,
      "end": 166.62,
      "text": "她也许会主动给你微信"
    },
    {
      "sid": "S00085",
      "start": 166.62,
      "end": 167.62,
      "text": "防止你继续跟着她"
    },
    {
      "sid": "S00086",
      "start": 167.62,
      "end": 170.62,
      "text": "但是她只是为了让你不要跟着她而已"
    },
    {
      "sid": "S00087",
      "start": 170.62,
      "end": 171.62,
      "text": "然后她回到家之后就把你删了"
    },
    {
      "sid": "S00088",
      "start": 171.62,
      "end": 172.62,
      "text": "或者是直接就不理你"
    },
    {
      "sid": "S00089",
      "start": 172.62,
      "end": 174.62,
      "text": "还有一直跟着女人走的这种行为"
    },
    {
      "sid": "S00090",
      "start": 174.62,
      "end": 176.62,
      "text": "还可能对搭讪者带来麻烦"
    },
    {
      "sid": "S00091",
      "start": 176.62,
      "end": 178.62,
      "text": "因为女人会觉得你骚扰她"
    },
    {
      "sid": "S00092",
      "start": 178.62,
      "end": 179.62,
      "text": "你是跟踪狂"
    },
    {
      "sid": "S00093",
      "start": 179.62,
      "end": 181.62,
      "text": "你可能会因此受到很多负面反馈"
    },
    {
      "sid": "S00094",
      "start": 181.62,
      "end": 183.62,
      "text": "让你的搭讪更加没有动力"
    },
    {
      "sid": "S00095",
      "start": 183.62,
      "end": 185.62,
      "text": "所以搭讪切记不要一直跟着女人走"
    },
    {
      "sid": "S00096",
      "start": 185.62,
      "end": 186.62,
      "text": "女人不愿意停下来"
    },
    {
      "sid": "S00097",
      "start": 186.62,
      "end": 187.62,
      "text": "你就让她离开"
    },
    {
      "sid": "S00098",
      "start": 187.62,
      "end": 189.62,
      "text": "这代表着你在开场的时候没有做好"
    },
    {
      "sid": "S00099",
      "start": 189.62,
      "end": 192.62,
      "text": "我今天是第几个搭讪女子"
    },
    {
      "sid": "S00100",
      "start": 192.62,
      "end": 195.62,
      "text": "第三个"
    },
    {
      "sid": "S00101",
      "start": 195.62,
      "end": 197.62,
      "text": "哎"
    },
    {
      "sid": "S00102",
      "start": 197.62,
      "end": 198.62,
      "text": "前面的人你都加了吗"
    },
    {
      "sid": "S00103",
      "start": 198.62,
      "end": 200.62,
      "text": "没加我就是跑了"
    },
    {
      "sid": "S00104",
      "start": 200.62,
      "end": 201.62,
      "text": "真的吗"
    },
    {
      "sid": "S00105",
      "start": 201.62,
      "end": 202.62,
      "text": "因为你把我叫做"
    },
    {
      "sid": "S00106",
      "start": 202.62,
      "end": 203.62,
      "text": "我还以为前面是推销的"
    },
    {
      "sid": "S00107",
      "start": 203.62,
      "end": 204.62,
      "text": "后面在后面喊了我"
    },
    {
      "sid": "S00108",
      "start": 204.62,
      "end": 205.62,
      "text": "我就马上跑了"
    },
    {
      "sid": "S00109",
      "start": 205.62,
      "end": 207.62,
      "text": "我姐姐在给我打个话"
    },
    {
      "sid": "S00110",
      "start": 207.62,
      "end": 209.62,
      "text": "再有人加你就把它给全都删掉"
    },
    {
      "sid": "S00111",
      "start": 209.62,
      "end": 211.62,
      "text": "拜拜"
    },
    {
      "sid": "S00112",
      "start": 213.62,
      "end": 214.62,
      "text": "信号二"
    },
    {
      "sid": "S00113",
      "start": 214.62,
      "end": 215.62,
      "text": "女人和你对视"
    },
    {
      "sid": "S00114",
      "start": 215.62,
      "end": 216.62,
      "text": "眼睛是心灵的窗户"
    },
    {
      "sid": "S00115",
      "start": 216.62,
      "end": 218.62,
      "text": "眼神交流能传递很多信息"
    },
    {
      "sid": "S00116",
      "start": 218.62,
      "end": 220.62,
      "text": "也是女人被你勾住的一个重要信号"
    },
    {
      "sid": "S00117",
      "start": 220.62,
      "end": 222.62,
      "text": "她此时此刻对你产生一定兴趣"
    },
    {
      "sid": "S00118",
      "start": 222.62,
      "end": 225.62,
      "text": "她才可能跟你持续的眼神对视"
    },
    {
      "sid": "S00119",
      "start": 225.62,
      "end": 227.62,
      "text": "同时女人能从你的眼神里看出"
    },
    {
      "sid": "S00120",
      "start": 227.62,
      "end": 229.62,
      "text": "你是自信的还是害怕的"
    },
    {
      "sid": "S00121",
      "start": 229.62,
      "end": 232.62,
      "text": "女人能从你的眼睛里感受到你此时此刻的状态"
    },
    {
      "sid": "S00122",
      "start": 232.62,
      "end": 234.62,
      "text": "哪怕你他妈的搭讪被拒绝了十次"
    },
    {
      "sid": "S00123",
      "start": 234.62,
      "end": 236.62,
      "text": "女人都能从你的眼睛里看出来"
    },
    {
      "sid": "S00124",
      "start": 236.62,
      "end": 237.62,
      "text": "所以说一个不自信的人"
    },
    {
      "sid": "S00125",
      "start": 237.62,
      "end": 238.62,
      "text": "她想假装自信"
    },
    {
      "sid": "S00126",
      "start": 238.62,
      "end": 240.62,
      "text": "是很容易被女人看穿的"
    },
    {
      "sid": "S00127",
      "start": 240.62,
      "end": 243.62,
      "text": "同时你还可以用你的眼神去传递你的意图"
    },
    {
      "sid": "S00128",
      "start": 243.62,
      "end": 244.62,
      "text": "你的男女框架"
    },
    {
      "sid": "S00129",
      "start": 244.62,
      "end": 246.62,
      "text": "眼神交流是社交的基础"
    },
    {
      "sid": "S00130",
      "start": 246.62,
      "end": 248.62,
      "text": "如果一个女人不和你保持眼神接触"
    },
    {
      "sid": "S00131",
      "start": 248.62,
      "end": 250.62,
      "text": "或者是不看你的眼睛"
    },
    {
      "sid": "S00132",
      "start": 250.62,
      "end": 252.62,
      "text": "那么你的此时搭讪注定是无效搭讪"
    },
    {
      "sid": "S00133",
      "start": 252.62,
      "end": 254.62,
      "text": "你也真好看"
    },
    {
      "sid": "S00134",
      "start": 254.62,
      "end": 255.62,
      "text": "谢谢"
    },
    {
      "sid": "S00135",
      "start": 255.62,
      "end": 258.62,
      "text": "我一直看的话会不会有点尴尬"
    },
    {
      "sid": "S00136",
      "start": 258.62,
      "end": 259.62,
      "text": "有点吧"
    },
    {
      "sid": "S00137",
      "start": 259.62,
      "end": 260.62,
      "text": "有点"
    },
    {
      "sid": "S00138",
      "start": 260.62,
      "end": 263.62,
      "text": "我想有机会的话可以约你穿吗"
    },
    {
      "sid": "S00139",
      "start": 263.62,
      "end": 264.62,
      "text": "可以"
    },
    {
      "sid": "S00140",
      "start": 264.62,
      "end": 265.62,
      "text": "好"
    },
    {
      "sid": "S00141",
      "start": 265.62,
      "end": 266.62,
      "text": "那我留你微信"
    },
    {
      "sid": "S00142",
      "start": 266.62,
      "end": 267.62,
      "text": "信号三"
    },
    {
      "sid": "S00143",
      "start": 267.62,
      "end": 272.26,
      "text": "开场结束后女人愿意持续和你交流"
    },
    {
      "sid": "S00144",
      "start": 272.26,
      "end": 274.26,
      "text": "顾名思义就是你在开场结束之后"
    },
    {
      "sid": "S00145",
      "start": 274.26,
      "end": 276.26,
      "text": "女人依然愿意和你就是进行对话"
    },
    {
      "sid": "S00146",
      "start": 276.26,
      "end": 277.26,
      "text": "她没有直接走开"
    },
    {
      "sid": "S00147",
      "start": 277.26,
      "end": 281.26,
      "text": "那么此刻女人就是在给她自己一个让她来了解你的机会"
    },
    {
      "sid": "S00148",
      "start": 281.26,
      "end": 284.26,
      "text": "你有机会自我介绍来说明自己的意图"
    },
    {
      "sid": "S00149",
      "start": 284.26,
      "end": 286.26,
      "text": "你有机会来表达自己不是个怪人"
    },
    {
      "sid": "S00150",
      "start": 286.26,
      "end": 287.26,
      "text": "而是一个正常人"
    },
    {
      "sid": "S00151",
      "start": 287.26,
      "end": 289.26,
      "text": "你有机会去展示自己的性格样本"
    },
    {
      "sid": "S00152",
      "start": 289.26,
      "end": 291.26,
      "text": "让她知道你是一个很有趣的人"
    },
    {
      "sid": "S00153",
      "start": 291.26,
      "end": 292.26,
      "text": "让她上钩"
    },
    {
      "sid": "S00154",
      "start": 292.26,
      "end": 298.26,
      "text": "女人愿意和你交流代表着她此时此刻或多或少是对你有一定兴趣的"
    },
    {
      "sid": "S00155",
      "start": 298.26,
      "end": 299.26,
      "text": "因为时间是很宝贵的"
    },
    {
      "sid": "S00156",
      "start": 299.26,
      "end": 303.26,
      "text": "没有人会在大街上给一个乞丐留很长时间"
    },
    {
      "sid": "S00157",
      "start": 303.26,
      "end": 304.26,
      "text": "因为每个人都很忙"
    },
    {
      "sid": "S00158",
      "start": 304.26,
      "end": 306.26,
      "text": "他们不会把时间浪费在没有意义的事情上面"
    },
    {
      "sid": "S00159",
      "start": 306.26,
      "end": 307.26,
      "text": "女人和你交流的越久"
    },
    {
      "sid": "S00160",
      "start": 307.26,
      "end": 309.26,
      "text": "她对你的了解也就越多"
    },
    {
      "sid": "S00161",
      "start": 309.26,
      "end": 311.26,
      "text": "你对她留下的印象也就越深"
    },
    {
      "sid": "S00162",
      "start": 311.26,
      "end": 313.26,
      "text": "你就越有可能吸引到她"
    },
    {
      "sid": "S00163",
      "start": 313.26,
      "end": 316.26,
      "text": "然后我看到你戴眼镜就像是老师"
    },
    {
      "sid": "S00164",
      "start": 316.26,
      "end": 318.26,
      "text": "你是做什么职业的"
    },
    {
      "sid": "S00165",
      "start": 318.26,
      "end": 320.26,
      "text": "有啊"
    },
    {
      "sid": "S00166",
      "start": 320.26,
      "end": 322.26,
      "text": "就是我过来搭讪你的"
    },
    {
      "sid": "S00167",
      "start": 322.26,
      "end": 324.26,
      "text": "我叫mike"
    },
    {
      "sid": "S00168",
      "start": 324.26,
      "end": 326.26,
      "text": "你好"
    },
    {
      "sid": "S00169",
      "start": 326.26,
      "end": 327.26,
      "text": "你好"
    },
    {
      "sid": "S00170",
      "start": 327.26,
      "end": 328.26,
      "text": "哇你真的很像老师"
    },
    {
      "sid": "S00171",
      "start": 328.26,
      "end": 331.26,
      "text": "他现在是采科罗"
    },
    {
      "sid": "S00172",
      "start": 331.26,
      "end": 332.26,
      "text": "采科罗"
    },
    {
      "sid": "S00173",
      "start": 332.26,
      "end": 333.26,
      "text": "这样子"
    },
    {
      "sid": "S00174",
      "start": 333.26,
      "end": 334.26,
      "text": "信号4"
    },
    {
      "sid": "S00175",
      "start": 334.26,
      "end": 337.26,
      "text": "女人不排斥和你进入男女框架"
    },
    {
      "sid": "S00176",
      "start": 337.26,
      "end": 339.26,
      "text": "这个很重要"
    },
    {
      "sid": "S00177",
      "start": 339.26,
      "end": 340.26,
      "text": "兄弟们要知道"
    },
    {
      "sid": "S00178",
      "start": 340.26,
      "end": 342.26,
      "text": "如果你和一个女人搭讪的时候"
    },
    {
      "sid": "S00179",
      "start": 342.26,
      "end": 343.26,
      "text": "你们的互动特别平淡"
    },
    {
      "sid": "S00180",
      "start": 343.26,
      "end": 344.26,
      "text": "只是礼貌性的互动"
    },
    {
      "sid": "S00181",
      "start": 344.26,
      "end": 346.26,
      "text": "甚至女生想和你做朋友"
    },
    {
      "sid": "S00182",
      "start": 346.26,
      "end": 348.26,
      "text": "她想把你拉进她的朋友框架里"
    },
    {
      "sid": "S00183",
      "start": 348.26,
      "end": 350.26,
      "text": "她想让你做成她的男给秘"
    },
    {
      "sid": "S00184",
      "start": 350.26,
      "end": 352.26,
      "text": "你没有展现出你身为一个男人"
    },
    {
      "sid": "S00185",
      "start": 352.26,
      "end": 355.26,
      "text": "对一个女人的那种原始的侵略性"
    },
    {
      "sid": "S00186",
      "start": 355.26,
      "end": 358.26,
      "text": "那么此时此刻你的搭讪注定是失败的"
    },
    {
      "sid": "S00187",
      "start": 358.26,
      "end": 360.26,
      "text": "你应该有意识的去传递男女框架"
    },
    {
      "sid": "S00188",
      "start": 360.26,
      "end": 361.26,
      "text": "你对她的信意图"
    },
    {
      "sid": "S00189",
      "start": 361.26,
      "end": 363.26,
      "text": "当然我这里的信意图不是嘴上说"
    },
    {
      "sid": "S00190",
      "start": 363.26,
      "end": 367.26,
      "text": "我想操你或者是其他的那种骚扰的话"
    },
    {
      "sid": "S00191",
      "start": 367.26,
      "end": 369.26,
      "text": "我这里说的信意图它更多的是一种钱沟通"
    },
    {
      "sid": "S00192",
      "start": 369.26,
      "end": 371.26,
      "text": "就是那种你身为一个男人"
    },
    {
      "sid": "S00193",
      "start": 371.26,
      "end": 373.26,
      "text": "你对这个女人的那种暧昧的那种氛围"
    },
    {
      "sid": "S00194",
      "start": 373.26,
      "end": 374.26,
      "text": "是我以为你会拒绝我"
    },
    {
      "sid": "S00195",
      "start": 374.26,
      "end": 375.26,
      "text": "你走的太快了"
    },
    {
      "sid": "S00196",
      "start": 375.26,
      "end": 376.26,
      "text": "给我的感觉很高冷"
    },
    {
      "sid": "S00197",
      "start": 376.26,
      "end": 378.26,
      "text": "因为我真的赶时间"
    },
    {
      "sid": "S00198",
      "start": 378.26,
      "end": 380.26,
      "text": "但我觉得你不是一个高冷的人"
    },
    {
      "sid": "S00199",
      "start": 380.26,
      "end": 382.26,
      "text": "那我就先走了"
    },
    {
      "sid": "S00200",
      "start": 382.26,
      "end": 383.26,
      "text": "可以"
    },
    {
      "sid": "S00201",
      "start": 383.26,
      "end": 384.26,
      "text": "拜拜"
    },
    {
      "sid": "S00202",
      "start": 384.26,
      "end": 386.26,
      "text": "如果她愿意接受你的男女框架"
    },
    {
      "sid": "S00203",
      "start": 386.26,
      "end": 388.26,
      "text": "那么你的搭讪一定是有效的"
    },
    {
      "sid": "S00204",
      "start": 388.26,
      "end": 389.26,
      "text": "如果她不接受"
    },
    {
      "sid": "S00205",
      "start": 389.26,
      "end": 391.26,
      "text": "那么你就可以不收她的号码"
    },
    {
      "sid": "S00206",
      "start": 391.26,
      "end": 393.26,
      "text": "因为这种号码注定是废号"
    },
    {
      "sid": "S00207",
      "start": 393.26,
      "end": 394.26,
      "text": "你去搭讪她"
    },
    {
      "sid": "S00208",
      "start": 394.26,
      "end": 395.26,
      "text": "她连男女框架都不愿意跟你进入"
    },
    {
      "sid": "S00209",
      "start": 395.26,
      "end": 397.26,
      "text": "那这种号你即便收到你的微信"
    },
    {
      "sid": "S00210",
      "start": 397.26,
      "end": 398.26,
      "text": "她也不会理你"
    },
    {
      "sid": "S00211",
      "start": 398.26,
      "end": 399.26,
      "text": "所以说这样子"
    },
    {
      "sid": "S00212",
      "start": 399.26,
      "end": 401.26,
      "text": "当你有当你学会建立男女框架的时候"
    },
    {
      "sid": "S00213",
      "start": 401.26,
      "end": 404.26,
      "text": "同时也是给你的搭讪增加了一种筛选"
    },
    {
      "sid": "S00214",
      "start": 404.26,
      "end": 406.26,
      "text": "它为你成功节省了很多时间"
    },
    {
      "sid": "S00215",
      "start": 406.26,
      "end": 408.26,
      "text": "OK以上就是我要给你们分享的"
    },
    {
      "sid": "S00216",
      "start": 408.26,
      "end": 411.26,
      "text": "关于有效搭讪信号的全部干货"
    },
    {
      "sid": "S00217",
      "start": 411.26,
      "end": 412.26,
      "text": "那么看我们视频的兄弟们"
    },
    {
      "sid": "S00218",
      "start": 412.26,
      "end": 414.26,
      "text": "如果想要学习更多的内容"
    },
    {
      "sid": "S00219",
      "start": 414.26,
      "end": 416.26,
      "text": "可以加我们团队的工作微信"
    },
    {
      "sid": "S00220",
      "start": 416.26,
      "end": 417.26,
      "text": "搭讪00010"
    },
    {
      "sid": "S00221",
      "start": 417.26,
      "end": 418.26,
      "text": "联系我本人"
    },
    {
      "sid": "S00222",
      "start": 418.26,
      "end": 419.26,
      "text": "我是搭讪玩家Mikey"
    },
    {
      "sid": "S00223",
      "start": 419.26,
      "end": 420.26,
      "text": "我们下一期再见"
    }
  ]
}
