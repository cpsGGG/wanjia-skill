{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-021",
  "youtube_id": "UQzx50-eHZE",
  "media_sha256": "b1eb6ce0fed78805a512874c6f2eabdfcfa55239b8163227498244ba8fb117a1",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 0.96,
      "text": "Hello 生日们 我是Mikey"
    },
    {
      "sid": "S00002",
      "start": 0.96,
      "end": 2.28,
      "text": "在上一期视频里呢"
    },
    {
      "sid": "S00003",
      "start": 2.28,
      "end": 3.9,
      "text": "我从多个维度讲了"
    },
    {
      "sid": "S00004",
      "start": 3.9,
      "end": 6.3,
      "text": "这个社会是如何鼓励你不自信的"
    },
    {
      "sid": "S00005",
      "start": 6.3,
      "end": 7.22,
      "text": "那么这一期呢"
    },
    {
      "sid": "S00006",
      "start": 7.22,
      "end": 8.34,
      "text": "我就来告诉你啊"
    },
    {
      "sid": "S00007",
      "start": 8.34,
      "end": 9.24,
      "text": "作为一个男人"
    },
    {
      "sid": "S00008",
      "start": 9.24,
      "end": 11.58,
      "text": "你该如何拿回属于你的自信"
    },
    {
      "sid": "S00009",
      "start": 11.58,
      "end": 14.34,
      "text": "并且不再被这个世俗社会打回冤行"
    },
    {
      "sid": "S00010",
      "start": 14.34,
      "end": 16.24,
      "text": "那么上一期视频发出之后呢"
    },
    {
      "sid": "S00011",
      "start": 16.24,
      "end": 17.56,
      "text": "我收了好多私信"
    },
    {
      "sid": "S00012",
      "start": 17.56,
      "end": 18.5,
      "text": "很多兄弟问我"
    },
    {
      "sid": "S00013",
      "start": 18.5,
      "end": 20.62,
      "text": "Mikey 我该怎么样才能变成自信"
    },
    {
      "sid": "S00014",
      "start": 20.62,
      "end": 22.78,
      "text": "我是先赚到人生中的第一个一百万"
    },
    {
      "sid": "S00015",
      "start": 22.78,
      "end": 25.44,
      "text": "还是练出我能撑爆T恤的胸肌"
    },
    {
      "sid": "S00016",
      "start": 25.44,
      "end": 27.68,
      "text": "亦或是我得到更多异性的喜欢"
    },
    {
      "sid": "S00017",
      "start": 27.68,
      "end": 29.66,
      "text": "那么我实话告诉你啊"
    },
    {
      "sid": "S00018",
      "start": 29.66,
      "end": 32.14,
      "text": "如果你抱着这些目的去追求自信"
    },
    {
      "sid": "S00019",
      "start": 32.14,
      "end": 34.2,
      "text": "那么你这辈子注定只有一个结果"
    },
    {
      "sid": "S00020",
      "start": 34.2,
      "end": 36.8,
      "text": "那就是在这种伪装出来的强大底下"
    },
    {
      "sid": "S00021",
      "start": 36.8,
      "end": 38.86,
      "text": "滋生出更深的自卑"
    },
    {
      "sid": "S00022",
      "start": 38.86,
      "end": 39.88,
      "text": "而今天呢"
    },
    {
      "sid": "S00023",
      "start": 39.88,
      "end": 41.42,
      "text": "我就跟兄弟们好好聊一聊"
    },
    {
      "sid": "S00024",
      "start": 41.42,
      "end": 44.84,
      "text": "我们该怎么样获得真正的自信"
    },
    {
      "sid": "S00025",
      "start": 44.84,
      "end": 48.26,
      "text": "我做情感行业这么多年"
    },
    {
      "sid": "S00026",
      "start": 48.26,
      "end": 50.46,
      "text": "我听过无数人对自信的理解"
    },
    {
      "sid": "S00027",
      "start": 50.46,
      "end": 53.1,
      "text": "听过无数导师他们对于自信的理解"
    },
    {
      "sid": "S00028",
      "start": 53.1,
      "end": 54.1,
      "text": "那么说到底呢"
    },
    {
      "sid": "S00029",
      "start": 54.1,
      "end": 54.86,
      "text": "也就是两种"
    },
    {
      "sid": "S00030",
      "start": 54.86,
      "end": 56.0,
      "text": "首先第一种呢"
    },
    {
      "sid": "S00031",
      "start": 56.0,
      "end": 56.86,
      "text": "我认为啊"
    },
    {
      "sid": "S00032",
      "start": 56.86,
      "end": 57.64,
      "text": "是最廉价"
    },
    {
      "sid": "S00033",
      "start": 57.64,
      "end": 58.4,
      "text": "最浅薄"
    },
    {
      "sid": "S00034",
      "start": 58.4,
      "end": 59.28,
      "text": "最low的自信"
    },
    {
      "sid": "S00035",
      "start": 59.28,
      "end": 60.48,
      "text": "那么这种自信呢"
    },
    {
      "sid": "S00036",
      "start": 60.48,
      "end": 62.24,
      "text": "是全靠外物"
    },
    {
      "sid": "S00037",
      "start": 62.24,
      "end": 63.1,
      "text": "攀比啊"
    },
    {
      "sid": "S00038",
      "start": 63.1,
      "end": 63.64,
      "text": "得来的"
    },
    {
      "sid": "S00039",
      "start": 63.64,
      "end": 65.54,
      "text": "就好比你开这辆保时机911"
    },
    {
      "sid": "S00040",
      "start": 65.54,
      "end": 67.06,
      "text": "那么提车那一天呢"
    },
    {
      "sid": "S00041",
      "start": 67.06,
      "end": 69.74,
      "text": "你觉得全世界所有人都非常青睐你"
    },
    {
      "sid": "S00042",
      "start": 69.74,
      "end": 70.66,
      "text": "等个红绿灯呢"
    },
    {
      "sid": "S00043",
      "start": 70.66,
      "end": 72.62,
      "text": "你都会觉得路人是不是在仰视你"
    },
    {
      "sid": "S00044",
      "start": 72.62,
      "end": 73.36,
      "text": "就连撩妹"
    },
    {
      "sid": "S00045",
      "start": 73.36,
      "end": 75.1,
      "text": "你都会瞬间觉得顺手了不少"
    },
    {
      "sid": "S00046",
      "start": 75.1,
      "end": 76.14,
      "text": "那么我承认啊"
    },
    {
      "sid": "S00047",
      "start": 76.14,
      "end": 77.62,
      "text": "这种自信的感觉呢"
    },
    {
      "sid": "S00048",
      "start": 77.62,
      "end": 78.56,
      "text": "它是真实的"
    },
    {
      "sid": "S00049",
      "start": 78.56,
      "end": 79.82,
      "text": "但是它能维持多久呢"
    },
    {
      "sid": "S00050",
      "start": 79.82,
      "end": 81.64,
      "text": "最多持续到在高架上"
    },
    {
      "sid": "S00051",
      "start": 81.64,
      "end": 83.62,
      "text": "你被一个法拉利轰着油门"
    },
    {
      "sid": "S00052",
      "start": 83.62,
      "end": 84.86,
      "text": "抄过去的那一刻"
    },
    {
      "sid": "S00053",
      "start": 84.86,
      "end": 86.02,
      "text": "那么你会瞬间自卑"
    },
    {
      "sid": "S00054",
      "start": 86.02,
      "end": 88.58,
      "text": "你会觉得所有人的目光都从你身上挪走了"
    },
    {
      "sid": "S00055",
      "start": 88.58,
      "end": 89.46,
      "text": "你的自信呢"
    },
    {
      "sid": "S00056",
      "start": 89.46,
      "end": 90.34,
      "text": "就像泡沫一样"
    },
    {
      "sid": "S00057",
      "start": 90.34,
      "end": 91.42,
      "text": "当场碎掉"
    },
    {
      "sid": "S00058",
      "start": 91.42,
      "end": 94.24,
      "text": "你突然会觉得保时机911好像没有那么香了"
    },
    {
      "sid": "S00059",
      "start": 94.24,
      "end": 95.24,
      "text": "你开始焦虑"
    },
    {
      "sid": "S00060",
      "start": 95.24,
      "end": 95.94,
      "text": "开始犹豫"
    },
    {
      "sid": "S00061",
      "start": 95.94,
      "end": 97.66,
      "text": "是不是只有换一台法拉利"
    },
    {
      "sid": "S00062",
      "start": 97.66,
      "end": 98.72,
      "text": "我才能找回自信"
    },
    {
      "sid": "S00063",
      "start": 98.72,
      "end": 100.38,
      "text": "而你拼命赚钱"
    },
    {
      "sid": "S00064",
      "start": 100.38,
      "end": 101.96,
      "text": "换车的这段日子里呢"
    },
    {
      "sid": "S00065",
      "start": 101.96,
      "end": 103.74,
      "text": "你又会陷入长期的自卑"
    },
    {
      "sid": "S00066",
      "start": 103.74,
      "end": 104.32,
      "text": "发现了吗"
    },
    {
      "sid": "S00067",
      "start": 104.32,
      "end": 105.22,
      "text": "这种自信"
    },
    {
      "sid": "S00068",
      "start": 105.22,
      "end": 107.04,
      "text": "本质上它是一种排位赛"
    },
    {
      "sid": "S00069",
      "start": 107.04,
      "end": 109.48,
      "text": "如果你是靠跟别人比有钱"
    },
    {
      "sid": "S00070",
      "start": 109.48,
      "end": 110.64,
      "text": "车更好"
    },
    {
      "sid": "S00071",
      "start": 110.64,
      "end": 112.7,
      "text": "女朋友更漂亮来证明自己"
    },
    {
      "sid": "S00072",
      "start": 112.7,
      "end": 114.92,
      "text": "那你永远不可能获得真正的自信"
    },
    {
      "sid": "S00073",
      "start": 114.92,
      "end": 116.16,
      "text": "因为人外有人"
    },
    {
      "sid": "S00074",
      "start": 116.16,
      "end": 117.08,
      "text": "天外有天"
    },
    {
      "sid": "S00075",
      "start": 117.08,
      "end": 118.8,
      "text": "只要有比你强的人出现"
    },
    {
      "sid": "S00076",
      "start": 118.8,
      "end": 120.16,
      "text": "你就会永远抬不起头"
    },
    {
      "sid": "S00077",
      "start": 120.16,
      "end": 121.04,
      "text": "这也是很多人"
    },
    {
      "sid": "S00078",
      "start": 121.04,
      "end": 122.28,
      "text": "为什么学了game之后"
    },
    {
      "sid": "S00079",
      "start": 122.28,
      "end": 123.48,
      "text": "睡了这么多女人"
    },
    {
      "sid": "S00080",
      "start": 123.48,
      "end": 125.86,
      "text": "却依旧感到自卑和空虚的原因"
    },
    {
      "sid": "S00081",
      "start": 125.86,
      "end": 126.72,
      "text": "同理呢"
    },
    {
      "sid": "S00082",
      "start": 126.72,
      "end": 128.52,
      "text": "你跟女生说几句俏皮话"
    },
    {
      "sid": "S00083",
      "start": 128.52,
      "end": 129.48,
      "text": "她对你态度好"
    },
    {
      "sid": "S00084",
      "start": 129.48,
      "end": 130.52,
      "text": "连发了几条消息"
    },
    {
      "sid": "S00085",
      "start": 130.52,
      "end": 132.06,
      "text": "你瞬间觉得自己是情圣"
    },
    {
      "sid": "S00086",
      "start": 132.06,
      "end": 134.14,
      "text": "恨不得发到聊机群里面炫耀一波"
    },
    {
      "sid": "S00087",
      "start": 134.14,
      "end": 136.26,
      "text": "可她如果半天不回你消息"
    },
    {
      "sid": "S00088",
      "start": 136.26,
      "end": 137.6,
      "text": "你又开始胡思乱想"
    },
    {
      "sid": "S00089",
      "start": 137.6,
      "end": 138.6,
      "text": "反复琢磨"
    },
    {
      "sid": "S00090",
      "start": 138.6,
      "end": 140.24,
      "text": "是不是自己哪句话说错了"
    },
    {
      "sid": "S00091",
      "start": 140.24,
      "end": 143.78,
      "text": "那么这种靠外界好评撑起来的自信"
    },
    {
      "sid": "S00092",
      "start": 143.78,
      "end": 144.66,
      "text": "说白了"
    },
    {
      "sid": "S00093",
      "start": 144.66,
      "end": 145.4,
      "text": "它就是乞讨"
    },
    {
      "sid": "S00094",
      "start": 145.4,
      "end": 146.72,
      "text": "那么乞讨来的东西呢"
    },
    {
      "sid": "S00095",
      "start": 146.72,
      "end": 147.88,
      "text": "人家可以随时收回"
    },
    {
      "sid": "S00096",
      "start": 147.88,
      "end": 148.6,
      "text": "你的心情"
    },
    {
      "sid": "S00097",
      "start": 148.6,
      "end": 149.18,
      "text": "你的底气"
    },
    {
      "sid": "S00098",
      "start": 149.18,
      "end": 151.6,
      "text": "全跟着别人对你的反应走"
    },
    {
      "sid": "S00099",
      "start": 151.6,
      "end": 152.72,
      "text": "你越在意什么"
    },
    {
      "sid": "S00100",
      "start": 152.72,
      "end": 154.14,
      "text": "什么就越能拿捏你"
    },
    {
      "sid": "S00101",
      "start": 154.14,
      "end": 155.32,
      "text": "甚至操控你的一切"
    },
    {
      "sid": "S00102",
      "start": 155.32,
      "end": 157.36,
      "text": "什么东西就捏住了你的稿纹"
    },
    {
      "sid": "S00103",
      "start": 157.36,
      "end": 158.36,
      "text": "那我们再说第二种"
    },
    {
      "sid": "S00104",
      "start": 158.36,
      "end": 160.2,
      "text": "比第一种更加的进阶"
    },
    {
      "sid": "S00105",
      "start": 160.2,
      "end": 161.34,
      "text": "它看着更高级"
    },
    {
      "sid": "S00106",
      "start": 161.34,
      "end": 163.14,
      "text": "但我觉得它也更威胁"
    },
    {
      "sid": "S00107",
      "start": 163.14,
      "end": 165.5,
      "text": "那就是为了成功而选择自信"
    },
    {
      "sid": "S00108",
      "start": 165.5,
      "end": 167.16,
      "text": "这听着非常的政治正确"
    },
    {
      "sid": "S00109",
      "start": 167.16,
      "end": 168.7,
      "text": "但其实它也是错的"
    },
    {
      "sid": "S00110",
      "start": 168.7,
      "end": 170.56,
      "text": "但是这套信念行动的兄弟呢"
    },
    {
      "sid": "S00111",
      "start": 170.56,
      "end": 172.14,
      "text": "一般来说都很有上进心"
    },
    {
      "sid": "S00112",
      "start": 172.14,
      "end": 173.44,
      "text": "听了很多励志课"
    },
    {
      "sid": "S00113",
      "start": 173.44,
      "end": 175.44,
      "text": "看了很多自我提升教程"
    },
    {
      "sid": "S00114",
      "start": 175.44,
      "end": 176.66,
      "text": "知道自信的男人"
    },
    {
      "sid": "S00115",
      "start": 176.66,
      "end": 177.66,
      "text": "更容易成事"
    },
    {
      "sid": "S00116",
      "start": 177.66,
      "end": 180.5,
      "text": "于是他们开始刻意模仿强者的样子"
    },
    {
      "sid": "S00117",
      "start": 180.5,
      "end": 182.12,
      "text": "像是说话声音变得红亮"
    },
    {
      "sid": "S00118",
      "start": 182.12,
      "end": 183.32,
      "text": "眼神不闪躲"
    },
    {
      "sid": "S00119",
      "start": 183.32,
      "end": 184.5,
      "text": "抬头挺胸"
    },
    {
      "sid": "S00120",
      "start": 184.5,
      "end": 186.66,
      "text": "那么我不是说这些行为不对啊"
    },
    {
      "sid": "S00121",
      "start": 186.66,
      "end": 187.34,
      "text": "相反"
    },
    {
      "sid": "S00122",
      "start": 187.34,
      "end": 188.92,
      "text": "这些做法是正确的"
    },
    {
      "sid": "S00123",
      "start": 188.92,
      "end": 190.22,
      "text": "我也教过这些东西"
    },
    {
      "sid": "S00124",
      "start": 190.22,
      "end": 193.44,
      "text": "但问题出在你的出发点"
    },
    {
      "sid": "S00125",
      "start": 193.44,
      "end": 193.86,
      "text": "记住"
    },
    {
      "sid": "S00126",
      "start": 193.86,
      "end": 196.48,
      "text": "是出发点不是行为本身"
    },
    {
      "sid": "S00127",
      "start": 196.48,
      "end": 197.42,
      "text": "我再说一遍"
    },
    {
      "sid": "S00128",
      "start": 197.42,
      "end": 199.96,
      "text": "是出发点不是行为本身"
    },
    {
      "sid": "S00129",
      "start": 199.96,
      "end": 202.28,
      "text": "如果你是为了做成一件事"
    },
    {
      "sid": "S00130",
      "start": 202.28,
      "end": 203.6,
      "text": "为了追到喜欢的人"
    },
    {
      "sid": "S00131",
      "start": 203.6,
      "end": 204.8,
      "text": "为了拿到资源"
    },
    {
      "sid": "S00132",
      "start": 204.8,
      "end": 207.02,
      "text": "才装作自信的样子"
    },
    {
      "sid": "S00133",
      "start": 207.02,
      "end": 208.1,
      "text": "那么在心理学上"
    },
    {
      "sid": "S00134",
      "start": 208.1,
      "end": 209.54,
      "text": "这个叫表演型人格"
    },
    {
      "sid": "S00135",
      "start": 209.54,
      "end": 212.78,
      "text": "你把自信当成了能撬动利益的杠杆"
    },
    {
      "sid": "S00136",
      "start": 212.78,
      "end": 213.88,
      "text": "那么心里想着"
    },
    {
      "sid": "S00137",
      "start": 213.88,
      "end": 215.64,
      "text": "是我都表现得这么自信了"
    },
    {
      "sid": "S00138",
      "start": 215.64,
      "end": 217.04,
      "text": "总该有好结果了吧"
    },
    {
      "sid": "S00139",
      "start": 217.04,
      "end": 219.5,
      "text": "可是你能保证事实顺心吗"
    },
    {
      "sid": "S00140",
      "start": 219.5,
      "end": 221.32,
      "text": "万一你摆出了十足的自信"
    },
    {
      "sid": "S00141",
      "start": 221.32,
      "end": 222.8,
      "text": "客户还是拒绝了你"
    },
    {
      "sid": "S00142",
      "start": 222.8,
      "end": 224.42,
      "text": "万一你表现得极尽魅力"
    },
    {
      "sid": "S00143",
      "start": 224.42,
      "end": 225.82,
      "text": "女生还是拉黑了你"
    },
    {
      "sid": "S00144",
      "start": 225.82,
      "end": 226.82,
      "text": "那这个时候呢"
    },
    {
      "sid": "S00145",
      "start": 226.82,
      "end": 227.82,
      "text": "你会怎么样呢"
    },
    {
      "sid": "S00146",
      "start": 227.82,
      "end": 229.9,
      "text": "你会瞬间被打回原型"
    },
    {
      "sid": "S00147",
      "start": 229.9,
      "end": 231.82,
      "text": "陷入严重的自我内耗"
    },
    {
      "sid": "S00148",
      "start": 231.82,
      "end": 233.9,
      "text": "你会怀疑是不是自信根本没有用"
    },
    {
      "sid": "S00149",
      "start": 233.9,
      "end": 235.5,
      "text": "还是我装的不够像"
    },
    {
      "sid": "S00150",
      "start": 235.5,
      "end": 237.58,
      "text": "甚至是无时无刻都在想"
    },
    {
      "sid": "S00151",
      "start": 237.58,
      "end": 239.5,
      "text": "我该怎么样才能装的更像一点"
    },
    {
      "sid": "S00152",
      "start": 239.5,
      "end": 241.56,
      "text": "那我们从现实的角度来说呢"
    },
    {
      "sid": "S00153",
      "start": 241.56,
      "end": 243.24,
      "text": "你把自信当成了筹码"
    },
    {
      "sid": "S00154",
      "start": 243.24,
      "end": 244.88,
      "text": "想用它换取一切"
    },
    {
      "sid": "S00155",
      "start": 244.88,
      "end": 246.12,
      "text": "而且一旦换不到"
    },
    {
      "sid": "S00156",
      "start": 246.12,
      "end": 248.2,
      "text": "这份伪装的自信会彻底作回"
    },
    {
      "sid": "S00157",
      "start": 248.2,
      "end": 250.0,
      "text": "你的整个人都会变得颓废"
    },
    {
      "sid": "S00158",
      "start": 250.0,
      "end": 251.3,
      "text": "不停的自我怀疑"
    },
    {
      "sid": "S00159",
      "start": 251.3,
      "end": 252.7,
      "text": "不停的自我内耗"
    },
    {
      "sid": "S00160",
      "start": 252.7,
      "end": 253.38,
      "text": "看到了没"
    },
    {
      "sid": "S00161",
      "start": 253.38,
      "end": 255.64,
      "text": "以上两种获得自信的方式"
    },
    {
      "sid": "S00162",
      "start": 255.64,
      "end": 258.7,
      "text": "本质上还是被世俗价值观给套牢了"
    },
    {
      "sid": "S00163",
      "start": 258.7,
      "end": 261.32,
      "text": "你依旧没有跳出世俗矩阵"
    },
    {
      "sid": "S00164",
      "start": 261.32,
      "end": 262.82,
      "text": "你所有的出发点呢"
    },
    {
      "sid": "S00165",
      "start": 262.82,
      "end": 264.64,
      "text": "还是在这套世俗矩阵中"
    },
    {
      "sid": "S00166",
      "start": 264.64,
      "end": 266.26,
      "text": "进行零和博弈"
    },
    {
      "sid": "S00167",
      "start": 266.26,
      "end": 268.52,
      "text": "依然是我做了什么什么什么"
    },
    {
      "sid": "S00168",
      "start": 268.52,
      "end": 270.48,
      "text": "我就应该怎么怎么样"
    },
    {
      "sid": "S00169",
      "start": 270.48,
      "end": 271.74,
      "text": "本质上呢"
    },
    {
      "sid": "S00170",
      "start": 271.74,
      "end": 273.54,
      "text": "它还是一种向外求"
    },
    {
      "sid": "S00171",
      "start": 273.54,
      "end": 277.22,
      "text": "那么真正的自信到底是什么呢"
    },
    {
      "sid": "S00172",
      "start": 277.22,
      "end": 278.0,
      "text": "很简单"
    },
    {
      "sid": "S00173",
      "start": 278.0,
      "end": 280.56,
      "text": "真正的自信就是自信本身"
    },
    {
      "sid": "S00174",
      "start": 280.56,
      "end": 281.76,
      "text": "它和成败"
    },
    {
      "sid": "S00175",
      "start": 281.76,
      "end": 284.82,
      "text": "结果外界的反应彻底无关"
    },
    {
      "sid": "S00176",
      "start": 284.82,
      "end": 285.86,
      "text": "换句话说呢"
    },
    {
      "sid": "S00177",
      "start": 285.86,
      "end": 287.64,
      "text": "哪怕你身处在一个孤岛里"
    },
    {
      "sid": "S00178",
      "start": 287.64,
      "end": 288.6,
      "text": "那这个时候呢"
    },
    {
      "sid": "S00179",
      "start": 288.6,
      "end": 289.58,
      "text": "我相信很多人会说"
    },
    {
      "sid": "S00180",
      "start": 289.58,
      "end": 290.94,
      "text": "都在孤岛上了"
    },
    {
      "sid": "S00181",
      "start": 290.94,
      "end": 292.66,
      "text": "没有任何人能跟我做对比了"
    },
    {
      "sid": "S00182",
      "start": 292.66,
      "end": 293.86,
      "text": "也没有任何观众"
    },
    {
      "sid": "S00183",
      "start": 293.86,
      "end": 295.78,
      "text": "那么我是不是可以暴露本性"
    },
    {
      "sid": "S00184",
      "start": 295.78,
      "end": 296.94,
      "text": "我可以自卑了"
    },
    {
      "sid": "S00185",
      "start": 296.94,
      "end": 297.34,
      "text": "错"
    },
    {
      "sid": "S00186",
      "start": 297.34,
      "end": 299.26,
      "text": "这个时候你也应该自信"
    },
    {
      "sid": "S00187",
      "start": 299.26,
      "end": 300.88,
      "text": "因为这跟你在孤岛上"
    },
    {
      "sid": "S00188",
      "start": 300.88,
      "end": 301.76,
      "text": "能不能生存"
    },
    {
      "sid": "S00189",
      "start": 301.76,
      "end": 302.46,
      "text": "能不能存活"
    },
    {
      "sid": "S00190",
      "start": 302.46,
      "end": 303.12,
      "text": "能不能逃离"
    },
    {
      "sid": "S00191",
      "start": 303.12,
      "end": 304.34,
      "text": "没有半毛钱关系"
    },
    {
      "sid": "S00192",
      "start": 304.34,
      "end": 305.34,
      "text": "因为自信"
    },
    {
      "sid": "S00193",
      "start": 305.34,
      "end": 306.84,
      "text": "它就和人权一样"
    },
    {
      "sid": "S00194",
      "start": 306.84,
      "end": 309.14,
      "text": "是你天生就被上天赋予的"
    },
    {
      "sid": "S00195",
      "start": 309.14,
      "end": 310.26,
      "text": "你不需要祈求"
    },
    {
      "sid": "S00196",
      "start": 310.26,
      "end": 311.48,
      "text": "也不需要去训练"
    },
    {
      "sid": "S00197",
      "start": 311.48,
      "end": 313.12,
      "text": "你只需要把世俗矩阵"
    },
    {
      "sid": "S00198",
      "start": 313.12,
      "end": 314.38,
      "text": "压抑的那一部分"
    },
    {
      "sid": "S00199",
      "start": 314.38,
      "end": 315.76,
      "text": "释放出来就行了"
    },
    {
      "sid": "S00200",
      "start": 315.76,
      "end": 317.5,
      "text": "所以不是你有钱了"
    },
    {
      "sid": "S00201",
      "start": 317.5,
      "end": 318.12,
      "text": "成功了"
    },
    {
      "sid": "S00202",
      "start": 318.12,
      "end": 318.84,
      "text": "你才能自信"
    },
    {
      "sid": "S00203",
      "start": 318.84,
      "end": 321.02,
      "text": "而是你先拥有了真正的自信"
    },
    {
      "sid": "S00204",
      "start": 321.02,
      "end": 323.26,
      "text": "你才可能慢慢的赚到钱"
    },
    {
      "sid": "S00205",
      "start": 323.26,
      "end": 324.92,
      "text": "并且拥有你想要的一切"
    },
    {
      "sid": "S00206",
      "start": 324.92,
      "end": 325.2,
      "text": "好"
    },
    {
      "sid": "S00207",
      "start": 325.2,
      "end": 326.64,
      "text": "那我们先打住啊"
    },
    {
      "sid": "S00208",
      "start": 326.64,
      "end": 328.46,
      "text": "可能有兄弟听了我刚才那段话"
    },
    {
      "sid": "S00209",
      "start": 328.46,
      "end": 329.32,
      "text": "又要想了"
    },
    {
      "sid": "S00210",
      "start": 329.32,
      "end": 330.46,
      "text": "那是不是只有自信了"
    },
    {
      "sid": "S00211",
      "start": 330.46,
      "end": 331.18,
      "text": "我才能成功"
    },
    {
      "sid": "S00212",
      "start": 331.18,
      "end": 331.9,
      "text": "才能有钱"
    },
    {
      "sid": "S00213",
      "start": 331.9,
      "end": 334.04,
      "text": "其实我今天讲的这些东西呢"
    },
    {
      "sid": "S00214",
      "start": 334.04,
      "end": 336.1,
      "text": "都是为了给兄弟们打破我知"
    },
    {
      "sid": "S00215",
      "start": 336.1,
      "end": 337.66,
      "text": "我为了让大家更加的"
    },
    {
      "sid": "S00216",
      "start": 337.66,
      "end": 339.06,
      "text": "能吃透这个道理呢"
    },
    {
      "sid": "S00217",
      "start": 339.06,
      "end": 340.52,
      "text": "给你们讲一个真事啊"
    },
    {
      "sid": "S00218",
      "start": 340.52,
      "end": 341.9,
      "text": "今年过年回家呢"
    },
    {
      "sid": "S00219",
      "start": 341.9,
      "end": 343.1,
      "text": "我跟我的饭友吃饭"
    },
    {
      "sid": "S00220",
      "start": 343.1,
      "end": 344.12,
      "text": "他是做销售的"
    },
    {
      "sid": "S00221",
      "start": 344.12,
      "end": 345.84,
      "text": "我们俩聊了不少工作上的事情"
    },
    {
      "sid": "S00222",
      "start": 345.84,
      "end": 346.9,
      "text": "他说了一句话"
    },
    {
      "sid": "S00223",
      "start": 346.9,
      "end": 348.3,
      "text": "我觉得特别特别到位"
    },
    {
      "sid": "S00224",
      "start": 348.3,
      "end": 349.78,
      "text": "三流的销售卖产品"
    },
    {
      "sid": "S00225",
      "start": 349.78,
      "end": 351.36,
      "text": "二流的销售卖理念"
    },
    {
      "sid": "S00226",
      "start": 351.36,
      "end": 353.1,
      "text": "一流的销售卖能量"
    },
    {
      "sid": "S00227",
      "start": 353.1,
      "end": 354.3,
      "text": "那么普通销售呢"
    },
    {
      "sid": "S00228",
      "start": 354.3,
      "end": 355.38,
      "text": "遇到客户犹豫时"
    },
    {
      "sid": "S00229",
      "start": 355.38,
      "end": 356.64,
      "text": "在心里面会打鼓"
    },
    {
      "sid": "S00230",
      "start": 356.64,
      "end": 357.82,
      "text": "表现出来的就是"
    },
    {
      "sid": "S00231",
      "start": 357.82,
      "end": 358.8,
      "text": "不停的解释"
    },
    {
      "sid": "S00232",
      "start": 358.8,
      "end": 359.54,
      "text": "低头让步"
    },
    {
      "sid": "S00233",
      "start": 359.54,
      "end": 360.42,
      "text": "拼命补救"
    },
    {
      "sid": "S00234",
      "start": 360.42,
      "end": 361.9,
      "text": "那么在客户眼里呢"
    },
    {
      "sid": "S00235",
      "start": 361.9,
      "end": 362.88,
      "text": "这就是一条甜狗"
    },
    {
      "sid": "S00236",
      "start": 362.88,
      "end": 364.3,
      "text": "可顶级销万不一样"
    },
    {
      "sid": "S00237",
      "start": 364.3,
      "end": 365.76,
      "text": "他们碰到客户沉默"
    },
    {
      "sid": "S00238",
      "start": 365.76,
      "end": 366.16,
      "text": "犹豫"
    },
    {
      "sid": "S00239",
      "start": 366.16,
      "end": 367.66,
      "text": "他敢去反问对方"
    },
    {
      "sid": "S00240",
      "start": 367.66,
      "end": 368.92,
      "text": "因为他心里很笃定"
    },
    {
      "sid": "S00241",
      "start": 368.92,
      "end": 369.98,
      "text": "我的产品够硬"
    },
    {
      "sid": "S00242",
      "start": 369.98,
      "end": 371.04,
      "text": "我有自己的底线"
    },
    {
      "sid": "S00243",
      "start": 371.04,
      "end": 371.66,
      "text": "你不买"
    },
    {
      "sid": "S00244",
      "start": 371.66,
      "end": 372.52,
      "text": "那是你的事"
    },
    {
      "sid": "S00245",
      "start": 372.52,
      "end": 373.12,
      "text": "你买了"
    },
    {
      "sid": "S00246",
      "start": 373.12,
      "end": 373.9,
      "text": "那是你的福气"
    },
    {
      "sid": "S00247",
      "start": 373.9,
      "end": 375.76,
      "text": "我依旧是那个顶尖的销售"
    },
    {
      "sid": "S00248",
      "start": 375.76,
      "end": 376.2,
      "text": "我知道"
    },
    {
      "sid": "S00249",
      "start": 376.2,
      "end": 377.16,
      "text": "听到这里呢"
    },
    {
      "sid": "S00250",
      "start": 377.16,
      "end": 378.26,
      "text": "可能有时候你要反驳"
    },
    {
      "sid": "S00251",
      "start": 378.26,
      "end": 378.52,
      "text": "Mike"
    },
    {
      "sid": "S00252",
      "start": 378.52,
      "end": 379.6,
      "text": "那我自信之后"
    },
    {
      "sid": "S00253",
      "start": 379.6,
      "end": 380.74,
      "text": "还是失败了怎么办"
    },
    {
      "sid": "S00254",
      "start": 380.74,
      "end": 382.34,
      "text": "那么我实话实说啊"
    },
    {
      "sid": "S00255",
      "start": 382.34,
      "end": 383.86,
      "text": "自信的人他照样会失败"
    },
    {
      "sid": "S00256",
      "start": 383.86,
      "end": 386.64,
      "text": "我们虽然说老天他更偏爱自信的人"
    },
    {
      "sid": "S00257",
      "start": 386.64,
      "end": 388.42,
      "text": "但是这只是概率问题"
    },
    {
      "sid": "S00258",
      "start": 388.42,
      "end": 390.44,
      "text": "自信不能让你杜绝失败"
    },
    {
      "sid": "S00259",
      "start": 390.44,
      "end": 392.08,
      "text": "但是他能让你在失败之后"
    },
    {
      "sid": "S00260",
      "start": 392.08,
      "end": 393.26,
      "text": "快速爬起来"
    },
    {
      "sid": "S00261",
      "start": 393.26,
      "end": 394.1,
      "text": "重新再来"
    },
    {
      "sid": "S00262",
      "start": 394.1,
      "end": 395.16,
      "text": "慢慢的提高胜率"
    },
    {
      "sid": "S00263",
      "start": 395.16,
      "end": 397.0,
      "text": "所以说千万不要把自信"
    },
    {
      "sid": "S00264",
      "start": 397.0,
      "end": 398.78,
      "text": "当成成败的唯一条件"
    },
    {
      "sid": "S00265",
      "start": 398.78,
      "end": 400.2,
      "text": "不要对他抱有执念"
    },
    {
      "sid": "S00266",
      "start": 400.2,
      "end": 401.74,
      "text": "我们要认清一点啊"
    },
    {
      "sid": "S00267",
      "start": 401.74,
      "end": 403.18,
      "text": "自信不保证有结果"
    },
    {
      "sid": "S00268",
      "start": 403.18,
      "end": 405.34,
      "text": "但是他保证你在做事的过程中呢"
    },
    {
      "sid": "S00269",
      "start": 405.34,
      "end": 406.1,
      "text": "不丢自己"
    },
    {
      "sid": "S00270",
      "start": 406.1,
      "end": 407.0,
      "text": "不垮气场"
    },
    {
      "sid": "S00271",
      "start": 407.0,
      "end": 408.5,
      "text": "他就像玩炸金花一样"
    },
    {
      "sid": "S00272",
      "start": 408.5,
      "end": 409.26,
      "text": "自信的人呢"
    },
    {
      "sid": "S00273",
      "start": 409.26,
      "end": 410.46,
      "text": "他能接受输"
    },
    {
      "sid": "S00274",
      "start": 410.46,
      "end": 412.9,
      "text": "所以说他拿牌的时候也敢炸糊"
    },
    {
      "sid": "S00275",
      "start": 412.9,
      "end": 415.1,
      "text": "局势不明的时候也敢果断加注"
    },
    {
      "sid": "S00276",
      "start": 415.1,
      "end": 417.52,
      "text": "而那些一心只想赢输不起的人呢"
    },
    {
      "sid": "S00277",
      "start": 417.52,
      "end": 418.84,
      "text": "他们哪怕手里握着好牌"
    },
    {
      "sid": "S00278",
      "start": 418.84,
      "end": 419.96,
      "text": "他们也会为手为脚"
    },
    {
      "sid": "S00279",
      "start": 419.96,
      "end": 420.72,
      "text": "不敢出击"
    },
    {
      "sid": "S00280",
      "start": 420.72,
      "end": 421.58,
      "text": "所以呢"
    },
    {
      "sid": "S00281",
      "start": 421.58,
      "end": 423.78,
      "text": "只要当你不再是为了成功而自信"
    },
    {
      "sid": "S00282",
      "start": 423.78,
      "end": 426.06,
      "text": "你才算真正的掌握了你的人生"
    },
    {
      "sid": "S00283",
      "start": 426.06,
      "end": 427.58,
      "text": "掌握了做大事的能力"
    },
    {
      "sid": "S00284",
      "start": 427.58,
      "end": 429.24,
      "text": "就像是我们刚出生的时候"
    },
    {
      "sid": "S00285",
      "start": 429.24,
      "end": 430.38,
      "text": "我们还是小孩的时候"
    },
    {
      "sid": "S00286",
      "start": 430.38,
      "end": 431.72,
      "text": "我们在刚出生的那一刻"
    },
    {
      "sid": "S00287",
      "start": 431.72,
      "end": 433.1,
      "text": "我们是天然自信的"
    },
    {
      "sid": "S00288",
      "start": 433.1,
      "end": 434.16,
      "text": "我们想哭就哭"
    },
    {
      "sid": "S00289",
      "start": 434.16,
      "end": 434.88,
      "text": "想闹就闹"
    },
    {
      "sid": "S00290",
      "start": 434.88,
      "end": 436.06,
      "text": "随着我们不断的长大"
    },
    {
      "sid": "S00291",
      "start": 436.06,
      "end": 437.94,
      "text": "我们开始变得慢慢的不自信了"
    },
    {
      "sid": "S00292",
      "start": 437.94,
      "end": 439.66,
      "text": "我们开始变得有条件的自信"
    },
    {
      "sid": "S00293",
      "start": 439.66,
      "end": 441.12,
      "text": "那么小时候上学的时候呢"
    },
    {
      "sid": "S00294",
      "start": 441.12,
      "end": 442.38,
      "text": "父母会让你考了100分"
    },
    {
      "sid": "S00295",
      "start": 442.38,
      "end": 443.44,
      "text": "你才可以怎么怎么样"
    },
    {
      "sid": "S00296",
      "start": 443.44,
      "end": 444.5,
      "text": "你才能得到我的爱"
    },
    {
      "sid": "S00297",
      "start": 444.5,
      "end": 445.8,
      "text": "进入工作之后呢"
    },
    {
      "sid": "S00298",
      "start": 445.8,
      "end": 448.14,
      "text": "上司说你必须得完成某一个任务"
    },
    {
      "sid": "S00299",
      "start": 448.14,
      "end": 449.38,
      "text": "我才允许你怎么怎么"
    },
    {
      "sid": "S00300",
      "start": 449.38,
      "end": 452.38,
      "text": "我们所有的自信都成了被他人允许之后"
    },
    {
      "sid": "S00301",
      "start": 452.38,
      "end": 453.5,
      "text": "才能展现出来的东西"
    },
    {
      "sid": "S00302",
      "start": 453.5,
      "end": 456.08,
      "text": "但是我这里想跟兄弟们说一句心理话"
    },
    {
      "sid": "S00303",
      "start": 456.08,
      "end": 457.5,
      "text": "自信就是自信"
    },
    {
      "sid": "S00304",
      "start": 457.5,
      "end": 460.5,
      "text": "不要把它和任何成败得失绑在一起"
    },
    {
      "sid": "S00305",
      "start": 460.5,
      "end": 462.26,
      "text": "不要为了成功而自信"
    },
    {
      "sid": "S00306",
      "start": 462.26,
      "end": 464.74,
      "text": "也不要为了做成某件事情而自信"
    },
    {
      "sid": "S00307",
      "start": 464.74,
      "end": 467.12,
      "text": "是为了自信本身而自信"
    },
    {
      "sid": "S00308",
      "start": 467.12,
      "end": 469.72,
      "text": "那么在这里呢可以叫做但行自信"
    },
    {
      "sid": "S00309",
      "start": 469.72,
      "end": 470.64,
      "text": "莫问虔诚"
    },
    {
      "sid": "S00310",
      "start": 470.64,
      "end": 472.74,
      "text": "我希望所有人去烧香拜佛"
    },
    {
      "sid": "S00311",
      "start": 472.74,
      "end": 474.04,
      "text": "不是为了啊"
    },
    {
      "sid": "S00312",
      "start": 474.04,
      "end": 475.58,
      "text": "我希望佛主保佑我"
    },
    {
      "sid": "S00313",
      "start": 475.58,
      "end": 476.88,
      "text": "而我去烧香拜佛"
    },
    {
      "sid": "S00314",
      "start": 476.88,
      "end": 478.62,
      "text": "而指示我带着虔诚的心"
    },
    {
      "sid": "S00315",
      "start": 478.62,
      "end": 479.54,
      "text": "是否保佑我"
    },
    {
      "sid": "S00316",
      "start": 479.54,
      "end": 481.48,
      "text": "我都选择为你烧香"
    },
    {
      "sid": "S00317",
      "start": 481.48,
      "end": 482.72,
      "text": "那么是一样的"
    },
    {
      "sid": "S00318",
      "start": 482.72,
      "end": 485.12,
      "text": "那么为什么我今天会跟兄弟们聊这些东西呢"
    },
    {
      "sid": "S00319",
      "start": 485.12,
      "end": 486.76,
      "text": "因为我是一个很爱思考的人"
    },
    {
      "sid": "S00320",
      "start": 486.76,
      "end": 489.08,
      "text": "我经常会在我的朋友圈里面"
    },
    {
      "sid": "S00321",
      "start": 489.08,
      "end": 490.32,
      "text": "写下我的一些感悟"
    },
    {
      "sid": "S00322",
      "start": 490.32,
      "end": 491.0,
      "text": "一些随想"
    },
    {
      "sid": "S00323",
      "start": 491.0,
      "end": 492.96,
      "text": "那么你们今天看到的这个文章呢"
    },
    {
      "sid": "S00324",
      "start": 492.96,
      "end": 495.06,
      "text": "这是我今年在3月12号的晚上"
    },
    {
      "sid": "S00325",
      "start": 495.06,
      "end": 497.0,
      "text": "我思考得来的东西"
    },
    {
      "sid": "S00326",
      "start": 497.0,
      "end": 499.06,
      "text": "我把它给写在了我的朋友圈里"
    },
    {
      "sid": "S00327",
      "start": 499.06,
      "end": 501.64,
      "text": "那么你们如果想要获得更多的一手的"
    },
    {
      "sid": "S00328",
      "start": 501.64,
      "end": 502.84,
      "text": "这样的一些心灵感悟"
    },
    {
      "sid": "S00329",
      "start": 502.84,
      "end": 504.8,
      "text": "你们可以添加我的微信"
    },
    {
      "sid": "S00330",
      "start": 504.8,
      "end": 506.56,
      "text": "那么我会经常在我的微信里"
    },
    {
      "sid": "S00331",
      "start": 506.56,
      "end": 508.24,
      "text": "分享很多类似的东西"
    },
    {
      "sid": "S00332",
      "start": 508.24,
      "end": 509.6,
      "text": "这一期内容呢"
    },
    {
      "sid": "S00333",
      "start": 509.6,
      "end": 510.64,
      "text": "可能比较深刻"
    },
    {
      "sid": "S00334",
      "start": 510.64,
      "end": 511.94,
      "text": "我希望你们看完"
    },
    {
      "sid": "S00335",
      "start": 511.94,
      "end": 512.94,
      "text": "好好琢磨琢磨"
    },
    {
      "sid": "S00336",
      "start": 512.94,
      "end": 513.62,
      "text": "我是Mike"
    },
    {
      "sid": "S00337",
      "start": 513.62,
      "end": 514.64,
      "text": "就书知道"
    },
    {
      "sid": "S00338",
      "start": 514.64,
      "end": 515.72,
      "text": "就在其中"
    }
  ]
}
