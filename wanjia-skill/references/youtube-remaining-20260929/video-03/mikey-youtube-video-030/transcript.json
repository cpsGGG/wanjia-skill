{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-030",
  "youtube_id": "RRkgTfaBsEI",
  "media_sha256": "410dc4f5fd1dd35c4a6569c7d868c8dd3419cd84d3a0d14f8e7f60ef87b932f7",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.32,
      "text": "我先问兄弟们一个问题"
    },
    {
      "sid": "S00002",
      "start": 1.32,
      "end": 3.46,
      "text": "想象一下你正在约会"
    },
    {
      "sid": "S00003",
      "start": 3.46,
      "end": 4.66,
      "text": "你的对面呢"
    },
    {
      "sid": "S00004",
      "start": 4.66,
      "end": 5.68,
      "text": "做着一个正妹"
    },
    {
      "sid": "S00005",
      "start": 5.68,
      "end": 6.88,
      "text": "她学历很高"
    },
    {
      "sid": "S00006",
      "start": 6.88,
      "end": 7.84,
      "text": "家境很好"
    },
    {
      "sid": "S00007",
      "start": 7.84,
      "end": 8.92,
      "text": "长得又正"
    },
    {
      "sid": "S00008",
      "start": 8.92,
      "end": 10.1,
      "text": "身材又顶"
    },
    {
      "sid": "S00009",
      "start": 10.1,
      "end": 12.04,
      "text": "谈吐落落大方"
    },
    {
      "sid": "S00010",
      "start": 12.04,
      "end": 14.32,
      "text": "她向你抛出了一个很难回答的问题"
    },
    {
      "sid": "S00011",
      "start": 14.32,
      "end": 16.1,
      "text": "你经常跟女生约会吗"
    },
    {
      "sid": "S00012",
      "start": 16.1,
      "end": 17.16,
      "text": "那么听到这里"
    },
    {
      "sid": "S00013",
      "start": 17.16,
      "end": 19.72,
      "text": "不少兄弟已经开始汗流浃背了"
    },
    {
      "sid": "S00014",
      "start": 19.72,
      "end": 21.56,
      "text": "你们可能会赶忙解释"
    },
    {
      "sid": "S00015",
      "start": 21.56,
      "end": 22.8,
      "text": "含糊过去"
    },
    {
      "sid": "S00016",
      "start": 22.8,
      "end": 24.6,
      "text": "那么她接着侃侃而谈"
    },
    {
      "sid": "S00017",
      "start": 24.6,
      "end": 26.68,
      "text": "你感受到了前所未有的压力"
    },
    {
      "sid": "S00018",
      "start": 26.68,
      "end": 27.86,
      "text": "你们之间的位置"
    },
    {
      "sid": "S00019",
      "start": 27.86,
      "end": 29.44,
      "text": "在不知不觉间"
    },
    {
      "sid": "S00020",
      "start": 29.44,
      "end": 30.5,
      "text": "产生了倾斜"
    },
    {
      "sid": "S00021",
      "start": 30.5,
      "end": 32.26,
      "text": "周围的人好像也在看向你"
    },
    {
      "sid": "S00022",
      "start": 32.26,
      "end": 34.12,
      "text": "你开始变得更加焦虑了"
    },
    {
      "sid": "S00023",
      "start": 34.12,
      "end": 34.36,
      "text": "好"
    },
    {
      "sid": "S00024",
      "start": 34.36,
      "end": 37.42,
      "text": "那么现在Mike哥扮演一个角色"
    },
    {
      "sid": "S00025",
      "start": 37.42,
      "end": 38.74,
      "text": "我扮演一个灭霸"
    },
    {
      "sid": "S00026",
      "start": 38.74,
      "end": 40.6,
      "text": "我打了一个响指"
    },
    {
      "sid": "S00027",
      "start": 40.6,
      "end": 41.76,
      "text": "你对面的女生"
    },
    {
      "sid": "S00028",
      "start": 41.76,
      "end": 43.62,
      "text": "变成了一个玩偶"
    },
    {
      "sid": "S00029",
      "start": 43.62,
      "end": 45.7,
      "text": "周围的人都消失不见了"
    },
    {
      "sid": "S00030",
      "start": 45.7,
      "end": 47.5,
      "text": "现在你还会紧张吗"
    },
    {
      "sid": "S00031",
      "start": 47.5,
      "end": 48.38,
      "text": "你还焦虑吗"
    },
    {
      "sid": "S00032",
      "start": 48.38,
      "end": 50.24,
      "text": "你感觉到了一阵轻松"
    },
    {
      "sid": "S00033",
      "start": 50.24,
      "end": 52.82,
      "text": "你似乎可以表达自己的真实想法"
    },
    {
      "sid": "S00034",
      "start": 52.82,
      "end": 55.66,
      "text": "你感觉你可以做你真正的自己"
    },
    {
      "sid": "S00035",
      "start": 55.66,
      "end": 57.38,
      "text": "那我们停下来想一想"
    },
    {
      "sid": "S00036",
      "start": 57.38,
      "end": 58.72,
      "text": "这两者的区别"
    },
    {
      "sid": "S00037",
      "start": 58.72,
      "end": 59.96,
      "text": "到底是什么呢"
    },
    {
      "sid": "S00038",
      "start": 59.96,
      "end": 60.54,
      "text": "大家好"
    },
    {
      "sid": "S00039",
      "start": 60.54,
      "end": 61.38,
      "text": "我是Mike"
    },
    {
      "sid": "S00040",
      "start": 61.38,
      "end": 62.26,
      "text": "上一期呢"
    },
    {
      "sid": "S00041",
      "start": 62.26,
      "end": 63.08,
      "text": "我讲了自我"
    },
    {
      "sid": "S00042",
      "start": 63.08,
      "end": 63.94,
      "text": "大家明白了"
    },
    {
      "sid": "S00043",
      "start": 63.94,
      "end": 65.08,
      "text": "为什么你没有自我"
    },
    {
      "sid": "S00044",
      "start": 65.08,
      "end": 66.22,
      "text": "就会变成龟男"
    },
    {
      "sid": "S00045",
      "start": 66.22,
      "end": 67.08,
      "text": "工具人"
    },
    {
      "sid": "S00046",
      "start": 67.08,
      "end": 67.54,
      "text": "被虑"
    },
    {
      "sid": "S00047",
      "start": 67.54,
      "end": 68.16,
      "text": "被甩"
    },
    {
      "sid": "S00048",
      "start": 68.16,
      "end": 70.02,
      "text": "或者是被禁声出户"
    },
    {
      "sid": "S00049",
      "start": 70.02,
      "end": 71.56,
      "text": "那么有兄弟要给你讲"
    },
    {
      "sid": "S00050",
      "start": 71.56,
      "end": 72.84,
      "text": "道理我都懂"
    },
    {
      "sid": "S00051",
      "start": 72.84,
      "end": 75.1,
      "text": "但到底要怎么样才能做到呢"
    },
    {
      "sid": "S00052",
      "start": 75.1,
      "end": 76.4,
      "text": "今天这期视频呢"
    },
    {
      "sid": "S00053",
      "start": 76.4,
      "end": 77.5,
      "text": "我就只讲方法"
    },
    {
      "sid": "S00054",
      "start": 77.5,
      "end": 79.08,
      "text": "告诉你怎么一步一步"
    },
    {
      "sid": "S00055",
      "start": 79.08,
      "end": 81.02,
      "text": "从思维到行为"
    },
    {
      "sid": "S00056",
      "start": 81.02,
      "end": 82.76,
      "text": "真正建立起你的自我"
    },
    {
      "sid": "S00057",
      "start": 82.76,
      "end": 92.4,
      "text": "从向外求到向内看"
    },
    {
      "sid": "S00058",
      "start": 92.4,
      "end": 93.94,
      "text": "停止向外寻求认可"
    },
    {
      "sid": "S00059",
      "start": 93.94,
      "end": 95.92,
      "text": "开始向内建立标准"
    },
    {
      "sid": "S00060",
      "start": 95.92,
      "end": 97.08,
      "text": "你是不是总想问"
    },
    {
      "sid": "S00061",
      "start": 97.08,
      "end": 98.84,
      "text": "我这样穿女生会喜欢吗"
    },
    {
      "sid": "S00062",
      "start": 98.84,
      "end": 100.16,
      "text": "我今天这个发型对不对"
    },
    {
      "sid": "S00063",
      "start": 100.16,
      "end": 100.96,
      "text": "我这样说"
    },
    {
      "sid": "S00064",
      "start": 100.96,
      "end": 102.26,
      "text": "她会觉得我有趣吗"
    },
    {
      "sid": "S00065",
      "start": 102.26,
      "end": 103.54,
      "text": "我赚多少钱"
    },
    {
      "sid": "S00066",
      "start": 103.54,
      "end": 105.04,
      "text": "她才会满意呢"
    },
    {
      "sid": "S00067",
      "start": 105.04,
      "end": 106.22,
      "text": "那么从现在开始"
    },
    {
      "sid": "S00068",
      "start": 106.22,
      "end": 107.9,
      "text": "把这些问题的族欲"
    },
    {
      "sid": "S00069",
      "start": 107.9,
      "end": 109.12,
      "text": "全都给我换掉"
    },
    {
      "sid": "S00070",
      "start": 109.12,
      "end": 110.16,
      "text": "换成我"
    },
    {
      "sid": "S00071",
      "start": 110.16,
      "end": 111.42,
      "text": "把她喜欢什么"
    },
    {
      "sid": "S00072",
      "start": 111.42,
      "end": 112.68,
      "text": "改成我喜欢什么"
    },
    {
      "sid": "S00073",
      "start": 112.68,
      "end": 114.0,
      "text": "把她怎么看我"
    },
    {
      "sid": "S00074",
      "start": 114.0,
      "end": 114.78,
      "text": "改成"
    },
    {
      "sid": "S00075",
      "start": 114.78,
      "end": 116.28,
      "text": "我怎么看我"
    },
    {
      "sid": "S00076",
      "start": 116.28,
      "end": 117.46,
      "text": "我们每个人生来"
    },
    {
      "sid": "S00077",
      "start": 117.46,
      "end": 118.36,
      "text": "就拥有自我"
    },
    {
      "sid": "S00078",
      "start": 118.36,
      "end": 119.34,
      "text": "比如说我们小时候"
    },
    {
      "sid": "S00079",
      "start": 119.34,
      "end": 120.24,
      "text": "我们想哭就哭"
    },
    {
      "sid": "S00080",
      "start": 120.24,
      "end": 121.22,
      "text": "想笑就笑"
    },
    {
      "sid": "S00081",
      "start": 121.22,
      "end": 122.84,
      "text": "那么随着我们的长大呢"
    },
    {
      "sid": "S00082",
      "start": 122.84,
      "end": 124.1,
      "text": "我们被外界的"
    },
    {
      "sid": "S00083",
      "start": 124.1,
      "end": 125.5,
      "text": "越来越多的行为规范"
    },
    {
      "sid": "S00084",
      "start": 125.5,
      "end": 126.36,
      "text": "或者是来自于"
    },
    {
      "sid": "S00085",
      "start": 126.36,
      "end": 127.42,
      "text": "他人的负反馈"
    },
    {
      "sid": "S00086",
      "start": 127.42,
      "end": 128.3,
      "text": "或者是来自于"
    },
    {
      "sid": "S00087",
      "start": 128.3,
      "end": 129.1,
      "text": "你的自我设限"
    },
    {
      "sid": "S00088",
      "start": 129.1,
      "end": 129.9,
      "text": "渐渐的"
    },
    {
      "sid": "S00089",
      "start": 129.9,
      "end": 131.98,
      "text": "我们的自我被淹没了"
    },
    {
      "sid": "S00090",
      "start": 131.98,
      "end": 133.24,
      "text": "那么从今天起呢"
    },
    {
      "sid": "S00091",
      "start": 133.24,
      "end": 134.46,
      "text": "每天做一件目的"
    },
    {
      "sid": "S00092",
      "start": 134.46,
      "end": 135.44,
      "text": "只是为了让自己"
    },
    {
      "sid": "S00093",
      "start": 135.44,
      "end": 136.16,
      "text": "开心的事情"
    },
    {
      "sid": "S00094",
      "start": 136.16,
      "end": 136.7,
      "text": "比如说"
    },
    {
      "sid": "S00095",
      "start": 136.7,
      "end": 137.74,
      "text": "打一把游戏"
    },
    {
      "sid": "S00096",
      "start": 137.74,
      "end": 138.76,
      "text": "看一集动漫"
    },
    {
      "sid": "S00097",
      "start": 138.76,
      "end": 139.7,
      "text": "去执行那个"
    },
    {
      "sid": "S00098",
      "start": 139.7,
      "end": 141.12,
      "text": "被搁置的锻炼计划"
    },
    {
      "sid": "S00099",
      "start": 141.12,
      "end": 142.5,
      "text": "或者是你的搭设计划"
    },
    {
      "sid": "S00100",
      "start": 142.5,
      "end": 144.1,
      "text": "或者是给你的女神"
    },
    {
      "sid": "S00101",
      "start": 144.1,
      "end": 144.92,
      "text": "发一条消息"
    },
    {
      "sid": "S00102",
      "start": 144.92,
      "end": 146.02,
      "text": "不管他回不回"
    },
    {
      "sid": "S00103",
      "start": 146.02,
      "end": 146.7,
      "text": "都不重要"
    },
    {
      "sid": "S00104",
      "start": 146.7,
      "end": 147.32,
      "text": "他喜不喜欢"
    },
    {
      "sid": "S00105",
      "start": 147.32,
      "end": 147.88,
      "text": "都不重要"
    },
    {
      "sid": "S00106",
      "start": 147.88,
      "end": 148.7,
      "text": "你发"
    },
    {
      "sid": "S00107",
      "start": 148.7,
      "end": 149.9,
      "text": "只是因为你想发"
    },
    {
      "sid": "S00108",
      "start": 149.9,
      "end": 150.4,
      "text": "记住"
    },
    {
      "sid": "S00109",
      "start": 150.4,
      "end": 151.44,
      "text": "去做决定"
    },
    {
      "sid": "S00110",
      "start": 151.44,
      "end": 152.26,
      "text": "做一件事"
    },
    {
      "sid": "S00111",
      "start": 152.26,
      "end": 153.22,
      "text": "去game之前呢"
    },
    {
      "sid": "S00112",
      "start": 153.22,
      "end": 154.16,
      "text": "你要先问问自己"
    },
    {
      "sid": "S00113",
      "start": 154.16,
      "end": 155.86,
      "text": "如果没有任何人评价我"
    },
    {
      "sid": "S00114",
      "start": 155.86,
      "end": 157.0,
      "text": "我会怎么做"
    },
    {
      "sid": "S00115",
      "start": 157.0,
      "end": 157.82,
      "text": "再问问自己"
    },
    {
      "sid": "S00116",
      "start": 157.82,
      "end": 159.4,
      "text": "如果我吃到了负反馈"
    },
    {
      "sid": "S00117",
      "start": 159.4,
      "end": 160.58,
      "text": "我又会怎么做"
    },
    {
      "sid": "S00118",
      "start": 160.58,
      "end": 162.1,
      "text": "我会怎么看待我自己"
    },
    {
      "sid": "S00119",
      "start": 162.1,
      "end": 163.5,
      "text": "我们要把这个问题呢"
    },
    {
      "sid": "S00120",
      "start": 163.5,
      "end": 164.32,
      "text": "给理明白"
    },
    {
      "sid": "S00121",
      "start": 164.32,
      "end": 165.74,
      "text": "我们要清楚这些行为呢"
    },
    {
      "sid": "S00122",
      "start": 165.74,
      "end": 166.48,
      "text": "是出局务"
    },
    {
      "sid": "S00123",
      "start": 166.48,
      "end": 167.52,
      "text": "是我做的决定"
    },
    {
      "sid": "S00124",
      "start": 167.52,
      "end": 168.52,
      "text": "别人的评价"
    },
    {
      "sid": "S00125",
      "start": 168.52,
      "end": 169.56,
      "text": "真的重要吗"
    },
    {
      "sid": "S00126",
      "start": 169.56,
      "end": 169.9,
      "text": "不"
    },
    {
      "sid": "S00127",
      "start": 169.9,
      "end": 171.06,
      "text": "慢慢的你会发现"
    },
    {
      "sid": "S00128",
      "start": 171.06,
      "end": 172.08,
      "text": "其实你自己的感受"
    },
    {
      "sid": "S00129",
      "start": 172.08,
      "end": 173.12,
      "text": "才是最重要的"
    },
    {
      "sid": "S00130",
      "start": 173.12,
      "end": 180.92,
      "text": "第二点"
    },
    {
      "sid": "S00131",
      "start": 180.92,
      "end": 182.0,
      "text": "建立边界感"
    },
    {
      "sid": "S00132",
      "start": 182.0,
      "end": 182.78,
      "text": "学会说不"
    },
    {
      "sid": "S00133",
      "start": 182.78,
      "end": 184.08,
      "text": "没有自我的人呢"
    },
    {
      "sid": "S00134",
      "start": 184.08,
      "end": 185.36,
      "text": "最缺少的就是边界感"
    },
    {
      "sid": "S00135",
      "start": 185.36,
      "end": 186.22,
      "text": "你不敢拒绝"
    },
    {
      "sid": "S00136",
      "start": 186.22,
      "end": 187.2,
      "text": "你不敢表达不满"
    },
    {
      "sid": "S00137",
      "start": 187.2,
      "end": 188.48,
      "text": "你不敢提出要求"
    },
    {
      "sid": "S00138",
      "start": 188.48,
      "end": 189.9,
      "text": "因为你怕这些行为"
    },
    {
      "sid": "S00139",
      "start": 189.9,
      "end": 190.78,
      "text": "会让女生觉得"
    },
    {
      "sid": "S00140",
      "start": 190.78,
      "end": 191.58,
      "text": "你这个人不好"
    },
    {
      "sid": "S00141",
      "start": 191.58,
      "end": 192.62,
      "text": "从而不喜欢你"
    },
    {
      "sid": "S00142",
      "start": 192.62,
      "end": 193.44,
      "text": "很多人说"
    },
    {
      "sid": "S00143",
      "start": 193.44,
      "end": 193.8,
      "text": "Mikey"
    },
    {
      "sid": "S00144",
      "start": 193.8,
      "end": 195.28,
      "text": "你为什么跟女生聊天的时候"
    },
    {
      "sid": "S00145",
      "start": 195.28,
      "end": 196.12,
      "text": "这么刻薄"
    },
    {
      "sid": "S00146",
      "start": 196.12,
      "end": 197.66,
      "text": "当女生说一些话的时候"
    },
    {
      "sid": "S00147",
      "start": 197.66,
      "end": 199.16,
      "text": "你竟然会直接怼他"
    },
    {
      "sid": "S00148",
      "start": 199.16,
      "end": 200.04,
      "text": "我想说的是"
    },
    {
      "sid": "S00149",
      "start": 200.04,
      "end": 201.18,
      "text": "因为我做那件事情"
    },
    {
      "sid": "S00150",
      "start": 201.18,
      "end": 202.48,
      "text": "是因为我想做"
    },
    {
      "sid": "S00151",
      "start": 202.48,
      "end": 203.0,
      "text": "而不是"
    },
    {
      "sid": "S00152",
      "start": 203.0,
      "end": 204.64,
      "text": "我奢求对方喜欢我"
    },
    {
      "sid": "S00153",
      "start": 204.64,
      "end": 205.76,
      "text": "我们永远要清楚"
    },
    {
      "sid": "S00154",
      "start": 205.76,
      "end": 207.74,
      "text": "委屈永远不可能求全"
    },
    {
      "sid": "S00155",
      "start": 207.74,
      "end": 209.08,
      "text": "很多时候我认为"
    },
    {
      "sid": "S00156",
      "start": 209.08,
      "end": 210.6,
      "text": "我只是在做一个正常人"
    },
    {
      "sid": "S00157",
      "start": 210.6,
      "end": 211.28,
      "text": "该做的事情"
    },
    {
      "sid": "S00158",
      "start": 211.28,
      "end": 212.26,
      "text": "但是对于"
    },
    {
      "sid": "S00159",
      "start": 212.26,
      "end": 213.46,
      "text": "平时目前很多"
    },
    {
      "sid": "S00160",
      "start": 213.46,
      "end": 214.58,
      "text": "不太了解女人"
    },
    {
      "sid": "S00161",
      "start": 214.58,
      "end": 215.14,
      "text": "或者是"
    },
    {
      "sid": "S00162",
      "start": 215.14,
      "end": 216.66,
      "text": "不太拥有自我的人"
    },
    {
      "sid": "S00163",
      "start": 216.66,
      "end": 217.38,
      "text": "他们会觉得"
    },
    {
      "sid": "S00164",
      "start": 217.38,
      "end": 218.34,
      "text": "我这个行为"
    },
    {
      "sid": "S00165",
      "start": 218.34,
      "end": 219.54,
      "text": "是在冒犯女人"
    },
    {
      "sid": "S00166",
      "start": 219.54,
      "end": 220.92,
      "text": "但其实对于女人来讲"
    },
    {
      "sid": "S00167",
      "start": 220.92,
      "end": 222.68,
      "text": "我这个只是一个正常人的行为"
    },
    {
      "sid": "S00168",
      "start": 222.68,
      "end": 223.88,
      "text": "包括我们在生活上"
    },
    {
      "sid": "S00169",
      "start": 223.88,
      "end": 224.86,
      "text": "同事让你加班"
    },
    {
      "sid": "S00170",
      "start": 224.86,
      "end": 225.84,
      "text": "你不敢拒绝"
    },
    {
      "sid": "S00171",
      "start": 225.84,
      "end": 226.98,
      "text": "女生跟你约会迟到"
    },
    {
      "sid": "S00172",
      "start": 226.98,
      "end": 227.9,
      "text": "你也不敢说什么"
    },
    {
      "sid": "S00173",
      "start": 227.9,
      "end": 228.86,
      "text": "但你却敢对着"
    },
    {
      "sid": "S00174",
      "start": 228.86,
      "end": 230.2,
      "text": "上菜慢的服务声"
    },
    {
      "sid": "S00175",
      "start": 230.2,
      "end": 231.18,
      "text": "大发雷霆"
    },
    {
      "sid": "S00176",
      "start": 231.18,
      "end": 232.5,
      "text": "对着酒店前台"
    },
    {
      "sid": "S00177",
      "start": 232.5,
      "end": 233.64,
      "text": "大放厥词"
    },
    {
      "sid": "S00178",
      "start": 233.64,
      "end": 234.94,
      "text": "你可能认为这是自我"
    },
    {
      "sid": "S00179",
      "start": 234.94,
      "end": 236.02,
      "text": "但这并不是自我"
    },
    {
      "sid": "S00180",
      "start": 236.02,
      "end": 237.5,
      "text": "这并不是真正的边界感"
    },
    {
      "sid": "S00181",
      "start": 237.5,
      "end": 239.02,
      "text": "这只是无能狂怒"
    },
    {
      "sid": "S00182",
      "start": 239.02,
      "end": 240.0,
      "text": "这只是弱者"
    },
    {
      "sid": "S00183",
      "start": 240.0,
      "end": 241.36,
      "text": "向更弱者抽刀"
    },
    {
      "sid": "S00184",
      "start": 241.36,
      "end": 243.68,
      "text": "就像我们疫情期间的保安一样"
    },
    {
      "sid": "S00185",
      "start": 243.68,
      "end": 245.12,
      "text": "那么拥有自我的边界感"
    },
    {
      "sid": "S00186",
      "start": 245.12,
      "end": 246.36,
      "text": "像是山上的云雾"
    },
    {
      "sid": "S00187",
      "start": 246.36,
      "end": 247.8,
      "text": "你既能融入其中"
    },
    {
      "sid": "S00188",
      "start": 247.8,
      "end": 249.3,
      "text": "也能感受到它的威压"
    },
    {
      "sid": "S00189",
      "start": 249.3,
      "end": 250.2,
      "text": "这里的边界"
    },
    {
      "sid": "S00190",
      "start": 250.2,
      "end": 252.48,
      "text": "即是阿德勒的课题分离理论中"
    },
    {
      "sid": "S00191",
      "start": 252.48,
      "end": 254.26,
      "text": "健康的人际边界"
    },
    {
      "sid": "S00192",
      "start": 254.26,
      "end": 256.52,
      "text": "也是你作为一个拥有自我的主体"
    },
    {
      "sid": "S00193",
      "start": 256.52,
      "end": 258.98,
      "text": "你心中关于自己底线的边界"
    },
    {
      "sid": "S00194",
      "start": 258.98,
      "end": 260.0,
      "text": "从今天开始"
    },
    {
      "sid": "S00195",
      "start": 260.0,
      "end": 261.68,
      "text": "试着每天去拒绝一个人"
    },
    {
      "sid": "S00196",
      "start": 261.68,
      "end": 263.26,
      "text": "不管是同事的无理要求"
    },
    {
      "sid": "S00197",
      "start": 263.26,
      "end": 264.66,
      "text": "还是女人的废物测试"
    },
    {
      "sid": "S00198",
      "start": 264.66,
      "end": 265.94,
      "text": "女人的无理试探"
    },
    {
      "sid": "S00199",
      "start": 265.94,
      "end": 267.58,
      "text": "当对方让你不舒服的时候"
    },
    {
      "sid": "S00200",
      "start": 267.58,
      "end": 268.32,
      "text": "你直接说出来"
    },
    {
      "sid": "S00201",
      "start": 268.32,
      "end": 269.42,
      "text": "你这样我并不喜欢"
    },
    {
      "sid": "S00202",
      "start": 269.42,
      "end": 271.62,
      "text": "你这样让我感到了不礼貌"
    },
    {
      "sid": "S00203",
      "start": 271.62,
      "end": 272.4,
      "text": "不舒服"
    },
    {
      "sid": "S00204",
      "start": 272.4,
      "end": 274.74,
      "text": "当对方继续去触碰你的边界时"
    },
    {
      "sid": "S00205",
      "start": 274.74,
      "end": 275.62,
      "text": "不要解释"
    },
    {
      "sid": "S00206",
      "start": 275.62,
      "end": 277.24,
      "text": "不要用讨好来补偿"
    },
    {
      "sid": "S00207",
      "start": 277.24,
      "end": 278.7,
      "text": "你可以选择转身就走"
    },
    {
      "sid": "S00208",
      "start": 278.7,
      "end": 279.1,
      "text": "记住"
    },
    {
      "sid": "S00209",
      "start": 279.1,
      "end": 280.24,
      "text": "真正的尊重"
    },
    {
      "sid": "S00210",
      "start": 280.24,
      "end": 282.12,
      "text": "永远不是需要去赢得的"
    },
    {
      "sid": "S00211",
      "start": 282.12,
      "end": 283.64,
      "text": "是不需要去争取的"
    },
    {
      "sid": "S00212",
      "start": 283.64,
      "end": 284.88,
      "text": "不需要去证明的"
    },
    {
      "sid": "S00213",
      "start": 284.88,
      "end": 292.22,
      "text": "三"
    },
    {
      "sid": "S00214",
      "start": 292.22,
      "end": 293.52,
      "text": "主动选择"
    },
    {
      "sid": "S00215",
      "start": 293.52,
      "end": 294.0,
      "text": "而不是"
    },
    {
      "sid": "S00216",
      "start": 294.0,
      "end": 295.3,
      "text": "被动接受"
    },
    {
      "sid": "S00217",
      "start": 295.3,
      "end": 296.72,
      "text": "一个没有自我的人呢"
    },
    {
      "sid": "S00218",
      "start": 296.72,
      "end": 298.58,
      "text": "总是在等着别人给出选项"
    },
    {
      "sid": "S00219",
      "start": 298.58,
      "end": 299.18,
      "text": "比如说"
    },
    {
      "sid": "S00220",
      "start": 299.18,
      "end": 300.26,
      "text": "我们去吃什么"
    },
    {
      "sid": "S00221",
      "start": 300.26,
      "end": 301.78,
      "text": "我们等会看什么电影"
    },
    {
      "sid": "S00222",
      "start": 301.78,
      "end": 303.24,
      "text": "我们要不要在一起"
    },
    {
      "sid": "S00223",
      "start": 303.24,
      "end": 304.74,
      "text": "你为什么不喜欢我"
    },
    {
      "sid": "S00224",
      "start": 304.74,
      "end": 306.86,
      "text": "只会活在别人的标准之下"
    },
    {
      "sid": "S00225",
      "start": 306.86,
      "end": 308.1,
      "text": "而拥有自我的人呢"
    },
    {
      "sid": "S00226",
      "start": 308.1,
      "end": 308.78,
      "text": "会直接说"
    },
    {
      "sid": "S00227",
      "start": 308.78,
      "end": 309.7,
      "text": "我今天想吃火锅"
    },
    {
      "sid": "S00228",
      "start": 309.7,
      "end": 311.3,
      "text": "或者是我今天想看这部电影"
    },
    {
      "sid": "S00229",
      "start": 311.3,
      "end": 312.24,
      "text": "我们去我那吧"
    },
    {
      "sid": "S00230",
      "start": 312.24,
      "end": 313.64,
      "text": "面对任何人和事"
    },
    {
      "sid": "S00231",
      "start": 313.64,
      "end": 315.4,
      "text": "都能给出自己的标准"
    },
    {
      "sid": "S00232",
      "start": 315.4,
      "end": 316.62,
      "text": "他们对于自己的生活"
    },
    {
      "sid": "S00233",
      "start": 316.62,
      "end": 317.96,
      "text": "是有选择权的"
    },
    {
      "sid": "S00234",
      "start": 317.96,
      "end": 319.34,
      "text": "那么在电影寄生丛里"
    },
    {
      "sid": "S00235",
      "start": 319.34,
      "end": 320.86,
      "text": "主角一家人能设计出"
    },
    {
      "sid": "S00236",
      "start": 320.86,
      "end": 322.14,
      "text": "环环相扣的计谋"
    },
    {
      "sid": "S00237",
      "start": 322.14,
      "end": 323.12,
      "text": "各凭本事"
    },
    {
      "sid": "S00238",
      "start": 323.12,
      "end": 325.16,
      "text": "混进富豪朴社长家里工作"
    },
    {
      "sid": "S00239",
      "start": 325.16,
      "end": 325.78,
      "text": "定居"
    },
    {
      "sid": "S00240",
      "start": 325.78,
      "end": 326.56,
      "text": "我们可以看到"
    },
    {
      "sid": "S00241",
      "start": 326.56,
      "end": 327.86,
      "text": "他们是有真本事的"
    },
    {
      "sid": "S00242",
      "start": 327.86,
      "end": 329.34,
      "text": "但是他们的一切行为"
    },
    {
      "sid": "S00243",
      "start": 329.34,
      "end": 330.62,
      "text": "他们的喜怒哀乐"
    },
    {
      "sid": "S00244",
      "start": 330.62,
      "end": 332.92,
      "text": "依然是以朴社长一家人为中心的"
    },
    {
      "sid": "S00245",
      "start": 332.92,
      "end": 334.62,
      "text": "他们要研究富人的喜好"
    },
    {
      "sid": "S00246",
      "start": 334.62,
      "end": 335.9,
      "text": "模仿富人的口吻"
    },
    {
      "sid": "S00247",
      "start": 335.9,
      "end": 337.08,
      "text": "在富人面前呢"
    },
    {
      "sid": "S00248",
      "start": 337.08,
      "end": 338.34,
      "text": "扮演好各自的角色"
    },
    {
      "sid": "S00249",
      "start": 338.34,
      "end": 339.82,
      "text": "他们的成功是建立在"
    },
    {
      "sid": "S00250",
      "start": 339.82,
      "end": 341.3,
      "text": "别人的认可之上的"
    },
    {
      "sid": "S00251",
      "start": 341.3,
      "end": 343.22,
      "text": "他们本质上就是一个寄生丛"
    },
    {
      "sid": "S00252",
      "start": 343.22,
      "end": 344.3,
      "text": "如果你也是这样"
    },
    {
      "sid": "S00253",
      "start": 344.3,
      "end": 345.76,
      "text": "那么你对于女人来讲"
    },
    {
      "sid": "S00254",
      "start": 345.76,
      "end": 346.66,
      "text": "你就是寄生丛"
    },
    {
      "sid": "S00255",
      "start": 346.66,
      "end": 348.14,
      "text": "你是在索取她的价值"
    },
    {
      "sid": "S00256",
      "start": 348.14,
      "end": 348.94,
      "text": "这也是为什么"
    },
    {
      "sid": "S00257",
      "start": 348.94,
      "end": 350.34,
      "text": "当暴风雨之夜呢"
    },
    {
      "sid": "S00258",
      "start": 350.34,
      "end": 351.32,
      "text": "主人突然回家"
    },
    {
      "sid": "S00259",
      "start": 351.32,
      "end": 352.5,
      "text": "他们就像蟑螂一样"
    },
    {
      "sid": "S00260",
      "start": 352.5,
      "end": 353.4,
      "text": "躲在桌子底下"
    },
    {
      "sid": "S00261",
      "start": 353.4,
      "end": 355.76,
      "text": "另一个几段电影是小丑里的亚瑟"
    },
    {
      "sid": "S00262",
      "start": 355.76,
      "end": 356.68,
      "text": "他来自底层"
    },
    {
      "sid": "S00263",
      "start": 356.68,
      "end": 357.24,
      "text": "贫穷"
    },
    {
      "sid": "S00264",
      "start": 357.24,
      "end": 358.04,
      "text": "被嘲笑"
    },
    {
      "sid": "S00265",
      "start": 358.04,
      "end": 358.72,
      "text": "被欺凌"
    },
    {
      "sid": "S00266",
      "start": 358.72,
      "end": 360.46,
      "text": "最后他终于彻底拥抱了"
    },
    {
      "sid": "S00267",
      "start": 360.46,
      "end": 363.82,
      "text": "那个被社会视为怪胎和失败的自我"
    },
    {
      "sid": "S00268",
      "start": 363.82,
      "end": 366.26,
      "text": "他不再去追求被脱口秀偶像的认可"
    },
    {
      "sid": "S00269",
      "start": 366.26,
      "end": 368.0,
      "text": "他不再渴望被母亲的认可"
    },
    {
      "sid": "S00270",
      "start": 368.0,
      "end": 370.0,
      "text": "不再奢望被社会认可"
    },
    {
      "sid": "S00271",
      "start": 370.0,
      "end": 370.94,
      "text": "他跳舞"
    },
    {
      "sid": "S00272",
      "start": 370.94,
      "end": 371.56,
      "text": "杀人"
    },
    {
      "sid": "S00273",
      "start": 371.56,
      "end": 372.64,
      "text": "他成为了符号"
    },
    {
      "sid": "S00274",
      "start": 372.64,
      "end": 374.92,
      "text": "他的一切行为的出发点都来自于"
    },
    {
      "sid": "S00275",
      "start": 374.92,
      "end": 375.32,
      "text": "我"
    },
    {
      "sid": "S00276",
      "start": 375.32,
      "end": 376.88,
      "text": "他从一个被动接受"
    },
    {
      "sid": "S00277",
      "start": 376.88,
      "end": 378.74,
      "text": "寻求外部认可的可怜虫"
    },
    {
      "sid": "S00278",
      "start": 378.74,
      "end": 380.58,
      "text": "变成了一个拥有扭曲"
    },
    {
      "sid": "S00279",
      "start": 380.58,
      "end": 382.46,
      "text": "但强大主体性的神"
    },
    {
      "sid": "S00280",
      "start": 382.46,
      "end": 384.5,
      "text": "但我这里并不是想告诉你们"
    },
    {
      "sid": "S00281",
      "start": 384.5,
      "end": 386.7,
      "text": "你们需要去伤害别人获得自我"
    },
    {
      "sid": "S00282",
      "start": 386.7,
      "end": 388.6,
      "text": "你们不需要去伤害别人获得自我"
    },
    {
      "sid": "S00283",
      "start": 388.6,
      "end": 391.3,
      "text": "你们只需要正常合理的去拒绝他人"
    },
    {
      "sid": "S00284",
      "start": 391.3,
      "end": 392.84,
      "text": "只需要正常合理的"
    },
    {
      "sid": "S00285",
      "start": 392.84,
      "end": 395.66,
      "text": "按照自己想要的生活方式去生活就可以"
    },
    {
      "sid": "S00286",
      "start": 395.66,
      "end": 397.08,
      "text": "那么从今天开始呢"
    },
    {
      "sid": "S00287",
      "start": 397.08,
      "end": 397.82,
      "text": "在约会中"
    },
    {
      "sid": "S00288",
      "start": 397.82,
      "end": 398.6,
      "text": "在聊天中"
    },
    {
      "sid": "S00289",
      "start": 398.6,
      "end": 400.96,
      "text": "我们要大胆的给对方三个选项"
    },
    {
      "sid": "S00290",
      "start": 400.96,
      "end": 402.42,
      "text": "让对方选其中一个"
    },
    {
      "sid": "S00291",
      "start": 402.42,
      "end": 403.88,
      "text": "而不是反复的问他"
    },
    {
      "sid": "S00292",
      "start": 403.88,
      "end": 404.78,
      "text": "你想怎么样"
    },
    {
      "sid": "S00293",
      "start": 404.78,
      "end": 405.7,
      "text": "你想吃什么"
    },
    {
      "sid": "S00294",
      "start": 405.7,
      "end": 406.68,
      "text": "那么在生活中呢"
    },
    {
      "sid": "S00295",
      "start": 406.68,
      "end": 407.54,
      "text": "主动做决定"
    },
    {
      "sid": "S00296",
      "start": 407.54,
      "end": 408.88,
      "text": "小到穿什么衣服"
    },
    {
      "sid": "S00297",
      "start": 408.88,
      "end": 410.34,
      "text": "大到要不要换份工作"
    },
    {
      "sid": "S00298",
      "start": 410.34,
      "end": 411.46,
      "text": "要不要出手搭讪"
    },
    {
      "sid": "S00299",
      "start": 411.46,
      "end": 413.26,
      "text": "不要再小心翼翼的维护"
    },
    {
      "sid": "S00300",
      "start": 413.26,
      "end": 415.26,
      "text": "那个第三人称下的你"
    },
    {
      "sid": "S00301",
      "start": 415.26,
      "end": 417.36,
      "text": "而是拥抱这个第一人称的我"
    },
    {
      "sid": "S00302",
      "start": 417.36,
      "end": 419.04,
      "text": "我们的人生是自己决定的"
    },
    {
      "sid": "S00303",
      "start": 419.04,
      "end": 420.0,
      "text": "你不是NPC"
    },
    {
      "sid": "S00304",
      "start": 420.0,
      "end": 421.36,
      "text": "你是一个玩家"
    },
    {
      "sid": "S00305",
      "start": 421.36,
      "end": 422.34,
      "text": "因为你是主角"
    },
    {
      "sid": "S00306",
      "start": 422.34,
      "end": 423.94,
      "text": "你永远看不到自己的背后"
    },
    {
      "sid": "S00307",
      "start": 423.94,
      "end": 425.9,
      "text": "你看到的一切都是第一人称视角"
    },
    {
      "sid": "S00308",
      "start": 425.9,
      "end": 426.84,
      "text": "所看到的"
    },
    {
      "sid": "S00309",
      "start": 426.84,
      "end": 436.08,
      "text": "用行为塑造思维"
    },
    {
      "sid": "S00310",
      "start": 436.08,
      "end": 437.08,
      "text": "很多兄弟会说"
    },
    {
      "sid": "S00311",
      "start": 437.08,
      "end": 437.4,
      "text": "Mike"
    },
    {
      "sid": "S00312",
      "start": 437.4,
      "end": 438.5,
      "text": "道理我都懂"
    },
    {
      "sid": "S00313",
      "start": 438.5,
      "end": 439.26,
      "text": "我的内心呢"
    },
    {
      "sid": "S00314",
      "start": 439.26,
      "end": 440.06,
      "text": "就是没有勇气"
    },
    {
      "sid": "S00315",
      "start": 440.06,
      "end": 441.08,
      "text": "我就是不敢"
    },
    {
      "sid": "S00316",
      "start": 441.08,
      "end": 441.82,
      "text": "我告诉你"
    },
    {
      "sid": "S00317",
      "start": 441.82,
      "end": 442.7,
      "text": "你可以先装"
    },
    {
      "sid": "S00318",
      "start": 442.7,
      "end": 444.8,
      "text": "装到你真正成为的那样的人"
    },
    {
      "sid": "S00319",
      "start": 444.8,
      "end": 445.68,
      "text": "没有人是"
    },
    {
      "sid": "S00320",
      "start": 445.68,
      "end": 447.8,
      "text": "我知道一个概念我就能成为那样的人"
    },
    {
      "sid": "S00321",
      "start": 447.8,
      "end": 449.3,
      "text": "都是从模仿开始"
    },
    {
      "sid": "S00322",
      "start": 449.3,
      "end": 450.96,
      "text": "就像我们小时候不会走路"
    },
    {
      "sid": "S00323",
      "start": 450.96,
      "end": 452.18,
      "text": "我们是不是模仿大人"
    },
    {
      "sid": "S00324",
      "start": 452.18,
      "end": 453.38,
      "text": "从爬到走"
    },
    {
      "sid": "S00325",
      "start": 453.38,
      "end": 454.5,
      "text": "你不敢直视他"
    },
    {
      "sid": "S00326",
      "start": 454.5,
      "end": 455.88,
      "text": "你可以先强迫自己"
    },
    {
      "sid": "S00327",
      "start": 455.88,
      "end": 456.58,
      "text": "搭讪的时候"
    },
    {
      "sid": "S00328",
      "start": 456.58,
      "end": 458.1,
      "text": "看对方的眼睛三秒"
    },
    {
      "sid": "S00329",
      "start": 458.1,
      "end": 459.7,
      "text": "你不敢表达自己的观点"
    },
    {
      "sid": "S00330",
      "start": 459.7,
      "end": 460.28,
      "text": "没关系"
    },
    {
      "sid": "S00331",
      "start": 460.28,
      "end": 461.84,
      "text": "你可以在评论区打出"
    },
    {
      "sid": "S00332",
      "start": 461.84,
      "end": 463.36,
      "text": "我觉得Mikey说的对"
    },
    {
      "sid": "S00333",
      "start": 463.36,
      "end": 464.52,
      "text": "你不敢推拉女生"
    },
    {
      "sid": "S00334",
      "start": 464.52,
      "end": 466.68,
      "text": "你可以先给不回你的女生扣问号"
    },
    {
      "sid": "S00335",
      "start": 466.68,
      "end": 467.98,
      "text": "给迟到的女生说"
    },
    {
      "sid": "S00336",
      "start": 467.98,
      "end": 469.18,
      "text": "你这样不太礼貌"
    },
    {
      "sid": "S00337",
      "start": 469.18,
      "end": 470.46,
      "text": "华尔街智囊里"
    },
    {
      "sid": "S00338",
      "start": 470.46,
      "end": 472.2,
      "text": "小李子饰演的乔丹"
    },
    {
      "sid": "S00339",
      "start": 472.2,
      "end": 474.28,
      "text": "一开始并不是真正的股票大师"
    },
    {
      "sid": "S00340",
      "start": 474.28,
      "end": 475.76,
      "text": "他从模仿开始"
    },
    {
      "sid": "S00341",
      "start": 475.76,
      "end": 476.72,
      "text": "讲话的口吻"
    },
    {
      "sid": "S00342",
      "start": 476.72,
      "end": 477.56,
      "text": "行为举止"
    },
    {
      "sid": "S00343",
      "start": 477.56,
      "end": 478.14,
      "text": "穿搭"
    },
    {
      "sid": "S00344",
      "start": 478.14,
      "end": 480.76,
      "text": "直到他真正的赚到了自己的第一桶金"
    },
    {
      "sid": "S00345",
      "start": 480.76,
      "end": 481.48,
      "text": "慢慢的"
    },
    {
      "sid": "S00346",
      "start": 481.48,
      "end": 484.04,
      "text": "他也拥有了真正的股票大师的思维"
    },
    {
      "sid": "S00347",
      "start": 484.04,
      "end": 484.76,
      "text": "财富"
    },
    {
      "sid": "S00348",
      "start": 484.76,
      "end": 486.86,
      "text": "不是每个人都拥有高启强那样"
    },
    {
      "sid": "S00349",
      "start": 486.86,
      "end": 489.12,
      "text": "被生活逼着转变的契机"
    },
    {
      "sid": "S00350",
      "start": 489.12,
      "end": 491.72,
      "text": "因为这并不是你死我活的博弈"
    },
    {
      "sid": "S00351",
      "start": 491.72,
      "end": 493.86,
      "text": "而是你蜕变的第一个保护色"
    },
    {
      "sid": "S00352",
      "start": 493.86,
      "end": 496.0,
      "text": "行为可以反向塑造你的心态"
    },
    {
      "sid": "S00353",
      "start": 496.0,
      "end": 497.26,
      "text": "你先是装的自信"
    },
    {
      "sid": "S00354",
      "start": 497.26,
      "end": 499.78,
      "text": "慢慢的你就会真的开始自信起来"
    },
    {
      "sid": "S00355",
      "start": 499.78,
      "end": 500.8,
      "text": "你装的有框架"
    },
    {
      "sid": "S00356",
      "start": 500.8,
      "end": 502.92,
      "text": "慢慢的你就会真的有框架"
    },
    {
      "sid": "S00357",
      "start": 502.92,
      "end": 505.38,
      "text": "人本身就是靠学习不断成长的"
    },
    {
      "sid": "S00358",
      "start": 505.38,
      "end": 506.74,
      "text": "人本身就是动物"
    },
    {
      "sid": "S00359",
      "start": 506.74,
      "end": 508.66,
      "text": "动物就是靠模仿慢慢的变强"
    },
    {
      "sid": "S00360",
      "start": 508.66,
      "end": 511.3,
      "text": "这就像是唯心论和唯物论的相互作用"
    },
    {
      "sid": "S00361",
      "start": 511.3,
      "end": 512.7,
      "text": "意识作用于物质"
    },
    {
      "sid": "S00362",
      "start": 512.7,
      "end": 515.42,
      "text": "而物质又反过来作用于意识"
    },
    {
      "sid": "S00363",
      "start": 515.42,
      "end": 516.88,
      "text": "最后持续实践"
    },
    {
      "sid": "S00364",
      "start": 516.88,
      "end": 518.72,
      "text": "形成真正的习惯"
    },
    {
      "sid": "S00365",
      "start": 518.72,
      "end": 519.9,
      "text": "建立真正的自我"
    },
    {
      "sid": "S00366",
      "start": 519.9,
      "end": 521.78,
      "text": "不是看了一个视频就能解决的"
    },
    {
      "sid": "S00367",
      "start": 521.78,
      "end": 522.86,
      "text": "你需要每天练习"
    },
    {
      "sid": "S00368",
      "start": 522.86,
      "end": 523.96,
      "text": "持续行动"
    },
    {
      "sid": "S00369",
      "start": 523.96,
      "end": 525.96,
      "text": "我知道很多兄弟们看完了上期视频"
    },
    {
      "sid": "S00370",
      "start": 525.96,
      "end": 527.6,
      "text": "会感觉到自己充满能量"
    },
    {
      "sid": "S00371",
      "start": 527.6,
      "end": 528.92,
      "text": "觉得自己打了鸡血"
    },
    {
      "sid": "S00372",
      "start": 528.92,
      "end": 530.82,
      "text": "但真正的方法论从来不是"
    },
    {
      "sid": "S00373",
      "start": 530.82,
      "end": 531.88,
      "text": "无内高潮"
    },
    {
      "sid": "S00374",
      "start": 531.88,
      "end": 534.14,
      "text": "而是你现在就去做并坚持"
    },
    {
      "sid": "S00375",
      "start": 534.14,
      "end": 536.6,
      "text": "那么种一棵树最好的时间是十年前"
    },
    {
      "sid": "S00376",
      "start": 536.6,
      "end": 538.14,
      "text": "其次就是现在"
    },
    {
      "sid": "S00377",
      "start": 538.14,
      "end": 540.12,
      "text": "Mikey在这里给兄弟们一个挑战"
    },
    {
      "sid": "S00378",
      "start": 540.12,
      "end": 541.02,
      "text": "从今天开始"
    },
    {
      "sid": "S00379",
      "start": 541.02,
      "end": 542.42,
      "text": "每天做一件"
    },
    {
      "sid": "S00380",
      "start": 542.42,
      "end": 544.32,
      "text": "只为我自己而做的事情"
    },
    {
      "sid": "S00381",
      "start": 544.32,
      "end": 547.02,
      "text": "每天拒绝一个不合理的请求"
    },
    {
      "sid": "S00382",
      "start": 547.02,
      "end": 549.06,
      "text": "每天主动提出一个选择"
    },
    {
      "sid": "S00383",
      "start": 549.06,
      "end": 550.26,
      "text": "每天装逼一次"
    },
    {
      "sid": "S00384",
      "start": 550.26,
      "end": 551.76,
      "text": "哪怕只是装的很自信"
    },
    {
      "sid": "S00385",
      "start": 551.76,
      "end": 552.4,
      "text": "没关系"
    },
    {
      "sid": "S00386",
      "start": 552.4,
      "end": 553.64,
      "text": "你坚持21天"
    },
    {
      "sid": "S00387",
      "start": 553.64,
      "end": 554.8,
      "text": "21天后呢"
    },
    {
      "sid": "S00388",
      "start": 554.8,
      "end": 556.08,
      "text": "你再回来看这个视频"
    },
    {
      "sid": "S00389",
      "start": 556.08,
      "end": 558.22,
      "text": "我相信你会在评论区里面感谢我"
    },
    {
      "sid": "S00390",
      "start": 558.22,
      "end": 558.74,
      "text": "兄弟们"
    },
    {
      "sid": "S00391",
      "start": 558.74,
      "end": 560.2,
      "text": "你的人生是你自己的"
    },
    {
      "sid": "S00392",
      "start": 560.2,
      "end": 562.08,
      "text": "你不是任何人剧本里的配角"
    },
    {
      "sid": "S00393",
      "start": 562.08,
      "end": 563.62,
      "text": "你有权利说我想要"
    },
    {
      "sid": "S00394",
      "start": 563.62,
      "end": 565.26,
      "text": "你有权利说我不喜欢"
    },
    {
      "sid": "S00395",
      "start": 565.26,
      "end": 566.58,
      "text": "你有权利选择"
    },
    {
      "sid": "S00396",
      "start": 566.58,
      "end": 567.7,
      "text": "我要干嘛"
    },
    {
      "sid": "S00397",
      "start": 567.7,
      "end": 569.8,
      "text": "你值得拥有这世间的一切美好"
    },
    {
      "sid": "S00398",
      "start": 569.8,
      "end": 571.12,
      "text": "你值得被尊重"
    },
    {
      "sid": "S00399",
      "start": 571.12,
      "end": 571.88,
      "text": "我是Mikey"
    },
    {
      "sid": "S00400",
      "start": 571.88,
      "end": 573.44,
      "text": "我们下一期再见"
    },
    {
      "sid": "S00401",
      "start": 612.24,
      "end": 616.0,
      "text": "included bad everything just just show me who you are for once"
    },
    {
      "sid": "S00402",
      "start": 616.0,
      "end": 619.38,
      "text": "i've been nothing but myself since the dad was born"
    },
    {
      "sid": "S00403",
      "start": 619.38,
      "end": 622.0,
      "text": "and if you can't see that it's your feeling"
    },
    {
      "sid": "S00404",
      "start": 622.0,
      "end": 623.22,
      "text": "not mine"
    },
    {
      "sid": "S00405",
      "start": 624.1,
      "end": 625.68,
      "text": "you know my father used to say"
    },
    {
      "sid": "S00406",
      "start": 626.68,
      "end": 628.94,
      "text": "whatever you do do it a hundred percent"
    },
    {
      "sid": "S00407",
      "start": 629.52,
      "end": 631.98,
      "text": "when you work work when you laugh laugh"
    },
    {
      "sid": "S00408",
      "start": 632.42,
      "end": 634.96,
      "text": "when you eat eat like it's you last meet"
    },
    {
      "sid": "S00409",
      "start": 634.96,
      "end": 640.42,
      "text": "easy doesn't end"
    },
    {
      "sid": "S00410",
      "start": 640.42,
      "end": 644.05,
      "text": "that's a tough opponent"
    },
    {
      "sid": "S00411",
      "start": 644.05,
      "end": 651.38,
      "text": "don't believe that in life"
    },
    {
      "sid": "S00412",
      "start": 651.38,
      "end": 651.88,
      "text": "OK"
    },
    {
      "sid": "S00413",
      "start": 651.88,
      "end": 654.38,
      "text": "The world ain't all sunshine and rainbows"
    },
    {
      "sid": "S00414",
      "start": 654.38,
      "end": 657.14,
      "text": "It's a very mean and nasty place"
    },
    {
      "sid": "S00415",
      "start": 657.14,
      "end": 658.68,
      "text": "And I don't care how tough you are"
    },
    {
      "sid": "S00416",
      "start": 658.68,
      "end": 660.62,
      "text": "It will beat you to your knees"
    },
    {
      "sid": "S00417",
      "start": 660.62,
      "end": 662.54,
      "text": "And keep you there permanently if you let it"
    },
    {
      "sid": "S00418",
      "start": 662.54,
      "end": 664.6,
      "text": "But you gotta be willing to take the hits"
    },
    {
      "sid": "S00419",
      "start": 664.6,
      "end": 666.36,
      "text": "And not pointing fingers saying"
    },
    {
      "sid": "S00420",
      "start": 666.36,
      "end": 667.56,
      "text": "You ain't where you want to be"
    },
    {
      "sid": "S00421",
      "start": 667.56,
      "end": 669.74,
      "text": "Because of him or her or anybody"
    },
    {
      "sid": "S00422",
      "start": 669.74,
      "end": 672.26,
      "text": "Cowards do that and that ain't you"
    },
    {
      "sid": "S00423",
      "start": 672.26,
      "end": 673.9,
      "text": "You're better than that"
    }
  ]
}
