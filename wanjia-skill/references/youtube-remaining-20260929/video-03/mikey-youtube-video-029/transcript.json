{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-029",
  "youtube_id": "Nk8m70zAZAk",
  "media_sha256": "c91be2e80f61dc36651c22db06b88eef9353416083b3cc0052a8bf7929cf8bdc",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.14,
      "end": 0.7,
      "text": "哎"
    },
    {
      "sid": "S00002",
      "start": 0.7,
      "end": 1.42,
      "text": "你"
    },
    {
      "sid": "S00003",
      "start": 1.42,
      "end": 2.18,
      "text": "没错"
    },
    {
      "sid": "S00004",
      "start": 2.18,
      "end": 3.08,
      "text": "就是你"
    },
    {
      "sid": "S00005",
      "start": 3.08,
      "end": 5.32,
      "text": "我看到你的头上"
    },
    {
      "sid": "S00006",
      "start": 5.32,
      "end": 6.36,
      "text": "正在顶着一个"
    },
    {
      "sid": "S00007",
      "start": 6.36,
      "end": 8.36,
      "text": "大大的感叹号"
    },
    {
      "sid": "S00008",
      "start": 8.36,
      "end": 10.02,
      "text": "也许你自己看不到"
    },
    {
      "sid": "S00009",
      "start": 10.02,
      "end": 11.28,
      "text": "但是我看到了"
    },
    {
      "sid": "S00010",
      "start": 11.28,
      "end": 13.56,
      "text": "在大部分游戏里面呢"
    },
    {
      "sid": "S00011",
      "start": 13.56,
      "end": 14.86,
      "text": "这个感叹号的含义"
    },
    {
      "sid": "S00012",
      "start": 14.86,
      "end": 17.04,
      "text": "代表着你是一个NPC"
    },
    {
      "sid": "S00013",
      "start": 17.04,
      "end": 25.34,
      "text": "当你还在执行着既定的程序"
    },
    {
      "sid": "S00014",
      "start": 25.34,
      "end": 27.94,
      "text": "揣摩着编写好的对话"
    },
    {
      "sid": "S00015",
      "start": 27.94,
      "end": 30.14,
      "text": "小心翼翼着打量路过的"
    },
    {
      "sid": "S00016",
      "start": 30.14,
      "end": 31.82,
      "text": "性感女NPC时"
    },
    {
      "sid": "S00017",
      "start": 31.82,
      "end": 34.36,
      "text": "这是一个人从天而降"
    },
    {
      "sid": "S00018",
      "start": 34.36,
      "end": 35.98,
      "text": "你发现这个人呢"
    },
    {
      "sid": "S00019",
      "start": 35.98,
      "end": 38.04,
      "text": "他居然不受规则的约束"
    },
    {
      "sid": "S00020",
      "start": 38.04,
      "end": 39.8,
      "text": "肆无忌惮地就上去"
    },
    {
      "sid": "S00021",
      "start": 39.8,
      "end": 41.06,
      "text": "跟这个女生讲话了"
    },
    {
      "sid": "S00022",
      "start": 41.06,
      "end": 42.62,
      "text": "用你没有见过的方式"
    },
    {
      "sid": "S00023",
      "start": 42.62,
      "end": 44.34,
      "text": "把这个女NPC给带走了"
    },
    {
      "sid": "S00024",
      "start": 44.34,
      "end": 45.9,
      "text": "你摇了摇头"
    },
    {
      "sid": "S00025",
      "start": 45.9,
      "end": 47.3,
      "text": "你安慰自己"
    },
    {
      "sid": "S00026",
      "start": 47.3,
      "end": 49.04,
      "text": "兴许是我眼花了"
    },
    {
      "sid": "S00027",
      "start": 49.04,
      "end": 50.6,
      "text": "这样的人应该不多"
    },
    {
      "sid": "S00028",
      "start": 50.6,
      "end": 52.38,
      "text": "那么这种从天而降的人"
    },
    {
      "sid": "S00029",
      "start": 52.38,
      "end": 54.02,
      "text": "到底是何方神圣呢"
    },
    {
      "sid": "S00030",
      "start": 54.02,
      "end": 55.74,
      "text": "在大多数游戏里"
    },
    {
      "sid": "S00031",
      "start": 55.74,
      "end": 58.14,
      "text": "我们把这种人称作为玩家"
    },
    {
      "sid": "S00032",
      "start": 58.14,
      "end": 66.78,
      "text": "哈喽大家好"
    },
    {
      "sid": "S00033",
      "start": 66.78,
      "end": 67.64,
      "text": "我是麦克"
    },
    {
      "sid": "S00034",
      "start": 67.64,
      "end": 70.96,
      "text": "有兄弟们好奇我频道名字的由来"
    },
    {
      "sid": "S00035",
      "start": 70.96,
      "end": 72.72,
      "text": "在之前的直播里呢"
    },
    {
      "sid": "S00036",
      "start": 72.72,
      "end": 74.36,
      "text": "我有浅浅地讲过一下"
    },
    {
      "sid": "S00037",
      "start": 74.36,
      "end": 75.66,
      "text": "那么搭讪"
    },
    {
      "sid": "S00038",
      "start": 75.66,
      "end": 78.86,
      "text": "代表着我game的行为和性质"
    },
    {
      "sid": "S00039",
      "start": 78.86,
      "end": 80.82,
      "text": "搭讪它象征着一种自由"
    },
    {
      "sid": "S00040",
      "start": 80.82,
      "end": 82.64,
      "text": "它能让我们深刻地感知到"
    },
    {
      "sid": "S00041",
      "start": 82.64,
      "end": 85.08,
      "text": "我们和这个世界是有链接的"
    },
    {
      "sid": "S00042",
      "start": 85.08,
      "end": 86.4,
      "text": "是真实存在的"
    },
    {
      "sid": "S00043",
      "start": 86.4,
      "end": 87.48,
      "text": "搭讪这个行为呢"
    },
    {
      "sid": "S00044",
      "start": 87.48,
      "end": 88.98,
      "text": "它超越了一切规则"
    },
    {
      "sid": "S00045",
      "start": 88.98,
      "end": 90.08,
      "text": "圈子"
    },
    {
      "sid": "S00046",
      "start": 90.08,
      "end": 91.66,
      "text": "而玩家呢"
    },
    {
      "sid": "S00047",
      "start": 91.66,
      "end": 94.4,
      "text": "则代表着我game的心态"
    },
    {
      "sid": "S00048",
      "start": 94.4,
      "end": 96.7,
      "text": "那么今天我就给兄弟们讲一讲"
    },
    {
      "sid": "S00049",
      "start": 96.7,
      "end": 98.1,
      "text": "到底什么是"
    },
    {
      "sid": "S00050",
      "start": 98.1,
      "end": 99.4,
      "text": "玩家心态"
    },
    {
      "sid": "S00051",
      "start": 99.4,
      "end": 113.67,
      "text": "那么从出生开始"
    },
    {
      "sid": "S00052",
      "start": 113.67,
      "end": 116.61,
      "text": "我们每个人都保持着对世界的好奇心"
    },
    {
      "sid": "S00053",
      "start": 116.61,
      "end": 118.39,
      "text": "我们看到没见过的东西呢"
    },
    {
      "sid": "S00054",
      "start": 118.39,
      "end": 120.31,
      "text": "你会目目转睛地盯着"
    },
    {
      "sid": "S00055",
      "start": 120.31,
      "end": 122.29,
      "text": "看到奇怪的东西呢"
    },
    {
      "sid": "S00056",
      "start": 122.29,
      "end": 123.37,
      "text": "你会想要触摸"
    },
    {
      "sid": "S00057",
      "start": 123.37,
      "end": 124.85,
      "text": "我们用我们的六感"
    },
    {
      "sid": "S00058",
      "start": 124.85,
      "end": 126.19,
      "text": "去感知这个世界"
    },
    {
      "sid": "S00059",
      "start": 126.19,
      "end": 129.21,
      "text": "我们像是一个有着原始本名的海藻"
    },
    {
      "sid": "S00060",
      "start": 129.21,
      "end": 131.49,
      "text": "无序地在这个世界里遨游"
    },
    {
      "sid": "S00061",
      "start": 131.49,
      "end": 132.87,
      "text": "但在这个过程中呢"
    },
    {
      "sid": "S00062",
      "start": 132.87,
      "end": 136.25,
      "text": "我们也难免会触碰到一些底层代码"
    },
    {
      "sid": "S00063",
      "start": 136.25,
      "end": 138.03,
      "text": "也就是所谓的规训"
    },
    {
      "sid": "S00064",
      "start": 138.03,
      "end": 139.55,
      "text": "那么大部分的规训呢"
    },
    {
      "sid": "S00065",
      "start": 139.55,
      "end": 140.49,
      "text": "都是善意的"
    },
    {
      "sid": "S00066",
      "start": 140.49,
      "end": 142.35,
      "text": "我们原始人看了毒蛇"
    },
    {
      "sid": "S00067",
      "start": 142.35,
      "end": 144.53,
      "text": "部落的长辈会教导我们"
    },
    {
      "sid": "S00068",
      "start": 144.53,
      "end": 145.67,
      "text": "这个东西不要碰"
    },
    {
      "sid": "S00069",
      "start": 145.67,
      "end": 147.15,
      "text": "父母老师呢"
    },
    {
      "sid": "S00070",
      "start": 147.15,
      "end": 147.95,
      "text": "也会教导我们"
    },
    {
      "sid": "S00071",
      "start": 147.95,
      "end": 148.79,
      "text": "我们要孝顺"
    },
    {
      "sid": "S00072",
      "start": 148.79,
      "end": 150.25,
      "text": "我们对人呢"
    },
    {
      "sid": "S00073",
      "start": 150.25,
      "end": 150.79,
      "text": "要友善"
    },
    {
      "sid": "S00074",
      "start": 150.79,
      "end": 153.33,
      "text": "那么现代文明诞生之后呢"
    },
    {
      "sid": "S00075",
      "start": 153.33,
      "end": 154.73,
      "text": "越来越多的规训"
    },
    {
      "sid": "S00076",
      "start": 154.73,
      "end": 156.91,
      "text": "被写进了底层代码"
    },
    {
      "sid": "S00077",
      "start": 156.91,
      "end": 158.25,
      "text": "我们应该怎么学习"
    },
    {
      "sid": "S00078",
      "start": 158.25,
      "end": 159.79,
      "text": "我们应该怎么谈恋爱"
    },
    {
      "sid": "S00079",
      "start": 159.79,
      "end": 161.45,
      "text": "但规训呢"
    },
    {
      "sid": "S00080",
      "start": 161.45,
      "end": 162.81,
      "text": "他同时又一把双人键"
    },
    {
      "sid": "S00081",
      "start": 162.81,
      "end": 164.11,
      "text": "你要对女人好"
    },
    {
      "sid": "S00082",
      "start": 164.11,
      "end": 165.17,
      "text": "你不能早恋"
    },
    {
      "sid": "S00083",
      "start": 165.17,
      "end": 168.37,
      "text": "你必须压制住自己的欲望和情绪"
    },
    {
      "sid": "S00084",
      "start": 168.37,
      "end": 169.89,
      "text": "你不能太张扬"
    },
    {
      "sid": "S00085",
      "start": 169.89,
      "end": 171.15,
      "text": "你不可以愤怒"
    },
    {
      "sid": "S00086",
      "start": 171.15,
      "end": 172.59,
      "text": "你甚至都不可以哭"
    },
    {
      "sid": "S00087",
      "start": 172.59,
      "end": 175.01,
      "text": "搭训这个行为是不对的"
    },
    {
      "sid": "S00088",
      "start": 175.01,
      "end": 176.63,
      "text": "等等等等等等"
    },
    {
      "sid": "S00089",
      "start": 176.63,
      "end": 178.13,
      "text": "甚至你都不能自信"
    },
    {
      "sid": "S00090",
      "start": 178.13,
      "end": 179.43,
      "text": "如果你自信"
    },
    {
      "sid": "S00091",
      "start": 179.43,
      "end": 181.03,
      "text": "你又是一个普通人"
    },
    {
      "sid": "S00092",
      "start": 181.03,
      "end": 182.81,
      "text": "那我可要骂你普信哦"
    },
    {
      "sid": "S00093",
      "start": 182.81,
      "end": 185.23,
      "text": "渐渐的你这颗蓝藻呢"
    },
    {
      "sid": "S00094",
      "start": 185.23,
      "end": 185.93,
      "text": "进化了"
    },
    {
      "sid": "S00095",
      "start": 185.93,
      "end": 187.27,
      "text": "你上岸了"
    },
    {
      "sid": "S00096",
      "start": 187.27,
      "end": 190.21,
      "text": "你变成了一个大脑里塞满了各种教条"
    },
    {
      "sid": "S00097",
      "start": 190.21,
      "end": 190.89,
      "text": "规训"
    },
    {
      "sid": "S00098",
      "start": 190.89,
      "end": 192.55,
      "text": "用两条腿走路的人"
    },
    {
      "sid": "S00099",
      "start": 192.55,
      "end": 194.73,
      "text": "你在不知不觉中呢"
    },
    {
      "sid": "S00100",
      "start": 194.73,
      "end": 197.55,
      "text": "一个感叹号从你头上冒了出来"
    },
    {
      "sid": "S00101",
      "start": 197.55,
      "end": 200.03,
      "text": "你变成了一个NPC"
    },
    {
      "sid": "S00102",
      "start": 200.03,
      "end": 208.66,
      "text": "小时候我接触到了一个游戏"
    },
    {
      "sid": "S00103",
      "start": 208.66,
      "end": 209.78,
      "text": "叫Minecraft"
    },
    {
      "sid": "S00104",
      "start": 209.78,
      "end": 211.06,
      "text": "我的世界"
    },
    {
      "sid": "S00105",
      "start": 211.06,
      "end": 213.96,
      "text": "我惊讶于游戏可以这么的自由"
    },
    {
      "sid": "S00106",
      "start": 213.96,
      "end": 216.44,
      "text": "我慢慢的去了解了这个游戏的玩法"
    },
    {
      "sid": "S00107",
      "start": 216.44,
      "end": 217.4,
      "text": "采集"
    },
    {
      "sid": "S00108",
      "start": 217.4,
      "end": 218.16,
      "text": "建造"
    },
    {
      "sid": "S00109",
      "start": 218.16,
      "end": 220.18,
      "text": "那么为了生存呢"
    },
    {
      "sid": "S00110",
      "start": 220.18,
      "end": 221.68,
      "text": "我打造了更好的装备"
    },
    {
      "sid": "S00111",
      "start": 221.68,
      "end": 224.04,
      "text": "我击败了一个又一个的敌人"
    },
    {
      "sid": "S00112",
      "start": 224.04,
      "end": 225.56,
      "text": "我开始查攻略"
    },
    {
      "sid": "S00113",
      "start": 225.56,
      "end": 227.3,
      "text": "玩到某一个节点的时候呢"
    },
    {
      "sid": "S00114",
      "start": 227.3,
      "end": 229.34,
      "text": "我突然从兴奋变成了麻木"
    },
    {
      "sid": "S00115",
      "start": 229.34,
      "end": 230.06,
      "text": "渐渐的"
    },
    {
      "sid": "S00116",
      "start": 230.06,
      "end": 231.5,
      "text": "我开始有一种无力感"
    },
    {
      "sid": "S00117",
      "start": 231.5,
      "end": 233.28,
      "text": "我觉得我好像在上班"
    },
    {
      "sid": "S00118",
      "start": 233.28,
      "end": 234.68,
      "text": "我开始意识到不对劲"
    },
    {
      "sid": "S00119",
      "start": 234.68,
      "end": 236.16,
      "text": "但我又说不上来"
    },
    {
      "sid": "S00120",
      "start": 236.16,
      "end": 238.02,
      "text": "直到有一天呢"
    },
    {
      "sid": "S00121",
      "start": 238.02,
      "end": 239.84,
      "text": "我突然抛弃掉"
    },
    {
      "sid": "S00122",
      "start": 239.84,
      "end": 241.28,
      "text": "我应该怎么样"
    },
    {
      "sid": "S00123",
      "start": 241.28,
      "end": 242.44,
      "text": "这个念头"
    },
    {
      "sid": "S00124",
      "start": 242.44,
      "end": 243.86,
      "text": "我第一次试着去"
    },
    {
      "sid": "S00125",
      "start": 243.86,
      "end": 245.14,
      "text": "我想怎么样"
    },
    {
      "sid": "S00126",
      "start": 245.14,
      "end": 247.96,
      "text": "于是我建造出了一个非常奇怪的建筑"
    },
    {
      "sid": "S00127",
      "start": 247.96,
      "end": 249.68,
      "text": "我站在屋顶"
    },
    {
      "sid": "S00128",
      "start": 249.68,
      "end": 250.86,
      "text": "眺望着远处"
    },
    {
      "sid": "S00129",
      "start": 250.86,
      "end": 252.36,
      "text": "我非常开心"
    },
    {
      "sid": "S00130",
      "start": 252.36,
      "end": 254.62,
      "text": "原来这才是我玩这个游戏的初衷"
    },
    {
      "sid": "S00131",
      "start": 254.62,
      "end": 256.0,
      "text": "我是一个玩家"
    },
    {
      "sid": "S00132",
      "start": 256.0,
      "end": 257.22,
      "text": "这种无力感"
    },
    {
      "sid": "S00133",
      "start": 257.22,
      "end": 258.5,
      "text": "你们觉得熟悉吗"
    },
    {
      "sid": "S00134",
      "start": 258.5,
      "end": 260.86,
      "text": "我们社会规则总是会告诉我们"
    },
    {
      "sid": "S00135",
      "start": 260.86,
      "end": 261.82,
      "text": "我们应该怎么样"
    },
    {
      "sid": "S00136",
      "start": 261.82,
      "end": 263.12,
      "text": "我们应该怎么去学习"
    },
    {
      "sid": "S00137",
      "start": 263.12,
      "end": 264.08,
      "text": "我们应该怎么做"
    },
    {
      "sid": "S00138",
      "start": 264.08,
      "end": 265.78,
      "text": "我们应该怎么样去工作"
    },
    {
      "sid": "S00139",
      "start": 265.78,
      "end": 267.42,
      "text": "我们应该怎么样和女人说话"
    },
    {
      "sid": "S00140",
      "start": 267.42,
      "end": 268.56,
      "text": "和女人相处"
    },
    {
      "sid": "S00141",
      "start": 268.56,
      "end": 270.02,
      "text": "有个兄弟加了我之后"
    },
    {
      "sid": "S00142",
      "start": 270.02,
      "end": 272.12,
      "text": "给我发了他和女人的聊天记录"
    },
    {
      "sid": "S00143",
      "start": 272.12,
      "end": 273.84,
      "text": "他跟我大吐苦水"
    },
    {
      "sid": "S00144",
      "start": 273.84,
      "end": 275.8,
      "text": "跟我说这个女人太高冷了"
    },
    {
      "sid": "S00145",
      "start": 275.8,
      "end": 276.38,
      "text": "不理他"
    },
    {
      "sid": "S00146",
      "start": 276.38,
      "end": 277.8,
      "text": "那么我看了一下聊天记录"
    },
    {
      "sid": "S00147",
      "start": 277.8,
      "end": 279.42,
      "text": "这个女人给他敲了一个问号"
    },
    {
      "sid": "S00148",
      "start": 279.42,
      "end": 282.94,
      "text": "他马上就着急忙慌的解释了一大堆"
    },
    {
      "sid": "S00149",
      "start": 282.94,
      "end": 284.66,
      "text": "然后这个女生回复了一个"
    },
    {
      "sid": "S00150",
      "start": 284.66,
      "end": 284.96,
      "text": "嗯"
    },
    {
      "sid": "S00151",
      "start": 284.96,
      "end": 286.86,
      "text": "我问他你为什么要解释这么多"
    },
    {
      "sid": "S00152",
      "start": 286.86,
      "end": 288.1,
      "text": "他说我也不想的"
    },
    {
      "sid": "S00153",
      "start": 288.1,
      "end": 289.46,
      "text": "当他正准备说的时候呢"
    },
    {
      "sid": "S00154",
      "start": 289.46,
      "end": 290.14,
      "text": "我打断了他"
    },
    {
      "sid": "S00155",
      "start": 290.14,
      "end": 291.32,
      "text": "我对他说啊"
    },
    {
      "sid": "S00156",
      "start": 291.32,
      "end": 291.62,
      "text": "对啊"
    },
    {
      "sid": "S00157",
      "start": 291.62,
      "end": 292.5,
      "text": "你也不想这样"
    },
    {
      "sid": "S00158",
      "start": 292.5,
      "end": 293.24,
      "text": "但是呢"
    },
    {
      "sid": "S00159",
      "start": 293.24,
      "end": 294.42,
      "text": "你觉得你应该这样"
    },
    {
      "sid": "S00160",
      "start": 294.42,
      "end": 296.32,
      "text": "我可以告诉你如何回复正确答案"
    },
    {
      "sid": "S00161",
      "start": 296.32,
      "end": 297.32,
      "text": "但是心态呢"
    },
    {
      "sid": "S00162",
      "start": 297.32,
      "end": 298.62,
      "text": "当他面对女人的时候呢"
    },
    {
      "sid": "S00163",
      "start": 298.62,
      "end": 301.2,
      "text": "他的大脑会自动的处于一种NPC模式"
    },
    {
      "sid": "S00164",
      "start": 301.2,
      "end": 302.94,
      "text": "面对女人的废物测试呢"
    },
    {
      "sid": "S00165",
      "start": 302.94,
      "end": 304.08,
      "text": "或者是无兴趣回应"
    },
    {
      "sid": "S00166",
      "start": 304.08,
      "end": 306.3,
      "text": "他只能检索出特定的回复"
    },
    {
      "sid": "S00167",
      "start": 306.3,
      "end": 308.46,
      "text": "他就像是游戏里的NPC一样"
    },
    {
      "sid": "S00168",
      "start": 308.46,
      "end": 310.22,
      "text": "永远机械的走路"
    },
    {
      "sid": "S00169",
      "start": 310.22,
      "end": 311.92,
      "text": "机械的说着同样的话"
    },
    {
      "sid": "S00170",
      "start": 311.92,
      "end": 314.12,
      "text": "机械的回答着重复的问题"
    },
    {
      "sid": "S00171",
      "start": 314.12,
      "end": 318.06,
      "text": "这也是大多数game中读者的一个常态"
    },
    {
      "sid": "S00172",
      "start": 318.06,
      "end": 319.18,
      "text": "为什么兄弟们会"
    },
    {
      "sid": "S00173",
      "start": 319.18,
      "end": 321.6,
      "text": "精一与我聊天约会时的那种"
    },
    {
      "sid": "S00174",
      "start": 321.6,
      "end": 322.72,
      "text": "没口套路"
    },
    {
      "sid": "S00175",
      "start": 322.72,
      "end": 323.44,
      "text": "放荡不羁"
    },
    {
      "sid": "S00176",
      "start": 323.44,
      "end": 325.2,
      "text": "永远有着意想不到的思路"
    },
    {
      "sid": "S00177",
      "start": 325.2,
      "end": 327.48,
      "text": "仿佛总是躲在女人的前面一样"
    },
    {
      "sid": "S00178",
      "start": 327.48,
      "end": 330.58,
      "text": "其实真相是因为我拥有一个玩家心态"
    },
    {
      "sid": "S00179",
      "start": 330.58,
      "end": 331.82,
      "text": "在我的世界里呢"
    },
    {
      "sid": "S00180",
      "start": 331.82,
      "end": 333.26,
      "text": "我把女人当成了NPC"
    },
    {
      "sid": "S00181",
      "start": 333.26,
      "end": 335.24,
      "text": "而拥有NPC心态的人呢"
    },
    {
      "sid": "S00182",
      "start": 335.24,
      "end": 337.12,
      "text": "会把女人当成主角"
    },
    {
      "sid": "S00183",
      "start": 337.12,
      "end": 338.68,
      "text": "这就是一个区别"
    },
    {
      "sid": "S00184",
      "start": 338.68,
      "end": 340.54,
      "text": "那么这个世界呢"
    },
    {
      "sid": "S00185",
      "start": 340.54,
      "end": 341.94,
      "text": "就是一个巨大的游戏"
    },
    {
      "sid": "S00186",
      "start": 341.94,
      "end": 342.88,
      "text": "这个游戏名呢"
    },
    {
      "sid": "S00187",
      "start": 342.88,
      "end": 343.74,
      "text": "叫地球online"
    },
    {
      "sid": "S00188",
      "start": 343.74,
      "end": 345.12,
      "text": "那么在这个游戏里呢"
    },
    {
      "sid": "S00189",
      "start": 345.12,
      "end": 345.9,
      "text": "只有三类人"
    },
    {
      "sid": "S00190",
      "start": 345.9,
      "end": 346.56,
      "text": "GM"
    },
    {
      "sid": "S00191",
      "start": 346.56,
      "end": 347.3,
      "text": "NPC"
    },
    {
      "sid": "S00192",
      "start": 347.3,
      "end": 347.96,
      "text": "玩家"
    },
    {
      "sid": "S00193",
      "start": 347.96,
      "end": 348.74,
      "text": "GM呢"
    },
    {
      "sid": "S00194",
      "start": 348.74,
      "end": 349.94,
      "text": "是这个游戏的设计者"
    },
    {
      "sid": "S00195",
      "start": 349.94,
      "end": 350.94,
      "text": "那么这一类人呢"
    },
    {
      "sid": "S00196",
      "start": 350.94,
      "end": 351.5,
      "text": "我们不了"
    },
    {
      "sid": "S00197",
      "start": 351.5,
      "end": 352.64,
      "text": "那剩下两种人"
    },
    {
      "sid": "S00198",
      "start": 352.64,
      "end": 353.74,
      "text": "你拥有什么样的心态"
    },
    {
      "sid": "S00199",
      "start": 353.74,
      "end": 354.5,
      "text": "直接决定了"
    },
    {
      "sid": "S00200",
      "start": 354.5,
      "end": 355.5,
      "text": "你以什么样的方式"
    },
    {
      "sid": "S00201",
      "start": 355.5,
      "end": 356.28,
      "text": "什么样的身份"
    },
    {
      "sid": "S00202",
      "start": 356.28,
      "end": 357.2,
      "text": "参与这场游戏"
    },
    {
      "sid": "S00203",
      "start": 357.2,
      "end": 359.56,
      "text": "我见过太多人陷入NPC心态了"
    },
    {
      "sid": "S00204",
      "start": 359.56,
      "end": 361.62,
      "text": "他们机械的重复的使用着"
    },
    {
      "sid": "S00205",
      "start": 361.62,
      "end": 362.82,
      "text": "相同的套路"
    },
    {
      "sid": "S00206",
      "start": 362.82,
      "end": 363.34,
      "text": "画术"
    },
    {
      "sid": "S00207",
      "start": 363.34,
      "end": 364.5,
      "text": "用复制贴贴"
    },
    {
      "sid": "S00208",
      "start": 364.5,
      "end": 365.72,
      "text": "来跟女人聊天"
    },
    {
      "sid": "S00209",
      "start": 365.72,
      "end": 366.84,
      "text": "甚至还有人"
    },
    {
      "sid": "S00210",
      "start": 366.84,
      "end": 368.0,
      "text": "直接干脆丢弃大脑"
    },
    {
      "sid": "S00211",
      "start": 368.0,
      "end": 369.4,
      "text": "用拆的GPT帮自己聊天"
    },
    {
      "sid": "S00212",
      "start": 369.4,
      "end": 370.54,
      "text": "他们在约会的时候呢"
    },
    {
      "sid": "S00213",
      "start": 370.54,
      "end": 372.0,
      "text": "会被导师的一些"
    },
    {
      "sid": "S00214",
      "start": 372.0,
      "end": 373.44,
      "text": "约会说的一些话"
    },
    {
      "sid": "S00215",
      "start": 373.44,
      "end": 375.06,
      "text": "把他们当成画术一样去使用"
    },
    {
      "sid": "S00216",
      "start": 375.06,
      "end": 376.3,
      "text": "他们不是在交流"
    },
    {
      "sid": "S00217",
      "start": 376.3,
      "end": 378.84,
      "text": "他们只是在实行代码"
    },
    {
      "sid": "S00218",
      "start": 378.84,
      "end": 380.2,
      "text": "就像游戏里的NPC一样"
    },
    {
      "sid": "S00219",
      "start": 380.2,
      "end": 382.04,
      "text": "永远就那么几套回复宫式"
    },
    {
      "sid": "S00220",
      "start": 382.04,
      "end": 383.2,
      "text": "女人感受到的"
    },
    {
      "sid": "S00221",
      "start": 383.2,
      "end": 384.7,
      "text": "并不是一个真实的人"
    },
    {
      "sid": "S00222",
      "start": 384.7,
      "end": 387.12,
      "text": "而是一个运行程序的机器人"
    },
    {
      "sid": "S00223",
      "start": 387.12,
      "end": 389.0,
      "text": "那么电影《楚门的世界》里呢"
    },
    {
      "sid": "S00224",
      "start": 389.0,
      "end": 390.22,
      "text": "《楚门的一生》"
    },
    {
      "sid": "S00225",
      "start": 390.22,
      "end": 392.42,
      "text": "都在生活在导演设定好的剧本里"
    },
    {
      "sid": "S00226",
      "start": 392.42,
      "end": 393.56,
      "text": "直到她开始怀疑"
    },
    {
      "sid": "S00227",
      "start": 393.56,
      "end": 394.74,
      "text": "为什么我的生活"
    },
    {
      "sid": "S00228",
      "start": 394.74,
      "end": 396.04,
      "text": "总是按部就班"
    },
    {
      "sid": "S00229",
      "start": 396.04,
      "end": 397.72,
      "text": "那么《头号玩家》里的韦德"
    },
    {
      "sid": "S00230",
      "start": 397.72,
      "end": 399.14,
      "text": "她为什么可以通关游戏"
    },
    {
      "sid": "S00231",
      "start": 399.14,
      "end": 400.12,
      "text": "因为她拒绝"
    },
    {
      "sid": "S00232",
      "start": 400.12,
      "end": 401.46,
      "text": "简单遵循游戏规则"
    },
    {
      "sid": "S00233",
      "start": 401.46,
      "end": 404.06,
      "text": "而是深入理解游戏背后的设计逻辑"
    },
    {
      "sid": "S00234",
      "start": 404.06,
      "end": 405.92,
      "text": "我为什么可以享受情感自由呢"
    },
    {
      "sid": "S00235",
      "start": 405.92,
      "end": 406.74,
      "text": "曾经的我呢"
    },
    {
      "sid": "S00236",
      "start": 406.74,
      "end": 408.42,
      "text": "也是一个标准的NPC"
    },
    {
      "sid": "S00237",
      "start": 408.42,
      "end": 410.06,
      "text": "当我第一次靠话术"
    },
    {
      "sid": "S00238",
      "start": 410.06,
      "end": 411.34,
      "text": "拔到一个妹子的时候"
    },
    {
      "sid": "S00239",
      "start": 411.34,
      "end": 412.94,
      "text": "我是非常开心的"
    },
    {
      "sid": "S00240",
      "start": 412.94,
      "end": 414.84,
      "text": "我就像在我的世界里"
    },
    {
      "sid": "S00241",
      "start": 414.84,
      "end": 416.7,
      "text": "第一次造出了一把钻石剑一样"
    },
    {
      "sid": "S00242",
      "start": 416.7,
      "end": 417.44,
      "text": "自鸣得意"
    },
    {
      "sid": "S00243",
      "start": 417.44,
      "end": 419.9,
      "text": "你们要说我有没有畏惧过改变"
    },
    {
      "sid": "S00244",
      "start": 419.9,
      "end": 420.8,
      "text": "我当然畏惧"
    },
    {
      "sid": "S00245",
      "start": 420.8,
      "end": 422.62,
      "text": "我畏惧过摆脱规则的束缚"
    },
    {
      "sid": "S00246",
      "start": 422.62,
      "end": 423.54,
      "text": "我也怀疑过"
    },
    {
      "sid": "S00247",
      "start": 423.54,
      "end": 424.76,
      "text": "这样真的可以吗"
    },
    {
      "sid": "S00248",
      "start": 424.76,
      "end": 425.82,
      "text": "我也在第一次"
    },
    {
      "sid": "S00249",
      "start": 425.82,
      "end": 428.04,
      "text": "由我想去认识这个女生的时候呢"
    },
    {
      "sid": "S00250",
      "start": 428.04,
      "end": 429.64,
      "text": "产生过焦虑"
    },
    {
      "sid": "S00251",
      "start": 429.64,
      "end": 430.76,
      "text": "产生过羞耻心"
    },
    {
      "sid": "S00252",
      "start": 430.76,
      "end": 432.36,
      "text": "但游戏不就是这样的"
    },
    {
      "sid": "S00253",
      "start": 432.36,
      "end": 434.14,
      "text": "我们会被更强的怪物打败"
    },
    {
      "sid": "S00254",
      "start": 434.14,
      "end": 436.12,
      "text": "我们会在不断地执行"
    },
    {
      "sid": "S00255",
      "start": 436.12,
      "end": 437.0,
      "text": "既定任务下"
    },
    {
      "sid": "S00256",
      "start": 437.0,
      "end": 437.56,
      "text": "感到迷茫"
    },
    {
      "sid": "S00257",
      "start": 437.56,
      "end": 439.26,
      "text": "我们会看到别的玩家"
    },
    {
      "sid": "S00258",
      "start": 439.26,
      "end": 440.42,
      "text": "拥有更好的装备的时候"
    },
    {
      "sid": "S00259",
      "start": 440.42,
      "end": 441.06,
      "text": "产生焦虑"
    },
    {
      "sid": "S00260",
      "start": 441.06,
      "end": 442.52,
      "text": "但这不重要"
    },
    {
      "sid": "S00261",
      "start": 442.52,
      "end": 443.66,
      "text": "重要的是"
    },
    {
      "sid": "S00262",
      "start": 443.66,
      "end": 444.76,
      "text": "你要清楚"
    },
    {
      "sid": "S00263",
      "start": 444.76,
      "end": 445.9,
      "text": "你是一个玩家"
    },
    {
      "sid": "S00264",
      "start": 445.9,
      "end": 447.76,
      "text": "艾比特泰特说过"
    },
    {
      "sid": "S00265",
      "start": 447.76,
      "end": 448.72,
      "text": "我们登上"
    },
    {
      "sid": "S00266",
      "start": 448.72,
      "end": 450.68,
      "text": "并非我们选择登上的舞台"
    },
    {
      "sid": "S00267",
      "start": 450.68,
      "end": 451.8,
      "text": "我们演出"
    },
    {
      "sid": "S00268",
      "start": 451.8,
      "end": 453.56,
      "text": "并非我们所选择的剧本"
    },
    {
      "sid": "S00269",
      "start": 453.56,
      "end": 454.1,
      "text": "没错"
    },
    {
      "sid": "S00270",
      "start": 454.1,
      "end": 455.3,
      "text": "我们没有办法像"
    },
    {
      "sid": "S00271",
      "start": 455.3,
      "end": 456.72,
      "text": "真正的游戏那样"
    },
    {
      "sid": "S00272",
      "start": 456.72,
      "end": 457.98,
      "text": "不断地随机重开"
    },
    {
      "sid": "S00273",
      "start": 457.98,
      "end": 459.24,
      "text": "我们没有办法去捏脸"
    },
    {
      "sid": "S00274",
      "start": 459.24,
      "end": 460.84,
      "text": "我们没有办法去调参数"
    },
    {
      "sid": "S00275",
      "start": 460.84,
      "end": 461.86,
      "text": "我们太多东西"
    },
    {
      "sid": "S00276",
      "start": 461.86,
      "end": 463.06,
      "text": "生来就是注定的"
    },
    {
      "sid": "S00277",
      "start": 463.06,
      "end": 463.94,
      "text": "但好在"
    },
    {
      "sid": "S00278",
      "start": 463.94,
      "end": 465.22,
      "text": "地球online这个game"
    },
    {
      "sid": "S00279",
      "start": 465.22,
      "end": 466.38,
      "text": "自由度足够高"
    },
    {
      "sid": "S00280",
      "start": 466.38,
      "end": 467.86,
      "text": "当你拥有了玩家心态"
    },
    {
      "sid": "S00281",
      "start": 467.86,
      "end": 468.94,
      "text": "当你遵守规则"
    },
    {
      "sid": "S00282",
      "start": 468.94,
      "end": 469.78,
      "text": "到理解规则"
    },
    {
      "sid": "S00283",
      "start": 469.78,
      "end": 470.66,
      "text": "到利用规则"
    },
    {
      "sid": "S00284",
      "start": 470.66,
      "end": 472.26,
      "text": "当你从害怕失败"
    },
    {
      "sid": "S00285",
      "start": 472.26,
      "end": 473.5,
