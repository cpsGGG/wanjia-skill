{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-027",
  "youtube_id": "uIiEXJAGugY",
  "media_sha256": "3dfea20b2994e0f7ef45573da3c4ad5372e2ac062f7a9c61b044151f4a2ba42b",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.14,
      "text": "真的是搞不明白了"
    },
    {
      "sid": "S00002",
      "start": 1.14,
      "end": 2.7,
      "text": "车车的魅力在哪里呢"
    },
    {
      "sid": "S00003",
      "start": 2.7,
      "end": 4.64,
      "text": "让大美女们都愿意为她驻足"
    },
    {
      "sid": "S00004",
      "start": 4.64,
      "end": 5.52,
      "text": "前有李佳格"
    },
    {
      "sid": "S00005",
      "start": 5.52,
      "end": 6.88,
      "text": "现在又有奶万"
    },
    {
      "sid": "S00006",
      "start": 6.88,
      "end": 8.26,
      "text": "李佳格跟她结婚"
    },
    {
      "sid": "S00007",
      "start": 8.26,
      "end": 9.46,
      "text": "为她生了两个孩子"
    },
    {
      "sid": "S00008",
      "start": 9.46,
      "end": 10.66,
      "text": "奶万有动作上"
    },
    {
      "sid": "S00009",
      "start": 10.66,
      "end": 11.76,
      "text": "与她有点暧昧不清"
    },
    {
      "sid": "S00010",
      "start": 11.76,
      "end": 12.52,
      "text": "一想起"
    },
    {
      "sid": "S00011",
      "start": 12.52,
      "end": 13.14,
      "text": "他们会对一个"
    },
    {
      "sid": "S00012",
      "start": 13.14,
      "end": 14.68,
      "text": "随便在街边小便的男人"
    },
    {
      "sid": "S00013",
      "start": 14.68,
      "end": 15.4,
      "text": "这么青睐"
    },
    {
      "sid": "S00014",
      "start": 15.4,
      "end": 16.64,
      "text": "就会觉得很魔幻"
    },
    {
      "sid": "S00015",
      "start": 16.64,
      "end": 17.28,
      "text": "搞不懂"
    },
    {
      "sid": "S00016",
      "start": 17.28,
      "end": 19.52,
      "text": "你们明白车车的魅力在哪吗"
    },
    {
      "sid": "S00017",
      "start": 19.52,
      "end": 21.34,
      "text": "车车的魅力到底在哪里"
    },
    {
      "sid": "S00018",
      "start": 21.34,
      "end": 22.76,
      "text": "强行为线头的男人"
    },
    {
      "sid": "S00019",
      "start": 22.76,
      "end": 23.92,
      "text": "永不他方"
    },
    {
      "sid": "S00020",
      "start": 30.0,
      "end": 32.8,
      "text": "我是Mike"
    },
    {
      "sid": "S00021",
      "start": 32.8,
      "end": 33.92,
      "text": "最近有个热搜"
    },
    {
      "sid": "S00022",
      "start": 33.92,
      "end": 35.14,
      "text": "我不知道大家有没有看到"
    },
    {
      "sid": "S00023",
      "start": 35.14,
      "end": 36.92,
      "text": "中国新书上的导演"
    },
    {
      "sid": "S00024",
      "start": 36.92,
      "end": 38.24,
      "text": "车车被拍到了"
    },
    {
      "sid": "S00025",
      "start": 38.24,
      "end": 39.38,
      "text": "和女rapper奶万"
    },
    {
      "sid": "S00026",
      "start": 39.38,
      "end": 41.48,
      "text": "在酒后勾肩搭背"
    },
    {
      "sid": "S00027",
      "start": 41.48,
      "end": 42.2,
      "text": "我们要知道"
    },
    {
      "sid": "S00028",
      "start": 42.2,
      "end": 43.7,
      "text": "车车她是有老婆的"
    },
    {
      "sid": "S00029",
      "start": 43.7,
      "end": 45.12,
      "text": "所以说这个行为呢"
    },
    {
      "sid": "S00030",
      "start": 45.12,
      "end": 46.68,
      "text": "无一触发了雷点"
    },
    {
      "sid": "S00031",
      "start": 46.68,
      "end": 48.2,
      "text": "那么视频一经发出呢"
    },
    {
      "sid": "S00032",
      "start": 48.2,
      "end": 49.18,
      "text": "瞬间上了热搜"
    },
    {
      "sid": "S00033",
      "start": 49.18,
      "end": 50.24,
      "text": "引爆了舆论"
    },
    {
      "sid": "S00034",
      "start": 50.24,
      "end": 51.48,
      "text": "那么评论区的声音呢"
    },
    {
      "sid": "S00035",
      "start": 51.48,
      "end": 52.14,
      "text": "分为两种"
    },
    {
      "sid": "S00036",
      "start": 52.14,
      "end": 53.52,
      "text": "一种就是经典言论"
    },
    {
      "sid": "S00037",
      "start": 53.52,
      "end": 53.92,
      "text": "比如说"
    },
    {
      "sid": "S00038",
      "start": 53.92,
      "end": 55.6,
      "text": "这符合我对rapper的刻板印象"
    },
    {
      "sid": "S00039",
      "start": 55.6,
      "end": 57.5,
      "text": "这符合我对娱乐圈的刻板印象"
    },
    {
      "sid": "S00040",
      "start": 57.5,
      "end": 58.26,
      "text": "这帮人争乱"
    },
    {
      "sid": "S00041",
      "start": 58.26,
      "end": 58.6,
      "text": "我呢"
    },
    {
      "sid": "S00042",
      "start": 58.6,
      "end": 60.04,
      "text": "我作为一个情感博主"
    },
    {
      "sid": "S00043",
      "start": 60.04,
      "end": 61.8,
      "text": "我也经常会收到类似的评论"
    },
    {
      "sid": "S00044",
      "start": 61.8,
      "end": 62.88,
      "text": "我可以说啊"
    },
    {
      "sid": "S00045",
      "start": 62.88,
      "end": 64.14,
      "text": "发这种评论的人"
    },
    {
      "sid": "S00046",
      "start": 64.14,
      "end": 65.48,
      "text": "都是一群典型的"
    },
    {
      "sid": "S00047",
      "start": 65.48,
      "end": 66.18,
      "text": "吃不到葡萄"
    },
    {
      "sid": "S00048",
      "start": 66.18,
      "end": 67.0,
      "text": "说葡萄酸的"
    },
    {
      "sid": "S00049",
      "start": 67.0,
      "end": 67.96,
      "text": "乌合之众的心理"
    },
    {
      "sid": "S00050",
      "start": 67.96,
      "end": 69.16,
      "text": "如果他们是公众人物"
    },
    {
      "sid": "S00051",
      "start": 69.16,
      "end": 70.12,
      "text": "他们有实权"
    },
    {
      "sid": "S00052",
      "start": 70.12,
      "end": 71.34,
      "text": "他们可能做的会"
    },
    {
      "sid": "S00053",
      "start": 71.34,
      "end": 72.24,
      "text": "有过之"
    },
    {
      "sid": "S00054",
      "start": 72.24,
      "end": 72.96,
      "text": "而无不及"
    },
    {
      "sid": "S00055",
      "start": 72.96,
      "end": 73.8,
      "text": "好"
    },
    {
      "sid": "S00056",
      "start": 73.8,
      "end": 74.68,
      "text": "那么这句话呢"
    },
    {
      "sid": "S00057",
      "start": 74.68,
      "end": 76.42,
      "text": "对于两性都适用"
    },
    {
      "sid": "S00058",
      "start": 76.42,
      "end": 77.38,
      "text": "第二种言论呢"
    },
    {
      "sid": "S00059",
      "start": 77.38,
      "end": 78.44,
      "text": "则是董哥"
    },
    {
      "sid": "S00060",
      "start": 78.44,
      "end": 79.58,
      "text": "他们会说"
    },
    {
      "sid": "S00061",
      "start": 79.58,
      "end": 79.9,
      "text": "啊"
    },
    {
      "sid": "S00062",
      "start": 79.9,
      "end": 81.12,
      "text": "因为车车他有钱"
    },
    {
      "sid": "S00063",
      "start": 81.12,
      "end": 82.3,
      "text": "他是爱惜子总裁"
    },
    {
      "sid": "S00064",
      "start": 82.3,
      "end": 84.24,
      "text": "他是一帮rapper的爹"
    },
    {
      "sid": "S00065",
      "start": 84.24,
      "end": 85.66,
      "text": "女人当然会喜欢他了"
    },
    {
      "sid": "S00066",
      "start": 85.66,
      "end": 87.18,
      "text": "奶万当然愿意咯"
    },
    {
      "sid": "S00067",
      "start": 87.18,
      "end": 88.3,
      "text": "他当然可以想怎么样"
    },
    {
      "sid": "S00068",
      "start": 88.3,
      "end": 89.04,
      "text": "就怎么样了"
    },
    {
      "sid": "S00069",
      "start": 89.04,
      "end": 89.96,
      "text": "那么这群人呢"
    },
    {
      "sid": "S00070",
      "start": 89.96,
      "end": 91.0,
      "text": "他们就像是目睹了"
    },
    {
      "sid": "S00071",
      "start": 91.0,
      "end": 92.94,
      "text": "秦始皇游街的百姓一样"
    },
    {
      "sid": "S00072",
      "start": 92.94,
      "end": 94.34,
      "text": "他们只会去议论"
    },
    {
      "sid": "S00073",
      "start": 94.34,
      "end": 95.32,
      "text": "不会去思考"
    },
    {
      "sid": "S00074",
      "start": 95.32,
      "end": 96.88,
      "text": "同样目睹了秦始皇的项羽"
    },
    {
      "sid": "S00075",
      "start": 96.88,
      "end": 97.42,
      "text": "则会说"
    },
    {
      "sid": "S00076",
      "start": 97.42,
      "end": 98.98,
      "text": "彼可取而代之"
    },
    {
      "sid": "S00077",
      "start": 98.98,
      "end": 99.94,
      "text": "而刘邦呢"
    },
    {
      "sid": "S00078",
      "start": 99.94,
      "end": 100.42,
      "text": "则会说"
    },
    {
      "sid": "S00079",
      "start": 100.42,
      "end": 102.42,
      "text": "大丈夫当如事也"
    },
    {
      "sid": "S00080",
      "start": 102.42,
      "end": 113.93,
      "text": "我们也有独立思考的能力"
    },
    {
      "sid": "S00081",
      "start": 113.93,
      "end": 115.15,
      "text": "无论是情感上"
    },
    {
      "sid": "S00082",
      "start": 115.15,
      "end": 115.95,
      "text": "还是生活中"
    },
    {
      "sid": "S00083",
      "start": 115.95,
      "end": 118.41,
      "text": "这也是我一直给兄弟们强调的"
    },
    {
      "sid": "S00084",
      "start": 118.41,
      "end": 119.45,
      "text": "我想做的事情呢"
    },
    {
      "sid": "S00085",
      "start": 119.45,
      "end": 120.73,
      "text": "并不是只是给你们"
    },
    {
      "sid": "S00086",
      "start": 120.73,
      "end": 122.09,
      "text": "某一个单一话术"
    },
    {
      "sid": "S00087",
      "start": 122.09,
      "end": 123.19,
      "text": "或单一技巧"
    },
    {
      "sid": "S00088",
      "start": 123.19,
      "end": 125.17,
      "text": "我想要你们真正去思考的是"
    },
    {
      "sid": "S00089",
      "start": 125.17,
      "end": 127.33,
      "text": "如何去成为我"
    },
    {
      "sid": "S00090",
      "start": 127.33,
      "end": 128.47,
      "text": "我想要你们去思考的是"
    },
    {
      "sid": "S00091",
      "start": 128.47,
      "end": 129.57,
      "text": "Mikey是基于一种"
    },
    {
      "sid": "S00092",
      "start": 129.57,
      "end": 130.93,
      "text": "什么样的价值观"
    },
    {
      "sid": "S00093",
      "start": 130.93,
      "end": 132.45,
      "text": "去做出了这样的行为"
    },
    {
      "sid": "S00094",
      "start": 132.45,
      "end": 133.41,
      "text": "做出了这样的"
    },
    {
      "sid": "S00095",
      "start": 133.41,
      "end": 135.63,
      "text": "你们看似是技巧的操作"
    },
    {
      "sid": "S00096",
      "start": 135.63,
      "end": 136.49,
      "text": "说出了一些"
    },
    {
      "sid": "S00097",
      "start": 136.49,
      "end": 138.27,
      "text": "你们认为是话术的"
    },
    {
      "sid": "S00098",
      "start": 138.27,
      "end": 138.65,
      "text": "话"
    },
    {
      "sid": "S00099",
      "start": 138.65,
      "end": 140.19,
      "text": "我想要你们从单一的"
    },
    {
      "sid": "S00100",
      "start": 140.19,
      "end": 141.59,
      "text": "局限的模仿我"
    },
    {
      "sid": "S00101",
      "start": 141.59,
      "end": 143.73,
      "text": "最终成为真正的我"
    },
    {
      "sid": "S00102",
      "start": 143.73,
      "end": 148.67,
      "text": "那么言归正传啊"
    },
    {
      "sid": "S00103",
      "start": 148.67,
      "end": 150.19,
      "text": "我相信看我频道的人呢"
    },
    {
      "sid": "S00104",
      "start": 150.19,
      "end": 151.85,
      "text": "都是具备独立思考的能力的人"
    },
    {
      "sid": "S00105",
      "start": 151.85,
      "end": 153.85,
      "text": "我们大家不需要去羡慕车车"
    },
    {
      "sid": "S00106",
      "start": 153.85,
      "end": 155.77,
      "text": "更不需要去抨击车车"
    },
    {
      "sid": "S00107",
      "start": 155.77,
      "end": 157.93,
      "text": "我们一定要透过现象看本质"
    },
    {
      "sid": "S00108",
      "start": 157.93,
      "end": 159.59,
      "text": "要提炼出关键的信息"
    },
    {
      "sid": "S00109",
      "start": 159.59,
      "end": 160.37,
      "text": "为我们所用"
    },
    {
      "sid": "S00110",
      "start": 160.37,
      "end": 161.73,
      "text": "在这件事情里呢"
    },
    {
      "sid": "S00111",
      "start": 161.73,
      "end": 162.75,
      "text": "我看到的车车"
    },
    {
      "sid": "S00112",
      "start": 162.75,
      "end": 165.33,
      "text": "是一个具备强行为线索的男人"
    },
    {
      "sid": "S00113",
      "start": 165.33,
      "end": 166.89,
      "text": "这也是他身上的魅力来源"
    },
    {
      "sid": "S00114",
      "start": 166.89,
      "end": 168.51,
      "text": "我认为这无关道德"
    },
    {
      "sid": "S00115",
      "start": 168.51,
      "end": 170.41,
      "text": "我们先来聊一聊车车这个人"
    },
    {
      "sid": "S00116",
      "start": 170.41,
      "end": 173.33,
      "text": "如果说PG1是黄毛式炮妞"
    },
    {
      "sid": "S00117",
      "start": 173.33,
      "end": 176.51,
      "text": "那么车车就是黄毛的老大"
    },
    {
      "sid": "S00118",
      "start": 176.51,
      "end": 178.39,
      "text": "我看新说唱第一季的时候呢"
    },
    {
      "sid": "S00119",
      "start": 178.39,
      "end": 180.29,
      "text": "我压根不知道这个人是谁"
    },
    {
      "sid": "S00120",
      "start": 180.29,
      "end": 181.43,
      "text": "他给我的印象呢"
    },
    {
      "sid": "S00121",
      "start": 181.43,
      "end": 182.41,
      "text": "就是又黑又胖"
    },
    {
      "sid": "S00122",
      "start": 182.41,
      "end": 183.75,
      "text": "那么节目里的rapper呢"
    },
    {
      "sid": "S00123",
      "start": 183.75,
      "end": 185.71,
      "text": "一个个都表现得非常的酷"
    },
    {
      "sid": "S00124",
      "start": 185.71,
      "end": 186.55,
      "text": "非常的自我"
    },
    {
      "sid": "S00125",
      "start": 186.55,
      "end": 187.41,
      "text": "他们谁也不屌"
    },
    {
      "sid": "S00126",
      "start": 187.41,
      "end": 188.57,
      "text": "但是车车一出场"
    },
    {
      "sid": "S00127",
      "start": 188.57,
      "end": 189.75,
      "text": "我能感受到这些"
    },
    {
      "sid": "S00128",
      "start": 189.75,
      "end": 191.95,
      "text": "就是天王老子来了都不服的"
    },
    {
      "sid": "S00129",
      "start": 191.95,
      "end": 193.25,
      "text": "rapper们在他面前"
    },
    {
      "sid": "S00130",
      "start": 193.25,
      "end": 194.57,
      "text": "变得格外的听话"
    },
    {
      "sid": "S00131",
      "start": 194.57,
      "end": 195.75,
      "text": "格外的乖巧"
    },
    {
      "sid": "S00132",
      "start": 195.75,
      "end": 197.27,
      "text": "这像是叛逆的学生"
    },
    {
      "sid": "S00133",
      "start": 197.27,
      "end": 198.59,
      "text": "见到了教导主任一样"
    },
    {
      "sid": "S00134",
      "start": 198.59,
      "end": 199.81,
      "text": "我当时心想"
    },
    {
      "sid": "S00135",
      "start": 199.81,
      "end": 201.43,
      "text": "这胖子他到底是谁啊"
    },
    {
      "sid": "S00136",
      "start": 201.43,
      "end": 202.63,
      "text": "后来才知道"
    },
    {
      "sid": "S00137",
      "start": 202.63,
      "end": 204.23,
      "text": "他是新说唱的导演"
    },
    {
      "sid": "S00138",
      "start": 204.23,
      "end": 205.93,
      "text": "那么问题来了"
    },
    {
      "sid": "S00139",
      "start": 205.93,
      "end": 207.17,
      "text": "你们在学校里"
    },
    {
      "sid": "S00140",
      "start": 207.17,
      "end": 207.81,
      "text": "在公司里"
    },
    {
      "sid": "S00141",
      "start": 207.81,
      "end": 209.23,
      "text": "你会因为这个人"
    },
    {
      "sid": "S00142",
      "start": 209.23,
      "end": 211.19,
      "text": "仅仅只是你的上司"
    },
    {
      "sid": "S00143",
      "start": 211.19,
      "end": 212.01,
      "text": "是你的老师"
    },
    {
      "sid": "S00144",
      "start": 212.01,
      "end": 212.89,
      "text": "是你的领导"
    },
    {
      "sid": "S00145",
      "start": 212.89,
      "end": 213.85,
      "text": "而尊重他们"
    },
    {
      "sid": "S00146",
      "start": 213.85,
      "end": 215.53,
      "text": "我相信有一部分人是会的"
    },
    {
      "sid": "S00147",
      "start": 215.53,
      "end": 217.05,
      "text": "但是rapper往往不会"
    },
    {
      "sid": "S00148",
      "start": 217.05,
      "end": 217.91,
      "text": "因为说唱文化"
    },
    {
      "sid": "S00149",
      "start": 217.91,
      "end": 218.89,
      "text": "他本身就是一种"
    },
    {
      "sid": "S00150",
      "start": 218.89,
      "end": 220.23,
      "text": "对于强权的呐喊"
    },
    {
      "sid": "S00151",
      "start": 220.23,
      "end": 220.81,
      "text": "这些rapper"
    },
    {
      "sid": "S00152",
      "start": 220.81,
      "end": 221.91,
      "text": "他们并不会因为"
    },
    {
      "sid": "S00153",
      "start": 221.91,
      "end": 223.37,
      "text": "你是这个节目的导演"
    },
    {
      "sid": "S00154",
      "start": 223.37,
      "end": 224.99,
      "text": "我就单方面的尊重你"
    },
    {
      "sid": "S00155",
      "start": 224.99,
      "end": 225.99,
      "text": "而且当时谁也不知道"
    },
    {
      "sid": "S00156",
      "start": 225.99,
      "end": 226.85,
      "text": "节目播出之后"
    },
    {
      "sid": "S00157",
      "start": 226.85,
      "end": 227.95,
      "text": "竟然会这么火"
    },
    {
      "sid": "S00158",
      "start": 227.95,
      "end": 229.41,
      "text": "他们尊重的其实是"
    },
    {
      "sid": "S00159",
      "start": 229.41,
      "end": 230.55,
      "text": "车车的气场"
    },
    {
      "sid": "S00160",
      "start": 230.55,
      "end": 231.45,
      "text": "并且他们也知道"
    },
    {
      "sid": "S00161",
      "start": 231.45,
      "end": 232.47,
      "text": "车车并不是一个"
    },
    {
      "sid": "S00162",
      "start": 232.47,
      "end": 233.31,
      "text": "普通的导演"
    },
    {
      "sid": "S00163",
      "start": 233.31,
      "end": 235.19,
      "text": "他是一个文化现象的发动者"
    },
    {
      "sid": "S00164",
      "start": 235.19,
      "end": 236.19,
      "text": "那么在17年以前"
    },
    {
      "sid": "S00165",
      "start": 236.19,
      "end": 238.31,
      "text": "说唱文化还是过街老鼠"
    },
    {
      "sid": "S00166",
      "start": 238.31,
      "end": 240.01,
      "text": "是不入流的小众文化"
    },
    {
      "sid": "S00167",
      "start": 240.01,
      "end": 242.39,
      "text": "车车将这个文化带上了主流"
    },
    {
      "sid": "S00168",
      "start": 242.39,
      "end": 243.63,
      "text": "给他赋予了一种光环"
    },
    {
      "sid": "S00169",
      "start": 243.63,
      "end": 245.21,
      "text": "一种开创者的光环"
    },
    {
      "sid": "S00170",
      "start": 245.21,
      "end": 246.63,
      "text": "就像是朝代的开创者"
    },
    {
      "sid": "S00171",
      "start": 246.63,
      "end": 247.59,
      "text": "公司的创始人"
    },
    {
      "sid": "S00172",
      "start": 247.59,
      "end": 248.31,
      "text": "人们对于那种"
    },
    {
      "sid": "S00173",
      "start": 248.31,
      "end": 249.67,
      "text": "能够创造价值的人"
    },
    {
      "sid": "S00174",
      "start": 249.67,
      "end": 251.29,
      "text": "会天然的产生敬畏"
    },
    {
      "sid": "S00175",
      "start": 251.29,
      "end": 253.17,
      "text": "这也是我们在心理学里面的"
    },
    {
      "sid": "S00176",
      "start": 253.17,
      "end": 254.17,
      "text": "一个很重要的概念"
    },
    {
      "sid": "S00177",
      "start": 254.17,
      "end": 255.79,
      "text": "叫做成就吸引力"
    },
    {
      "sid": "S00178",
      "start": 255.79,
      "end": 256.51,
      "text": "而反过来"
    },
    {
      "sid": "S00179",
      "start": 256.51,
      "end": 257.77,
      "text": "这些成就也会塑造"
    },
    {
      "sid": "S00180",
      "start": 257.77,
      "end": 259.13,
      "text": "他们的性格底色"
    },
    {
      "sid": "S00181",
      "start": 259.13,
      "end": 280.94,
      "text": "一种我们称为领袖魅力的东西"
    },
    {
      "sid": "S00182",
      "start": 280.94,
      "end": 283.18,
      "text": "身份和气场当然会相互作用"
    },
    {
      "sid": "S00183",
      "start": 283.18,
      "end": 285.94,
      "text": "但这并不是一个先有机还是先有蛋的问题"
    },
    {
      "sid": "S00184",
      "start": 285.94,
      "end": 288.3,
      "text": "在这里讨论这个东西也没有什么意义"
    },
    {
      "sid": "S00185",
      "start": 288.3,
      "end": 290.5,
      "text": "因为我见过太多社会属性"
    },
    {
      "sid": "S00186",
      "start": 290.5,
      "end": 292.14,
      "text": "外外价值拉满的学员"
    },
    {
      "sid": "S00187",
      "start": 292.14,
      "end": 293.02,
      "text": "可能他们在公司里"
    },
    {
      "sid": "S00188",
      "start": 293.02,
      "end": 294.54,
      "text": "他们是一个完全的强者"
    },
    {
      "sid": "S00189",
      "start": 294.54,
      "end": 296.38,
      "text": "所有人都对他唯命是从"
    },
    {
      "sid": "S00190",
      "start": 296.38,
      "end": 298.98,
      "text": "但是他们在女人面前却表现得像一个小朋友"
    },
    {
      "sid": "S00191",
      "start": 298.98,
      "end": 301.26,
      "text": "仿佛他在公司里的那些自信的行为"
    },
    {
      "sid": "S00192",
      "start": 301.26,
      "end": 302.98,
      "text": "那些气场全都消失了"
    },
    {
      "sid": "S00193",
      "start": 302.98,
      "end": 303.56,
      "text": "为什么呢"
    },
    {
      "sid": "S00194",
      "start": 303.56,
      "end": 305.5,
      "text": "这涉及到车射性格的第二点"
    },
    {
      "sid": "S00195",
      "start": 305.5,
      "end": 306.66,
      "text": "强行为性的男人"
    },
    {
      "sid": "S00196",
      "start": 306.66,
      "end": 308.54,
      "text": "他们是绝对充满一致性的"
    },
    {
      "sid": "S00197",
      "start": 308.54,
      "end": 310.16,
      "text": "他们在面对各种事情上"
    },
    {
      "sid": "S00198",
      "start": 310.16,
      "end": 311.26,
      "text": "尤其在面对女人上"
    },
    {
      "sid": "S00199",
      "start": 311.26,
      "end": 314.34,
      "text": "他们是能一直保持着非常的淡定"
    },
    {
      "sid": "S00200",
      "start": 314.34,
      "end": 315.02,
      "text": "非常的自我"
    },
    {
      "sid": "S00201",
      "start": 315.02,
      "end": 315.92,
      "text": "非常的高位的"
    },
    {
      "sid": "S00202",
      "start": 315.92,
      "end": 318.04,
      "text": "我们可以看一下车射和他前妻的直播"
    },
    {
      "sid": "S00203",
      "start": 318.04,
      "end": 319.68,
      "text": "他是不会去哄着他的"
    },
    {
      "sid": "S00204",
      "start": 319.68,
      "end": 321.7,
      "text": "当他的前妻表现得非常过躁"
    },
    {
      "sid": "S00205",
      "start": 321.7,
      "end": 323.56,
      "text": "车射会直接对他的前妻说"
    },
    {
      "sid": "S00206",
      "start": 323.56,
      "end": 323.96,
      "text": "闭嘴"
    },
    {
      "sid": "S00207",
      "start": 323.96,
      "end": 324.7,
      "text": "少说一点"
    },
    {
      "sid": "S00208",
      "start": 324.7,
      "end": 326.2,
      "text": "这种能量并不是尖锐的"
    },
    {
      "sid": "S00209",
      "start": 326.2,
      "end": 327.36,
      "text": "它是一种润物"
    },
    {
      "sid": "S00210",
      "start": 327.36,
      "end": 328.6,
      "text": "戏无声的能量"
    },
    {
      "sid": "S00211",
      "start": 328.6,
      "end": 330.16,
      "text": "但是却拥有了绝对的权威"
    },
    {
      "sid": "S00212",
      "start": 330.16,
      "end": 331.68,
      "text": "这也是我经常在跟你们讲"
    },
    {
      "sid": "S00213",
      "start": 331.68,
      "end": 332.7,
      "text": "约会案例的时候"
    },
    {
      "sid": "S00214",
      "start": 332.7,
      "end": 333.66,
      "text": "我会说的"
    },
    {
      "sid": "S00215",
      "start": 333.66,
      "end": 335.04,
      "text": "平静而有力量"
    },
    {
      "sid": "S00216",
      "start": 335.04,
      "end": 336.56,
      "text": "其实意思是差不多的"
    },
    {
      "sid": "S00217",
      "start": 336.56,
      "end": 338.76,
      "text": "我看一堆人马后炮说"
    },
    {
      "sid": "S00218",
      "start": 338.76,
      "end": 340.32,
      "text": "车射这个人道德恶劣"
    },
    {
      "sid": "S00219",
      "start": 340.32,
      "end": 341.96,
      "text": "把他的行为统一用"
    },
    {
      "sid": "S00220",
      "start": 341.96,
      "end": 343.28,
      "text": "大男子主义来解释"
    },
    {
      "sid": "S00221",
      "start": 343.28,
      "end": 345.2,
      "text": "我认为这是典型的二极管思维"
    },
    {
      "sid": "S00222",
      "start": 345.2,
      "end": 347.24,
      "text": "在他和奶万罗爆事件发酵之后"
    },
    {
      "sid": "S00223",
      "start": 347.24,
      "end": 348.98,
      "text": "其实李佳格他什么也没说"
    },
    {
      "sid": "S00224",
      "start": 348.98,
      "end": 350.1,
      "text": "他只是发了一条"
    },
    {
      "sid": "S00225",
      "start": 350.1,
      "end": 352.22,
      "text": "他们已经离婚的澄清微博"
    },
    {
      "sid": "S00226",
      "start": 352.22,
      "end": 353.3,
      "text": "他为什么要这么做呢"
    },
    {
      "sid": "S00227",
      "start": 353.3,
      "end": 355.54,
      "text": "很多人会觉得这是在保护奶万"
    },
    {
      "sid": "S00228",
      "start": 355.54,
      "end": 356.92,
      "text": "其实这并不是在保护奶万"
    },
    {
      "sid": "S00229",
      "start": 356.92,
      "end": 358.64,
      "text": "他发这条微博的目的"
    },
    {
      "sid": "S00230",
      "start": 358.64,
      "end": 360.54,
      "text": "其实是为了保护车射"
    },
    {
      "sid": "S00231",
      "start": 360.54,
      "end": 361.96,
      "text": "保护他的前夫哥"
    },
    {
      "sid": "S00232",
      "start": 361.96,
      "end": 363.6,
      "text": "因为他并不想让他的前夫哥"
    },
    {
      "sid": "S00233",
      "start": 363.6,
      "end": 365.78,
      "text": "套上一个出轨者的头衔"
    },
    {
      "sid": "S00234",
      "start": 365.78,
      "end": 367.94,
      "text": "就想当年他们在结婚的时候"
    },
    {
      "sid": "S00235",
      "start": 367.94,
      "end": 370.74,
      "text": "李佳格是毅然决然的退出娱乐圈的"
    },
    {
      "sid": "S00236",
      "start": 370.74,
      "end": 372.52,
      "text": "他当时已经是事业的高分期了"
    },
    {
      "sid": "S00237",
      "start": 372.52,
      "end": 373.9,
      "text": "并且他自己出了彩礼钱"
    },
    {
      "sid": "S00238",
      "start": 373.9,
      "end": 375.44,
      "text": "他为车射生了两个儿女"
    },
    {
      "sid": "S00239",
      "start": 375.44,
      "end": 376.7,
      "text": "车射在婚后生活呢"
    },
    {
      "sid": "S00240",
      "start": 376.7,
      "end": 378.26,
      "text": "也是一种绝对的高位状态"
    },
    {
      "sid": "S00241",
      "start": 378.26,
      "end": 379.28,
      "text": "绝对的主导状态"
    },
    {
      "sid": "S00242",
      "start": 379.28,
      "end": 380.1,
      "text": "而奶万呢"
    },
    {
      "sid": "S00243",
      "start": 380.1,
      "end": 381.44,
      "text": "他在事情发酵之后"
    },
    {
      "sid": "S00244",
      "start": 381.44,
      "end": 382.92,
      "text": "他发了一串小作文"
    },
    {
      "sid": "S00245",
      "start": 382.92,
      "end": 383.58,
      "text": "聊天截图"
    },
    {
      "sid": "S00246",
      "start": 383.58,
      "end": 385.2,
      "text": "里面提到车射的部分呢"
    },
    {
      "sid": "S00247",
      "start": 385.2,
      "end": 387.22,
      "text": "也只是紧紧的"
    },
    {
      "sid": "S00248",
      "start": 387.22,
      "end": 389.24,
      "text": "希望车射能帮他澄清"
    },
    {
      "sid": "S00249",
      "start": 389.24,
      "end": 390.66,
      "text": "并且他擅自主张的"
    },
    {
      "sid": "S00250",
      "start": 390.66,
      "end": 392.7,
      "text": "把车射和他的老婆做了绑兵"
    },
    {
      "sid": "S00251",
      "start": 392.7,
      "end": 393.8,
      "text": "他希望他的老婆"
    },
    {
      "sid": "S00252",
      "start": 393.8,
      "end": 394.84,
      "text": "能站出来帮他澄清"
    },
    {
      "sid": "S00253",
      "start": 394.84,
      "end": 396.24,
      "text": "甚至以命令时的口吻"
    },
    {
      "sid": "S00254",
      "start": 396.24,
      "end": 397.3,
      "text": "就质问李佳格"
    },
    {
      "sid": "S00255",
      "start": 397.3,
      "end": 398.34,
      "text": "为什么不帮他澄清"
    },
    {
      "sid": "S00256",
      "start": 398.34,
      "end": 399.08,
      "text": "但是这件事情"
    },
    {
      "sid": "S00257",
      "start": 399.08,
      "end": 400.48,
      "text": "跟李佳格一点关系都没有"
    },
    {
      "sid": "S00258",
      "start": 400.48,
      "end": 401.94,
      "text": "难道奶万不知道吗"
    },
    {
      "sid": "S00259",
      "start": 401.94,
      "end": 403.12,
      "text": "那他为什么要把李佳格"
    },
    {
      "sid": "S00260",
      "start": 403.12,
      "end": 404.02,
      "text": "一起拉出来呢"
    },
    {
      "sid": "S00261",
      "start": 404.02,
      "end": 406.02,
      "text": "其实他是在转移矛盾"
    },
    {
      "sid": "S00262",
      "start": 406.02,
      "end": 407.82,
      "text": "因为在这件事情中呢"
    },
    {
      "sid": "S00263",
      "start": 407.82,
      "end": 409.06,
      "text": "车射是那个强者"
    },
    {
      "sid": "S00264",
      "start": 409.06,
      "end": 410.5,
      "text": "而李佳格和奶万"
    },
    {
      "sid": "S00265",
      "start": 410.5,
      "end": 411.86,
      "text": "他们都是弱者"
    },
    {
      "sid": "S00266",
      "start": 411.86,
      "end": 414.08,
      "text": "那么人性就是弱者会向强者"
    },
    {
      "sid": "S00267",
      "start": 414.08,
      "end": 414.86,
      "text": "俯首称臣"
    },
    {
      "sid": "S00268",
      "start": 414.86,
      "end": 417.06,
      "text": "而弱者会向更弱者抽刀"
    },
    {
      "sid": "S00269",
      "start": 417.06,
      "end": 418.16,
      "text": "所以也导致了奶万"
    },
    {
      "sid": "S00270",
      "start": 418.16,
      "end": 420.34,
      "text": "必重救星的去偏袒车射"
    },
    {
      "sid": "S00271",
      "start": 420.34,
      "end": 421.84,
      "text": "选择性的把攻击"
    },
    {
      "sid": "S00272",
      "start": 421.84,
      "end": 423.76,
      "text": "都打到了他的前妻"
    },
    {
      "sid": "S00273",
      "start": 423.76,
      "end": 424.9,
      "text": "李佳格身上"
    },
    {
      "sid": "S00274",
      "start": 424.9,
      "end": 425.88,
      "text": "那么这种欺软"
    },
    {
      "sid": "S00275",
      "start": 425.88,
      "end": 427.3,
      "text": "怕硬的形式作风呢"
    },
    {
      "sid": "S00276",
      "start": 427.3,
      "end": 429.26,
      "text": "也直接导致了奶万的微薄"
    },
    {
      "sid": "S00277",
      "start": 429.26,
      "end": 430.7,
      "text": "被网民给爆破"
    },
    {
      "sid": "S00278",
      "start": 430.7,
      "end": 431.88,
      "text": "那么无论他们背后"
    },
    {
      "sid": "S00279",
      "start": 431.88,
      "end": 432.7,
      "text": "有没有睡过"
    },
    {
      "sid": "S00280",
      "start": 432.7,
      "end": 433.86,
      "text": "是什么样的关系"
    },
    {
      "sid": "S00281",
      "start": 433.86,
      "end": 435.18,
      "text": "但他对车射的尊重"
    },
    {
      "sid": "S00282",
      "start": 435.18,
      "end": 436.94,
      "text": "以及他在车射面前的低位"
    },
    {
      "sid": "S00283",
      "start": 436.94,
      "end": 438.3,
      "text": "都是真实存在的"
    },
    {
      "sid": "S00284",
      "start": 438.3,
      "end": 439.12,
      "text": "而车射呢"
    },
    {
      "sid": "S00285",
      "start": 439.12,
      "end": 441.1,
      "text": "他在面对这起公关事件的处理"
    },
    {
      "sid": "S00286",
      "start": 441.1,
      "end": 441.92,
      "text": "我们能感觉到"
    },
    {
      "sid": "S00287",
      "start": 441.92,
      "end": 443.18,
      "text": "这个人是完全没feel的"
    },
    {
      "sid": "S00288",
      "start": 443.18,
      "end": 444.7,
      "text": "他是一种云淡分清的感觉"
    },
    {
      "sid": "S00289",
      "start": 444.7,
      "end": 446.68,
      "text": "这并不是他复杂的社会关系决定"
    },
    {
      "sid": "S00290",
      "start": 446.68,
      "end": 447.54,
      "text": "这跟很多人说"
    },
    {
      "sid": "S00291",
      "start": 447.54,
      "end": 449.28,
      "text": "奶万媚不媚男也没什么关系"
    },
    {
      "sid": "S00292",
      "start": 449.28,
      "end": 450.12,
      "text": "女人媚男"
    },
    {
      "sid": "S00293",
      "start": 450.12,
      "end": 451.44,
      "text": "媚的只是强者"
    },
    {
      "sid": "S00294",
      "start": 451.44,
      "end": 453.36,
      "text": "如果车射是一种软弱的性格"
    },
    {
      "sid": "S00295",
      "start": 453.36,
      "end": 454.48,
      "text": "我相信奶万"
    },
    {
      "sid": "S00296",
      "start": 454.48,
      "end": 455.98,
      "text": "他绝对不是今天这副嘴脸"
    },
    {
      "sid": "S00297",
      "start": 455.98,
      "end": 459.08,
      "text": "那么强行为线组的男人呢"
    },
    {
      "sid": "S00298",
      "start": 459.08,
      "end": 460.1,
      "text": "还有一个很强的特质"
    },
    {
      "sid": "S00299",
      "start": 460.1,
      "end": 461.36,
      "text": "就是解决问题的能力"
    },
    {
      "sid": "S00300",
      "start": 461.36,
      "end": 462.14,
      "text": "可能有人会说"
    },
    {
      "sid": "S00301",
      "start": 462.14,
      "end": 463.22,
      "text": "他的吸引力是来自于"
    },
    {
      "sid": "S00302",
      "start": 463.22,
      "end": 464.02,
      "text": "他背后的资源"
    },
    {
      "sid": "S00303",
      "start": 464.02,
      "end": 465.96,
      "text": "那么爆光的聊天记录里呢"
    },
    {
      "sid": "S00304",
      "start": 465.96,
      "end": 467.46,
      "text": "也确实存在"
    },
    {
      "sid": "S00305",
      "start": 467.46,
      "end": 468.38,
      "text": "车射对奶万讲"
    },
    {
      "sid": "S00306",
      "start": 468.38,
      "end": 469.78,
      "text": "我手里有一些核心资源"
    },
    {
      "sid": "S00307",
      "start": 469.78,
      "end": 471.36,
      "text": "但是果真如此嘛"
    },
    {
      "sid": "S00308",
      "start": 471.36,
      "end": 473.16,
      "text": "我们依然要透过现象看本质"
    },
    {
      "sid": "S00309",
      "start": 473.16,
      "end": 474.64,
      "text": "车射的手里确实有资源"
    },
    {
      "sid": "S00310",
      "start": 474.64,
      "end": 475.66,
      "text": "每一季新说唱的"
    },
    {
      "sid": "S00311",
      "start": 475.66,
      "end": 477.34,
      "text": "都是wapper们的成名舞台"
    },
    {
      "sid": "S00312",
      "start": 477.34,
      "end": 478.88,
      "text": "他连接了地下说唱文化"
    },
    {
      "sid": "S00313",
      "start": 478.88,
      "end": 480.18,
      "text": "和主流娱乐市场"
    },
    {
      "sid": "S00314",
      "start": 480.18,
      "end": 481.36,
      "text": "这种资源掌控呢"
    },
    {
      "sid": "S00315",
      "start": 481.36,
      "end": 483.22,
      "text": "并不是庸俗的我有关系"
    },
    {
      "sid": "S00316",
      "start": 483.22,
      "end": 485.1,
      "text": "而是能够识别天赋"
    },
    {
      "sid": "S00317",
      "start": 485.1,
      "end": 487.34,
      "text": "并将之与平台匹配的能力"
    },
    {
      "sid": "S00318",
      "start": 487.34,
      "end": 488.2,
      "text": "说人话呢"
    },
    {
      "sid": "S00319",
      "start": 488.2,
      "end": 489.9,
      "text": "就是解决问题的能力"
    },
    {
      "sid": "S00320",
      "start": 489.9,
      "end": 491.46,
      "text": "那么有资源的人太多了"
    },
    {
      "sid": "S00321",
      "start": 491.46,
      "end": 492.66,
      "text": "有资源的人翻车"
    },
    {
      "sid": "S00322",
      "start": 492.66,
      "end": 493.86,
      "text": "塌房的人就更多了"
    },
    {
      "sid": "S00323",
      "start": 493.86,
      "end": 494.96,
      "text": "比如说吴某凡"
    },
    {
      "sid": "S00324",
      "start": 494.96,
      "end": 495.9,
      "text": "我打个比喻啊"
    },
    {
      "sid": "S00325",
      "start": 495.9,
      "end": 497.12,
      "text": "在game的过程中呢"
    },
    {
      "sid": "S00326",
      "start": 497.12,
      "end": 497.9,
      "text": "是一条跑道"
    },
    {
      "sid": "S00327",
      "start": 497.9,
      "end": 498.7,
      "text": "终点呢"
    },
    {
      "sid": "S00328",
      "start": 498.7,
      "end": 500.14,
      "text": "是你能成功吸引到它"
    },
    {
      "sid": "S00329",
      "start": 500.14,
      "end": 500.76,
      "text": "你是w币"
    },
    {
      "sid": "S00330",
      "start": 500.76,
      "end": 501.32,
      "text": "你够帅"
    },
    {
      "sid": "S00331",
      "start": 501.32,
      "end": 501.94,
      "text": "你有资源"
    },
    {
      "sid": "S00332",
      "start": 501.94,
      "end": 502.72,
      "text": "你的起点呢"
    },
    {
      "sid": "S00333",
      "start": 502.72,
      "end": 503.9,
      "text": "可能会离终点更近"
    },
    {
      "sid": "S00334",
      "start": 503.9,
      "end": 505.34,
      "text": "但当问题出现"
    },
    {
      "sid": "S00335",
      "start": 505.34,
      "end": 506.26,
      "text": "你不去解决"
    },
    {
      "sid": "S00336",
      "start": 506.26,
      "end": 507.32,
      "text": "这就好比"
    },
    {
      "sid": "S00337",
      "start": 507.32,
      "end": 509.7,
      "text": "跑道上凭空出现了一堵墙"
    },
    {
      "sid": "S00338",
      "start": 509.7,
      "end": 511.52,
      "text": "你不知道该怎么样去跨过去"
    },
    {
      "sid": "S00339",
      "start": 511.52,
      "end": 513.42,
      "text": "那么你自然没有办法到达终点"
    },
    {
      "sid": "S00340",
      "start": 513.42,
      "end": 515.04,
      "text": "听说上开播到现在呢"
    },
    {
      "sid": "S00341",
      "start": 515.04,
      "end": 516.92,
      "text": "这群wapper到底出了多少问题"
    },
    {
      "sid": "S00342",
      "start": 516.92,
      "end": 518.38,
      "text": "资本市场不可能"
    },
    {
      "sid": "S00343",
      "start": 518.38,
      "end": 519.06,
      "text": "视而不见"
    },
    {
      "sid": "S00344",
      "start": 519.06,
      "end": 520.08,
      "text": "但节目本身"
    },
    {
      "sid": "S00345",
      "start": 520.08,
      "end": 521.64,
      "text": "似乎没有受到任何影响"
    },
    {
      "sid": "S00346",
      "start": 521.64,
      "end": 522.54,
      "text": "我不敢说这里面"
    },
    {
      "sid": "S00347",
      "start": 522.54,
      "end": 523.54,
      "text": "全是车车的功劳"
    },
    {
      "sid": "S00348",
      "start": 523.54,
      "end": 525.16,
      "text": "但是他一定做了很多事情"
    },
    {
      "sid": "S00349",
      "start": 525.16,
      "end": 527.42,
      "text": "因为他是一个会解决问题的男人"
    },
    {
      "sid": "S00350",
      "start": 527.42,
      "end": 530.65,
      "text": "那么社会发展到现在"
    },
    {
      "sid": "S00351",
      "start": 530.65,
      "end": 531.93,
      "text": "女人心中的alpha"
    },
    {
      "sid": "S00352",
      "start": 531.93,
      "end": 533.01,
      "text": "真正的强大"
    },
    {
      "sid": "S00353",
      "start": 533.01,
      "end": 534.29,
      "text": "有强心性的男人"
    },
    {
      "sid": "S00354",
      "start": 534.29,
      "end": 535.91,
      "text": "已经从以前的保护性"
    },
    {
      "sid": "S00355",
      "start": 535.91,
      "end": 537.17,
      "text": "发展到认知性"
    },
    {
      "sid": "S00356",
      "start": 537.17,
      "end": 537.91,
      "text": "女人目强"
    },
    {
      "sid": "S00357",
      "start": 537.91,
      "end": 540.13,
      "text": "不再是物理层面的强大"
    },
    {
      "sid": "S00358",
      "start": 540.13,
      "end": 541.31,
      "text": "不再是崇尚暴力"
    },
    {
      "sid": "S00359",
      "start": 541.31,
      "end": 542.27,
      "text": "不再是仅仅的"
    },
    {
      "sid": "S00360",
      "start": 542.27,
      "end": 543.67,
      "text": "谁能提供保护"
    },
    {
      "sid": "S00361",
      "start": 543.67,
      "end": 544.91,
      "text": "提供生存资源"
    },
    {
      "sid": "S00362",
      "start": 544.91,
      "end": 545.87,
      "text": "我就崇拜谁"
    },
    {
      "sid": "S00363",
      "start": 545.87,
      "end": 547.19,
      "text": "如果你仅仅只是一个"
    },
    {
      "sid": "S00364",
      "start": 547.19,
      "end": 548.79,
      "text": "会提供资源的傻逼"
    },
    {
      "sid": "S00365",
      "start": 548.79,
      "end": 549.81,
      "text": "那么你充其量"
    },
    {
      "sid": "S00366",
      "start": 549.81,
      "end": 551.95,
      "text": "也只是会被女人当成ATM机"
    },
    {
      "sid": "S00367",
      "start": 551.95,
      "end": 553.31,
      "text": "被当成供养者"
    },
    {
      "sid": "S00368",
      "start": 553.31,
      "end": 554.83,
      "text": "人类现在目强的强"
    },
    {
      "sid": "S00369",
      "start": 554.83,
      "end": 556.37,
      "text": "目的是认知"
    },
    {
      "sid": "S00370",
      "start": 556.37,
      "end": 557.97,
      "text": "目的是行为层面的强大"
    },
    {
      "sid": "S00371",
      "start": 557.97,
      "end": 559.17,
      "text": "我今天在这里"
    },
    {
      "sid": "S00372",
      "start": 559.17,
      "end": 560.67,
      "text": "跟兄弟们讨论车撤"
    },
    {
      "sid": "S00373",
      "start": 560.67,
      "end": 561.69,
      "text": "实际上讨论的是"
    },
    {
      "sid": "S00374",
      "start": 561.69,
      "end": 563.45,
      "text": "这个时代对于男性魅力的"
    },
    {
      "sid": "S00375",
      "start": 563.45,
      "end": 564.29,
      "text": "重新定义"
    },
    {
      "sid": "S00376",
      "start": 564.29,
      "end": 565.59,
      "text": "如果你还没有意识到这一点"
    },
    {
      "sid": "S00377",
      "start": 565.59,
      "end": 567.41,
      "text": "你就会被情感市场给淘汰"
    },
    {
      "sid": "S00378",
      "start": 567.41,
      "end": 569.33,
      "text": "这是一个非常现实的问题"
    },
    {
      "sid": "S00379",
      "start": 569.33,
      "end": 571.49,
      "text": "有学员向我发问"
    },
    {
      "sid": "S00380",
      "start": 571.49,
      "end": 573.21,
      "text": "他认为强心性性的男人"
    },
    {
      "sid": "S00381",
      "start": 573.21,
      "end": 574.15,
      "text": "是天生的"
    },
    {
      "sid": "S00382",
      "start": 574.15,
      "end": 576.11,
      "text": "是没有办法通过后天改变的"
    },
    {
      "sid": "S00383",
      "start": 576.11,
      "end": 578.45,
      "text": "如果我的例子还不够"
    },
    {
      "sid": "S00384",
      "start": 578.45,
      "end": 579.49,
      "text": "我们可以再看一些"
    },
    {
      "sid": "S00385",
      "start": 579.49,
      "end": 584.06,
      "text": "我没有办法改变所有人"
    },
    {
      "sid": "S00386",
      "start": 584.06,
      "end": 586.44,
      "text": "但我看到的微博热搜下面的那些评论"
    },
    {
      "sid": "S00387",
      "start": 586.44,
      "end": 587.62,
      "text": "我除了感到悲哀"
    },
    {
      "sid": "S00388",
      "start": 587.62,
      "end": 589.38,
      "text": "我还产生了一种使命感"
    },
    {
      "sid": "S00389",
      "start": 589.38,
      "end": 591.1,
      "text": "革命远远还没有结束"
    },
    {
      "sid": "S00390",
      "start": 591.1,
      "end": 591.72,
      "text": "敌人"
    },
    {
      "sid": "S00391",
      "start": 591.72,
      "end": 592.72,
      "text": "如狼似虎"
    },
    {
      "sid": "S00392",
      "start": 592.72,
      "end": 595.0,
      "text": "我每次看到那些被灌出毛病的女人"
    },
    {
      "sid": "S00393",
      "start": 595.0,
      "end": 595.9,
      "text": "我都在想"
    },
    {
      "sid": "S00394",
      "start": 595.9,
      "end": 597.62,
      "text": "如果跪在地上的男人少一点"
    },
    {
      "sid": "S00395",
      "start": 597.62,
      "end": 598.74,
      "text": "他们还会这么跳呢"
    },
    {
      "sid": "S00396",
      "start": 598.74,
      "end": 634.87,
      "text": "我都在想"
    }
  ]
}
