{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-022",
  "youtube_id": "-ibLhiQv4V8",
  "media_sha256": "29c8ed3c230144fae0c352255394ebd33b2f86562d541e62259ae96b4ed1db74",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.12,
      "text": "Hello 兄弟们我是Mikey"
    },
    {
      "sid": "S00002",
      "start": 1.12,
      "end": 3.0,
      "text": "欢迎来到我的最新一期节目"
    },
    {
      "sid": "S00003",
      "start": 3.0,
      "end": 6.24,
      "text": "我的这一期节目讲的是一个比较特殊的案例"
    },
    {
      "sid": "S00004",
      "start": 6.24,
      "end": 8.44,
      "text": "是我一个学员他炮打多了"
    },
    {
      "sid": "S00005",
      "start": 8.44,
      "end": 9.4,
      "text": "反而中毒了"
    },
    {
      "sid": "S00006",
      "start": 9.4,
      "end": 11.6,
      "text": "反而不知道该怎么样去跟女人相处了"
    },
    {
      "sid": "S00007",
      "start": 11.6,
      "end": 13.24,
      "text": "那么为什么炮打的越多"
    },
    {
      "sid": "S00008",
      "start": 13.24,
      "end": 14.96,
      "text": "反而会变得更迷茫"
    },
    {
      "sid": "S00009",
      "start": 14.96,
      "end": 15.96,
      "text": "或者是变得更痛苦"
    },
    {
      "sid": "S00010",
      "start": 15.96,
      "end": 17.12,
      "text": "我这里有很多学员"
    },
    {
      "sid": "S00011",
      "start": 17.12,
      "end": 19.36,
      "text": "他们手里握着三到五个炮友"
    },
    {
      "sid": "S00012",
      "start": 19.36,
      "end": 23.32,
      "text": "但是有的时候他们依旧会陷入一个长期的内耗之中"
    },
    {
      "sid": "S00013",
      "start": 23.32,
      "end": 25.76,
      "text": "很多人觉得有炮友就不会内耗了"
    },
    {
      "sid": "S00014",
      "start": 25.76,
      "end": 26.88,
      "text": "怎么还会内耗"
    },
    {
      "sid": "S00015",
      "start": 26.88,
      "end": 28.8,
      "text": "那么这就是我的学员的困扰"
    },
    {
      "sid": "S00016",
      "start": 28.8,
      "end": 29.96,
      "text": "这些内耗的兄弟"
    },
    {
      "sid": "S00017",
      "start": 29.96,
      "end": 31.28,
      "text": "他们有一个共同的特征"
    },
    {
      "sid": "S00018",
      "start": 31.28,
      "end": 32.64,
      "text": "就是他们跟女人聊天"
    },
    {
      "sid": "S00019",
      "start": 32.64,
      "end": 35.32,
      "text": "就是不会像以前那样就是聊得更加洒脱了"
    },
    {
      "sid": "S00020",
      "start": 35.32,
      "end": 37.72,
      "text": "他们更像是一种脑袋里记了很多公式"
    },
    {
      "sid": "S00021",
      "start": 37.72,
      "end": 39.12,
      "text": "然后必须要套进去"
    },
    {
      "sid": "S00022",
      "start": 39.12,
      "end": 41.24,
      "text": "那么其实在我眼里这就是中毒了"
    },
    {
      "sid": "S00023",
      "start": 41.24,
      "end": 43.12,
      "text": "就是我认为的强框架中毒"
    },
    {
      "sid": "S00024",
      "start": 43.12,
      "end": 44.12,
      "text": "在我的私教课里"
    },
    {
      "sid": "S00025",
      "start": 44.12,
      "end": 46.2,
      "text": "我也叫它为理论中毒"
    },
    {
      "sid": "S00026",
      "start": 46.2,
      "end": 48.7,
      "text": "你学了太多的推拉框架高价的展示"
    },
    {
      "sid": "S00027",
      "start": 48.7,
      "end": 52.52,
      "text": "最后你把自己变成了一个只会执行程序的怪人"
    },
    {
      "sid": "S00028",
      "start": 52.52,
      "end": 54.7,
      "text": "而你在看完我今天这个内部案例之后"
    },
    {
      "sid": "S00029",
      "start": 54.7,
      "end": 57.0,
      "text": "我相信可以很好的解决这个问题"
    },
    {
      "sid": "S00030",
      "start": 57.0,
      "end": 58.62,
      "text": "那么首先我们来说一下这个学员"
    },
    {
      "sid": "S00031",
      "start": 58.62,
      "end": 59.76,
      "text": "这个学员25岁"
    },
    {
      "sid": "S00032",
      "start": 59.76,
      "end": 60.58,
      "text": "是个北京人"
    },
    {
      "sid": "S00033",
      "start": 60.58,
      "end": 61.48,
      "text": "是个工程师"
    },
    {
      "sid": "S00034",
      "start": 61.48,
      "end": 63.9,
      "text": "他的天赋和物性都是不错的"
    },
    {
      "sid": "S00035",
      "start": 63.9,
      "end": 65.36,
      "text": "对于很多game的理论"
    },
    {
      "sid": "S00036",
      "start": 65.36,
      "end": 66.9,
      "text": "我跟他讲了他都能明白"
    },
    {
      "sid": "S00037",
      "start": 66.9,
      "end": 67.88,
      "text": "也能很快上手"
    },
    {
      "sid": "S00038",
      "start": 67.88,
      "end": 69.26,
      "text": "只不过在处理问题上"
    },
    {
      "sid": "S00039",
      "start": 69.26,
      "end": 71.1,
      "text": "他有的时候有点抓牛角尖"
    },
    {
      "sid": "S00040",
      "start": 71.1,
      "end": 72.26,
      "text": "就是有点极端"
    },
    {
      "sid": "S00041",
      "start": 72.26,
      "end": 73.78,
      "text": "甚至说可以有点强迫症"
    },
    {
      "sid": "S00042",
      "start": 73.78,
      "end": 74.94,
      "text": "那么具体表现"
    },
    {
      "sid": "S00043",
      "start": 74.94,
      "end": 77.52,
      "text": "就是如果这个女生非常的喜欢他"
    },
    {
      "sid": "S00044",
      "start": 77.52,
      "end": 79.0,
      "text": "然后想要跟他发生信"
    },
    {
      "sid": "S00045",
      "start": 79.0,
      "end": 80.66,
      "text": "但是需要一个台阶"
    },
    {
      "sid": "S00046",
      "start": 80.66,
      "end": 82.3,
      "text": "但是他死活不愿意给这个台阶"
    },
    {
      "sid": "S00047",
      "start": 82.3,
      "end": 83.3,
      "text": "为什么不给这个台阶"
    },
    {
      "sid": "S00048",
      "start": 83.3,
      "end": 85.5,
      "text": "他认为就是我给了这个台阶之后"
    },
    {
      "sid": "S00049",
      "start": 85.5,
      "end": 86.98,
      "text": "我就成了舔狗了"
    },
    {
      "sid": "S00050",
      "start": 86.98,
      "end": 88.3,
      "text": "或者是我给了这个台阶之后"
    },
    {
      "sid": "S00051",
      "start": 88.3,
      "end": 89.06,
      "text": "我让步了"
    },
    {
      "sid": "S00052",
      "start": 89.06,
      "end": 91.52,
      "text": "那就说明我现在不是高位框架了"
    },
    {
      "sid": "S00053",
      "start": 91.52,
      "end": 92.54,
      "text": "其实是不对的"
    },
    {
      "sid": "S00054",
      "start": 92.54,
      "end": 93.8,
      "text": "很多时候有些女生"
    },
    {
      "sid": "S00055",
      "start": 93.8,
      "end": 95.4,
      "text": "他不是那种很自信的女生"
    },
    {
      "sid": "S00056",
      "start": 95.4,
      "end": 96.64,
      "text": "他就是需要一个台阶"
    },
    {
      "sid": "S00057",
      "start": 96.64,
      "end": 97.48,
      "text": "那么你给他"
    },
    {
      "sid": "S00058",
      "start": 97.48,
      "end": 98.62,
      "text": "那么就这个结果"
    },
    {
      "sid": "S00059",
      "start": 98.62,
      "end": 99.84,
      "text": "你不给了就没有了"
    },
    {
      "sid": "S00060",
      "start": 99.84,
      "end": 100.44,
      "text": "第二个问题"
    },
    {
      "sid": "S00061",
      "start": 100.44,
      "end": 101.7,
      "text": "就是他跟女人聊天"
    },
    {
      "sid": "S00062",
      "start": 101.7,
      "end": 104.46,
      "text": "这个女生一旦变成了黄灯或者是红灯"
    },
    {
      "sid": "S00063",
      "start": 104.46,
      "end": 105.84,
      "text": "他就会想破罐子破栓"
    },
    {
      "sid": "S00064",
      "start": 105.84,
      "end": 107.22,
      "text": "他就想跟这女生吵一架"
    },
    {
      "sid": "S00065",
      "start": 107.22,
      "end": 108.86,
      "text": "然后让这个女生把他拉黑删除"
    },
    {
      "sid": "S00066",
      "start": 108.86,
      "end": 110.34,
      "text": "只有这样子彻底撩死"
    },
    {
      "sid": "S00067",
      "start": 110.34,
      "end": 111.44,
      "text": "他才会停止内耗"
    },
    {
      "sid": "S00068",
      "start": 111.44,
      "end": 112.72,
      "text": "否则他就会一直内耗"
    },
    {
      "sid": "S00069",
      "start": 112.72,
      "end": 114.68,
      "text": "他不能接受他头上有一把"
    },
    {
      "sid": "S00070",
      "start": 114.68,
      "end": 115.96,
      "text": "达默克利斯之键"
    },
    {
      "sid": "S00071",
      "start": 115.96,
      "end": 117.16,
      "text": "随时掉下来那种感觉"
    },
    {
      "sid": "S00072",
      "start": 117.16,
      "end": 117.64,
      "text": "说实话"
    },
    {
      "sid": "S00073",
      "start": 117.64,
      "end": 119.04,
      "text": "我以前早期也是这样子"
    },
    {
      "sid": "S00074",
      "start": 119.04,
      "end": 119.56,
      "text": "但后面"
    },
    {
      "sid": "S00075",
      "start": 119.56,
      "end": 121.22,
      "text": "我在不断的锻炼自己一种"
    },
    {
      "sid": "S00076",
      "start": 121.22,
      "end": 124.12,
      "text": "对事情悬崖未绝的那种掌控感"
    },
    {
      "sid": "S00077",
      "start": 124.12,
      "end": 125.2,
      "text": "那种克制感"
    },
    {
      "sid": "S00078",
      "start": 125.2,
      "end": 126.58,
      "text": "然后经过很长时间的锻炼"
    },
    {
      "sid": "S00079",
      "start": 126.58,
      "end": 127.94,
      "text": "我现在已经完全能接受"
    },
    {
      "sid": "S00080",
      "start": 127.94,
      "end": 129.96,
      "text": "事情悬崖未绝的那种感觉了"
    },
    {
      "sid": "S00081",
      "start": 129.96,
      "end": 132.14,
      "text": "而且最主要的就是有一些女生"
    },
    {
      "sid": "S00082",
      "start": 132.14,
      "end": 134.68,
      "text": "她们就是需要你慢功出细活的"
    },
    {
      "sid": "S00083",
      "start": 134.68,
      "end": 135.74,
      "text": "你不能急于修成"
    },
    {
      "sid": "S00084",
      "start": 135.74,
      "end": 137.74,
      "text": "这样有的时候确实会达到反效果"
    },
    {
      "sid": "S00085",
      "start": 137.74,
      "end": 139.44,
      "text": "所以说我在接受这个学院之后"
    },
    {
      "sid": "S00086",
      "start": 139.44,
      "end": 141.1,
      "text": "我就很清楚的意识到"
    },
    {
      "sid": "S00087",
      "start": 141.1,
      "end": 142.4,
      "text": "他身上存在的一些问题"
    },
    {
      "sid": "S00088",
      "start": 142.4,
      "end": 144.22,
      "text": "这就是我过往的也存在的问题"
    },
    {
      "sid": "S00089",
      "start": 144.22,
      "end": 144.96,
      "text": "一般来说"
    },
    {
      "sid": "S00090",
      "start": 144.96,
      "end": 146.86,
      "text": "中毒的学院他其实是挺难带的"
    },
    {
      "sid": "S00091",
      "start": 146.86,
      "end": 148.44,
      "text": "因为他脑子里装了很多东西"
    },
    {
      "sid": "S00092",
      "start": 148.44,
      "end": 150.88,
      "text": "比如说我们把小白当成一个白纸"
    },
    {
      "sid": "S00093",
      "start": 150.88,
      "end": 151.98,
      "text": "那么中毒的兄弟"
    },
    {
      "sid": "S00094",
      "start": 151.98,
      "end": 154.62,
      "text": "就更多的是一个画了五颜六色的画"
    },
    {
      "sid": "S00095",
      "start": 154.62,
      "end": 156.28,
      "text": "然后你这个时候你要给他解读"
    },
    {
      "sid": "S00096",
      "start": 156.28,
      "end": 157.56,
      "text": "你要给他重新变成白纸"
    },
    {
      "sid": "S00097",
      "start": 157.56,
      "end": 158.68,
      "text": "实际是很难的"
    },
    {
      "sid": "S00098",
      "start": 158.68,
      "end": 159.86,
      "text": "那我们废话不多说"
    },
    {
      "sid": "S00099",
      "start": 159.86,
      "end": 161.42,
      "text": "我们先看第一张截图"
    },
    {
      "sid": "S00100",
      "start": 161.42,
      "end": 163.02,
      "text": "这个学院在下午三点的时候"
    },
    {
      "sid": "S00101",
      "start": 163.02,
      "end": 164.46,
      "text": "发了一个最后通牒"
    },
    {
      "sid": "S00102",
      "start": 164.46,
      "end": 165.72,
      "text": "至周六五点下班"
    },
    {
      "sid": "S00103",
      "start": 165.72,
      "end": 166.56,
      "text": "我们去开房"
    },
    {
      "sid": "S00104",
      "start": 166.56,
      "end": 168.22,
      "text": "你们来感受一下这种压迫感"
    },
    {
      "sid": "S00105",
      "start": 168.22,
      "end": 168.72,
      "text": "兄弟们"
    },
    {
      "sid": "S00106",
      "start": 168.72,
      "end": 169.96,
      "text": "是不是觉得非常的帅"
    },
    {
      "sid": "S00107",
      "start": 169.96,
      "end": 171.02,
      "text": "非常的酷"
    },
    {
      "sid": "S00108",
      "start": 171.02,
      "end": 172.22,
      "text": "是不是非常的强框架"
    },
    {
      "sid": "S00109",
      "start": 172.22,
      "end": 172.52,
      "text": "错"
    },
    {
      "sid": "S00110",
      "start": 172.52,
      "end": 173.44,
      "text": "这不叫强框架"
    },
    {
      "sid": "S00111",
      "start": 173.44,
      "end": 174.64,
      "text": "这是自插式进攻"
    },
    {
      "sid": "S00112",
      "start": 174.64,
      "end": 175.94,
      "text": "你们可以看女生的反应"
    },
    {
      "sid": "S00113",
      "start": 175.94,
      "end": 176.62,
      "text": "你跟谁"
    },
    {
      "sid": "S00114",
      "start": 176.62,
      "end": 177.7,
      "text": "这明显是一个试探"
    },
    {
      "sid": "S00115",
      "start": 177.7,
      "end": 178.78,
      "text": "学员回咱俩"
    },
    {
      "sid": "S00116",
      "start": 178.78,
      "end": 179.92,
      "text": "那么接下来的女生"
    },
    {
      "sid": "S00117",
      "start": 179.92,
      "end": 181.5,
      "text": "直接就祭出了他的杀招"
    },
    {
      "sid": "S00118",
      "start": 181.5,
      "end": 182.76,
      "text": "我们还没有确定关系"
    },
    {
      "sid": "S00119",
      "start": 182.76,
      "end": 183.64,
      "text": "我们怎么能开房"
    },
    {
      "sid": "S00120",
      "start": 183.64,
      "end": 184.66,
      "text": "很多兄弟在这里"
    },
    {
      "sid": "S00121",
      "start": 184.66,
      "end": 186.7,
      "text": "就会犯跟兄弟一样的错误"
    },
    {
      "sid": "S00122",
      "start": 186.7,
      "end": 187.7,
      "text": "开始跟女生讲道理"
    },
    {
      "sid": "S00123",
      "start": 187.7,
      "end": 188.56,
      "text": "那么他回的话"
    },
    {
      "sid": "S00124",
      "start": 188.56,
      "end": 189.32,
      "text": "我就不念了"
    },
    {
      "sid": "S00125",
      "start": 189.32,
      "end": 190.84,
      "text": "兄弟们可以暂停的看一下"
    },
    {
      "sid": "S00126",
      "start": 190.84,
      "end": 191.62,
      "text": "你们记住"
    },
    {
      "sid": "S00127",
      "start": 191.62,
      "end": 193.68,
      "text": "在女人感性的世界里"
    },
    {
      "sid": "S00128",
      "start": 193.68,
      "end": 194.34,
      "text": "讲逻辑"
    },
    {
      "sid": "S00129",
      "start": 194.34,
      "end": 195.64,
      "text": "是最大的不符合逻辑"
    },
    {
      "sid": "S00130",
      "start": 195.64,
      "end": 197.54,
      "text": "永远不要试图用逻辑"
    },
    {
      "sid": "S00131",
      "start": 197.54,
      "end": 199.82,
      "text": "去说服一个需要感觉的女生"
    },
    {
      "sid": "S00132",
      "start": 199.82,
      "end": 201.1,
      "text": "因为你一旦这么说了"
    },
    {
      "sid": "S00133",
      "start": 201.1,
      "end": 202.16,
      "text": "你到底想要跟他打炮"
    },
    {
      "sid": "S00134",
      "start": 202.16,
      "end": 203.12,
      "text": "还是想要跟他辩论"
    },
    {
      "sid": "S00135",
      "start": 203.12,
      "end": 203.98,
      "text": "所以在这里"
    },
    {
      "sid": "S00136",
      "start": 203.98,
      "end": 204.98,
      "text": "女生的潜台词"
    },
    {
      "sid": "S00137",
      "start": 204.98,
      "end": 206.24,
      "text": "不是我不去"
    },
    {
      "sid": "S00138",
      "start": 206.24,
      "end": 208.44,
      "text": "而是我不能无缘无故的"
    },
    {
      "sid": "S00139",
      "start": 208.44,
      "end": 209.34,
      "text": "就去跟你打炮"
    },
    {
      "sid": "S00140",
      "start": 209.34,
      "end": 210.52,
      "text": "所以说他需要的是"
    },
    {
      "sid": "S00141",
      "start": 210.52,
      "end": 212.1,
      "text": "你给他一个合理化的借口"
    },
    {
      "sid": "S00142",
      "start": 212.1,
      "end": 213.32,
      "text": "去绕开他的ASD"
    },
    {
      "sid": "S00143",
      "start": 213.32,
      "end": 215.26,
      "text": "就这女生已经把自己给开圆了"
    },
    {
      "sid": "S00144",
      "start": 215.26,
      "end": 217.66,
      "text": "他已经很明显的在告诉这个男生"
    },
    {
      "sid": "S00145",
      "start": 217.66,
      "end": 218.4,
      "text": "我想要什么"
    },
    {
      "sid": "S00146",
      "start": 218.4,
      "end": 219.16,
      "text": "但是这个学员"
    },
    {
      "sid": "S00147",
      "start": 219.16,
      "end": 221.9,
      "text": "还是太想去维持高框架人设"
    },
    {
      "sid": "S00148",
      "start": 221.9,
      "end": 223.08,
      "text": "以至于他忘了"
    },
    {
      "sid": "S00149",
      "start": 223.08,
      "end": 224.74,
      "text": "女人他也是有道德压力的"
    },
    {
      "sid": "S00150",
      "start": 224.74,
      "end": 227.04,
      "text": "你需要去合理化他的道德压力"
    },
    {
      "sid": "S00151",
      "start": 227.04,
      "end": 229.32,
      "text": "我之后也是告诉了他一些底层逻辑"
    },
    {
      "sid": "S00152",
      "start": 229.32,
      "end": 230.92,
      "text": "让他去给女生台阶下"
    },
    {
      "sid": "S00153",
      "start": 230.92,
      "end": 232.02,
      "text": "你们可以暂停看一下"
    },
    {
      "sid": "S00154",
      "start": 232.02,
      "end": 233.12,
      "text": "我是怎么说的"
    },
    {
      "sid": "S00155",
      "start": 233.12,
      "end": 234.18,
      "text": "好我们继续"
    },
    {
      "sid": "S00156",
      "start": 234.18,
      "end": 236.36,
      "text": "因为之前聊天聊奔的缘故"
    },
    {
      "sid": "S00157",
      "start": 236.36,
      "end": 237.3,
      "text": "你们也可以看到"
    },
    {
      "sid": "S00158",
      "start": 237.3,
      "end": 239.3,
      "text": "女生最后已经说出"
    },
    {
      "sid": "S00159",
      "start": 239.3,
      "end": 240.58,
      "text": "这礼拜就悬了"
    },
    {
      "sid": "S00160",
      "start": 240.58,
      "end": 241.84,
      "text": "要等下周这句话"
    },
    {
      "sid": "S00161",
      "start": 241.84,
      "end": 244.6,
      "text": "那一般情况下这就属于死刑讯告了"
    },
    {
      "sid": "S00162",
      "start": 244.6,
      "end": 245.52,
      "text": "学员也慌了"
    },
    {
      "sid": "S00163",
      "start": 245.52,
      "end": 246.38,
      "text": "跑来问我"
    },
    {
      "sid": "S00164",
      "start": 246.38,
      "end": 247.6,
      "text": "迈克我该怎么办"
    },
    {
      "sid": "S00165",
      "start": 247.6,
      "end": 248.3,
      "text": "我告诉他"
    },
    {
      "sid": "S00166",
      "start": 248.3,
      "end": 249.58,
      "text": "要继续立人设"
    },
    {
      "sid": "S00167",
      "start": 249.58,
      "end": 250.46,
      "text": "给他台阶"
    },
    {
      "sid": "S00168",
      "start": 250.46,
      "end": 252.46,
      "text": "同样我也给了他两段话术"
    },
    {
      "sid": "S00169",
      "start": 252.46,
      "end": 253.8,
      "text": "我建议所有的兄弟们"
    },
    {
      "sid": "S00170",
      "start": 253.8,
      "end": 255.22,
      "text": "都去理解一下"
    },
    {
      "sid": "S00171",
      "start": 255.22,
      "end": 257.94,
      "text": "我这两段话术的背后的底层逻辑"
    },
    {
      "sid": "S00172",
      "start": 257.94,
      "end": 258.6,
      "text": "想一想"
    },
    {
      "sid": "S00173",
      "start": 258.6,
      "end": 260.12,
      "text": "迈克为什么要这么说"
    },
    {
      "sid": "S00174",
      "start": 260.12,
      "end": 260.74,
      "text": "第一段话"
    },
    {
      "sid": "S00175",
      "start": 260.74,
      "end": 262.06,
      "text": "我还是把截图放出来"
    },
    {
      "sid": "S00176",
      "start": 262.06,
      "end": 263.38,
      "text": "兄弟们可以暂停看一下"
    },
    {
      "sid": "S00177",
      "start": 263.38,
      "end": 264.66,
      "text": "好看完了吧"
    },
    {
      "sid": "S00178",
      "start": 264.66,
      "end": 265.92,
      "text": "我这里用的是一招"
    },
    {
      "sid": "S00179",
      "start": 265.92,
      "end": 266.94,
      "text": "叫做以退为进"
    },
    {
      "sid": "S00180",
      "start": 266.94,
      "end": 269.12,
      "text": "这段话给女生的感受是什么"
    },
    {
      "sid": "S00181",
      "start": 269.12,
      "end": 270.72,
      "text": "你不是在拒绝给名分吗"
    },
    {
      "sid": "S00182",
      "start": 270.72,
      "end": 272.54,
      "text": "好我承认我把你当女朋友"
    },
    {
      "sid": "S00183",
      "start": 272.54,
      "end": 274.72,
      "text": "那为什么我不跟你确定关系"
    },
    {
      "sid": "S00184",
      "start": 274.72,
      "end": 276.26,
      "text": "因为我的内心有阴影"
    },
    {
      "sid": "S00185",
      "start": 276.26,
      "end": 277.54,
      "text": "我害怕责任"
    },
    {
      "sid": "S00186",
      "start": 277.54,
      "end": 278.04,
      "text": "看到没有"
    },
    {
      "sid": "S00187",
      "start": 278.04,
      "end": 280.12,
      "text": "我把问题从我想要白嫖你"
    },
    {
      "sid": "S00188",
      "start": 280.12,
      "end": 281.16,
      "text": "转变成了一个"
    },
    {
      "sid": "S00189",
      "start": 281.16,
      "end": 283.62,
      "text": "我是受过伤的真诚男人"
    },
    {
      "sid": "S00190",
      "start": 283.62,
      "end": 284.3,
      "text": "这样一来呢"
    },
    {
      "sid": "S00191",
      "start": 284.3,
      "end": 285.56,
      "text": "就弱化了学员之前"
    },
    {
      "sid": "S00192",
      "start": 285.56,
      "end": 286.66,
      "text": "给出的需求感"
    },
    {
      "sid": "S00193",
      "start": 286.66,
      "end": 288.72,
      "text": "反而强化了他的真诚"
    },
    {
      "sid": "S00194",
      "start": 288.72,
      "end": 289.7,
      "text": "而这个内容呢"
    },
    {
      "sid": "S00195",
      "start": 289.7,
      "end": 291.94,
      "text": "也是在我即将推出的支配游戏中"
    },
    {
      "sid": "S00196",
      "start": 291.94,
      "end": 292.6,
      "text": "也有设计"
    },
    {
      "sid": "S00197",
      "start": 292.6,
      "end": 293.36,
      "text": "很多时候呢"
    },
    {
      "sid": "S00198",
      "start": 293.36,
      "end": 294.78,
      "text": "其实不仅仅只有高位镇压"
    },
    {
      "sid": "S00199",
      "start": 294.78,
      "end": 296.08,
      "text": "才能去支配对方"
    },
    {
      "sid": "S00200",
      "start": 296.08,
      "end": 296.96,
      "text": "以退为进"
    },
    {
      "sid": "S00201",
      "start": 296.96,
      "end": 297.96,
      "text": "也能支配对方"
    },
    {
      "sid": "S00202",
      "start": 297.96,
      "end": 299.24,
      "text": "就像孙子兵法里说的"
    },
    {
      "sid": "S00203",
      "start": 299.24,
      "end": 300.24,
      "text": "兵无常事"
    },
    {
      "sid": "S00204",
      "start": 300.24,
      "end": 301.46,
      "text": "水无常行"
    },
    {
      "sid": "S00205",
      "start": 301.46,
      "end": 301.72,
      "text": "好"
    },
    {
      "sid": "S00206",
      "start": 301.72,
      "end": 303.1,
      "text": "那我们话扯远了"
    },
    {
      "sid": "S00207",
      "start": 303.1,
      "end": 303.76,
      "text": "我们来看看"
    },
    {
      "sid": "S00208",
      "start": 303.76,
      "end": 305.8,
      "text": "我给这个学员发的第二句话说"
    },
    {
      "sid": "S00209",
      "start": 305.8,
      "end": 307.68,
      "text": "我就是很真诚的跟你处"
    },
    {
      "sid": "S00210",
      "start": 307.68,
      "end": 309.38,
      "text": "如果只是为了顺你的话"
    },
    {
      "sid": "S00211",
      "start": 309.38,
      "end": 311.26,
      "text": "那么我可以随便说我们的关系"
    },
    {
      "sid": "S00212",
      "start": 311.26,
      "end": 312.02,
      "text": "之前呢"
    },
    {
      "sid": "S00213",
      "start": 312.02,
      "end": 313.0,
      "text": "我们是以退为进"
    },
    {
      "sid": "S00214",
      "start": 313.0,
      "end": 313.66,
      "text": "那这里呢"
    },
    {
      "sid": "S00215",
      "start": 313.66,
      "end": 315.0,
      "text": "叫做逼宫绝杀"
    },
    {
      "sid": "S00216",
      "start": 315.0,
      "end": 316.34,
      "text": "这句话的潜台词就是"
    },
    {
      "sid": "S00217",
      "start": 316.34,
      "end": 317.6,
      "text": "相当于告诉女生"
    },
    {
      "sid": "S00218",
      "start": 317.6,
      "end": 319.3,
      "text": "骗子才会给出承诺"
    },
    {
      "sid": "S00219",
      "start": 319.3,
      "end": 320.54,
      "text": "因为我不是骗子"
    },
    {
      "sid": "S00220",
      "start": 320.54,
      "end": 322.04,
      "text": "我不想给出这个承诺"
    },
    {
      "sid": "S00221",
      "start": 322.04,
      "end": 323.9,
      "text": "因为骗子它是不在乎后果的"
    },
    {
      "sid": "S00222",
      "start": 323.9,
      "end": 324.7,
      "text": "而我不给呢"
    },
    {
      "sid": "S00223",
      "start": 324.7,
      "end": 326.44,
      "text": "是因为我太看重这种关系了"
    },
    {
      "sid": "S00224",
      "start": 326.44,
      "end": 327.44,
      "text": "我不想骗你"
    },
    {
      "sid": "S00225",
      "start": 327.44,
      "end": 328.96,
      "text": "这句话直接把没名分"
    },
    {
      "sid": "S00226",
      "start": 328.96,
      "end": 331.22,
      "text": "这颗毒药包装成了我很正直"
    },
    {
      "sid": "S00227",
      "start": 331.22,
      "end": 332.8,
      "text": "所以说你们后来也看到了"
    },
    {
      "sid": "S00228",
      "start": 332.8,
      "end": 333.76,
      "text": "这个女生妥协了"
    },
    {
      "sid": "S00229",
      "start": 333.76,
      "end": 334.06,
      "text": "为什么"
    },
    {
      "sid": "S00230",
      "start": 334.06,
      "end": 336.3,
      "text": "因为她给了足够的面子"
    },
    {
      "sid": "S00231",
      "start": 336.3,
      "end": 337.5,
      "text": "给了足够的台阶"
    },
    {
      "sid": "S00232",
      "start": 337.5,
      "end": 339.06,
      "text": "让这个女生无法拒绝她"
    },
    {
      "sid": "S00233",
      "start": 339.06,
      "end": 340.9,
      "text": "这个女生可以自己告诉自己"
    },
    {
      "sid": "S00234",
      "start": 340.9,
      "end": 342.28,
      "text": "她不是不想负责"
    },
    {
      "sid": "S00235",
      "start": 342.28,
      "end": 343.52,
      "text": "她只是太真诚了"
    },
    {
      "sid": "S00236",
      "start": 343.52,
      "end": 345.2,
      "text": "她其实是想把我当女朋友的"
    },
    {
      "sid": "S00237",
      "start": 345.2,
      "end": 345.9,
      "text": "再之后呢"
    },
    {
      "sid": "S00238",
      "start": 345.9,
      "end": 347.72,
      "text": "这个学员也是和这个女生打上了炮"
    },
    {
      "sid": "S00239",
      "start": 347.72,
      "end": 348.66,
      "text": "成功得失"
    },
    {
      "sid": "S00240",
      "start": 348.66,
      "end": 350.28,
      "text": "那关于这个女生的聊天呢"
    },
    {
      "sid": "S00241",
      "start": 350.28,
      "end": 351.52,
      "text": "我们就先告一段落"
    },
    {
      "sid": "S00242",
      "start": 351.52,
      "end": 352.2,
      "text": "这个学员呢"
    },
    {
      "sid": "S00243",
      "start": 352.2,
      "end": 353.18,
      "text": "我一开始就有说过"
    },
    {
      "sid": "S00244",
      "start": 353.18,
      "end": 353.88,
      "text": "她天赋很高"
    },
    {
      "sid": "S00245",
      "start": 353.88,
      "end": 355.26,
      "text": "她是不缺性资源的"
    },
    {
      "sid": "S00246",
      "start": 355.26,
      "end": 356.16,
      "text": "所以说很多时候呢"
    },
    {
      "sid": "S00247",
      "start": 356.16,
      "end": 357.04,
      "text": "是多线并进"
    },
    {
      "sid": "S00248",
      "start": 357.04,
      "end": 358.1,
      "text": "但是呢就是容易"
    },
    {
      "sid": "S00249",
      "start": 358.1,
      "end": 360.48,
      "text": "一不小心就掉进了框架的怪圈"
    },
    {
      "sid": "S00250",
      "start": 360.48,
      "end": 362.14,
      "text": "从小让自己当一个alpha男人"
    },
    {
      "sid": "S00251",
      "start": 362.14,
      "end": 363.2,
      "text": "然后把其他人不当人"
    },
    {
      "sid": "S00252",
      "start": 363.2,
      "end": 365.02,
      "text": "那我们也来看另外一个案例"
    },
    {
      "sid": "S00253",
      "start": 365.02,
      "end": 366.18,
      "text": "同样也是这个学员"
    },
    {
      "sid": "S00254",
      "start": 366.18,
      "end": 367.24,
      "text": "她跟我反馈啊"
    },
    {
      "sid": "S00255",
      "start": 367.24,
      "end": 368.38,
      "text": "朋友圈这个女生"
    },
    {
      "sid": "S00256",
      "start": 368.38,
      "end": 370.1,
      "text": "给人的感觉像是放盗女"
    },
    {
      "sid": "S00257",
      "start": 370.1,
      "end": 370.9,
      "text": "但那天呢"
    },
    {
      "sid": "S00258",
      "start": 370.9,
      "end": 372.44,
      "text": "她其实是表现得很保守"
    },
    {
      "sid": "S00259",
      "start": 372.44,
      "end": 373.12,
      "text": "我该怎么办"
    },
    {
      "sid": "S00260",
      "start": 373.12,
      "end": 373.82,
      "text": "那这里呢"
    },
    {
      "sid": "S00261",
      "start": 373.82,
      "end": 375.3,
      "text": "我分享一个核心概念"
    },
    {
      "sid": "S00262",
      "start": 375.3,
      "end": 377.1,
      "text": "就是人她其实是有水分的"
    },
    {
      "sid": "S00263",
      "start": 377.1,
      "end": 378.04,
      "text": "一个女生的朋友圈"
    },
    {
      "sid": "S00264",
      "start": 378.04,
      "end": 379.96,
      "text": "她永远只有一定的参考价值"
    },
    {
      "sid": "S00265",
      "start": 379.96,
      "end": 381.56,
      "text": "但是绝对不能代表着她"
    },
    {
      "sid": "S00266",
      "start": 381.56,
      "end": 382.28,
      "text": "因为很多女生"
    },
    {
      "sid": "S00267",
      "start": 382.28,
      "end": 384.22,
      "text": "她可能朋友圈更新的非常的频繁"
    },
    {
      "sid": "S00268",
      "start": 384.22,
      "end": 385.68,
      "text": "放了很多很性感的照片"
    },
    {
      "sid": "S00269",
      "start": 385.68,
      "end": 386.98,
      "text": "她其实是想表现得"
    },
    {
      "sid": "S00270",
      "start": 386.98,
      "end": 387.9,
      "text": "她是一个很自信的人"
    },
    {
      "sid": "S00271",
      "start": 387.9,
      "end": 388.88,
      "text": "但是什么样的人"
    },
    {
      "sid": "S00272",
      "start": 388.88,
      "end": 390.02,
      "text": "会想要去这么做"
    },
    {
      "sid": "S00273",
      "start": 390.02,
      "end": 390.7,
      "text": "这种女生呢"
    },
    {
      "sid": "S00274",
      "start": 390.7,
      "end": 391.74,
      "text": "往往是不自信的"
    },
    {
      "sid": "S00275",
      "start": 391.74,
      "end": 393.38,
      "text": "她可能内心是非常敏感的"
    },
    {
      "sid": "S00276",
      "start": 393.38,
      "end": 394.38,
      "text": "她发这些照片"
    },
    {
      "sid": "S00277",
      "start": 394.38,
      "end": 395.62,
      "text": "其实只是为了自证"
    },
    {
      "sid": "S00278",
      "start": 395.62,
      "end": 396.6,
      "text": "我是一个自信的人"
    },
    {
      "sid": "S00279",
      "start": 396.6,
      "end": 397.5,
      "text": "但是他们依然"
    },
    {
      "sid": "S00280",
      "start": 397.5,
      "end": 398.38,
      "text": "其实是很敏感"
    },
    {
      "sid": "S00281",
      "start": 398.38,
      "end": 399.48,
      "text": "如果你直接用朋友圈"
    },
    {
      "sid": "S00282",
      "start": 399.48,
      "end": 400.2,
      "text": "去定义一个人"
    },
    {
      "sid": "S00283",
      "start": 400.2,
      "end": 401.58,
      "text": "那么你就会像这个学员一样"
    },
    {
      "sid": "S00284",
      "start": 401.58,
      "end": 402.86,
      "text": "表现得前后不一致"
    },
    {
      "sid": "S00285",
      "start": 402.86,
      "end": 404.46,
      "text": "很多时候一个完整的"
    },
    {
      "sid": "S00286",
      "start": 404.46,
      "end": 405.56,
      "text": "富有信张力的人"
    },
    {
      "sid": "S00287",
      "start": 405.56,
      "end": 407.52,
      "text": "她是往往具备阴阳两面"
    },
    {
      "sid": "S00288",
      "start": 407.52,
      "end": 409.76,
      "text": "如果你一直展示你的阳面"
    },
    {
      "sid": "S00289",
      "start": 409.76,
      "end": 411.76,
      "text": "那么就过刚一折"
    },
    {
      "sid": "S00290",
      "start": 411.76,
      "end": 413.62,
      "text": "反而会损失你自身的魅力"
    },
    {
      "sid": "S00291",
      "start": 413.62,
      "end": 414.68,
      "text": "所以说很多时候"
    },
    {
      "sid": "S00292",
      "start": 414.68,
      "end": 415.54,
      "text": "在你拿不准"
    },
    {
      "sid": "S00293",
      "start": 415.54,
      "end": 416.58,
      "text": "什么时候该退"
    },
    {
      "sid": "S00294",
      "start": 416.58,
      "end": 417.88,
      "text": "什么时候该进的时候"
    },
    {
      "sid": "S00295",
      "start": 417.88,
      "end": 419.38,
      "text": "那么你其实是需要找一个"
    },
    {
      "sid": "S00296",
      "start": 419.38,
      "end": 421.34,
      "text": "专业人士去进行学习的"
    },
    {
      "sid": "S00297",
      "start": 421.34,
      "end": 422.08,
      "text": "那么在最后"
    },
    {
      "sid": "S00298",
      "start": 422.08,
      "end": 422.9,
      "text": "我想兄弟们"
    },
    {
      "sid": "S00299",
      "start": 422.9,
      "end": 423.96,
      "text": "你可以看这张图"
    },
    {
      "sid": "S00300",
      "start": 423.96,
      "end": 425.6,
      "text": "这个学员在过去半年里"
    },
    {
      "sid": "S00301",
      "start": 425.6,
      "end": 427.22,
      "text": "无数次跟我提到"
    },
    {
      "sid": "S00302",
      "start": 427.22,
      "end": 428.44,
      "text": "中毒需要解读"
    },
    {
      "sid": "S00303",
      "start": 428.44,
      "end": 429.4,
      "text": "在解读之后"
    },
    {
      "sid": "S00304",
      "start": 429.4,
      "end": 430.4,
      "text": "她现在的状态是"
    },
    {
      "sid": "S00305",
      "start": 430.4,
      "end": 431.82,
      "text": "有四五个固定炮友"
    },
    {
      "sid": "S00306",
      "start": 431.82,
      "end": 432.88,
      "text": "能随时约出来"
    },
    {
      "sid": "S00307",
      "start": 432.88,
      "end": 434.3,
      "text": "甚至可以接训女生家里"
    },
    {
      "sid": "S00308",
      "start": 434.3,
      "end": 435.2,
      "text": "甚至是之前"
    },
    {
      "sid": "S00309",
      "start": 435.2,
      "end": 436.7,
      "text": "把她拉黑过的北京富婆"
    },
    {
      "sid": "S00310",
      "start": 436.7,
      "end": 438.56,
      "text": "现在也得乖乖的听她话"
    },
    {
      "sid": "S00311",
      "start": 438.56,
      "end": 439.22,
      "text": "不过到这里"
    },
    {
      "sid": "S00312",
      "start": 439.22,
      "end": 441.1,
      "text": "我想在看视频的各位"
    },
    {
      "sid": "S00313",
      "start": 441.1,
      "end": 442.58,
      "text": "你们羡慕这种状态吗"
    },
    {
      "sid": "S00314",
      "start": 442.58,
      "end": 443.86,
      "text": "我想百万之八十的兄弟"
    },
    {
      "sid": "S00315",
      "start": 443.86,
      "end": 444.66,
      "text": "可能都会羡慕"
    },
    {
      "sid": "S00316",
      "start": 444.66,
      "end": 445.4,
      "text": "但我认为"
    },
    {
      "sid": "S00317",
      "start": 445.4,
      "end": 447.1,
      "text": "这不应该是你们追求的"
    },
    {
      "sid": "S00318",
      "start": 447.1,
      "end": 447.72,
      "text": "十要终点"
    },
    {
      "sid": "S00319",
      "start": 447.72,
      "end": 448.96,
      "text": "这个学院在解读之后"
    },
    {
      "sid": "S00320",
      "start": 448.96,
      "end": 450.68,
      "text": "已经拥有了非常可贵的东西"
    },
    {
      "sid": "S00321",
      "start": 450.68,
      "end": 451.82,
      "text": "那就是热情的力量"
    },
    {
      "sid": "S00322",
      "start": 451.82,
      "end": 452.84,
      "text": "很多屏幕前的兄弟们"
    },
    {
      "sid": "S00323",
      "start": 452.84,
      "end": 453.68,
      "text": "你们是没有的"
    },
    {
      "sid": "S00324",
      "start": 453.68,
      "end": 455.5,
      "text": "如果你只是想像一个打中机一样"
    },
    {
      "sid": "S00325",
      "start": 455.5,
      "end": 457.84,
      "text": "每天在不同的女生面前穿插"
    },
    {
      "sid": "S00326",
      "start": 457.84,
      "end": 459.36,
      "text": "用着同样的套路"
    },
    {
      "sid": "S00327",
      "start": 459.36,
      "end": 460.3,
      "text": "说着同样的话"
    },
    {
      "sid": "S00328",
      "start": 460.3,
      "end": 461.04,
      "text": "那么最后"
    },
    {
      "sid": "S00329",
      "start": 461.04,
      "end": 463.14,
      "text": "你一定会对女人失去兴趣的"
    },
    {
      "sid": "S00330",
      "start": 463.14,
      "end": 464.22,
      "text": "你会觉得把妹"
    },
    {
      "sid": "S00331",
      "start": 464.22,
      "end": 465.2,
      "text": "是件很累的事情"
    },
    {
      "sid": "S00332",
      "start": 465.2,
      "end": 466.16,
      "text": "这就像我前几天"
    },
    {
      "sid": "S00333",
      "start": 466.16,
      "end": 467.22,
      "text": "在支配游戏里面"
    },
    {
      "sid": "S00334",
      "start": 467.22,
      "end": 468.28,
      "text": "写到的一段话"
    },
    {
      "sid": "S00335",
      "start": 468.28,
      "end": 469.5,
      "text": "我这里我可以读出来"
    },
    {
      "sid": "S00336",
      "start": 469.5,
      "end": 470.18,
      "text": "分享给大家"
    },
    {
      "sid": "S00337",
      "start": 470.18,
      "end": 471.54,
      "text": "我希望兄弟们记住"
    },
    {
      "sid": "S00338",
      "start": 471.54,
      "end": 473.34,
      "text": "技术只是你game的骨架"
    },
    {
      "sid": "S00339",
      "start": 473.34,
      "end": 474.92,
      "text": "而热情才是燃油"
    },
    {
      "sid": "S00340",
      "start": 474.92,
      "end": 475.84,
      "text": "没有油的话"
    },
    {
      "sid": "S00341",
      "start": 475.84,
      "end": 477.1,
      "text": "这台机器再精美"
    },
    {
      "sid": "S00342",
      "start": 477.1,
      "end": 478.36,
      "text": "它只是一堆废铁"
    },
    {
      "sid": "S00343",
      "start": 478.36,
      "end": 480.52,
      "text": "高手和菜鸟的最大区别在于"
    },
    {
      "sid": "S00344",
      "start": 480.52,
      "end": 483.0,
      "text": "高手它是享受那个博弈的过程的"
    },
    {
      "sid": "S00345",
      "start": 483.0,
      "end": 483.9,
      "text": "它是享受那种"
    },
    {
      "sid": "S00346",
      "start": 483.9,
      "end": 484.78,
      "text": "哪怕被拒绝"
    },
    {
      "sid": "S00347",
      "start": 484.78,
      "end": 486.64,
      "text": "我也要展示自己的魅力的快感"
    },
    {
      "sid": "S00348",
      "start": 486.64,
      "end": 487.3,
      "text": "而不是一种"
    },
    {
      "sid": "S00349",
      "start": 487.3,
      "end": 488.3,
      "text": "我不可以被拒绝"
    },
    {
      "sid": "S00350",
      "start": 488.3,
      "end": 489.06,
      "text": "你去搭讪"
    },
    {
      "sid": "S00351",
      "start": 489.06,
      "end": 490.7,
      "text": "是因为你此刻心情好"
    },
    {
      "sid": "S00352",
      "start": 490.7,
      "end": 492.48,
      "text": "你想去把这种好的状态"
    },
    {
      "sid": "S00353",
      "start": 492.48,
      "end": 493.58,
      "text": "分享给对面人"
    },
    {
      "sid": "S00354",
      "start": 493.58,
      "end": 495.14,
      "text": "而不是去祈求对方"
    },
    {
      "sid": "S00355",
      "start": 495.14,
      "end": 496.68,
      "text": "给你一个好的反应"
    },
    {
      "sid": "S00356",
      "start": 496.68,
      "end": 498.02,
      "text": "你得学会去挖掘"
    },
    {
      "sid": "S00357",
      "start": 498.02,
      "end": 499.16,
      "text": "女性身上的那种"
    },
    {
      "sid": "S00358",
      "start": 499.16,
      "end": 500.16,
      "text": "独特的生命力"
    },
    {
      "sid": "S00359",
      "start": 500.16,
      "end": 501.44,
      "text": "去欣赏她们的审美"
    },
    {
      "sid": "S00360",
      "start": 501.44,
      "end": 502.16,
      "text": "她们的倔强"
    },
    {
      "sid": "S00361",
      "start": 502.16,
      "end": 503.42,
      "text": "你得对这些女生"
    },
    {
      "sid": "S00362",
      "start": 503.42,
      "end": 505.48,
      "text": "或者是对这些NPC充满好奇"
    },
    {
      "sid": "S00363",
      "start": 505.48,
      "end": 506.8,
      "text": "一种就是我想看看"
    },
    {
      "sid": "S00364",
      "start": 506.8,
      "end": 508.4,
      "text": "你到底是什么样的那种状态"
    },
    {
      "sid": "S00365",
      "start": 508.4,
      "end": 509.26,
      "text": "去接近他们"
    },
    {
      "sid": "S00366",
      "start": 509.26,
      "end": 509.9,
      "text": "那个时候"
    },
    {
      "sid": "S00367",
      "start": 509.9,
      "end": 511.3,
      "text": "你的眼里是有光的"
    },
    {
      "sid": "S00368",
      "start": 511.3,
      "end": 511.9,
      "text": "这种光"
    },
    {
      "sid": "S00369",
      "start": 511.9,
      "end": 514.06,
      "text": "比任何精心准备的话术"
    },
    {
      "sid": "S00370",
      "start": 514.06,
      "end": 514.9,
      "text": "所带来的吸引"
    },
    {
      "sid": "S00371",
      "start": 514.9,
      "end": 515.64,
      "text": "都要致命"
    },
    {
      "sid": "S00372",
      "start": 515.64,
      "end": 516.46,
      "text": "到这里"
    },
    {
      "sid": "S00373",
      "start": 516.46,
      "end": 518.06,
      "text": "这个视频已经接近尾声了"
    },
    {
      "sid": "S00374",
      "start": 518.06,
      "end": 519.16,
      "text": "我做这些视频的目的"
    },
    {
      "sid": "S00375",
      "start": 519.16,
      "end": 520.84,
      "text": "是为了让很多已经中毒"
    },
    {
      "sid": "S00376",
      "start": 520.84,
      "end": 521.52,
      "text": "或者是"
    },
    {
      "sid": "S00377",
      "start": 521.52,
      "end": 523.5,
      "text": "每天睡很多妞蛋不开心的兄弟"
    },
    {
      "sid": "S00378",
      "start": 523.5,
      "end": 524.74,
      "text": "去认清自己"
    },
    {
      "sid": "S00379",
      "start": 524.74,
      "end": 525.7,
      "text": "我们讲的解读"
    },
    {
      "sid": "S00380",
      "start": 525.7,
      "end": 526.88,
      "text": "不是让你变回"
    },
    {
      "sid": "S00381",
      "start": 526.88,
      "end": 528.62,
      "text": "让女生牵着鼻子走的舔狗"
    },
    {
      "sid": "S00382",
      "start": 528.62,
      "end": 529.64,
      "text": "而是让你明白"
    },
    {
      "sid": "S00383",
      "start": 529.64,
      "end": 531.82,
      "text": "技巧是用来降低沟通成本的"
    },
    {
      "sid": "S00384",
      "start": 531.82,
      "end": 533.1,
      "text": "但是它不能取代真诚"
    },
    {
      "sid": "S00385",
      "start": 533.1,
      "end": 533.9,
      "text": "真正的强者"
    },
    {
      "sid": "S00386",
      "start": 533.9,
      "end": 535.82,
      "text": "是不需要时时刻刻提醒自己"
    },
    {
      "sid": "S00387",
      "start": 535.82,
      "end": 536.94,
      "text": "要一定要够强"
    },
    {
      "sid": "S00388",
      "start": 536.94,
      "end": 537.6,
      "text": "够strong"
    },
    {
      "sid": "S00389",
      "start": 537.6,
      "end": 538.12,
      "text": "示弱"
    },
    {
      "sid": "S00390",
      "start": 538.12,
      "end": 539.84,
      "text": "其实也是一种强大来的"
    },
    {
      "sid": "S00391",
      "start": 539.84,
      "end": 540.6,
      "text": "那么今天这个案例"
    },
    {
      "sid": "S00392",
      "start": 540.6,
      "end": 541.72,
      "text": "只是我私教库里"
    },
    {
      "sid": "S00393",
      "start": 541.72,
      "end": 542.82,
      "text": "比较特殊的一个案例"
    },
    {
      "sid": "S00394",
      "start": 542.82,
      "end": 544.18,
      "text": "如果你也像这个学院一样"
    },
    {
      "sid": "S00395",
      "start": 544.18,
      "end": 545.62,
      "text": "在多线并进中"
    },
    {
      "sid": "S00396",
      "start": 545.62,
      "end": 546.62,
      "text": "感到疲惫"
    },
    {
      "sid": "S00397",
      "start": 546.62,
      "end": 547.52,
      "text": "或者是感到累"
    },
    {
      "sid": "S00398",
      "start": 547.52,
      "end": 548.26,
      "text": "感到迷茫"
    },
    {
      "sid": "S00399",
      "start": 548.26,
      "end": 549.42,
      "text": "你可以添加我的威胁"
    },
    {
      "sid": "S00400",
      "start": 549.42,
      "end": 550.9,
      "text": "我会手把手带你去拆解"
    },
    {
      "sid": "S00401",
      "start": 550.9,
      "end": 551.96,
      "text": "最关键的问题"
    },
    {
      "sid": "S00402",
      "start": 551.96,
      "end": 553.0,
      "text": "我依旧希望"
    },
    {
      "sid": "S00403",
      "start": 553.0,
      "end": 554.22,
      "text": "看我视频的兄弟们"
    },
    {
      "sid": "S00404",
      "start": 554.22,
      "end": 555.62,
      "text": "能做一个有血有肉"
    },
    {
      "sid": "S00405",
      "start": 555.62,
      "end": 557.3,
      "text": "有灵魂的男人"
    },
    {
      "sid": "S00406",
      "start": 557.3,
      "end": 558.1,
      "text": "我是Mikey"
    },
    {
      "sid": "S00407",
      "start": 558.1,
      "end": 558.84,
      "text": "旧熟之道"
    },
    {
      "sid": "S00408",
      "start": 558.84,
      "end": 559.74,
      "text": "就在其中"
    },
    {
      "sid": "S00409",
      "start": 559.74,
      "end": 561.0,
      "text": "我们下一期视频见"
    }
  ]
}
