    },
    {
      "sid": "S00190",
      "start": 336.06,
      "end": 337.48,
      "text": "那么由于时间关系"
    },
    {
      "sid": "S00191",
      "start": 337.48,
      "end": 338.88,
      "text": "我只能挑选"
    },
    {
      "sid": "S00192",
      "start": 338.88,
      "end": 341.06,
      "text": "我认为最重要的一条来讲"
    },
    {
      "sid": "S00193",
      "start": 341.06,
      "end": 344.1,
      "text": "也就是我视频中不断提及的自我"
    },
    {
      "sid": "S00194",
      "start": 344.1,
      "end": 345.56,
      "text": "因为就像我之前说的"
    },
    {
      "sid": "S00195",
      "start": 345.56,
      "end": 348.06,
      "text": "女人都是依靠感觉去行动的生物"
