    {
      "sid": "S00155",
      "start": 279.8,
      "end": 281.78,
      "text": "说白了就是拥有主体性"
    },
    {
      "sid": "S00156",
      "start": 281.78,
      "end": 283.28,
      "text": "不要将自己误化"
    },
    {
      "sid": "S00157",
      "start": 283.28,
      "end": 284.9,
      "text": "因为女人本上是侦探"
    },
    {
      "sid": "S00158",
      "start": 284.9,
      "end": 286.6,
      "text": "他们擅长于用线索"
