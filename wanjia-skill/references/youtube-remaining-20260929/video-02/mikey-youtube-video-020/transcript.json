{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-020",
  "youtube_id": "myHvEWyuWZI",
  "media_sha256": "42fae846fef3d9584ba92df1f043191c2bdd827bb904074cf110b76ec34319eb",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.28,
      "text": "Hello大家好我是Mikey"
    },
    {
      "sid": "S00002",
      "start": 1.28,
      "end": 5.88,
      "text": "今天我们来聊一聊该如何给女人留下强行为线索"
    },
    {
      "sid": "S00003",
      "start": 5.88,
      "end": 10.24,
      "text": "那么在此之前兄弟们得明白什么是强行为线索"
    },
    {
      "sid": "S00004",
      "start": 10.24,
      "end": 14.6,
      "text": "在之前的视频里你们会看到我讲强行为线索中的可责性"
    },
    {
      "sid": "S00005",
      "start": 14.6,
      "end": 15.88,
      "text": "或者是身要认证"
    },
    {
      "sid": "S00006",
      "start": 15.88,
      "end": 18.88,
      "text": "这些都是构成强行为线索的因素"
    },
    {
      "sid": "S00007",
      "start": 18.88,
      "end": 20.2,
      "text": "但又并非是全部"
    },
    {
      "sid": "S00008",
      "start": 20.2,
      "end": 22.24,
      "text": "强行为线索说直接一点"
    },
    {
      "sid": "S00009",
      "start": 22.24,
      "end": 25.92,
      "text": "就是人们不愿意相信自己所看见的所听见的"
    },
    {
      "sid": "S00010",
      "start": 25.92,
      "end": 28.68,
      "text": "他们只愿意相信自己所推理出来的东西"
    },
    {
      "sid": "S00011",
      "start": 28.68,
      "end": 30.16,
      "text": "那么我打个比方啊"
    },
    {
      "sid": "S00012",
      "start": 30.16,
      "end": 31.48,
      "text": "你现在面前有两个人"
    },
    {
      "sid": "S00013",
      "start": 31.48,
      "end": 33.8,
      "text": "他们都说自己是华尔街的操盘手"
    },
    {
      "sid": "S00014",
      "start": 33.8,
      "end": 36.16,
      "text": "有一只优质的股票给你来买"
    },
    {
      "sid": "S00015",
      "start": 36.16,
      "end": 37.04,
      "text": "那么其中呢"
    },
    {
      "sid": "S00016",
      "start": 37.04,
      "end": 38.52,
      "text": "一个是穿着高定西装"
    },
    {
      "sid": "S00017",
      "start": 38.52,
      "end": 39.96,
      "text": "戴着金丝眼镜"
    },
    {
      "sid": "S00018",
      "start": 39.96,
      "end": 41.44,
      "text": "梳着大油头的男人"
    },
    {
      "sid": "S00019",
      "start": 41.44,
      "end": 42.4,
      "text": "而另一个呢"
    },
    {
      "sid": "S00020",
      "start": 42.4,
      "end": 44.08,
      "text": "则是穿着一身大卫衣"
    },
    {
      "sid": "S00021",
      "start": 44.08,
      "end": 44.88,
      "text": "牛仔裤"
    },
    {
      "sid": "S00022",
      "start": 44.88,
      "end": 46.02,
      "text": "带个大金链子"
    },
    {
      "sid": "S00023",
      "start": 46.02,
      "end": 47.04,
      "text": "那么我问你"
    },
    {
      "sid": "S00024",
      "start": 47.04,
      "end": 48.32,
      "text": "你更愿意相信谁"
    },
    {
      "sid": "S00025",
      "start": 48.32,
      "end": 49.58,
      "text": "99%的人"
    },
    {
      "sid": "S00026",
      "start": 49.58,
      "end": 51.92,
      "text": "更愿意相信那个穿着高定西装的人"
    },
    {
      "sid": "S00027",
      "start": 51.92,
      "end": 53.28,
      "text": "因为前者"
    },
    {
      "sid": "S00028",
      "start": 53.28,
      "end": 56.26,
      "text": "符合人们对于华尔街精英的刻板印象"
    },
    {
      "sid": "S00029",
      "start": 56.26,
      "end": 58.24,
      "text": "这也是为什么我经常说"
    },
    {
      "sid": "S00030",
      "start": 58.24,
      "end": 59.64,
      "text": "在女人的认知里"
    },
    {
      "sid": "S00031",
      "start": 59.64,
      "end": 62.06,
      "text": "感觉永远大于事实"
    },
    {
      "sid": "S00032",
      "start": 62.06,
      "end": 63.58,
      "text": "那么我再说一遍啊"
    },
    {
      "sid": "S00033",
      "start": 63.58,
      "end": 65.8,
      "text": "感觉永远大于事实"
    },
    {
      "sid": "S00034",
      "start": 65.8,
      "end": 67.0,
      "text": "那么怎么理解呢"
    },
    {
      "sid": "S00035",
      "start": 67.0,
      "end": 67.98,
      "text": "我打个比方吧"
    },
    {
      "sid": "S00036",
      "start": 67.98,
      "end": 70.06,
      "text": "女人认为优秀的男人是什么样子的"
    },
    {
      "sid": "S00037",
      "start": 70.06,
      "end": 72.7,
      "text": "举手投足间都透露出一种自信感"
    },
    {
      "sid": "S00038",
      "start": 72.7,
      "end": 74.98,
      "text": "说话也是那种精英的傲慢气息"
    },
    {
      "sid": "S00039",
      "start": 74.98,
      "end": 76.66,
      "text": "这个时候如果一个屌丝"
    },
    {
      "sid": "S00040",
      "start": 76.66,
      "end": 78.42,
      "text": "她经过系统性的训练"
    },
    {
      "sid": "S00041",
      "start": 78.42,
      "end": 80.22,
      "text": "她具备了这些特质"
    },
    {
      "sid": "S00042",
      "start": 80.22,
      "end": 81.54,
      "text": "那么女人就会认为"
    },
    {
      "sid": "S00043",
      "start": 81.54,
      "end": 82.68,
      "text": "她是社会的精英"
    },
    {
      "sid": "S00044",
      "start": 82.68,
      "end": 85.0,
      "text": "跟她事实上的身份没有半冒钱关系"
    },
    {
      "sid": "S00045",
      "start": 85.0,
      "end": 86.22,
      "text": "即便她是个黄毛"
    },
    {
      "sid": "S00046",
      "start": 86.22,
      "end": 87.78,
      "text": "她在经过系统训练之后"
    },
    {
      "sid": "S00047",
      "start": 87.78,
      "end": 88.88,
      "text": "她拥有了这些特质"
    },
    {
      "sid": "S00048",
      "start": 88.88,
      "end": 90.12,
      "text": "那么女人依然会认为"
    },
    {
      "sid": "S00049",
      "start": 90.12,
      "end": 91.04,
      "text": "她是一个精英男"
    },
    {
      "sid": "S00050",
      "start": 91.04,
      "end": 92.98,
      "text": "就算你是一个上司公司的老板"
    },
    {
      "sid": "S00051",
      "start": 92.98,
      "end": 94.42,
      "text": "你在和女人说话的过程中"
    },
    {
      "sid": "S00052",
      "start": 94.42,
      "end": 95.86,
      "text": "你没有传递出这种感觉"
    },
    {
      "sid": "S00053",
      "start": 95.86,
      "end": 96.56,
      "text": "你没有传递出"
    },
    {
      "sid": "S00054",
      "start": 96.56,
      "end": 98.24,
      "text": "你在公司里的那种强行为线索"
    },
    {
      "sid": "S00055",
      "start": 98.24,
      "end": 99.6,
      "text": "你的行为唯唯诺诺"
    },
    {
      "sid": "S00056",
      "start": 99.6,
      "end": 100.78,
      "text": "说话微微缩缩"
    },
    {
      "sid": "S00057",
      "start": 100.78,
      "end": 102.6,
      "text": "不敢去和女人眼神接触"
    },
    {
      "sid": "S00058",
      "start": 102.6,
      "end": 104.28,
      "text": "那么即便女人在逻辑上"
    },
    {
      "sid": "S00059",
      "start": 104.28,
      "end": 106.58,
      "text": "她知道你是一个上司公司的老板"
    },
    {
      "sid": "S00060",
      "start": 106.58,
      "end": 107.6,
      "text": "你能赚很多钱"
    },
    {
      "sid": "S00061",
      "start": 107.6,
      "end": 109.68,
      "text": "但她依旧会总觉得你差点意思"
    },
    {
      "sid": "S00062",
      "start": 109.68,
      "end": 111.16,
      "text": "或者说她对你没感觉"
    },
    {
      "sid": "S00063",
      "start": 111.16,
      "end": 113.38,
      "text": "她感觉你不像是一个精英阶级的人"
    },
    {
      "sid": "S00064",
      "start": 113.38,
      "end": 115.22,
      "text": "甚至她会让你去对她付出"
    },
    {
      "sid": "S00065",
      "start": 115.22,
      "end": 116.74,
      "text": "来自证你的价值"
    },
    {
      "sid": "S00066",
      "start": 116.74,
      "end": 119.14,
      "text": "就像让子弹飞里的那句台词一样"
    },
    {
      "sid": "S00067",
      "start": 119.14,
      "end": 121.6,
      "text": "人们不愿意相信一个土匪叫木枝"
    },
    {
      "sid": "S00068",
      "start": 121.6,
      "end": 124.08,
      "text": "他们更愿意相信一个土匪叫做麻子"
    },
    {
      "sid": "S00069",
      "start": 124.08,
      "end": 126.14,
      "text": "而且脸上得真的长麻子"
    },
    {
      "sid": "S00070",
      "start": 126.14,
      "end": 128.1,
      "text": "那为什么他们会有感觉"
    },
    {
      "sid": "S00071",
      "start": 128.1,
      "end": 129.46,
      "text": "大于事实的认知呢"
    },
    {
      "sid": "S00072",
      "start": 129.46,
      "end": 130.42,
      "text": "因为女人呢"
    },
    {
      "sid": "S00073",
      "start": 130.42,
      "end": 131.82,
      "text": "她们从出生到死亡"
    },
    {
      "sid": "S00074",
      "start": 131.82,
      "end": 132.9,
      "text": "她们的潜意识里"
    },
    {
      "sid": "S00075",
      "start": 132.9,
      "end": 134.76,
      "text": "无时无刻都在思考一个问题"
    },
    {
      "sid": "S00076",
      "start": 134.76,
      "end": 136.88,
      "text": "那就是如何让我的基因"
    },
    {
      "sid": "S00077",
      "start": 136.88,
      "end": 139.16,
      "text": "更加有效地传递和存活下去"
    },
    {
      "sid": "S00078",
      "start": 139.16,
      "end": 141.2,
      "text": "因为女人的怀孕周期很长"
    },
    {
      "sid": "S00079",
      "start": 141.2,
      "end": 142.82,
      "text": "生育资源非常的宝贵"
    },
    {
      "sid": "S00080",
      "start": 142.82,
      "end": 145.5,
      "text": "所以说他们需要确保自己和后代"
    },
    {
      "sid": "S00081",
      "start": 145.5,
      "end": 147.4,
      "text": "在漫长的虚弱期内"
    },
    {
      "sid": "S00082",
      "start": 147.4,
      "end": 149.16,
      "text": "获得保护与资源"
    },
    {
      "sid": "S00083",
      "start": 149.16,
      "end": 150.76,
      "text": "于是他们在原始社会中"
    },
    {
      "sid": "S00084",
      "start": 150.76,
      "end": 151.9,
      "text": "就进化出了一种"
    },
    {
      "sid": "S00085",
      "start": 151.9,
      "end": 155.66,
      "text": "依靠感觉去判断一个男人的本能"
    },
    {
      "sid": "S00086",
      "start": 155.66,
      "end": 157.1,
      "text": "特别是到了现代"
    },
    {
      "sid": "S00087",
      "start": 157.1,
      "end": 159.02,
      "text": "他们和男人的交往接触中"
    },
    {
      "sid": "S00088",
      "start": 159.02,
      "end": 160.76,
      "text": "则更加依靠这种本能"
    },
    {
      "sid": "S00089",
      "start": 160.76,
      "end": 162.48,
      "text": "如果你释放的行为线索不对"
    },
    {
      "sid": "S00090",
      "start": 162.48,
      "end": 165.1,
      "text": "即使你们两个人都躺在一张床上了"
    },
    {
      "sid": "S00091",
      "start": 165.1,
      "end": 167.4,
      "text": "他也有可能因为对你没有感觉"
    },
    {
      "sid": "S00092",
      "start": 167.4,
      "end": 168.72,
      "text": "然后穿上衣服走人"
    },
    {
      "sid": "S00093",
      "start": 168.72,
      "end": 171.12,
      "text": "就比如你在约会的时候和女人讲"
    },
    {
      "sid": "S00094",
      "start": 171.12,
      "end": 172.8,
      "text": "你是一个上司公司的老板"
    },
    {
      "sid": "S00095",
      "start": 172.8,
      "end": 174.28,
      "text": "你年薪上千万"
    },
    {
      "sid": "S00096",
      "start": 174.28,
      "end": 175.54,
      "text": "在上海有他大平层"
    },
    {
      "sid": "S00097",
      "start": 175.54,
      "end": 176.74,
      "text": "他根本不会相信"
    },
    {
      "sid": "S00098",
      "start": 176.74,
      "end": 179.32,
      "text": "他甚至会有一种看待爆发户那种"
    },
    {
      "sid": "S00099",
      "start": 179.32,
      "end": 181.7,
      "text": "极度厌恶的眼神去审视你"
    },
    {
      "sid": "S00100",
      "start": 181.7,
      "end": 183.36,
      "text": "这也是为什么很多女生"
    },
    {
      "sid": "S00101",
      "start": 183.36,
      "end": 184.84,
      "text": "他们在小红书上"
    },
    {
      "sid": "S00102",
      "start": 184.84,
      "end": 187.14,
      "text": "他们会集体去批判金融男"
    },
    {
      "sid": "S00103",
      "start": 187.14,
      "end": 188.42,
      "text": "什么拒绝金融男"
    },
    {
      "sid": "S00104",
      "start": 188.42,
      "end": 190.18,
      "text": "不是因为金融男没有价值"
    },
    {
      "sid": "S00105",
      "start": 190.18,
      "end": 192.48,
      "text": "而是他们传递价值的方式错了"
    },
    {
      "sid": "S00106",
      "start": 192.48,
      "end": 194.66,
      "text": "让女人的价值雷达系统产生了误判"
    },
    {
      "sid": "S00107",
      "start": 194.66,
      "end": 197.96,
      "text": "让他在感觉上认为你是一个低价值男人"
    },
    {
      "sid": "S00108",
      "start": 197.96,
      "end": 200.1,
      "text": "记住是感觉而非事实"
    },
    {
      "sid": "S00109",
      "start": 200.1,
      "end": 201.72,
      "text": "那如何传递"
    },
    {
      "sid": "S00110",
      "start": 201.72,
      "end": 203.7,
      "text": "释放你的强行为线索呢"
    },
    {
      "sid": "S00111",
      "start": 203.7,
      "end": 206.12,
      "text": "兄弟们只要看过我之前的约会金讲"
    },
    {
      "sid": "S00112",
      "start": 206.12,
      "end": 207.06,
      "text": "或者是直播"
    },
    {
      "sid": "S00113",
      "start": 207.06,
      "end": 209.16,
      "text": "你们或多或少都会有一些头绪"
    },
    {
      "sid": "S00114",
      "start": 209.16,
      "end": 210.5,
      "text": "那么我今天在这里"
    },
    {
      "sid": "S00115",
      "start": 210.5,
      "end": 212.8,
      "text": "从道 法 术 气"
    },
    {
      "sid": "S00116",
      "start": 212.8,
      "end": 213.7,
      "text": "四个层面"
    },
    {
      "sid": "S00117",
      "start": 213.7,
      "end": 215.6,
      "text": "给兄弟们简单总结一下"
    },
    {
      "sid": "S00118",
      "start": 215.6,
      "end": 218.64,
      "text": "祝你们早日领悟其中的关键诀窍"
    },
    {
      "sid": "S00119",
      "start": 218.64,
      "end": 219.9,
      "text": "那么首先第一点"
    },
    {
      "sid": "S00120",
      "start": 219.9,
      "end": 220.88,
      "text": "道的层面"
    },
    {
      "sid": "S00121",
      "start": 220.88,
      "end": 222.02,
      "text": "也是最重要的"
    },
    {
      "sid": "S00122",
      "start": 222.02,
      "end": 223.9,
      "text": "就是保持你的主体性"
    },
    {
      "sid": "S00123",
      "start": 223.9,
      "end": 225.9,
      "text": "你要彻底忘掉女人"
    },
    {
      "sid": "S00124",
      "start": 225.9,
      "end": 226.68,
      "text": "去做你自己"
    },
    {
      "sid": "S00125",
      "start": 226.68,
      "end": 228.32,
      "text": "那么所有人都知道一句话"
    },
    {
      "sid": "S00126",
      "start": 228.32,
      "end": 230.8,
      "text": "叫做钱只会流向不缺钱的人"
    },
    {
      "sid": "S00127",
      "start": 230.8,
      "end": 233.12,
      "text": "女人只会奔向不缺女人的人"
    },
    {
      "sid": "S00128",
      "start": 233.12,
      "end": 235.7,
      "text": "如果你一直抱有一种非常饥渴"
    },
    {
      "sid": "S00129",
      "start": 235.7,
      "end": 237.32,
      "text": "讨好低位的心态"
    },
    {
      "sid": "S00130",
      "start": 237.32,
      "end": 238.22,
      "text": "去和女人接触"
    },
    {
      "sid": "S00131",
      "start": 238.22,
      "end": 240.24,
      "text": "那么女人是很容易感觉出来的"
    },
    {
      "sid": "S00132",
      "start": 240.24,
      "end": 242.94,
      "text": "就像很多新手或者是game中毒患者"
    },
    {
      "sid": "S00133",
      "start": 242.94,
      "end": 244.2,
      "text": "她们和女人接触的时候"
    },
    {
      "sid": "S00134",
      "start": 244.2,
      "end": 245.52,
      "text": "她们脑袋里一直在想"
    },
    {
      "sid": "S00135",
      "start": 245.52,
      "end": 247.0,
      "text": "我该怎么调情"
    },
    {
      "sid": "S00136",
      "start": 247.0,
      "end": 249.34,
      "text": "我该怎么样让这个女人觉得我很有钱"
    },
    {
      "sid": "S00137",
      "start": 249.34,
      "end": 251.2,
      "text": "我该怎么样让这个女人开心"
    },
    {
      "sid": "S00138",
      "start": 251.2,
      "end": 253.34,
      "text": "我该怎么样凹险我的身世"
    },
    {
      "sid": "S00139",
      "start": 253.34,
      "end": 255.28,
      "text": "最后把这个女人骗到床上去"
    },
    {
      "sid": "S00140",
      "start": 255.28,
      "end": 256.9,
      "text": "那么你带着这么多目的"
    },
    {
      "sid": "S00141",
      "start": 256.9,
      "end": 258.88,
      "text": "你就会拥有很强的心理负担"
