    },
    {
      "sid": "S00171",
      "start": 306.96,
      "end": 308.56,
      "text": "就再也约不出来的女生"
    },
    {
      "sid": "S00172",
      "start": 308.56,
      "end": 310.34,
      "text": "是不是你在约会的时候"
    },
    {
      "sid": "S00173",
      "start": 310.34,
      "end": 312.18,
      "text": "都传递了这些弱性的线索"
    },
    {
      "sid": "S00174",
      "start": 312.18,
      "end": 313.94,
      "text": "那么我们一直在讲game"
    },
    {
      "sid": "S00175",
      "start": 313.94,
      "end": 316.2,
      "text": "这个词直译过来就是游戏"
    },
    {
      "sid": "S00176",
      "start": 316.2,
      "end": 317.72,
      "text": "你在和女人交往的时候"
    },
    {
      "sid": "S00177",
      "start": 317.72,
      "end": 320.96,
      "text": "你就应该把这个过程看成一场游戏"
    },
    {
      "sid": "S00178",
      "start": 320.96,
      "end": 322.02,
      "text": "你和她作案"
