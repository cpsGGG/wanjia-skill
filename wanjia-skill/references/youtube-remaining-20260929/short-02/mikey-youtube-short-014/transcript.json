  "youtube_id": "CMpHMvwuZRI",
  "media_sha256": "47cec1795baaa8fbe6e7f4f5eab0698a1bedb8ac8ae5c7f9250d621f419eaa51",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.74,
      "text": "Mike你觉得女人最抽象的是什么"
    },
    {
      "sid": "S00002",
      "start": 1.74,
      "end": 4.18,
      "text": "女人最抽象的是就是她们非常的诚实"
    },
    {
      "sid": "S00003",
      "start": 4.18,
      "end": 7.0,
      "text": "她们非常的诚实"
    },
    {
      "sid": "S00004",
      "start": 7.0,
      "end": 9.56,
      "text": "她们对男性的木墙就跟像"
    },
    {
      "sid": "S00005",
      "start": 9.56,
      "end": 12.2,
      "text": "就像是他妈的男人直接对"
    },
    {
      "sid": "S00006",
      "start": 12.2,
      "end": 15.4,
      "text": "就女人对自己木墙的毫不遮掩"
    },
    {
      "sid": "S00007",
      "start": 15.4,
      "end": 18.7,
      "text": "就好像一个男的他妈的"
    },
    {
      "sid": "S00008",
      "start": 18.7,
      "end": 20.86,
      "text": "见到一个女的很好看"
    },
    {
      "sid": "S00009",
      "start": 20.86,
      "end": 22.36,
      "text": "就当着她的面打飞机一样"
    },
    {
      "sid": "S00010",
      "start": 22.36,
      "end": 23.6,
      "text": "非常的诚实"
    },
    {
      "sid": "S00011",
      "start": 23.6,
      "end": 25.64,
      "text": "但是我们男人好歹会收敛"
    },
    {
      "sid": "S00012",
      "start": 25.64,
      "end": 26.84,
      "text": "女人完全不收敛"
    },
    {
      "sid": "S00013",
      "start": 26.84,
      "end": 28.12,
      "text": "她觉得你是个傻敌"
    },
    {
      "sid": "S00014",
      "start": 28.12,
      "end": 29.86,
      "text": "她会一秒钟她们离开你"
    },
    {
      "sid": "S00015",
      "start": 29.86,
      "end": 32.7,
      "text": "Mike我记得你之前在法国直播的时候"
    },
    {
      "sid": "S00016",
      "start": 32.7,
      "end": 35.98,
      "text": "说过破除对方防御机制"
    },
    {
      "sid": "S00017",
      "start": 35.98,
      "end": 37.86,
      "text": "就是放松"
    },
    {
      "sid": "S00018",
      "start": 37.86,
      "end": 40.58,
      "text": "那是不是我在和女人搭讪到见面的时候"
    },
    {
      "sid": "S00019",
      "start": 40.58,
      "end": 41.68,
      "text": "也应该这么相处"
    },
    {
      "sid": "S00020",
      "start": 41.68,
      "end": 43.42,
      "text": "因为我面相挺酷的"
    },
    {
      "sid": "S00021",
      "start": 43.42,
      "end": 46.62,
      "text": "就是很多时候会以一种讨好的态度"
    },
    {
      "sid": "S00022",
      "start": 46.62,
      "end": 47.22,
      "text": "和女人搭讪"
    },
    {
      "sid": "S00023",
      "start": 47.22,
      "end": 48.38,
      "text": "感觉对方太正了"
    },
    {
      "sid": "S00024",
      "start": 48.38,
      "end": 52.88,
      "text": "是你讨好对方就会有防御机制"
    },
    {
      "sid": "S00025",
      "start": 52.88,
      "end": 54.3,
      "text": "我们走在路上一个消瘦"
    },
    {
      "sid": "S00026",
      "start": 54.3,
      "end": 55.22,
      "text": "嬉皮笑脸的过来"
    },
    {
      "sid": "S00027",
      "start": 55.22,
      "end": 56.04,
      "text": "她妈跟我们讲话"
    },
    {
      "sid": "S00028",
      "start": 56.04,
      "end": 57.08,
      "text": "我们都会防御机制"
    },
    {
      "sid": "S00029",
      "start": 57.08,
      "end": 57.84,
      "text": "我们都会害怕"
    },
    {
      "sid": "S00030",
      "start": 57.84,
      "end": 59.84,
      "text": "我们都会觉得这个男的他妈的"
    },
    {
      "sid": "S00031",
      "start": 59.84,
      "end": 61.68,
      "text": "无视线殷勤非奸即到"
    },
    {
      "sid": "S00032",
      "start": 61.68,
      "end": 62.68,
      "text": "但如果这个男的他妈的"
    },
    {
      "sid": "S00033",
      "start": 62.68,
      "end": 64.68,
      "text": "只是很淡定的走过来说"
    },
    {
      "sid": "S00034",
      "start": 64.68,
      "end": 65.96,
      "text": "哎兄弟给你推荐个东西"
    },
    {
      "sid": "S00035",
      "start": 65.96,
      "end": 68.28,
      "text": "然后这个时候你可能会认真听一下"
    },
    {
      "sid": "S00036",
      "start": 68.28,
      "end": 69.68,
      "text": "你会认真听"
    },
    {
      "sid": "S00037",
      "start": 69.68,
      "end": 72.08,
      "text": "Mike在你这里提升的内核"
    },
    {
      "sid": "S00038",
      "start": 72.08,
      "end": 74.68,
      "text": "怎么样有效的在女生面前转换为吸引力"
    },
    {
      "sid": "S00039",
      "start": 74.68,
      "end": 75.12,
      "text": "强行为吸引力"
    },
    {
      "sid": "S00040",
      "start": 75.12,
      "end": 76.4,
      "text": "强行为吸引力"
    },
    {
      "sid": "S00041",
      "start": 76.4,
      "end": 80.3,
      "text": "就是把内核转换成吸引力的一个方法"
    },
    {
      "sid": "S00042",
      "start": 80.3,
      "end": 80.88,
      "text": "一个技巧"
    },
    {
      "sid": "S00043",
      "start": 80.88,
      "end": 83.26,
      "text": "优秀的猎手是靠留下线索"
    },
    {
      "sid": "S00044",
      "start": 83.26,
      "end": 84.92,
      "text": "然后让猎物自己探寻"
    },
    {
      "sid": "S00045",
      "start": 84.92,
      "end": 86.52,
      "text": "最后把猎物拿下来"
    },
    {
      "sid": "S00046",
      "start": 86.52,
      "end": 86.81941,
      "text": "好"
    }
  ]
}
