{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-011",
  "youtube_id": "kKNgwMlrzk8",
  "media_sha256": "91a2e9dc810f2f53140e74a6052786a5164967bf78f80ea7ea34cb08ac30767a",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.21,
      "end": 6.09,
      "text": "自己接触这个东西"
    },
    {
      "sid": "S00002",
      "start": 6.09,
      "end": 7.09,
      "text": "它是看情况的"
    },
    {
      "sid": "S00003",
      "start": 7.09,
      "end": 7.63,
      "text": "有的时候要"
    },
    {
      "sid": "S00004",
      "start": 7.63,
      "end": 8.67,
      "text": "有的时候不能要"
    },
    {
      "sid": "S00005",
      "start": 8.67,
      "end": 10.91,
      "text": "它里面是有逻辑的"
    },
    {
      "sid": "S00006",
      "start": 10.91,
      "end": 12.03,
      "text": "因为比如说这个女生"
    },
    {
      "sid": "S00007",
      "start": 12.03,
      "end": 13.85,
      "text": "她还不了解"
    },
    {
      "sid": "S00008",
      "start": 13.85,
      "end": 14.91,
      "text": "你上来就自己接触"
    },
    {
      "sid": "S00009",
      "start": 14.91,
      "end": 16.21,
      "text": "她会觉得就是你"
    },
    {
      "sid": "S00010",
      "start": 16.21,
      "end": 18.77,
      "text": "她已经得到你了"
    },
    {
      "sid": "S00011",
      "start": 18.77,
      "end": 19.49,
      "text": "然后你这个男的"
    },
    {
      "sid": "S00012",
      "start": 19.49,
      "end": 22.21,
      "text": "就是可能只是想睡他"
    },
    {
      "sid": "S00013",
      "start": 22.21,
      "end": 23.33,
      "text": "然后会降低"
    },
    {
      "sid": "S00014",
      "start": 23.33,
      "end": 24.65,
      "text": "就是那个安全感"
    },
    {
      "sid": "S00015",
      "start": 24.65,
      "end": 25.39,
      "text": "这个时候"
    },
    {
      "sid": "S00016",
      "start": 25.39,
      "end": 26.73,
      "text": "你不能上来就这样子"
    },
    {
      "sid": "S00017",
      "start": 26.73,
      "end": 29.03,
      "text": "你需要就是跟他聊"
    },
    {
      "sid": "S00018",
      "start": 29.03,
      "end": 29.91,
      "text": "聊到后面"
    },
    {
      "sid": "S00019",
      "start": 29.91,
      "end": 31.09,
      "text": "这个时候你感觉这个女生"
    },
    {
      "sid": "S00020",
      "start": 31.09,
      "end": 32.17,
      "text": "她没有那么的自信"
    },
    {
      "sid": "S00021",
      "start": 32.17,
      "end": 33.31,
      "text": "这个时候你可以"
    },
    {
      "sid": "S00022",
      "start": 33.31,
      "end": 34.65,
      "text": "跟她自己接触"
    },
    {
      "sid": "S00023",
      "start": 34.65,
      "end": 35.83,
      "text": "那自己接触本身"
    },
    {
      "sid": "S00024",
      "start": 35.83,
      "end": 37.99,
      "text": "它相当于是伸出橄榄枝"
    },
    {
      "sid": "S00025",
      "start": 37.99,
      "end": 38.83,
      "text": "能懂吗"
    },
    {
      "sid": "S00026",
      "start": 38.83,
      "end": 39.63,
      "text": "那么这个时候"
    },
    {
      "sid": "S00027",
      "start": 39.63,
      "end": 40.39,
      "text": "你给她点"
    },
    {
      "sid": "S00028",
      "start": 40.39,
      "end": 41.75,
      "text": "你给她示好"
    },
    {
      "sid": "S00029",
      "start": 41.75,
      "end": 43.33,
      "text": "这个时候她就会自信起来"
    },
    {
      "sid": "S00030",
      "start": 43.33,
      "end": 44.75,
      "text": "那么她就会赶在你面前"
    },
    {
      "sid": "S00031",
      "start": 44.75,
      "end": 45.41,
      "text": "弹路行飞"
    },
    {
      "sid": "S00032",
      "start": 45.41,
      "end": 47.03,
      "text": "那么这是一样的"
    },
    {
      "sid": "S00033",
      "start": 47.03,
      "end": 47.93,
      "text": "能懂吗"
    },
    {
      "sid": "S00034",
      "start": 47.93,
      "end": 48.75,
      "text": "但是有些女生"
    },
    {
      "sid": "S00035",
      "start": 48.75,
      "end": 49.63,
      "text": "她本身就很自信"
    },
    {
      "sid": "S00036",
      "start": 49.63,
      "end": 51.13,
      "text": "这个时候你就不需要这么做了"
    },
    {
      "sid": "S00037",
      "start": 51.13,
      "end": 53.93,
      "text": "所以说她是根据对方来决定的"
    },
    {
      "sid": "S00038",
      "start": 53.93,
      "end": 56.19,
      "text": "而不是说我一定要有遵循"
    },
    {
      "sid": "S00039",
      "start": 56.19,
      "end": 57.41,
      "text": "某一个流程"
    },
    {
      "sid": "S00040",
      "start": 57.41,
      "end": 58.13,
      "text": "就会在这边"
    },
    {
      "sid": "S00041",
      "start": 58.13,
      "end": 58.282086,
      "text": "同时"
    }
  ]
}
