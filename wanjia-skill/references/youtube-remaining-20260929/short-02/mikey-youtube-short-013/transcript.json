    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.84,
      "text": "我见到兄弟们全文背诵"
    },
    {
      "sid": "S00002",
      "start": 1.84,
      "end": 5.98,
      "text": "我给他发了时间地点"
    },
    {
      "sid": "S00003",
