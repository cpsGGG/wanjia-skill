{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-012",
  "youtube_id": "GSFHvvEzMxA",
  "media_sha256": "ef19b233a906930c1d84f44d5fbcf388be13bea2d43f5d7e543b8dc3246ce142",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 1.01,
      "end": 4.27,
      "text": "麦哥可以谈一谈对事业以及执行力的见解吗"
    },
    {
      "sid": "S00002",
      "start": 4.27,
      "end": 7.23,
      "text": "关于执行力这个东西呢"
    },
    {
      "sid": "S00003",
      "start": 7.23,
      "end": 8.35,
      "text": "我的建议是"
    },
    {
      "sid": "S00004",
      "start": 8.35,
      "end": 10.01,
      "text": "不要既要又要"
    },
    {
      "sid": "S00005",
      "start": 10.01,
      "end": 12.23,
      "text": "人都有执行力的兄弟们"
    },
    {
      "sid": "S00006",
      "start": 12.23,
      "end": 13.93,
      "text": "每个人都有执行力的"
    },
    {
      "sid": "S00007",
      "start": 13.93,
      "end": 17.31,
      "text": "只是你们在执行不执行这个行为"
    },
    {
      "sid": "S00008",
      "start": 17.31,
      "end": 18.89,
      "text": "那为什么你会不执行呢"
    },
    {
      "sid": "S00009",
      "start": 18.89,
      "end": 20.27,
      "text": "是因为你想太多了"
    },
    {
      "sid": "S00010",
      "start": 20.27,
      "end": 22.67,
      "text": "你想的是我要做得好"
    },
    {
      "sid": "S00011",
      "start": 22.67,
      "end": 23.55,
      "text": "我要做得完美"
    },
    {
      "sid": "S00012",
      "start": 23.55,
      "end": 25.35,
      "text": "我要正那的"
    },
    {
      "sid": "S00013",
      "start": 25.35,
      "end": 28.23,
      "text": "但是前提是你得先把流程跑通"
    },
    {
      "sid": "S00014",
      "start": 28.23,
      "end": 30.21,
      "text": "你流程都没有跑通"
    },
    {
      "sid": "S00015",
      "start": 30.21,
      "end": 33.01,
      "text": "你谈何是说什么我要做大做强的"
    },
    {
      "sid": "S00016",
      "start": 33.01,
      "end": 36.37,
      "text": "你先一个人把整套流程"
    },
    {
      "sid": "S00017",
      "start": 36.37,
      "end": 39.71,
      "text": "整套流水线全部做了一遍"
    },
    {
      "sid": "S00018",
      "start": 39.71,
      "end": 41.21,
      "text": "全部跑通了"
    },
    {
      "sid": "S00019",
      "start": 41.21,
      "end": 42.67,
      "text": "那么这个时候"
    },
    {
      "sid": "S00020",
      "start": 42.67,
      "end": 45.03,
      "text": "把一些技术性的难题"
    },
    {
      "sid": "S00021",
      "start": 45.03,
      "end": 48.45,
      "text": "分下去让专业的人来做"
    },
    {
      "sid": "S00022",
      "start": 48.45,
      "end": 50.73,
      "text": "你做决策者"
    },
    {
      "sid": "S00023",
      "start": 50.73,
      "end": 53.37,
      "text": "一些无脑的东西"
    },
    {
      "sid": "S00024",
      "start": 53.37,
      "end": 54.55,
      "text": "就是去招员工"
    },
    {
      "sid": "S00025",
      "start": 54.55,
      "end": 57.27,
      "text": "去招那些就是刚进社会的大学生"
    },
    {
      "sid": "S00026",
      "start": 57.27,
      "end": 58.21,
      "text": "让他们去帮你做"
    },
    {
      "sid": "S00027",
      "start": 58.21,
      "end": 59.21,
      "text": "而且行之又低"
    },
    {
      "sid": "S00028",
      "start": 59.21,
      "end": 61.43,
      "text": "一定是先把流程跑通了"
    },
    {
      "sid": "S00029",
      "start": 61.43,
      "end": 62.91,
      "text": "你自己先把流程跑通了"
    },
    {
      "sid": "S00030",
      "start": 62.91,
      "end": 65.07,
      "text": "你才能去开支散业"
    },
    {
      "sid": "S00031",
      "start": 65.07,
      "end": 66.43,
      "text": "而不是就是我上来"
    },
    {
      "sid": "S00032",
      "start": 66.43,
      "end": 67.09,
      "text": "我啥也不知道"
    },
    {
      "sid": "S00033",
      "start": 67.09,
      "end": 68.21,
      "text": "我就先狂招人"
    },
    {
      "sid": "S00034",
      "start": 68.21,
      "end": 69.31,
      "text": "这样是没用的"
    },
    {
      "sid": "S00035",
      "start": 69.31,
      "end": 70.71,
      "text": "就是不要想太多"
    },
    {
      "sid": "S00036",
      "start": 70.71,
      "end": 71.61,
      "text": "你先遇到问题"
    },
    {
      "sid": "S00037",
      "start": 71.61,
      "end": 72.51,
      "text": "你先做就行了"
    },
    {
      "sid": "S00038",
      "start": 72.51,
      "end": 73.41,
      "text": "遇到问题"
    },
    {
      "sid": "S00039",
      "start": 73.41,
      "end": 74.31,
      "text": "我们再解决问题"
    },
    {
      "sid": "S00040",
      "start": 74.31,
      "end": 75.162993,
      "text": "我先做一个事"
    }
  ]
}
