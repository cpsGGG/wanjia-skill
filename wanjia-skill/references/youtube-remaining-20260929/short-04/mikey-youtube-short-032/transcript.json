{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-032",
  "youtube_id": "vT44uMVNSes",
  "media_sha256": "ffdf73c1221bf58e99db3613b3facb6222e114394fa84821da3e97487d42a87e",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.68,
      "text": "为什么你接触game这么久"
    },
    {
      "sid": "S00002",
      "start": 1.68,
      "end": 3.26,
      "text": "你依然没有自我家质量"
    },
    {
      "sid": "S00003",
      "start": 3.26,
      "end": 4.5,
      "text": "你依然没有人脉"
    },
    {
      "sid": "S00004",
      "start": 4.5,
      "end": 7.38,
      "text": "你甚至越game越失败"
    },
    {
      "sid": "S00005",
      "start": 7.38,
      "end": 9.1,
      "text": "越game越迷茫"
    },
    {
      "sid": "S00006",
      "start": 9.1,
      "end": 11.42,
      "text": "那么你明明变得越来越优秀了"
    },
    {
      "sid": "S00007",
      "start": 11.42,
      "end": 13.4,
      "text": "你的收入也越来越高"
    },
    {
      "sid": "S00008",
      "start": 13.4,
      "end": 15.3,
      "text": "可你木然回首"
    },
    {
      "sid": "S00009",
      "start": 15.3,
      "end": 16.16,
      "text": "你却发现"
    },
    {
      "sid": "S00010",
      "start": 16.16,
      "end": 17.54,
      "text": "我现在拿到的结果"
    },
    {
      "sid": "S00011",
      "start": 17.54,
      "end": 18.7,
      "text": "和我两年前拿到的结果"
    },
    {
      "sid": "S00012",
      "start": 18.7,
      "end": 19.82,
      "text": "好像没有什么区别"
    },
    {
      "sid": "S00013",
      "start": 19.82,
      "end": 21.72,
      "text": "我甚至还退步了"
    },
    {
      "sid": "S00014",
      "start": 21.72,
      "end": 24.82,
      "text": "那么以前刚接触game的时候"
    },
    {
      "sid": "S00015",
      "start": 24.82,
      "end": 26.28,
      "text": "在机前的驱使下"
    },
    {
      "sid": "S00016",
      "start": 26.28,
      "end": 28.64,
      "text": "你偶尔还能拿到一些高质量结果"
    },
    {
      "sid": "S00017",
      "start": 28.64,
      "end": 30.52,
      "text": "现在呢反而低质量结果"
    },
    {
      "sid": "S00018",
      "start": 30.52,
      "end": 31.5,
      "text": "去稳定化"
    },
    {
      "sid": "S00019",
      "start": 31.5,
      "end": 33.04,
      "text": "你越来越迷茫"
    },
    {
      "sid": "S00020",
      "start": 33.04,
      "end": 34.1,
      "text": "越来越失望"
    },
    {
      "sid": "S00021",
      "start": 34.1,
      "end": 36.24,
      "text": "那么如果你有这类的情况"
    },
    {
      "sid": "S00022",
      "start": 36.24,
      "end": 36.78,
      "text": "松跌"
    },
    {
      "sid": "S00023",
      "start": 36.78,
      "end": 39.08,
      "text": "那说明你只会向下社交"
    },
    {
      "sid": "S00024",
      "start": 39.08,
      "end": 41.3,
      "text": "你害怕与高分女生相处"
    },
    {
      "sid": "S00025",
      "start": 41.3,
      "end": 43.14,
      "text": "你一旦遇到那种地位"
    },
    {
      "sid": "S00026",
      "start": 43.14,
      "end": 43.8,
      "text": "比自己高"
    },
    {
      "sid": "S00027",
      "start": 43.8,
      "end": 44.98,
      "text": "实力比自己强的人"
    },
    {
      "sid": "S00028",
      "start": 44.98,
      "end": 46.6,
      "text": "你就害怕"
    },
    {
      "sid": "S00029",
      "start": 46.6,
      "end": 48.14,
      "text": "你就把握不住是腰框架"
    },
    {
      "sid": "S00030",
      "start": 48.14,
      "end": 50.68,
      "text": "你就没有办法从容的去做你自己"
    },
    {
      "sid": "S00031",
      "start": 50.68,
      "end": 52.44,
      "text": "然后你就会逃避"
    },
    {
      "sid": "S00032",
      "start": 52.44,
      "end": 54.26,
      "text": "与这类高分女生接触"
    },
    {
      "sid": "S00033",
      "start": 54.26,
      "end": 55.04,
      "text": "我们要清楚"
    },
    {
      "sid": "S00034",
      "start": 55.04,
      "end": 56.56,
      "text": "高分女生都是很自我的"
    },
    {
      "sid": "S00035",
      "start": 56.56,
      "end": 58.04,
      "text": "你跟她相处"
    },
    {
      "sid": "S00036",
      "start": 58.04,
      "end": 59.44,
      "text": "你的气场强于路"
    },
    {
      "sid": "S00037",
      "start": 59.44,
      "end": 60.76,
      "text": "她是马上能感觉到的"
    },
    {
      "sid": "S00038",
      "start": 60.76,
      "end": 61.98,
      "text": "你逃避了之后"
    },
    {
      "sid": "S00039",
      "start": 61.98,
      "end": 64.82,
      "text": "你进而会去找一些舒适圈以内的女生找本"
    },
    {
      "sid": "S00040",
      "start": 64.82,
      "end": 66.64,
      "text": "那么这样的人呢"
    },
    {
      "sid": "S00041",
      "start": 66.64,
      "end": 67.58,
      "text": "你再努力"
    },
    {
      "sid": "S00042",
      "start": 67.58,
      "end": 69.18,
      "text": "你也是在原地踏步"
    },
    {
      "sid": "S00043",
      "start": 69.18,
      "end": 71.62,
      "text": "那些真正懂得如何把高分"
    },
    {
      "sid": "S00044",
      "start": 71.62,
      "end": 73.46,
      "text": "或者是把高分女生变成朋友的人"
    },
    {
      "sid": "S00045",
      "start": 73.46,
      "end": 74.96,
      "text": "他们都是有自己的方法"
    },
    {
      "sid": "S00046",
      "start": 74.96,
      "end": 75.92,
      "text": "有自己的框架的"
    },
    {
      "sid": "S00047",
      "start": 75.92,
      "end": 78.7,
      "text": "他们在高分女生那边收获的结果"
    },
    {
      "sid": "S00048",
      "start": 78.7,
      "end": 81.24,
      "text": "远比你把十个低分都要有用"
    },
    {
      "sid": "S00049",
      "start": 81.24,
      "end": 83.76,
      "text": "那么这里我要给兄弟们讲一个概念"
    },
    {
      "sid": "S00050",
      "start": 83.76,
      "end": 86.8,
      "text": "叫做价值不等于自我价值感"
    },
    {
      "sid": "S00051",
      "start": 86.8,
      "end": 88.2,
      "text": "为什么这么讲"
    },
    {
      "sid": "S00052",
      "start": 88.2,
      "end": 90.24,
      "text": "很多兄弟们你们其实是非常有价值的"
    },
    {
      "sid": "S00053",
      "start": 90.24,
      "end": 91.8,
      "text": "就跟我刚才讲的那个一样"
    },
    {
      "sid": "S00054",
      "start": 91.8,
      "end": 95.08,
      "text": "你们在你们可能收入长相"
    },
    {
      "sid": "S00055",
      "start": 95.08,
      "end": 97.18,
      "text": "或者是穿搭各方面都有提升"
    },
    {
      "sid": "S00056",
      "start": 97.18,
      "end": 98.34,
      "text": "身材上也有提升"
    },
    {
      "sid": "S00057",
      "start": 98.34,
      "end": 99.64,
      "text": "变得越来越优秀了"
    },
    {
      "sid": "S00058",
      "start": 99.64,
      "end": 102.38,
      "text": "但是你会发现我怎么把还是过去的一些女生"
    },
    {
      "sid": "S00059",
      "start": 102.38,
      "end": 104.52,
      "text": "这是源自于你的自我价值感不足"
    },
    {
      "sid": "S00060",
      "start": 104.52,
      "end": 106.52,
      "text": "你觉得自己配不上那些高分女生"
    },
    {
      "sid": "S00061",
      "start": 106.52,
      "end": 110.56,
      "text": "所以说你就会下意识的去把一些就是自己舒适圈以内的女生"
    },
    {
      "sid": "S00062",
      "start": 110.56,
      "end": 111.32,
      "text": "OK"
    },
    {
      "sid": "S00063",
      "start": 111.32,
      "end": 114.42,
      "text": "那么你不断的去向下社交会导致什么"
    },
    {
      "sid": "S00064",
      "start": 114.42,
      "end": 118.76,
      "text": "会导致你不断的去收获到一些低质量的反馈"
    },
    {
      "sid": "S00065",
      "start": 118.76,
      "end": 123.8,
      "text": "那么低质量的反馈就会反过来去强化你低自我价值感的这个事实"
    },
    {
      "sid": "S00066",
      "start": 123.8,
      "end": 124.38,
      "text": "OK"
    },
    {
      "sid": "S00067",
      "start": 124.38,
      "end": 125.94,
      "text": "那么你就会恶性循环"
    },
    {
      "sid": "S00068",
      "start": 125.94,
      "end": 127.48,
      "text": "那怎么去打破呢"
    },
    {
      "sid": "S00069",
      "start": 127.48,
      "end": 132.66,
      "text": "我觉得你得先从我大胆的去拒绝向下社交开始"
    },
    {
      "sid": "S00070",
      "start": 132.66,
      "end": 133.88,
      "text": "拒绝低分女生"
    },
    {
      "sid": "S00071",
      "start": 133.88,
      "end": 135.76,
      "text": "不断的向上社交"
    },
    {
      "sid": "S00072",
      "start": 135.76,
      "end": 137.26,
      "text": "不断的去挑战高分"
    },
    {
      "sid": "S00073",
      "start": 137.26,
      "end": 138.7,
      "text": "去征服"
    },
    {
      "sid": "S00074",
      "start": 138.7,
      "end": 139.86,
      "text": "去挑战"
    },
    {
      "sid": "S00075",
      "start": 139.86,
      "end": 142.32,
      "text": "我们通过一次又一次的结果"
    },
    {
      "sid": "S00076",
      "start": 142.32,
      "end": 144.56,
      "text": "用来强化我们的自我价值感"
    },
    {
      "sid": "S00077",
      "start": 144.56,
      "end": 145.76,
      "text": "随着你的结果越来越多"
    },
    {
      "sid": "S00078",
      "start": 145.76,
      "end": 147.5,
      "text": "你慢慢的你会发现"
    },
    {
      "sid": "S00079",
      "start": 147.5,
      "end": 148.7,
      "text": "你会自然而然的"
    },
    {
      "sid": "S00080",
      "start": 148.7,
      "end": 152.84,
      "text": "不会再去跟你过去的说实圈的那种女生接触了"
    },
    {
      "sid": "S00081",
      "start": 152.84,
      "end": 154.44,
      "text": "那么你就成长"
    },
    {
      "sid": "S00082",
      "start": 154.44,
      "end": 157.04,
      "text": "但是在向上社交的这个过程中是有很多困难的"
    },
    {
      "sid": "S00083",
      "start": 157.04,
      "end": 158.18,
      "text": "你需要有很多"
    },
    {
      "sid": "S00084",
      "start": 158.18,
      "end": 160.18,
      "text": "你可能需要去打破阶级壁垒"
    },
    {
      "sid": "S00085",
      "start": 160.18,
      "end": 161.32,
      "text": "你可能需要用一些技巧"
    },
    {
      "sid": "S00086",
      "start": 161.32,
      "end": 162.38,
      "text": "用一些方法"
    },
    {
      "sid": "S00087",
      "start": 162.38,
      "end": 166.92,
      "text": "那么这也是我今年频道要重点推出的一些实操技巧"
    },
    {
      "sid": "S00088",
      "start": 166.92,
      "end": 169.02,
      "text": "那么希望兄弟们持续关注"
    },
    {
      "sid": "S00089",
      "start": 169.02,
      "end": 169.88,
      "text": "大声王家TV"
    }
  ]
}
