{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-035",
  "youtube_id": "yu4M9Pjy79k",
  "media_sha256": "1b3f00d918277dd8f2930094a5f734c796701578e8b32ff4c32100f597f16685",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 3.2,
      "text": "把吸引和安全感做了到位之后"
    },
    {
      "sid": "S00002",
      "start": 3.2,
      "end": 5.36,
      "text": "那这个时候我们要干嘛做浮层性测试"
    },
    {
      "sid": "S00003",
      "start": 5.36,
      "end": 6.34,
      "text": "做浮层性累积"
    },
    {
      "sid": "S00004",
      "start": 6.34,
      "end": 9.48,
      "text": "因为我们在前期其实没有做过多的浮层性测试的"
    },
    {
      "sid": "S00005",
      "start": 9.48,
      "end": 11.32,
      "text": "你不知道这个女生温度在哪里"
    },
    {
      "sid": "S00006",
      "start": 11.32,
      "end": 13.72,
      "text": "就比如说你不知道这个吸引力到了什么度"
    },
    {
      "sid": "S00007",
      "start": 13.72,
      "end": 16.0,
      "text": "是不是能够你带回家"
    },
    {
      "sid": "S00008",
      "start": 16.0,
      "end": 17.9,
      "text": "以及安全感他对方还缺不缺"
    },
    {
      "sid": "S00009",
      "start": 17.9,
      "end": 19.8,
      "text": "那这个时候我们要干嘛做浮层性测试"
    },
    {
      "sid": "S00010",
      "start": 19.8,
      "end": 21.06,
      "text": "这个时候可以用牵手"
    },
    {
      "sid": "S00011",
      "start": 21.06,
      "end": 23.48,
      "text": "那如果你发现浮层性测试他全都给接触了"
    },
    {
      "sid": "S00012",
      "start": 23.48,
      "end": 25.14,
      "text": "包括褒腰之间的他都可以接受"
    },
    {
      "sid": "S00013",
      "start": 25.14,
      "end": 26.96,
      "text": "那这个时候我们直接对他讲就是走去我家"
    },
    {
      "sid": "S00014",
      "start": 26.96,
      "end": 28.02,
      "text": "那你不要说直接去我家"
    },
    {
      "sid": "S00015",
      "start": 28.02,
      "end": 30.34,
      "text": "你可以说走陪我去玩PS5"
    },
    {
      "sid": "S00016",
      "start": 30.34,
      "end": 31.76,
      "text": "如果你家里有PS5"
    },
    {
      "sid": "S00017",
      "start": 31.76,
      "end": 33.74,
      "text": "你可以说走去我家玩PS5"
    },
    {
      "sid": "S00018",
      "start": 33.74,
      "end": 35.26,
      "text": "我们一起玩火云热究极分爆"
    },
    {
      "sid": "S00019",
      "start": 35.26,
      "end": 36.92,
      "text": "我们可以玩龙珠超宇宙"
    },
    {
      "sid": "S00020",
      "start": 36.92,
      "end": 38.46,
      "text": "我们可以玩很多很多游戏"
    },
    {
      "sid": "S00021",
      "start": 38.46,
      "end": 40.04,
      "text": "那或者是去我家看他们小星"
    },
    {
      "sid": "S00022",
      "start": 40.04,
      "end": 40.94,
      "text": "都可以"
    },
    {
      "sid": "S00023",
      "start": 40.94,
      "end": 43.02,
      "text": "或者是就任何理由"
    },
    {
      "sid": "S00024",
      "start": 43.02,
      "end": 45.6,
      "text": "你要清楚如果我们的吸引已经建立成功之后"
    },
    {
      "sid": "S00025",
      "start": 45.6,
      "end": 48.68,
      "text": "你说的这些理由只要不是特别的牵强"
    },
    {
      "sid": "S00026",
      "start": 48.68,
      "end": 50.1,
      "text": "其实对方都是可以接受的"
    },
    {
      "sid": "S00027",
      "start": 50.1,
      "end": 52.88,
      "text": "但问题关键点在于你的吸引有没有做好"
    },
    {
      "sid": "S00028",
      "start": 52.88,
      "end": 53.78,
      "text": "如果吸引没做好"
    },
    {
      "sid": "S00029",
      "start": 53.78,
      "end": 55.0,
      "text": "你后期是不可能收尾的"
    },
    {
      "sid": "S00030",
      "start": 55.0,
      "end": 56.54,
      "text": "因为你还没有你刚提出这句话"
    },
    {
      "sid": "S00031",
      "start": 56.54,
      "end": 57.82,
      "text": "走去我家他说为什么要去你家"
    },
    {
      "sid": "S00032",
      "start": 57.82,
      "end": 58.5,
      "text": "你说"
    }
  ]
}
