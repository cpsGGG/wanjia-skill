{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-033",
  "youtube_id": "apoG8W9NziA",
  "media_sha256": "3790e034ad20110c87bb005c60df5ab3a8dda8bf476cce3560ba028f34d5638e",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.16,
      "text": "那么今天有一个学员他跟我打电话"
    },
    {
      "sid": "S00002",
      "start": 2.16,
      "end": 3.32,
      "text": "他问我就是"
    },
    {
      "sid": "S00003",
      "start": 3.32,
      "end": 5.26,
      "text": "我跟女生相处的时候"
    },
    {
      "sid": "S00004",
      "start": 5.26,
      "end": 6.96,
      "text": "我到底该怎么样才能"
    },
    {
      "sid": "S00005",
      "start": 6.96,
      "end": 9.04,
      "text": "维护好我的高位框架"
    },
    {
      "sid": "S00006",
      "start": 9.04,
      "end": 10.84,
      "text": "我该怎么样就是"
    },
    {
      "sid": "S00007",
      "start": 10.84,
      "end": 12.28,
      "text": "才能让"
    },
    {
      "sid": "S00008",
      "start": 12.28,
      "end": 14.6,
      "text": "显得我地位更高一点"
    },
    {
      "sid": "S00009",
      "start": 14.6,
      "end": 16.92,
      "text": "然后他之前就跟女生约会"
    },
    {
      "sid": "S00010",
      "start": 16.92,
      "end": 19.02,
      "text": "总是约完会之后女生就不理他了"
    },
    {
      "sid": "S00011",
      "start": 19.02,
      "end": 20.04,
      "text": "就他问我为什么"
    },
    {
      "sid": "S00012",
      "start": 20.04,
      "end": 22.72,
      "text": "他说就是他会打压这些女生"
    },
    {
      "sid": "S00013",
      "start": 22.72,
      "end": 23.32,
      "text": "然后怎么样"
    },
    {
      "sid": "S00014",
      "start": 23.32,
      "end": 26.36,
      "text": "但是这些女生好像并不觉得他是高位框架了"
    },
    {
      "sid": "S00015",
      "start": 26.36,
      "end": 28.68,
      "text": "那么这里其实就有涉及到一个问题"
    },
    {
      "sid": "S00016",
      "start": 28.68,
      "end": 32.2,
      "text": "就是你觉得什么样的人需要靠打压别人"
    },
    {
      "sid": "S00017",
      "start": 32.2,
      "end": 33.9,
      "text": "才能让自己变得高位框架"
    },
    {
      "sid": "S00018",
      "start": 33.9,
      "end": 36.68,
      "text": "因为这其实骨子里是不自信的"
    },
    {
      "sid": "S00019",
      "start": 36.68,
      "end": 39.2,
      "text": "就高位框架这个东西"
    },
    {
      "sid": "S00020",
      "start": 39.2,
      "end": 40.84,
      "text": "它不是说我靠打压别人"
    },
    {
      "sid": "S00021",
      "start": 40.84,
      "end": 41.74,
      "text": "我才会有高位框架"
    },
    {
      "sid": "S00022",
      "start": 41.74,
      "end": 43.02,
      "text": "首先你得先清楚"
    },
    {
      "sid": "S00023",
      "start": 43.02,
      "end": 44.32,
      "text": "我是一个高位框架的人"
    },
    {
      "sid": "S00024",
      "start": 44.32,
      "end": 45.94,
      "text": "得先清楚这件事情"
    },
    {
      "sid": "S00025",
      "start": 45.94,
      "end": 48.38,
      "text": "然后你如果是一种"
    },
    {
      "sid": "S00026",
      "start": 48.38,
      "end": 51.34,
      "text": "我认为最屌的一个状态"
    },
    {
      "sid": "S00027",
      "start": 51.34,
      "end": 53.08,
      "text": "就是不以物喜不以己悲"
    },
    {
      "sid": "S00028",
      "start": 53.08,
      "end": 55.3,
      "text": "你这样的一个心态跟女生相处的时候"
    },
    {
      "sid": "S00029",
      "start": 55.3,
      "end": 57.34,
      "text": "你自然而然就已经高位框架了"
    },
    {
      "sid": "S00030",
      "start": 57.34,
      "end": 59.9,
      "text": "你不需要刻意的去追求所谓的高位框架"
    },
    {
      "sid": "S00031",
      "start": 59.9,
      "end": 60.86,
      "text": "我要去打压别人"
    },
    {
      "sid": "S00032",
      "start": 60.86,
      "end": 61.98,
      "text": "我要去怎么样怎么样"
    },
    {
      "sid": "S00033",
      "start": 61.98,
      "end": 62.56,
      "text": "你不需要"
    },
    {
      "sid": "S00034",
      "start": 62.56,
      "end": 64.92,
      "text": "你只需要就是很坦然的去"
    },
    {
      "sid": "S00035",
      "start": 64.92,
      "end": 67.34,
      "text": "很从容的去做自己想做的事情"
    },
    {
      "sid": "S00036",
      "start": 67.34,
      "end": 68.72,
      "text": "去表达自己想表达的"
    },
    {
      "sid": "S00037",
      "start": 68.72,
      "end": 70.86,
      "text": "你自然而然的就是高位框架了"
    },
    {
      "sid": "S00038",
      "start": 70.86,
      "end": 72.86,
      "text": "因为这个时候你说话给人的感觉"
    },
    {
      "sid": "S00039",
      "start": 72.86,
      "end": 74.64,
      "text": "其实是平静还有力量"
    },
    {
      "sid": "S00040",
      "start": 74.64,
      "end": 76.44,
      "text": "这其实是最关键"
    },
    {
      "sid": "S00041",
      "start": 76.44,
      "end": 77.88,
      "text": "我认为最重要的"
    },
    {
      "sid": "S00042",
      "start": 77.88,
      "end": 78.96,
      "text": "你可能就是"
    },
    {
      "sid": "S00043",
      "start": 78.96,
      "end": 81.18,
      "text": "同样一件事情"
    },
    {
      "sid": "S00044",
      "start": 81.18,
      "end": 81.96,
      "text": "比如说冒犯你"
    },
    {
      "sid": "S00045",
      "start": 81.96,
      "end": 82.58,
      "text": "你说冒犯你"
    },
    {
      "sid": "S00046",
      "start": 82.58,
      "end": 84.04,
      "text": "他可能就是跟你聊天的时候"
    },
    {
      "sid": "S00047",
      "start": 84.04,
      "end": 85.28,
      "text": "跟你一直玩手机"
    },
    {
      "sid": "S00048",
      "start": 85.28,
      "end": 87.44,
      "text": "但如果你真的是一个高位框架的人"
    },
    {
      "sid": "S00049",
      "start": 87.44,
      "end": 88.94,
      "text": "你不需要去装"
    },
    {
      "sid": "S00050",
      "start": 88.94,
      "end": 91.78,
      "text": "你可能是很平静的去跟他讲"
    },
    {
      "sid": "S00051",
      "start": 91.78,
      "end": 92.0,
      "text": "你说"
    },
    {
      "sid": "S00052",
      "start": 92.0,
      "end": 93.58,
      "text": "你是不太想讲话吗"
    },
    {
      "sid": "S00053",
      "start": 93.58,
      "end": 94.32,
      "text": "你这种其实"
    },
    {
      "sid": "S00054",
      "start": 94.32,
      "end": 95.96,
      "text": "做这种状态是很对的"
    },
    {
      "sid": "S00055",
      "start": 95.96,
      "end": 96.74,
      "text": "OK"
    },
    {
      "sid": "S00056",
      "start": 96.74,
      "end": 98.36,
      "text": "这种才是我认为"
    },
    {
      "sid": "S00057",
      "start": 98.36,
      "end": 101.14,
      "text": "不以物喜不以己悲"
    },
    {
      "sid": "S00058",
      "start": 101.14,
      "end": 103.14,
      "text": "所以我认为这才是真正的"
    },
    {
      "sid": "S00059",
      "start": 103.14,
      "end": 104.22,
      "text": "所谓的高位框架"
    },
    {
      "sid": "S00060",
      "start": 104.22,
      "end": 106.62,
      "text": "而不是说对方我要去打压"
    },
    {
      "sid": "S00061",
      "start": 106.62,
      "end": 107.62,
      "text": "对人冒犯别人"
    },
    {
      "sid": "S00062",
      "start": 107.62,
      "end": 108.12,
      "text": "怎么样怎么样"
    },
    {
      "sid": "S00063",
      "start": 108.12,
      "end": 109.62,
      "text": "来显示我很强"
    },
    {
      "sid": "S00064",
      "start": 109.62,
      "end": 110.62,
      "text": "你得不断的秀肌肉"
    },
    {
      "sid": "S00065",
      "start": 110.62,
      "end": 111.5,
      "text": "显示自己强"
    },
    {
      "sid": "S00066",
      "start": 111.5,
      "end": 112.42,
      "text": "那你永远不可能"
    },
    {
      "sid": "S00067",
      "start": 112.42,
      "end": 113.82,
      "text": "获得真正的高位框架"
    },
    {
      "sid": "S00068",
      "start": 113.82,
      "end": 114.62,
      "text": "因为这骨子里"
    },
    {
      "sid": "S00069",
      "start": 114.62,
      "end": 116.62,
      "text": "本质上是一种不自信"
    },
    {
      "sid": "S00070",
      "start": 116.62,
      "end": 119.1,
      "text": "最重要的那个点就是"
    },
    {
      "sid": "S00071",
      "start": 119.1,
      "end": 121.1,
      "text": "你得清楚的意识到"
    },
    {
      "sid": "S00072",
      "start": 121.1,
      "end": 122.38,
      "text": "我本来就不需要"
    }
  ]
}
