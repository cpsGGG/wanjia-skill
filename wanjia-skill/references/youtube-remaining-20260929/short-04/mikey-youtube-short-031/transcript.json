{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-031",
  "youtube_id": "iJ-sPn7b1_Q",
  "media_sha256": "648f80958b8ebed752cf6b95c6d1a6f307462fbf2edb0aba0db56602453cb48b",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 2.36,
      "end": 4.76,
      "text": "最恐怖的事情就是没有任何人知道我是谁"
    },
    {
      "sid": "S00002",
      "start": 4.76,
      "end": 7.14,
      "text": "没有任何人记得我"
    },
    {
      "sid": "S00003",
      "start": 7.14,
      "end": 12.04,
      "text": "是最恐怖的事情"
    },
    {
      "sid": "S00004",
      "start": 12.04,
      "end": 16.6,
      "text": "你来到这个世界上"
    },
    {
      "sid": "S00005",
      "start": 16.6,
      "end": 17.88,
      "text": "你不是活给别人看的"
    },
    {
      "sid": "S00006",
      "start": 17.88,
      "end": 18.9,
      "text": "活给你自己看的"
    },
    {
      "sid": "S00007",
      "start": 18.9,
      "end": 19.96,
      "text": "能懂吗"
    },
    {
      "sid": "S00008",
      "start": 19.96,
      "end": 21.88,
      "text": "我不想就是"
    },
    {
      "sid": "S00009",
      "start": 21.88,
      "end": 23.28,
      "text": "我未来我死"
    },
    {
      "sid": "S00010",
      "start": 23.28,
      "end": 24.02,
      "text": "我快死了"
    },
    {
      "sid": "S00011",
      "start": 24.02,
      "end": 25.04,
      "text": "我躺在ICU里面"
    },
    {
      "sid": "S00012",
      "start": 25.04,
      "end": 27.54,
      "text": "我回顾我的人生的本地历史记录"
    },
    {
      "sid": "S00013",
      "start": 27.54,
      "end": 30.04,
      "text": "我发现我他妈这一生"
    },
    {
      "sid": "S00014",
      "start": 30.04,
      "end": 30.46,
      "text": "陆路"
    },
    {
      "sid": "S00015",
      "start": 30.46,
      "end": 34.48,
      "text": "那我会非常的难过的"
    },
    {
      "sid": "S00016",
      "start": 34.48,
      "end": 39.18,
      "text": "能懂吗"
    },
    {
      "sid": "S00017",
      "start": 39.18,
      "end": 45.43,
      "text": "很多时候你在人生中做的很多选择"
    },
    {
      "sid": "S00018",
      "start": 45.43,
      "end": 46.43,
      "text": "只是为了让你"
    },
    {
      "sid": "S00019",
      "start": 46.43,
      "end": 48.67,
      "text": "只是在给你的人生本地历史记录"
    },
    {
      "sid": "S00020",
      "start": 48.67,
      "end": 50.03,
      "text": "天砖家王"
    },
    {
      "sid": "S00021",
      "start": 50.03,
      "end": 51.79,
      "text": "你甚至都不需要获得他人的任务"
    },
    {
      "sid": "S00022",
      "start": 51.79,
      "end": 53.43,
      "text": "你只管去做你想做的事情"
    },
    {
      "sid": "S00023",
      "start": 53.43,
      "end": 53.91,
      "text": "都会好"
    },
    {
      "sid": "S00024",
      "start": 53.91,
      "end": 55.21,
      "text": "能懂吗"
    },
    {
      "sid": "S00025",
      "start": 55.21,
      "end": 56.85,
      "text": "即便就是"
    },
    {
      "sid": "S00026",
      "start": 56.85,
      "end": 58.67,
      "text": "没做好也没关系"
    },
    {
      "sid": "S00027",
      "start": 58.67,
      "end": 59.31,
      "text": "这比你做"
    },
    {
      "sid": "S00028",
      "start": 59.31,
      "end": 61.96,
      "text": "而不是"
    },
    {
      "sid": "S00029",
      "start": 61.96,
      "end": 63.62,
      "text": "父母说什么"
    },
    {
      "sid": "S00030",
      "start": 63.62,
      "end": 64.88,
      "text": "那个危险"
    },
    {
      "sid": "S00031",
      "start": 64.88,
      "end": 65.86,
      "text": "那个不好"
    },
    {
      "sid": "S00032",
      "start": 65.86,
      "end": 67.7,
      "text": "上班最稳定"
    },
    {
      "sid": "S00033",
      "start": 67.7,
      "end": 68.82,
      "text": "铁饭碗最稳定"
    },
    {
      "sid": "S00034",
      "start": 68.82,
      "end": 70.02,
      "text": "你就当公务员好了"
    },
    {
      "sid": "S00035",
      "start": 70.02,
      "end": 71.56,
      "text": "赶紧去考研考工"
    },
    {
      "sid": "S00036",
      "start": 71.56,
      "end": 76.2,
      "text": "那考工的人也"
    },
    {
      "sid": "S00037",
      "start": 76.2,
      "end": 77.3,
      "text": "就是"
    },
    {
      "sid": "S00038",
      "start": 77.3,
      "end": 79.98,
      "text": "活得波澜壮阔"
    },
    {
      "sid": "S00039",
      "start": 79.98,
      "end": 81.26,
      "text": "对不对"
    },
    {
      "sid": "S00040",
      "start": 81.26,
      "end": 84.46,
      "text": "比如说那个写那个什么明朝"
    },
    {
      "sid": "S00041",
      "start": 84.46,
      "end": 86.82,
      "text": "就明朝那点事的那个人"
    },
    {
      "sid": "S00042",
      "start": 86.82,
      "end": 88.5,
      "text": "人家也活得波澜壮阔"
    },
    {
      "sid": "S00043",
      "start": 88.5,
      "end": 89.46,
      "text": "人家当物理"
    },
    {
      "sid": "S00044",
      "start": 89.46,
      "end": 90.1,
      "text": "上了就是"
    },
    {
      "sid": "S00045",
      "start": 90.1,
      "end": 97.99,
      "text": "你觉得马斯克怎么样"
    },
    {
      "sid": "S00046",
      "start": 97.99,
      "end": 99.31,
      "text": "马斯克就是典型的"
    },
    {
      "sid": "S00047",
      "start": 99.31,
      "end": 100.01,
      "text": "就是"
    },
    {
      "sid": "S00048",
      "start": 100.01,
      "end": 101.59,
      "text": "就是什么"
    },
    {
      "sid": "S00049",
      "start": 101.59,
      "end": 102.29,
      "text": "武备"
    },
    {
      "sid": "S00050",
      "start": 102.29,
      "end": 103.35,
      "text": "武备开"
    },
    {
      "sid": "S00051",
      "start": 103.35,
      "end": 104.69,
      "text": "人中龙凤"
    },
    {
      "sid": "S00052",
      "start": 104.69,
      "end": 107.51,
      "text": "川普呢"
    },
    {
      "sid": "S00053",
      "start": 107.51,
      "end": 108.63,
      "text": "就是更是人中龙凤"
    },
    {
      "sid": "S00054",
      "start": 108.63,
      "end": 109.27,
      "text": "啊"
    }
  ]
}
