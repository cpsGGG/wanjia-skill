{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-030",
  "youtube_id": "Dn0SHuE89J0",
  "media_sha256": "426129f366674dbfd13e295cca8140e0d7f73f8fecfbd836d8c3639dc2df4c2d",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 3.79,
      "end": 5.55,
      "text": "我之前我记得我跟一个女生约会"
    },
    {
      "sid": "S00002",
      "start": 5.55,
      "end": 6.21,
      "text": "那女生说"
    },
    {
      "sid": "S00003",
      "start": 6.21,
      "end": 8.27,
      "text": "有没有人说过你很普兴"
    },
    {
      "sid": "S00004",
      "start": 8.27,
      "end": 10.73,
      "text": "然后我说"
    },
    {
      "sid": "S00005",
      "start": 10.73,
      "end": 12.63,
      "text": "我说这个东西不重要吧"
    },
    {
      "sid": "S00006",
      "start": 12.63,
      "end": 13.51,
      "text": "那我问你"
    },
    {
      "sid": "S00007",
      "start": 13.51,
      "end": 14.31,
      "text": "你是不是普通人"
    },
    {
      "sid": "S00008",
      "start": 14.31,
      "end": 15.35,
      "text": "那女生说"
    },
    {
      "sid": "S00009",
      "start": 15.35,
      "end": 16.37,
      "text": "是啊"
    },
    {
      "sid": "S00010",
      "start": 16.37,
      "end": 17.25,
      "text": "我是普通人"
    },
    {
      "sid": "S00011",
      "start": 17.25,
      "end": 18.61,
      "text": "我说那你是不是很自卑"
    },
    {
      "sid": "S00012",
      "start": 18.61,
      "end": 20.29,
      "text": "她说我不自卑"
    },
    {
      "sid": "S00013",
      "start": 20.29,
      "end": 21.21,
      "text": "我很自信的"
    },
    {
      "sid": "S00014",
      "start": 21.21,
      "end": 22.79,
      "text": "我说那你是不是普兴女"
    },
    {
      "sid": "S00015",
      "start": 22.79,
      "end": 24.15,
      "text": "她闭嘴了"
    },
    {
      "sid": "S00016",
      "start": 24.15,
      "end": 25.27,
      "text": "还不知道该说什么了"
    },
    {
      "sid": "S00017",
      "start": 25.27,
      "end": 28.11,
      "text": "就是说这些说这种"
    },
    {
      "sid": "S00018",
      "start": 28.11,
      "end": 29.71,
      "text": "用这些词汇的人"
    },
    {
      "sid": "S00019",
      "start": 29.71,
      "end": 31.51,
      "text": "本身没有独立思考能力"
    },
    {
      "sid": "S00020",
      "start": 31.51,
      "end": 32.55,
      "text": "然后智商也偏低"
    },
    {
      "sid": "S00021",
      "start": 32.55,
      "end": 34.41,
      "text": "你直接怼回去就行了"
    },
    {
      "sid": "S00022",
      "start": 34.41,
      "end": 36.77,
      "text": "是的"
    },
    {
      "sid": "S00023",
      "start": 36.77,
      "end": 37.91,
      "text": "你不需要跟人抬杠"
    },
    {
      "sid": "S00024",
      "start": 37.91,
      "end": 41.79,
      "text": "你永远不可能说服一个装睡的人"
    },
    {
      "sid": "S00025",
      "start": 41.79,
      "end": 44.11,
      "text": "因为人是屁股决定脑袋的"
    },
    {
      "sid": "S00026",
      "start": 44.11,
      "end": 45.37,
      "text": "他说这些话的一切目的"
    },
    {
      "sid": "S00027",
      "start": 45.37,
      "end": 47.13,
      "text": "都是基于他是女性的立场"
    },
    {
      "sid": "S00028",
      "start": 47.13,
      "end": 50.17,
      "text": "说一些就是对他有利的话"
    },
    {
      "sid": "S00029",
      "start": 50.17,
      "end": 51.79,
      "text": "那如果他的灵魂"
    },
    {
      "sid": "S00030",
      "start": 51.79,
      "end": 53.03,
      "text": "附着在一个男人身上"
    },
    {
      "sid": "S00031",
      "start": 53.03,
      "end": 54.11,
      "text": "他此刻当一个男人"
    },
    {
      "sid": "S00032",
      "start": 54.11,
      "end": 55.15,
      "text": "那么他说的一些话"
    },
    {
      "sid": "S00033",
      "start": 55.15,
      "end": 56.97,
      "text": "也是所有的话"
    },
    {
      "sid": "S00034",
      "start": 56.97,
      "end": 57.97,
      "text": "都是围绕着自己"
    },
    {
      "sid": "S00035",
      "start": 57.97,
      "end": 59.99,
      "text": "身为男性的利益点去讲的"
    },
    {
      "sid": "S00036",
      "start": 59.99,
      "end": 61.77,
      "text": "所以说人是屁股决定脑袋的"
    },
    {
      "sid": "S00037",
      "start": 61.77,
      "end": 63.15,
      "text": "没有真正的客观"
    },
    {
      "sid": "S00038",
      "start": 63.15,
      "end": 63.99,
      "text": "都是主观"
    },
    {
      "sid": "S00039",
      "start": 63.99,
      "end": 68.13,
      "text": "这也是为什么"
    },
    {
      "sid": "S00040",
      "start": 68.13,
      "end": 69.63,
      "text": "唯物世界的可贵"
    },
    {
      "sid": "S00041",
      "start": 69.63,
      "end": 71.85,
      "text": "没有人能做到真正的唯物"
    },
    {
      "sid": "S00042",
      "start": 71.85,
      "end": 74.71,
      "text": "有那就是圣人"
    },
    {
      "sid": "S00043",
      "start": 74.71,
      "end": 77.31,
      "text": "但是我们要尽可能能做到唯物"
    },
    {
      "sid": "S00044",
      "start": 77.31,
      "end": 80.94,
      "text": "但唯物呢也是"
    },
    {
      "sid": "S00045",
      "start": 80.94,
      "end": 82.84,
      "text": "选择性的唯物"
    },
    {
      "sid": "S00046",
      "start": 82.84,
      "end": 87.45,
      "text": "在我们创业的时候"
    },
    {
      "sid": "S00047",
      "start": 87.45,
      "end": 88.99,
      "text": "在我们撩妹的时候"
    },
    {
      "sid": "S00048",
      "start": 88.99,
      "end": 90.45,
      "text": "在我们做任何事情的时候"
    },
    {
      "sid": "S00049",
      "start": 90.45,
      "end": 91.11,
      "text": "我们可以唯物"
    },
    {
      "sid": "S00050",
      "start": 91.11,
      "end": 91.99,
      "text": "但是呢"
    },
    {
      "sid": "S00051",
      "start": 91.99,
      "end": 93.39,
      "text": "当触及到我们的利益的时候"
    },
    {
      "sid": "S00052",
      "start": 93.39,
      "end": 94.13,
      "text": "我们要唯心"
    },
    {
      "sid": "S00053",
      "start": 94.13,
      "end": 97.04,
      "text": "这个就是哲学"
    },
    {
      "sid": "S00054",
      "start": 97.04,
      "end": 99.64,
      "text": "东西啊"
    },
    {
      "sid": "S00055",
      "start": 99.64,
      "end": 100.76,
      "text": "我前面说了"
    },
    {
      "sid": "S00056",
      "start": 100.76,
      "end": 102.44,
      "text": "当你在做一些"
    },
    {
      "sid": "S00057",
      "start": 102.44,
      "end": 103.72,
      "text": "很重要的事情的时候"
    },
    {
      "sid": "S00058",
      "start": 103.72,
      "end": 106.64,
      "text": "你是以自己的利益为主的时候"
    },
    {
      "sid": "S00059",
      "start": 106.64,
      "end": 107.7,
      "text": "你是可以唯心的"
    },
    {
      "sid": "S00060",
      "start": 107.7,
      "end": 108.72,
      "text": "但是我们要尽量的"
    },
    {
      "sid": "S00061",
      "start": 108.72,
      "end": 109.74,
      "text": "我们要尽量的"
    },
    {
      "sid": "S00062",
      "start": 109.74,
      "end": 110.46,
      "text": "我们要尽量的"
    },
    {
      "sid": "S00063",
      "start": 110.46,
      "end": 110.94,
      "text": "我们要尽量的"
    }
  ]
}
