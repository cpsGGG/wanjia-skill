  "media_sha256": "617bdee83069d91b5edb8ada837dbffd4414da4406411be16f933cd49559c365",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.3,
      "text": "强行为线索怎么回应"
    },
    {
      "sid": "S00002",
      "start": 1.3,
      "end": 4.56,
      "text": "我们一般我们讲吸引"
    },
    {
      "sid": "S00003",
      "start": 4.56,
      "end": 5.18,
      "text": "什么是吸引"
    },
    {
      "sid": "S00004",
      "start": 5.18,
      "end": 7.2,
      "text": "吸引的本质就是强行为线索"
    },
    {
      "sid": "S00005",
      "start": 7.2,
      "end": 10.18,
      "text": "那为什么有些人他们天生就能把妹呢"
    },
    {
      "sid": "S00006",
      "start": 10.18,
      "end": 11.58,
      "text": "他们天生就能泡妞呢"
    },
    {
      "sid": "S00007",
      "start": 11.58,
      "end": 14.18,
      "text": "你们有没有思考过这个问题"
    },
    {
      "sid": "S00008",
      "start": 14.18,
      "end": 16.66,
      "text": "是这个人天生就掌握了什么技巧吗"
    },
    {
      "sid": "S00009",
      "start": 16.66,
      "end": 17.96,
      "text": "不是的"
    },
    {
      "sid": "S00010",
      "start": 17.96,
      "end": 20.68,
      "text": "是这个人他从出生那一刻开始"
    },
    {
      "sid": "S00011",
      "start": 20.68,
      "end": 22.26,
      "text": "他父母的教育"
    },
    {
      "sid": "S00012",
      "start": 22.26,
      "end": 23.68,
      "text": "或者是他寻找环境"
    },
    {
      "sid": "S00013",
      "start": 23.68,
      "end": 25.1,
      "text": "或者是各方面因素"
    },
    {
      "sid": "S00014",
      "start": 25.1,
      "end": 27.76,
      "text": "给他造就了一身强行为线索"
    },
    {
      "sid": "S00015",
      "start": 27.76,
      "end": 29.2,
      "text": "以至于他在青春期的时候"
    },
    {
      "sid": "S00016",
      "start": 29.2,
      "end": 31.22,
      "text": "你就会发现他就是可以去吸引到女人"
    },
    {
      "sid": "S00017",
      "start": 31.22,
      "end": 32.96,
      "text": "他没有任何的迹象"
    },
    {
      "sid": "S00018",
      "start": 32.96,
      "end": 34.06,
      "text": "他也不知道他为什么"
    },
    {
      "sid": "S00019",
      "start": 34.06,
      "end": 36.72,
      "text": "他甚至他自己都不知道这些女人为什么喜欢他"
    },
    {
      "sid": "S00020",
      "start": 36.72,
      "end": 38.62,
      "text": "他就觉得这些女人喜欢"
    },
    {
      "sid": "S00021",
      "start": 38.62,
      "end": 40.84,
      "text": "就这些女人就是会喜欢他"
    },
    {
      "sid": "S00022",
      "start": 40.84,
      "end": 41.94,
      "text": "就是会对他有感觉"
    },
    {
      "sid": "S00023",
      "start": 41.94,
      "end": 44.02,
      "text": "他也不知道这些女人为什么会喜欢他"
    },
    {
      "sid": "S00024",
      "start": 44.02,
      "end": 45.36,
      "text": "然后呢"
    },
    {
      "sid": "S00025",
      "start": 45.36,
      "end": 47.08,
      "text": "如果这个人呢"
    },
    {
      "sid": "S00026",
      "start": 47.08,
      "end": 49.4,
      "text": "他觉得他如果这个男生呢"
    },
    {
      "sid": "S00027",
      "start": 49.4,
      "end": 50.82,
      "text": "这个具备强行性的人呢"
    },
    {
      "sid": "S00028",
      "start": 50.82,
      "end": 53.66,
      "text": "他臭巧长得又有点小帅"
    },
    {
      "sid": "S00029",
      "start": 53.66,
      "end": 54.84,
      "text": "那这个时候呢"
    },
    {
      "sid": "S00030",
      "start": 54.84,
      "end": 55.38,
      "text": "他就会觉得"
    },
    {
      "sid": "S00031",
      "start": 55.38,
      "end": 58.08,
      "text": "可能是因为他们看上了我的颜值"
    },
    {
      "sid": "S00032",
      "start": 58.08,
      "end": 59.52,
      "text": "但是呢"
    },
    {
      "sid": "S00033",
      "start": 59.52,
      "end": 61.66,
      "text": "他没有去思考过"
    },
    {
      "sid": "S00034",
      "start": 61.66,
      "end": 63.08,
      "text": "有一部分帅哥"
    },
    {
      "sid": "S00035",
      "start": 63.08,
      "end": 64.2,
      "text": "他们长得帅"
    },
    {
      "sid": "S00036",
      "start": 64.2,
      "end": 65.38,
      "text": "但是没有吸引力的"
    },
    {
      "sid": "S00037",
      "start": 65.38,
      "end": 66.8,
      "text": "女人一样不会喜欢他"
    },
    {
      "sid": "S00038",
      "start": 66.8,
      "end": 72.11,
      "text": "这个就是要用辩证的角度去看待这件事情了"
    },
    {
      "sid": "S00039",
      "start": 72.11,
      "end": 74.65,
      "text": "那也有一些人呢"
    },
    {
      "sid": "S00040",
      "start": 74.65,
      "end": 76.99,
      "text": "就是他可能从小"
    },
    {
      "sid": "S00041",
      "start": 76.99,
      "end": 79.01,
      "text": "他从小他长大"
    },
    {
      "sid": "S00042",
      "start": 79.01,
      "end": 79.93,
      "text": "从小到大"
    },
    {
      "sid": "S00043",
      "start": 79.93,
      "end": 82.53,
      "text": "他就是比较怒弱弱弱"
    },
    {
      "sid": "S00044",
      "start": 82.53,
      "end": 84.51,
      "text": "他就是具备了很多弱性的线索"
    },
    {
      "sid": "S00045",
      "start": 84.51,
      "end": 86.55,
      "text": "然后呢"
    },
    {
      "sid": "S00046",
      "start": 86.55,
      "end": 87.67,
      "text": "他恰巧就长得丑"
    },
    {
      "sid": "S00047",
      "start": 87.67,
      "end": 89.25,
      "text": "然后呢"
    },
    {
      "sid": "S00048",
      "start": 89.25,
      "end": 90.23,
      "text": "他把他所有的"
    },
    {
      "sid": "S00049",
      "start": 90.23,
      "end": 91.55,
      "text": "归因"
    },
    {
      "sid": "S00050",
      "start": 91.55,
      "end": 93.41,
      "text": "所有失败的归因都归因于"
    },
    {
      "sid": "S00051",
      "start": 93.41,
      "end": 95.39,
      "text": "因为我长得丑"
    },
    {
      "sid": "S00052",
      "start": 95.39,
      "end": 97.17,
      "text": "所以说女人不爱我"
    },
    {
      "sid": "S00053",
      "start": 97.17,
      "end": 99.17,
      "text": "没有归因到就是"
    },
    {
      "sid": "S00054",
      "start": 99.17,
      "end": 102.13,
      "text": "就是正确的点上"
    },
    {
      "sid": "S00055",
      "start": 102.13,
      "end": 103.73,
      "text": "有没有可能是你这个人"
    },
    {
      "sid": "S00056",
      "start": 103.73,
      "end": 105.67,
      "text": "又他妈的没有强生性的时候"
    },
    {
      "sid": "S00057",
      "start": 105.67,
      "end": 106.41,
      "text": "长得又丑"
    },
    {
      "sid": "S00058",
      "start": 106.41,
      "end": 108.37,
      "text": "导致了就是女人不光"
    },
    {
      "sid": "S00059",
      "start": 108.37,
      "end": 109.33,
      "text": "就是"
    },
    {
      "sid": "S00060",
      "start": 109.33,
      "end": 111.67,
      "text": "就不光就是跟你接近了"
    },
    {
      "sid": "S00061",
      "start": 111.67,
      "end": 112.27,
      "text": "不喜欢你"
    },
    {
      "sid": "S00062",
      "start": 112.27,
      "end": 113.63,
      "text": "甚至都不愿意接近你"
    },
    {
      "sid": "S00063",
      "start": 113.63,
      "end": 115.23,
      "text": "能懂吗"
    }
  ]
}
