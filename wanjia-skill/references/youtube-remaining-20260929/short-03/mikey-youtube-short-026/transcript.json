    },
    {
      "sid": "S00023",
      "start": 41.22,
      "end": 42.3,
      "text": "然后他想跟你见面"
    },
    {
      "sid": "S00024",
      "start": 42.3,
      "end": 43.68,
      "text": "他无法拒绝你"
    },
    {
      "sid": "S00025",
      "start": 43.68,
      "end": 46.14,
      "text": "他无法拒绝你"
    },
    {
      "sid": "S00026",
      "start": 46.14,
      "end": 48.46,
      "text": "就是我跟"
    },
    {
      "sid": "S00027",
      "start": 48.46,
