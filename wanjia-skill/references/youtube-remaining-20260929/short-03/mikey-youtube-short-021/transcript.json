  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.0,
      "text": "就是開心一種放鬆的一種狀況"
    },
    {
      "sid": "S00002",
      "start": 2.0,
      "end": 6.16,
      "text": "而不是我要強行去表現出我很高能量"
    },
    {
      "sid": "S00003",
      "start": 6.16,
      "end": 7.76,
      "text": "我很優秀我很酷"
    },
    {
      "sid": "S00004",
      "start": 7.76,
      "end": 9.44,
      "text": "這是不具備一致性的"
    },
    {
      "sid": "S00005",
      "start": 9.44,
      "end": 12.0,
      "text": "因為你生活中你當下並不是這樣子"
    },
    {
      "sid": "S00006",
      "start": 13.28,
      "end": 13.92,
      "text": "對吧"
    },
    {
      "sid": "S00007",
      "start": 15.04,
      "end": 16.24,
      "text": "不然會用力過門"
    },
    {
      "sid": "S00008",
      "start": 16.24,
      "end": 18.56,
      "text": "用力過門的話女人會覺得就是"
    },
    {
      "sid": "S00009",
      "start": 18.56,
      "end": 20.48,
      "text": "這男的有點奇怪"
    },
    {
      "sid": "S00010",
      "start": 20.48,
      "end": 22.24,
      "text": "無視線陰晴味"
    }
  ]
