{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-028",
  "youtube_id": "MqnwsxmTFL8",
  "media_sha256": "0f5439ad583b54bca5f2cdb68944d6ae5e8b374fc76607af64fd47dba1ae783f",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 0.86,
      "text": "我来跟你们讲一下"
    },
    {
      "sid": "S00002",
      "start": 0.86,
      "end": 2.28,
      "text": "跟女生会讲话的一个"
    },
    {
      "sid": "S00003",
      "start": 2.28,
      "end": 3.94,
      "text": "会紧张的一个原因"
    },
    {
      "sid": "S00004",
      "start": 3.94,
      "end": 5.86,
      "text": "是因为你在潜意识里"
    },
    {
      "sid": "S00005",
      "start": 5.86,
      "end": 7.8,
      "text": "你把这个女人当成了一个裁判"
    },
    {
      "sid": "S00006",
      "start": 7.8,
      "end": 10.94,
      "text": "当成了评委"
    },
    {
      "sid": "S00007",
      "start": 10.94,
      "end": 13.24,
      "text": "她能决定"
    },
    {
      "sid": "S00008",
      "start": 13.24,
      "end": 14.78,
      "text": "你的价值"
    },
    {
      "sid": "S00009",
      "start": 14.78,
      "end": 17.6,
      "text": "她的反应决定了你的价值"
    },
    {
      "sid": "S00010",
      "start": 17.6,
      "end": 20.44,
      "text": "这意味着你把自己"
    },
    {
      "sid": "S00011",
      "start": 20.44,
      "end": 21.2,
      "text": "就是"
    },
    {
      "sid": "S00012",
      "start": 21.2,
      "end": 22.58,
      "text": "她为刀组"
    },
    {
      "sid": "S00013",
      "start": 22.58,
      "end": 23.38,
      "text": "你为鱼肉"
    },
    {
      "sid": "S00014",
      "start": 23.38,
      "end": 24.16,
      "text": "那我想知道"
    },
    {
      "sid": "S00015",
      "start": 24.16,
      "end": 25.9,
      "text": "你男的四个人都会紧张"
    },
    {
      "sid": "S00016",
      "start": 25.9,
      "end": 28.02,
      "text": "因为你跟她这场约会"
    },
    {
      "sid": "S00017",
      "start": 28.02,
      "end": 28.74,
      "text": "如果失败了"
    },
    {
      "sid": "S00018",
      "start": 28.74,
      "end": 29.96,
      "text": "意味着你这个人是个傻逼"
    },
    {
      "sid": "S00019",
      "start": 29.96,
      "end": 32.44,
      "text": "你肯定会紧张"
    },
    {
      "sid": "S00020",
      "start": 32.44,
      "end": 34.16,
      "text": "但我跟女生约会"
    },
    {
      "sid": "S00021",
      "start": 34.16,
      "end": 34.74,
      "text": "我失败了"
    },
    {
      "sid": "S00022",
      "start": 34.74,
      "end": 36.02,
      "text": "我只会觉得是失败了"
    },
    {
      "sid": "S00023",
      "start": 36.02,
      "end": 36.7,
      "text": "OK 没关系"
    },
    {
      "sid": "S00024",
      "start": 36.7,
      "end": 37.82,
      "text": "找找原因"
    },
    {
      "sid": "S00025",
      "start": 37.82,
      "end": 39.64,
      "text": "哦 这个女生有男朋友"
    },
    {
      "sid": "S00026",
      "start": 39.64,
      "end": 41.16,
      "text": "那我该怎么操作呢"
    },
    {
      "sid": "S00027",
      "start": 41.16,
      "end": 42.14,
      "text": "想一想想一想"
    },
    {
      "sid": "S00028",
      "start": 42.14,
      "end": 43.32,
      "text": "啊 我知道怎么做了"
    },
    {
      "sid": "S00029",
      "start": 43.32,
      "end": 44.46,
      "text": "我不会说"
    },
    {
      "sid": "S00030",
      "start": 44.46,
      "end": 45.36,
      "text": "我失败了"
    },
    {
      "sid": "S00031",
      "start": 45.36,
      "end": 46.36,
      "text": "我这个傻逼"
    },
    {
      "sid": "S00032",
      "start": 46.36,
      "end": 47.78,
      "text": "我竟然失败了"
    },
    {
      "sid": "S00033",
      "start": 47.78,
      "end": 49.06,
      "text": "我不可以失败"
    },
    {
      "sid": "S00034",
      "start": 49.06,
      "end": 50.44,
      "text": "那我不会了"
    },
    {
      "sid": "S00035",
      "start": 50.44,
      "end": 52.76,
      "text": "而且很多时候"
    },
    {
      "sid": "S00036",
      "start": 52.76,
      "end": 53.42,
      "text": "你认为的失败"
    },
    {
      "sid": "S00037",
      "start": 53.42,
      "end": 54.46,
      "text": "它未必是真的失败"
    },
    {
      "sid": "S00038",
      "start": 54.46,
      "end": 57.52,
      "text": "你需要去结合多种因素"
    },
    {
      "sid": "S00039",
      "start": 57.52,
      "end": 59.88,
      "text": "最后去推出一个真相"
    },
    {
      "sid": "S00040",
      "start": 59.88,
      "end": 61.06,
      "text": "而不是某一单因素"
    },
    {
      "sid": "S00041",
      "start": 61.06,
      "end": 64.28,
      "text": "你如果潜意识地把女人当成一个裁判"
    },
    {
      "sid": "S00042",
      "start": 64.28,
      "end": 66.2,
      "text": "她对你说yes"
    },
    {
      "sid": "S00043",
      "start": 66.2,
      "end": 67.56,
      "text": "你就有价值"
    },
    {
      "sid": "S00044",
      "start": 67.56,
      "end": 68.88,
      "text": "她对你说no你就没有价值"
    },
    {
      "sid": "S00045",
      "start": 68.88,
      "end": 70.62,
      "text": "那么你这一生都会就是"
    },
    {
      "sid": "S00046",
      "start": 70.62,
      "end": 73.74,
      "text": "你这一生都是随波逐流的"
    },
    {
      "sid": "S00047",
      "start": 73.74,
      "end": 75.12,
      "text": "你没有自己的主心骨"
    },
    {
      "sid": "S00048",
      "start": 75.12,
      "end": 76.98,
      "text": "没有主心骨的人是很没有魅力的"
    },
    {
      "sid": "S00049",
      "start": 76.98,
      "end": 80.16,
      "text": "没有主心骨的人"
    },
    {
      "sid": "S00050",
      "start": 80.16,
      "end": 81.36,
      "text": "我管你有多少钱"
    },
    {
      "sid": "S00051",
      "start": 81.36,
      "end": 82.6,
      "text": "有多少价值"
    },
    {
      "sid": "S00052",
      "start": 82.6,
      "end": 83.28,
      "text": "客观价值"
    },
    {
      "sid": "S00053",
      "start": 83.28,
      "end": 85.38,
      "text": "她就是左男"
    },
    {
      "sid": "S00054",
      "start": 85.38,
      "end": 88.8,
      "text": "就是价值不等于价值感"
    },
    {
      "sid": "S00055",
      "start": 88.8,
      "end": 91.3,
      "text": "有价值感的人往往都有主心骨"
    },
    {
      "sid": "S00056",
      "start": 91.3,
      "end": 92.44,
      "text": "因为你有了主心骨"
    },
    {
      "sid": "S00057",
      "start": 92.44,
      "end": 93.24,
      "text": "你才会有价值感"
    },
    {
      "sid": "S00058",
      "start": 93.24,
      "end": 94.62,
      "text": "你光有价值"
    },
    {
      "sid": "S00059",
      "start": 94.62,
      "end": 95.26,
      "text": "你没有主心骨"
    },
    {
      "sid": "S00060",
      "start": 95.26,
      "end": 97.9,
      "text": "你的价值终有一天会离你而去"
    },
    {
      "sid": "S00061",
      "start": 97.9,
      "end": 101.36,
      "text": "他只是今天正好"
    },
    {
      "sid": "S00062",
      "start": 101.36,
      "end": 102.7,
      "text": "这些价值砸到你的手上了"
    },
    {
      "sid": "S00063",
      "start": 102.7,
      "end": 104.64,
      "text": "可能过几天就慢慢流到别人身上了"
    },
    {
      "sid": "S00064",
      "start": 104.64,
      "end": 108.23,
      "text": "有些人炒股赚了很多很多钱"
    },
    {
      "sid": "S00065",
      "start": 108.23,
      "end": 109.03,
      "text": "但他依然自卑"
    },
    {
      "sid": "S00066",
      "start": 109.03,
      "end": 110.69,
      "text": "非常自卑"
    },
    {
      "sid": "S00067",
      "start": 110.69,
      "end": 112.01,
      "text": "他炒比特币赚了很多很多钱"
    },
    {
      "sid": "S00068",
      "start": 112.01,
      "end": 112.59,
      "text": "他依然自卑"
    },
    {
      "sid": "S00069",
      "start": 112.59,
      "end": 113.29,
      "text": "他依然空虚"
    },
    {
      "sid": "S00070",
      "start": 113.29,
      "end": 114.59,
      "text": "为什么"
    },
    {
      "sid": "S00071",
      "start": 114.59,
      "end": 115.31,
      "text": "他有价值"
    },
    {
      "sid": "S00072",
      "start": 115.31,
      "end": 116.21,
      "text": "但他没有价值感"
    },
    {
      "sid": "S00073",
      "start": 116.21,
      "end": 117.39,
      "text": "但也有些人"
    },
    {
      "sid": "S00074",
      "start": 117.39,
      "end": 118.27,
      "text": "他们没有那么有钱"
    },
    {
      "sid": "S00075",
      "start": 118.27,
      "end": 119.45,
      "text": "但是他就觉得自己很屌"
    }
  ]
}
