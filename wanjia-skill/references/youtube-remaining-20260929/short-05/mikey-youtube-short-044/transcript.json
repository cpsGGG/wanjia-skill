{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-044",
  "youtube_id": "SRv3bw4d6AA",
  "media_sha256": "832fb91364a3009d5e46aea792ba73da08938a220774cec9eaeac30ccf1436e1",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.7,
      "text": "给她一次和费杨阳一起看演唱会的机会"
    },
    {
      "sid": "S00002",
      "start": 2.7,
      "end": 5.42,
      "text": "她能为着良心说自己是一个人来的"
    },
    {
      "sid": "S00003",
      "start": 5.42,
      "end": 7.5,
      "text": "再给她一次被点名的机会"
    },
    {
      "sid": "S00004",
      "start": 7.5,
      "end": 10.84,
      "text": "她能以为自己被选中当明星家属了"
    },
    {
      "sid": "S00005",
      "start": 10.84,
      "end": 12.7,
      "text": "据现场网友透露"
    },
    {
      "sid": "S00006",
      "start": 12.7,
      "end": 14.14,
      "text": "镜头给到小仙女时"
    },
    {
      "sid": "S00007",
      "start": 14.14,
      "end": 16.68,
      "text": "小仙女捂着小嘴对费杨阳说道"
    },
    {
      "sid": "S00008",
      "start": 16.68,
      "end": 19.0,
      "text": "待会我两别互动装不认识"
    },
    {
      "sid": "S00009",
      "start": 19.0,
      "end": 20.54,
      "text": "费杨阳很不解"
    },
    {
      "sid": "S00010",
      "start": 20.54,
      "end": 23.28,
      "text": "但小仙女的要求是没法拒绝的"
    },
    {
      "sid": "S00011",
      "start": 23.28,
      "end": 24.52,
      "text": "直到老薛提问"
    },
    {
      "sid": "S00012",
      "start": 24.52,
      "end": 26.18,
      "text": "小仙女是几个人来的"
    },
    {
      "sid": "S00013",
      "start": 26.18,
      "end": 28.16,
      "text": "小仙女举起一根手指"
    },
    {
      "sid": "S00014",
      "start": 28.16,
      "end": 29.44,
      "text": "回答一个人来时"
    },
    {
      "sid": "S00015",
      "start": 29.44,
      "end": 32.04,
      "text": "费杨阳最后的幻想也破灭了"
    },
    {
      "sid": "S00016",
      "start": 32.04,
      "end": 34.08,
      "text": "不敢相信的质问小仙女"
    },
    {
      "sid": "S00017",
      "start": 34.08,
      "end": 34.98,
      "text": "我不是人吗"
    },
    {
      "sid": "S00018",
      "start": 34.98,
      "end": 38.06,
      "text": "小仙女被初中破防恼羞成怒"
    },
    {
      "sid": "S00019",
      "start": 38.06,
      "end": 39.74,
      "text": "直接让费杨阳滚蛋"
    },
    {
      "sid": "S00020",
      "start": 39.74,
      "end": 41.38,
      "text": "但滚是不可能的"
    },
    {
      "sid": "S00021",
      "start": 41.38,
      "end": 43.28,
      "text": "早已被拿捏得死死的"
    },
    {
      "sid": "S00022",
      "start": 43.28,
      "end": 45.7,
      "text": "要不然也不会成为费杨阳"
    },
    {
      "sid": "S00023",
      "start": 45.7,
      "end": 48.02,
      "text": "果不其然演唱会结束后"
    },
    {
      "sid": "S00024",
      "start": 48.02,
      "end": 49.46,
      "text": "网友拍到费杨阳"
    },
    {
      "sid": "S00025",
      "start": 49.46,
      "end": 52.0,
      "text": "还是屁颠屁颠跟在小仙女后面"
    },
    {
      "sid": "S00026",
      "start": 52.0,
      "end": 54.82,
      "text": "估计已经全变成费杨阳的错了"
    },
    {
      "sid": "S00027",
      "start": 54.82,
      "end": 57.42,
      "text": "盲财票是费杨阳家家买的"
    },
    {
      "sid": "S00028",
      "start": 57.42,
      "end": 58.18,
      "text": "好,是个家人的"
    },
    {
      "sid": "S00029",
      "start": 58.18,
      "end": 59.78,
      "text": "好,是个人讨厌的"
    }
  ]
}
