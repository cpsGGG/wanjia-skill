  "media_sha256": "6a4bb19553fe7c993f1a8b8cba36984e04f2b3ec53b0e8db950ef59ac40f1490",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.3,
      "text": "练习是不断重复吗?我认为不是的"
    },
    {
      "sid": "S00002",
      "start": 2.3,
      "end": 4.06,
      "text": "不断的重复只是天真的练习"
    },
    {
      "sid": "S00003",
      "start": 4.06,
      "end": 6.04,
      "text": "它是没有办法带来有效的进步的"
    },
    {
      "sid": "S00004",
      "start": 6.04,
      "end": 8.04,
      "text": "正确的练习需要好导师"
    },
    {
      "sid": "S00005",
      "start": 8.04,
      "end": 9.08,
      "text": "有目标有反馈"
    },
    {
      "sid": "S00006",
      "start": 9.08,
      "end": 11.66,
      "text": "我们身边从不缺乏一些看似努力"
    },
    {
      "sid": "S00007",
      "start": 11.66,
      "end": 12.84,
      "text": "其实没有结果的人"
    },
    {
      "sid": "S00008",
      "start": 12.84,
      "end": 15.2,
      "text": "练习搭讪时采取阶段性进步"
    },
    {
      "sid": "S00009",
      "start": 15.2,
      "end": 17.12,
      "text": "并针对性调整策略"
    },
    {
      "sid": "S00010",
      "start": 17.12,
      "end": 19.72,
      "text": "和你机械性的每日花上几个小时"
    },
    {
      "sid": "S00011",
      "start": 19.72,
      "end": 20.66,
      "text": "为了搭讪而搭讪"
    },
    {
      "sid": "S00012",
      "start": 20.66,
      "end": 22.76,
      "text": "这两者的区别是超级大的"
    }
  ]
}
