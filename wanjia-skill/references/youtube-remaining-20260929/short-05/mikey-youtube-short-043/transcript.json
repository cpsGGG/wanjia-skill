{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-043",
  "youtube_id": "beVlsu3s1mQ",
  "media_sha256": "6e851b5215486fb8941dd343130996ffaa4c4ec4270751f3c68dd196a2fd5309",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.3,
      "text": "很多兄弟们经常跟我抱怨"
    },
    {
      "sid": "S00002",
      "start": 1.3,
      "end": 2.68,
      "text": "我改变不了我太难了"
    },
    {
      "sid": "S00003",
      "start": 2.68,
      "end": 5.18,
      "text": "我这里想跟兄弟们讲的就是"
    },
    {
      "sid": "S00004",
      "start": 5.18,
      "end": 6.56,
      "text": "你不要老批评自己"
    },
    {
      "sid": "S00005",
      "start": 6.56,
      "end": 8.7,
      "text": "你越批评自己你越改变不了"
    },
    {
      "sid": "S00006",
      "start": 8.7,
      "end": 10.36,
      "text": "因为你越批评自己"
    },
    {
      "sid": "S00007",
      "start": 10.36,
      "end": 12.76,
      "text": "你的自尊水平就会不断的下降"
    },
    {
      "sid": "S00008",
      "start": 12.76,
      "end": 15.68,
      "text": "你已经耗费了大量的精力去批评自己"
    },
    {
      "sid": "S00009",
      "start": 15.68,
      "end": 18.48,
      "text": "那你就没有力气去改变了"
    },
    {
      "sid": "S00010",
      "start": 18.48,
      "end": 19.7,
      "text": "你想要改变"
    },
    {
      "sid": "S00011",
      "start": 19.7,
      "end": 22.22,
      "text": "你第一步应该是接纳我当下的这个自己"
    },
    {
      "sid": "S00012",
      "start": 22.22,
      "end": 24.44,
      "text": "虽然我是一个犯过错的人"
    },
    {
      "sid": "S00013",
      "start": 24.44,
      "end": 27.02,
      "text": "虽然我是一个伤害过别人的人"
    },
    {
      "sid": "S00014",
      "start": 27.02,
      "end": 28.66,
      "text": "但是我依然爱我自己"
    },
    {
      "sid": "S00015",
      "start": 28.66,
      "end": 30.44,
      "text": "我愿意接纳当下的这个字"
    },
    {
      "sid": "S00016",
      "start": 30.44,
      "end": 32.36,
      "text": "我可以做得更好"
    },
    {
      "sid": "S00017",
      "start": 32.36,
      "end": 32.88,
      "text": "OK"
    },
    {
      "sid": "S00018",
      "start": 32.88,
      "end": 34.76,
      "text": "只有接纳自己的问题"
    },
    {
      "sid": "S00019",
      "start": 34.76,
      "end": 36.54,
      "text": "才有改变的力量"
    }
  ]
}
