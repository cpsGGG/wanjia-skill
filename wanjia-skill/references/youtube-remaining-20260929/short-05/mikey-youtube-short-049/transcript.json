{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-049",
  "youtube_id": "J4fxjbY8u0U",
  "media_sha256": "43c85dabc08370b13e2c80f19a514f82c135e5b86b72424cdfb027421cc612e7",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 1.44,
      "text": "大家有没有遇到过那种"
    },
    {
      "sid": "S00002",
      "start": 1.44,
      "end": 3.16,
      "text": "出来玩就一直在玩手机的女生"
    },
    {
      "sid": "S00003",
      "start": 3.16,
      "end": 4.44,
      "text": "就让你喝酒你也不喝"
    },
    {
      "sid": "S00004",
      "start": 4.44,
      "end": 5.6,
      "text": "让你玩游戏你也不玩"
    },
    {
      "sid": "S00005",
      "start": 5.6,
      "end": 8.36,
      "text": "搞得自己一种高高在上的感觉"
    },
    {
      "sid": "S00006",
      "start": 8.36,
      "end": 10.72,
      "text": "其实在Mikey这里我认为这种是最low的"
    },
    {
      "sid": "S00007",
      "start": 10.72,
      "end": 11.4,
      "text": "为什么"
    },
    {
      "sid": "S00008",
      "start": 11.4,
      "end": 13.0,
      "text": "因为我觉得你既然来了"
    },
    {
      "sid": "S00009",
      "start": 13.0,
      "end": 14.8,
      "text": "你就应该尊重这个场合里的所有人"
    },
    {
      "sid": "S00010",
      "start": 14.8,
      "end": 17.88,
      "text": "我觉得给面子是社交里面最基本的"
    },
    {
      "sid": "S00011",
      "start": 17.88,
      "end": 20.66,
      "text": "如果你一开始觉得这个局不行就不该来"
    },
    {
      "sid": "S00012",
      "start": 20.66,
      "end": 23.4,
      "text": "有些女生她就是那种又菜又爱玩"
    },
    {
      "sid": "S00013",
      "start": 23.4,
      "end": 24.34,
      "text": "什么局都想去"
    },
    {
      "sid": "S00014",
      "start": 24.34,
      "end": 25.8,
      "text": "去了还搞不清楚状况"
    },
    {
      "sid": "S00015",
      "start": 25.8,
      "end": 27.76,
      "text": "最后把自己在圈子里搞臭了"
    },
    {
      "sid": "S00016",
      "start": 27.76,
      "end": 29.58,
      "text": "也只能混一些就是低端新手局"
    },
    {
      "sid": "S00017",
      "start": 29.58,
      "end": 30.9,
      "text": "老了也没有人要"
    }
  ]
}
