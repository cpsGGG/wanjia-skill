{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-046",
  "youtube_id": "zHgwYvflSrs",
  "media_sha256": "cdbf960bb9c98e7b3600ab4c6bd1a342dbcd2ef9e6161900fcf77ed01b8fcdd8",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 3.22,
      "text": "为什么很多人宁愿忍受生活里没有异性的长期失落"
    },
    {
      "sid": "S00002",
      "start": 3.22,
      "end": 6.66,
      "text": "也不愿意承受搭讪异性时那份短暂的紧张"
    },
    {
      "sid": "S00003",
      "start": 6.66,
      "end": 9.16,
      "text": "宁愿忍受平庸带来的长期自卑"
    },
    {
      "sid": "S00004",
      "start": 9.16,
      "end": 13.94,
      "text": "也不愿意承受挑战未知给自己带来的那份短暂的恐惧"
    },
    {
      "sid": "S00005",
      "start": 13.94,
      "end": 17.32,
      "text": "因为紧张和恐惧它虽然是短暂的"
    },
    {
      "sid": "S00006",
      "start": 17.32,
      "end": 19.34,
      "text": "但是它是猛烈的"
    },
    {
      "sid": "S00007",
      "start": 19.34,
      "end": 21.3,
      "text": "而自卑和失落虽然是长期"
    },
    {
      "sid": "S00008",
      "start": 21.3,
      "end": 23.16,
      "text": "但是它是缓和的"
    },
    {
      "sid": "S00009",
      "start": 23.16,
      "end": 26.36,
      "text": "人们的大脑还是猛烈的感受"
    },
    {
      "sid": "S00010",
      "start": 26.36,
      "end": 28.1,
      "text": "更容易接受缓和的感受"
    },
    {
      "sid": "S00011",
      "start": 28.1,
      "end": 32.54,
      "text": "所以说在短暂紧张的恐惧和长期自卑失落之间"
    },
    {
      "sid": "S00012",
      "start": 32.54,
      "end": 35.72,
      "text": "人们更容易选择长期而缓和的感受"
    }
  ]
}
