{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-047",
  "youtube_id": "n5elOH9OnBA",
  "media_sha256": "7e661b00752c5494d6af62b8a9aca54b87d6b10648766272611b9d97b27c0e42",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.5,
      "end": 3.58,
      "text": "其实有的时候错误也是一种变相的经验"
    },
    {
      "sid": "S00002",
      "start": 3.58,
      "end": 6.18,
      "text": "我来说一下我自己对犯错的看法"
    },
    {
      "sid": "S00003",
      "start": 6.18,
      "end": 9.96,
      "text": "是一种我愿意为我犯的错误全部买单"
    },
    {
      "sid": "S00004",
      "start": 9.96,
      "end": 13.1,
      "text": "但是我不会后悔我做的任何决定"
    },
    {
      "sid": "S00005",
      "start": 13.1,
      "end": 15.22,
      "text": "我从来不会怀疑自己的眼光"
    },
    {
      "sid": "S00006",
      "start": 15.22,
      "end": 18.76,
      "text": "我认为之所以事与愿违"
    },
    {
      "sid": "S00007",
      "start": 18.76,
      "end": 21.02,
      "text": "它只不过是我当下的能力不够而已"
    },
    {
      "sid": "S00008",
      "start": 21.02,
      "end": 22.44,
      "text": "我们可以去慢慢提示能力"
    },
    {
      "sid": "S00009",
      "start": 22.44,
      "end": 23.3,
      "text": "仅死而已"
    },
    {
      "sid": "S00010",
      "start": 23.3,
      "end": 25.26,
      "text": "如果让我重新来过的话"
    },
    {
      "sid": "S00011",
      "start": 25.26,
      "end": 28.28,
      "text": "我依旧会坚持当初的那个选择"
    },
    {
      "sid": "S00012",
      "start": 28.28,
      "end": 32.48,
      "text": "因为你没有办法就是站在现在的一个角度"
    },
    {
      "sid": "S00013",
      "start": 32.48,
      "end": 35.74,
      "text": "去批判当时的自己"
    },
    {
      "sid": "S00014",
      "start": 35.74,
      "end": 36.36,
      "text": "懂吗"
    },
    {
      "sid": "S00015",
      "start": 36.36,
      "end": 37.8,
      "text": "当时的你其实也很难"
    },
    {
      "sid": "S00016",
      "start": 37.8,
      "end": 39.96,
      "text": "所以说兄弟们不要去自我过话"
    },
    {
      "sid": "S00017",
      "start": 39.96,
      "end": 40.66,
      "text": "OK"
    }
  ]
}
