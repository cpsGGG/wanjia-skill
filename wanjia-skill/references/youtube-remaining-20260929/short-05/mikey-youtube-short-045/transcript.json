{
  "schema_version": 1,
  "stable_id": "mikey-youtube-short-045",
  "youtube_id": "juXjBbeF0vs",
  "media_sha256": "19a2952505c1b3b62045359addd38874b9c44c8543bf3a88b869944e29264df0",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.36,
      "text": "我认为爱情本身没有最优选择"
    },
    {
      "sid": "S00002",
      "start": 2.36,
      "end": 3.72,
      "text": "痴情的人也没有错"
    },
    {
      "sid": "S00003",
      "start": 3.72,
      "end": 8.14,
      "text": "错的是那群拿着一个痴情的人开玩笑的人"
    },
    {
      "sid": "S00004",
      "start": 8.14,
      "end": 11.16,
      "text": "他们不明白爱情本身的样子"
    },
    {
      "sid": "S00005",
      "start": 11.16,
      "end": 12.8,
      "text": "人生的话其实真的很长"
    },
    {
      "sid": "S00006",
      "start": 12.8,
      "end": 14.86,
      "text": "我们会不断地遇到一些新鲜感"
    },
    {
      "sid": "S00007",
      "start": 14.86,
      "end": 16.54,
      "text": "一些新的现后新的选择"
    },
    {
      "sid": "S00008",
      "start": 16.54,
      "end": 18.34,
      "text": "但是最难得的是"
    },
    {
      "sid": "S00009",
      "start": 18.34,
      "end": 20.6,
      "text": "我知道你不是我的最优选择"
    },
    {
      "sid": "S00010",
      "start": 20.6,
      "end": 21.72,
      "text": "但你是我的唯一"
    },
    {
      "sid": "S00011",
      "start": 21.72,
      "end": 26.2,
      "text": "你是我心里可以唯一记者和挂念的人"
    }
  ]
}
