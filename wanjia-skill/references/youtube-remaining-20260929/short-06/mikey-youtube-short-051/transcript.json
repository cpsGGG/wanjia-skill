  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 2.13,
      "end": 4.13,
      "text": "嘿 哈喽"
    },
    {
      "sid": "S00002",
      "start": 4.89,
      "end": 9.38,
      "text": "做我想和你认识谁"
    },
    {
      "sid": "S00003",
      "start": 9.38,
      "end": 10.38,
      "text": "嘿"
    },
    {
      "sid": "S00004",
      "start": 11.12,
      "end": 13.88,
      "text": "哇 我想和你认识谁"
    },
    {
      "sid": "S00005",
      "start": 13.88,
      "end": 15.38,
      "text": "可以吗"
    },
    {
      "sid": "S00006",
      "start": 15.38,
      "end": 16.38,
      "text": "嗨"
    },
    {
      "sid": "S00007",
      "start": 16.38,
      "end": 17.88,
      "text": "我是Mike"
    },
    {
      "sid": "S00008",
      "start": 17.88,
      "end": 20.38,
      "text": "你好 你好 你好 你现在是要上你"
    },
    {
      "sid": "S00009",
      "start": 20.38,
      "end": 21.78,
      "text": "我去逛街"
    },
    {
      "sid": "S00010",
      "start": 21.78,
      "end": 24.38,
      "text": "那个我可以走时间留你微信"
    },
    {
      "sid": "S00011",
      "start": 24.38,
      "end": 26.38,
      "text": "我走时间可以留你微信"
    },
    {
      "sid": "S00012",
      "start": 26.38,
      "end": 29.28,
      "text": "行 你是成都本城市开人吗"
    },
    {
      "sid": "S00013",
      "start": 29.28,
      "end": 29.96,
      "text": "我不是"
    },
    {
      "sid": "S00014",
      "start": 29.96,
      "end": 30.66,
      "text": "你不是啊"
    },
    {
      "sid": "S00015",
      "start": 30.66,
      "end": 31.62,
      "text": "我张苏无私的"
    },
    {
      "sid": "S00016",
      "start": 31.62,
      "end": 32.62,
      "text": "你拿好吧"
    },
    {
      "sid": "S00017",
      "start": 32.62,
      "end": 34.38,
      "text": "行 我上你"
    },
    {
      "sid": "S00018",
      "start": 34.38,
      "end": 38.4,
      "text": "我觉得你好可爱"
    },
    {
      "sid": "S00019",
      "start": 38.4,
      "end": 39.4,
      "text": "嗯"
    },
    {
      "sid": "S00020",
      "start": 39.4,
      "end": 41.4,
      "text": "就很小 小不点"
    },
    {
      "sid": "S00021",
      "start": 41.4,
      "end": 44.4,
      "text": "你是来旅游的"
    },
    {
      "sid": "S00022",
      "start": 44.4,
      "end": 45.4,
      "text": "对"
    },
    {
      "sid": "S00023",
      "start": 45.4,
      "end": 46.4,
      "text": "你什么时候走"
    },
    {
      "sid": "S00024",
      "start": 46.4,
      "end": 47.4,
      "text": "很快 明天就走"
    },
    {
      "sid": "S00025",
      "start": 47.4,
      "end": 49.4,
      "text": "啊 我想"
    },
    {
      "sid": "S00026",
      "start": 49.4,
      "end": 51.4,
      "text": "最后有机会的话再来成都"
    },
    {
      "sid": "S00027",
      "start": 51.4,
      "end": 52.4,
      "text": "我可以约你"
    },
    {
      "sid": "S00028",
      "start": 52.4,
      "end": 53.4,
      "text": "拜拜"
    }
  ]
}
