{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-004",
  "youtube_id": "ea-wnYQpZWM",
  "media_sha256": "0b7b0b6c5098a220b0ba980abab0f6ac3dac52094b2616b888b9f249c50d233d",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.78,
      "text": "学员在小红书上找了一个女摄影师拍展示面"
    },
    {
      "sid": "S00002",
      "start": 2.78,
      "end": 4.88,
      "text": "最后竟然把女摄影师给链接了"
    },
    {
      "sid": "S00003",
      "start": 4.88,
      "end": 6.5,
      "text": "还靠着极致吸引力"
    },
    {
      "sid": "S00004",
      "start": 6.5,
      "end": 9.04,
      "text": "收获长期的免费展示面拍摄"
    },
    {
      "sid": "S00005",
      "start": 9.04,
      "end": 10.46,
      "text": "那么兄弟们今天这个案例呢"
    },
    {
      "sid": "S00006",
      "start": 10.46,
      "end": 13.38,
      "text": "是我的学员案例中实际收获最大的一个"
    },
    {
      "sid": "S00007",
      "start": 13.38,
      "end": 15.8,
      "text": "但是呢这个学员他并不是一约TD"
    },
    {
      "sid": "S00008",
      "start": 15.8,
      "end": 18.54,
      "text": "他是在我的指导下经过了三次约会"
    },
    {
      "sid": "S00009",
      "start": 18.54,
      "end": 20.16,
      "text": "最终才成功收尾的"
    },
    {
      "sid": "S00010",
      "start": 20.16,
      "end": 22.98,
      "text": "那么很多人呢他们都会认为一约TD是最屌的"
    },
    {
      "sid": "S00011",
      "start": 22.98,
      "end": 24.08,
      "text": "但是有些时候呢"
    },
    {
      "sid": "S00012",
      "start": 24.08,
      "end": 27.0,
      "text": "我觉得我们更应该去享受约会的过程"
    },
    {
      "sid": "S00013",
      "start": 27.0,
      "end": 28.6,
      "text": "而不是总想着一约收尾"
    },
    {
      "sid": "S00014",
      "start": 28.6,
      "end": 31.76,
      "text": "好那我来说一下这个学员他为什么会约了三次"
    },
    {
      "sid": "S00015",
      "start": 31.76,
      "end": 34.78,
      "text": "因为他犯了一个很多兄弟们都共有的错误"
    },
    {
      "sid": "S00016",
      "start": 34.78,
      "end": 36.66,
      "text": "那就是高吸引低可得性"
    },
    {
      "sid": "S00017",
      "start": 36.66,
      "end": 37.48,
      "text": "什么意思呢"
    },
    {
      "sid": "S00018",
      "start": 37.48,
      "end": 40.94,
      "text": "就是他可以让这个女生对他产生感觉产生吸引"
    },
    {
      "sid": "S00019",
      "start": 40.94,
      "end": 43.5,
      "text": "但是呢他接不了女人扔给他的废物测试"
    },
    {
      "sid": "S00020",
      "start": 43.5,
      "end": 45.62,
      "text": "所以你会发现他们一场约会下来呢"
    },
    {
      "sid": "S00021",
      "start": 45.62,
      "end": 47.2,
      "text": "女生给他的反应是非常好的"
    },
    {
      "sid": "S00022",
      "start": 47.2,
      "end": 48.38,
      "text": "但是就是提不了"
    },
    {
      "sid": "S00023",
      "start": 48.38,
      "end": 50.6,
      "text": "那么这个学员呢化名老周80后"
    },
    {
      "sid": "S00024",
      "start": 50.6,
      "end": 52.24,
      "text": "是一家公司的高管"
    },
    {
      "sid": "S00025",
      "start": 52.24,
      "end": 53.88,
      "text": "那么从客观条件上来讲呢"
    },
    {
      "sid": "S00026",
      "start": 53.88,
      "end": 54.8,
      "text": "他的条件很不错"
    },
    {
      "sid": "S00027",
      "start": 54.8,
      "end": 56.4,
      "text": "他事业稳定收入不低"
    },
    {
      "sid": "S00028",
      "start": 56.4,
      "end": 57.94,
      "text": "而且呢事业还在上升期"
    },
    {
      "sid": "S00029",
      "start": 57.94,
      "end": 60.32,
      "text": "他整个人的状态和自信也是往上走的"
    },
    {
      "sid": "S00030",
      "start": 60.32,
      "end": 62.2,
      "text": "但是呢他和大多数学员一样"
    },
    {
      "sid": "S00031",
      "start": 62.2,
      "end": 64.18,
      "text": "他的自身形象管理非常的一般"
    },
    {
      "sid": "S00032",
      "start": 64.18,
      "end": 65.82,
      "text": "我第一次打开他的朋友圈"
    },
    {
      "sid": "S00033",
      "start": 65.82,
      "end": 66.64,
      "text": "我就震惊了"
    },
    {
      "sid": "S00034",
      "start": 66.64,
      "end": 67.44,
      "text": "我很难想象"
    },
    {
      "sid": "S00035",
      "start": 67.44,
      "end": 69.88,
      "text": "这是一个人类高质量男性的朋友圈"
    },
    {
      "sid": "S00036",
      "start": 69.88,
      "end": 71.78,
      "text": "于是呢我帮他调整完形象之后"
    },
    {
      "sid": "S00037",
      "start": 71.78,
      "end": 73.1,
      "text": "我就让他去拍了一组"
    },
    {
      "sid": "S00038",
      "start": 73.1,
      "end": 75.52,
      "text": "全新的符合我的标准的战士年"
    },
    {
      "sid": "S00039",
      "start": 75.52,
      "end": 76.5,
      "text": "那么正常来讲呢"
    },
    {
      "sid": "S00040",
      "start": 76.5,
      "end": 78.62,
      "text": "这个故事到这里应该还是很普通的"
    },
    {
      "sid": "S00041",
      "start": 78.62,
      "end": 80.34,
      "text": "选场景拍照片拿片"
    },
    {
      "sid": "S00042",
      "start": 80.34,
      "end": 82.1,
      "text": "回去呢再把线上形象换掉"
    },
    {
      "sid": "S00043",
      "start": 82.1,
      "end": 83.36,
      "text": "然后开始大量约会"
    },
    {
      "sid": "S00044",
      "start": 83.36,
      "end": 85.38,
      "text": "那么这个时候呢问题突然出现了"
    },
    {
      "sid": "S00045",
      "start": 85.38,
      "end": 88.22,
      "text": "给他拍照的人呢是一个02年的女摄影师"
    },
    {
      "sid": "S00046",
      "start": 88.22,
      "end": 90.46,
      "text": "那么老周呢本来只是去拍展示面的"
    },
    {
      "sid": "S00047",
      "start": 90.46,
      "end": 92.08,
      "text": "结果展示面还没有拍完"
    },
    {
      "sid": "S00048",
      "start": 92.08,
      "end": 94.2,
      "text": "他先跟摄影师看对眼了"
    },
    {
      "sid": "S00049",
      "start": 94.2,
      "end": 95.82,
      "text": "于是他开始向我求助"
    },
    {
      "sid": "S00050",
      "start": 95.82,
      "end": 98.52,
      "text": "怎么样和这个女摄影师产生链接"
    },
    {
      "sid": "S00051",
      "start": 98.52,
      "end": 100.04,
      "text": "那么这个开局就很有意思"
    },
    {
      "sid": "S00052",
      "start": 100.04,
      "end": 102.06,
      "text": "摄影师呢原本是来通过拍照片"
    },
    {
      "sid": "S00053",
      "start": 102.06,
      "end": 103.44,
      "text": "帮他吸引更多女生的"
    },
    {
      "sid": "S00054",
      "start": 103.44,
      "end": 105.48,
      "text": "结果不小心把自己也给搭进去了"
    },
    {
      "sid": "S00055",
      "start": 105.48,
      "end": 107.12,
      "text": "这个女生他之前开过画室"
    },
    {
      "sid": "S00056",
      "start": 107.12,
      "end": 108.96,
      "text": "现在在美誉机构做绘画老师"
    },
    {
      "sid": "S00057",
      "start": 108.96,
      "end": 110.16,
      "text": "同时呢也接摄影"
    },
    {
      "sid": "S00058",
      "start": 110.16,
      "end": 110.86,
      "text": "她很年轻"
    },
    {
      "sid": "S00059",
      "start": 110.86,
      "end": 111.72,
      "text": "神明也在线"
    },
    {
      "sid": "S00060",
      "start": 111.72,
      "end": 113.88,
      "text": "气质形象呢也正好在学员的点上"
    },
    {
      "sid": "S00061",
      "start": 113.88,
      "end": 115.12,
      "text": "可这个时候问题也来了"
    },
    {
      "sid": "S00062",
      "start": 115.12,
      "end": 116.72,
      "text": "这个学员是两周前报名"
    },
    {
      "sid": "S00063",
      "start": 116.72,
      "end": 118.46,
      "text": "他也只有两周的约会经验"
    },
    {
      "sid": "S00064",
      "start": 118.46,
      "end": 120.6,
      "text": "他的技术水平呢也就刚刚脱离"
    },
    {
      "sid": "S00065",
      "start": 120.6,
      "end": 121.66,
      "text": "小白这个阶段"
    },
    {
      "sid": "S00066",
      "start": 121.66,
      "end": 123.42,
      "text": "也就是说流程他记住了一点"
    },
    {
      "sid": "S00067",
      "start": 123.42,
      "end": 125.1,
      "text": "但是内核呢以及社交直觉"
    },
    {
      "sid": "S00068",
      "start": 125.1,
      "end": 126.46,
      "text": "他还是完全没有建立的"
    },
    {
      "sid": "S00069",
      "start": 126.46,
      "end": 128.36,
      "text": "好那我们直接看第一次约会"
    },
    {
      "sid": "S00070",
      "start": 128.36,
      "end": 129.56,
      "text": "第一次正式约会呢"
    },
    {
      "sid": "S00071",
      "start": 129.56,
      "end": 130.8,
      "text": "两个人约在了一个亲巴"
    },
    {
      "sid": "S00072",
      "start": 130.8,
      "end": 132.64,
      "text": "根据学员后来发来的反馈"
    },
    {
      "sid": "S00073",
      "start": 132.64,
      "end": 134.36,
      "text": "现场呢有一点小争执"
    },
    {
      "sid": "S00074",
      "start": 134.36,
      "end": 135.54,
      "text": "但是戏没有断"
    },
    {
      "sid": "S00075",
      "start": 135.54,
      "end": 136.68,
      "text": "喝了点酒以后呢"
    },
    {
      "sid": "S00076",
      "start": 136.68,
      "end": 138.38,
      "text": "两个人开始拥抱亲吻"
    },
    {
      "sid": "S00077",
      "start": 138.38,
      "end": 139.66,
      "text": "女生呢也明确表达"
    },
    {
      "sid": "S00078",
      "start": 139.66,
      "end": 141.2,
      "text": "他对学员是有感觉的"
    },
    {
      "sid": "S00079",
      "start": 141.2,
      "end": 142.0,
      "text": "那么到这一步"
    },
    {
      "sid": "S00080",
      "start": 142.0,
      "end": 143.98,
      "text": "学员的脑袋里呢已经开始幻想"
    },
    {
      "sid": "S00081",
      "start": 143.98,
      "end": 145.06,
      "text": "在夕阳下的奔跑"
    },
    {
      "sid": "S00082",
      "start": 145.06,
      "end": 146.9,
      "text": "他觉得今晚应该是吻"
    },
    {
      "sid": "S00083",
      "start": 146.9,
      "end": 148.52,
      "text": "可当他提出转场"
    },
    {
      "sid": "S00084",
      "start": 148.52,
      "end": 149.7,
      "text": "跟他回酒店的时候"
    },
    {
      "sid": "S00085",
      "start": 149.7,
      "end": 151.62,
      "text": "女摄影师呢马上踩了刹车"
    },
    {
      "sid": "S00086",
      "start": 151.62,
      "end": 152.78,
      "text": "他坚持要回家"
    },
    {
      "sid": "S00087",
      "start": 152.78,
      "end": 153.86,
      "text": "不愿意跟他去酒店"
    },
    {
      "sid": "S00088",
      "start": 153.86,
      "end": 155.24,
      "text": "学员当场脑袋当机了"
    },
    {
      "sid": "S00089",
      "start": 155.24,
      "end": 156.32,
      "text": "因为在学员的观念里"
    },
    {
      "sid": "S00090",
      "start": 156.32,
      "end": 157.9,
      "text": "他认为接吻就等于愿意"
    },
    {
      "sid": "S00091",
      "start": 157.9,
      "end": 159.26,
      "text": "反之呢则是拒绝"
    },
    {
      "sid": "S00092",
      "start": 159.26,
      "end": 160.46,
      "text": "但这其实是不对的"
    },
    {
      "sid": "S00093",
      "start": 160.46,
      "end": 161.98,
      "text": "有过大量实战经验的人"
    },
    {
      "sid": "S00094",
      "start": 161.98,
      "end": 162.9,
      "text": "他们一定会知道"
    },
    {
      "sid": "S00095",
      "start": 162.9,
      "end": 163.82,
      "text": "一个女生呢"
    },
    {
      "sid": "S00096",
      "start": 163.82,
      "end": 165.58,
      "text": "他愿意跟你牵手或者是接吻"
    },
    {
      "sid": "S00097",
      "start": 165.58,
      "end": 166.86,
      "text": "他说明不了任何事情"
    },
    {
      "sid": "S00098",
      "start": 166.86,
      "end": 168.22,
      "text": "他可以在酒吧一晚上"
    },
    {
      "sid": "S00099",
      "start": 168.22,
      "end": 170.44,
      "text": "跟四五个陌生异性产生亲密接触"
    },
    {
      "sid": "S00100",
      "start": 170.44,
      "end": 171.22,
      "text": "但是最后呢"
    },
    {
      "sid": "S00101",
      "start": 171.22,
      "end": 173.5,
      "text": "他可能只会跟其中的某一个回家"
    },
    {
      "sid": "S00102",
      "start": 173.5,
      "end": 174.7,
      "text": "那我们话说回来"
    },
    {
      "sid": "S00103",
      "start": 174.7,
      "end": 175.44,
      "text": "这个学员呢"
    },
    {
      "sid": "S00104",
      "start": 175.44,
      "end": 176.82,
      "text": "他这里其实是有吸引的"
    },
    {
      "sid": "S00105",
      "start": 176.82,
      "end": 178.54,
      "text": "但是女生不愿意跟他回去的"
    },
    {
      "sid": "S00106",
      "start": 178.54,
      "end": 179.62,
      "text": "真正原因是因为"
    },
    {
      "sid": "S00107",
      "start": 179.62,
      "end": 180.76,
      "text": "他的吸引很高"
    },
    {
      "sid": "S00108",
      "start": 180.76,
      "end": 181.7,
      "text": "拉得非常的高"
    },
    {
      "sid": "S00109",
      "start": 181.7,
      "end": 183.12,
      "text": "但是低可得性"
    },
    {
      "sid": "S00110",
      "start": 183.12,
      "end": 184.38,
      "text": "也是我在上一期视频"
    },
    {
      "sid": "S00111",
      "start": 184.38,
      "end": 186.14,
      "text": "用刘亦菲举的那个例子"
    },
    {
      "sid": "S00112",
      "start": 186.14,
      "end": 187.64,
      "text": "就是高吸引低可得性"
    },
    {
      "sid": "S00113",
      "start": 187.64,
      "end": 188.9,
      "text": "让女生觉得无法追逐"
    },
    {
      "sid": "S00114",
      "start": 188.9,
      "end": 189.82,
      "text": "完全没有幻想"
    },
    {
      "sid": "S00115",
      "start": 189.82,
      "end": 190.82,
      "text": "而且更要命的是"
    },
    {
      "sid": "S00116",
      "start": 190.82,
      "end": 191.8,
      "text": "他在约会过程中"
    },
    {
      "sid": "S00117",
      "start": 191.8,
      "end": 193.22,
      "text": "他直接对这个女生说"
    },
    {
      "sid": "S00118",
      "start": 193.22,
      "end": 194.06,
      "text": "我不谈恋爱"
    },
    {
      "sid": "S00119",
      "start": 194.06,
      "end": 194.62,
      "text": "同时呢"
    },
    {
      "sid": "S00120",
      "start": 194.62,
      "end": 196.42,
      "text": "他又不给这个女生可得性"
    },
    {
      "sid": "S00121",
      "start": 196.42,
      "end": 198.26,
      "text": "然后在约会结尾的时候呢"
    },
    {
      "sid": "S00122",
      "start": 198.26,
      "end": 199.52,
      "text": "又要带这个女生去酒店"
    },
    {
      "sid": "S00123",
      "start": 199.52,
      "end": 201.26,
      "text": "那么这种种线索的累积"
    },
    {
      "sid": "S00124",
      "start": 201.26,
      "end": 202.34,
      "text": "就是在告诉女生"
    },
    {
      "sid": "S00125",
      "start": 202.34,
      "end": 203.16,
      "text": "我们是夜景"
    },
    {
      "sid": "S00126",
      "start": 203.16,
      "end": 204.58,
      "text": "我相信没有任何一个女生"
    },
    {
      "sid": "S00127",
      "start": 204.58,
      "end": 205.56,
      "text": "是愿意接受的"
    },
    {
      "sid": "S00128",
      "start": 205.56,
      "end": 207.4,
      "text": "那么在女生明确拒绝以后呢"
    },
    {
      "sid": "S00129",
      "start": 207.4,
      "end": 208.12,
      "text": "我让这个学员"
    },
    {
      "sid": "S00130",
      "start": 208.12,
      "end": 209.26,
      "text": "不要继续硬抵"
    },
    {
      "sid": "S00131",
      "start": 209.26,
      "end": 210.26,
      "text": "直接把她送回去"
    },
    {
      "sid": "S00132",
      "start": 210.26,
      "end": 211.08,
      "text": "要学会撤退"
    },
    {
      "sid": "S00133",
      "start": 211.08,
      "end": 211.62,
      "text": "后续呢"
    },
    {
      "sid": "S00134",
      "start": 211.62,
      "end": 212.86,
      "text": "我把整段约会录音"
    },
    {
      "sid": "S00135",
      "start": 212.86,
      "end": 213.68,
      "text": "给听完之后"
    },
    {
      "sid": "S00136",
      "start": 213.68,
      "end": 215.28,
      "text": "我发现学员的状态非常凝密"
    },
    {
      "sid": "S00137",
      "start": 215.28,
      "end": 216.16,
      "text": "它是一种就是"
    },
    {
      "sid": "S00138",
      "start": 216.16,
      "end": 218.46,
      "text": "他想要今晚有一个美好的夜晚"
    },
    {
      "sid": "S00139",
      "start": 218.46,
      "end": 219.36,
      "text": "但同时呢"
    },
    {
      "sid": "S00140",
      "start": 219.36,
      "end": 220.7,
      "text": "他自己又很怕"
    },
    {
      "sid": "S00141",
      "start": 220.7,
      "end": 222.14,
      "text": "这个女生问他要关系"
    },
    {
      "sid": "S00142",
      "start": 222.14,
      "end": 222.98,
      "text": "这就导致了"
    },
    {
      "sid": "S00143",
      "start": 222.98,
      "end": 223.94,
      "text": "他在约会过程中"
    },
    {
      "sid": "S00144",
      "start": 223.94,
      "end": 226.0,
      "text": "错过了很多提升吸引的timing"
    },
    {
      "sid": "S00145",
      "start": 226.0,
      "end": 227.28,
      "text": "他在该踩油门的时候"
    },
    {
      "sid": "S00146",
      "start": 227.28,
      "end": 227.92,
      "text": "不踩刹车"
    },
    {
      "sid": "S00147",
      "start": 227.92,
      "end": 229.1,
      "text": "在该踩刹车的时候"
    },
    {
      "sid": "S00148",
      "start": 229.1,
      "end": 229.96,
      "text": "又踩了油门"
    },
    {
      "sid": "S00149",
      "start": 229.96,
      "end": 231.66,
      "text": "给女生的感觉就是非常的拧巴"
    },
    {
      "sid": "S00150",
      "start": 231.66,
      "end": 232.44,
      "text": "本质原因呢"
    },
    {
      "sid": "S00151",
      "start": 232.44,
      "end": 234.1,
      "text": "是学员他没有再享受过程"
    },
    {
      "sid": "S00152",
      "start": 234.1,
      "end": 235.72,
      "text": "他的脑袋里一直在焦虑"
    },
    {
      "sid": "S00153",
      "start": 235.72,
      "end": 236.22,
      "text": "终点"
    },
    {
      "sid": "S00154",
      "start": 236.22,
      "end": 236.98,
      "text": "但是这个学员呢"
    },
    {
      "sid": "S00155",
      "start": 236.98,
      "end": 238.76,
      "text": "我已经训练了他将近两周了"
    },
    {
      "sid": "S00156",
      "start": 238.76,
      "end": 239.8,
      "text": "所以说他的操作"
    },
    {
      "sid": "S00157",
      "start": 239.8,
      "end": 241.82,
      "text": "还是凌驾于很多普通人之上的"
    },
    {
      "sid": "S00158",
      "start": 241.82,
      "end": 243.46,
      "text": "那么在录音里30分钟的时候"
    },
    {
      "sid": "S00159",
      "start": 243.46,
      "end": 244.66,
      "text": "两个人已经出现了"
    },
    {
      "sid": "S00160",
      "start": 244.66,
      "end": 245.8,
      "text": "明显的肢体接触"
    },
    {
      "sid": "S00161",
      "start": 245.8,
      "end": 246.96,
      "text": "然后40分钟左右"
    },
    {
      "sid": "S00162",
      "start": 246.96,
      "end": 248.14,
      "text": "气氛开始往上走"
    },
    {
      "sid": "S00163",
      "start": 248.14,
      "end": 249.04,
      "text": "接近50分钟"
    },
    {
      "sid": "S00164",
      "start": 249.04,
      "end": 251.1,
      "text": "也出现了可以自然转场的窗口"
    },
    {
      "sid": "S00165",
      "start": 251.1,
      "end": 252.78,
      "text": "但是因为他没有给可得性"
    },
    {
      "sid": "S00166",
      "start": 252.78,
      "end": 253.88,
      "text": "以至于女生认为"
    },
    {
      "sid": "S00167",
      "start": 253.88,
      "end": 255.0,
      "text": "他只是想玩一玩"
    },
    {
      "sid": "S00168",
      "start": 255.0,
      "end": 256.68,
      "text": "所以第一次约会是没有收尾的"
    },
    {
      "sid": "S00169",
      "start": 256.68,
      "end": 258.12,
      "text": "那么既然第一次约会没成"
    },
    {
      "sid": "S00170",
      "start": 258.12,
      "end": 259.52,
      "text": "于是我开始着手"
    },
    {
      "sid": "S00171",
      "start": 259.52,
      "end": 260.88,
      "text": "帮他去排第二次约会"
    },
    {
      "sid": "S00172",
      "start": 260.88,
      "end": 261.36,
      "text": "并且呢"
    },
    {
      "sid": "S00173",
      "start": 261.36,
      "end": 262.26,
      "text": "把他第二次约会"
    },
    {
      "sid": "S00174",
      "start": 262.26,
      "end": 263.56,
      "text": "可能出现的岔子"
    },
    {
      "sid": "S00175",
      "start": 263.56,
      "end": 265.32,
      "text": "全都逐个给他拆解了"
    },
    {
      "sid": "S00176",
      "start": 265.32,
      "end": 266.06,
      "text": "比如这个学员"
    },
    {
      "sid": "S00177",
      "start": 266.06,
      "end": 266.94,
      "text": "如果继续分享"
    },
    {
      "sid": "S00178",
      "start": 266.94,
      "end": 267.72,
      "text": "那就正常接"
    },
    {
      "sid": "S00179",
      "start": 267.72,
      "end": 268.66,
      "text": "如果他再一次"
    },
    {
      "sid": "S00180",
      "start": 268.66,
      "end": 269.62,
      "text": "向你索要关系"
    },
    {
      "sid": "S00181",
      "start": 269.62,
      "end": 271.28,
      "text": "你就把真实想法给他说清楚"
    },
    {
      "sid": "S00182",
      "start": 271.28,
      "end": 272.16,
      "text": "如果他不喝酒"
    },
    {
      "sid": "S00183",
      "start": 272.16,
      "end": 273.64,
      "text": "也不要因此而打乱节奏"
    },
    {
      "sid": "S00184",
      "start": 273.64,
      "end": 275.72,
      "text": "如果他再一次选择回家"
    },
    {
      "sid": "S00185",
      "start": 275.72,
      "end": 276.64,
      "text": "那我们就停下来"
    },
    {
      "sid": "S00186",
      "start": 276.64,
      "end": 277.38,
      "text": "不要去追问"
    },
    {
      "sid": "S00187",
      "start": 277.38,
      "end": 278.78,
      "text": "也不要破防不要翻领"
    },
    {
      "sid": "S00188",
      "start": 278.78,
      "end": 280.06,
      "text": "那么对于学员来讲呢"
    },
    {
      "sid": "S00189",
      "start": 280.06,
      "end": 280.8,
      "text": "这些问题呢"
    },
    {
      "sid": "S00190",
      "start": 280.8,
      "end": 281.72,
      "text": "可能叫突发状况"
    },
    {
      "sid": "S00191",
      "start": 281.72,
      "end": 282.48,
      "text": "但是在我这里"
    },
    {
      "sid": "S00192",
      "start": 282.48,
      "end": 284.08,
      "text": "没有所谓的突发状况"
    },
    {
      "sid": "S00193",
      "start": 284.08,
      "end": 285.72,
      "text": "因为女人做任何动作之前呢"
    },
    {
      "sid": "S00194",
      "start": 285.72,
      "end": 286.6,
      "text": "都是有信号的"
    },
    {
      "sid": "S00195",
      "start": 286.6,
      "end": 287.16,
      "text": "同时呢"
    },
    {
      "sid": "S00196",
      "start": 287.16,
      "end": 288.92,
      "text": "我也在第二次约会之前呢"
    },
    {
      "sid": "S00197",
      "start": 288.92,
      "end": 290.2,
      "text": "我有去指导这个学员"
    },
    {
      "sid": "S00198",
      "start": 290.2,
      "end": 291.54,
      "text": "该怎么样跟他线上网聊"
    },
    {
      "sid": "S00199",
      "start": 291.54,
      "end": 292.72,
      "text": "怎么样维持住"
    },
    {
      "sid": "S00200",
      "start": 292.72,
      "end": 294.62,
      "text": "跟他第一次约会的那个吸引力"
    },
    {
      "sid": "S00201",
      "start": 294.62,
      "end": 295.12,
      "text": "同时呢"
    },
    {
      "sid": "S00202",
      "start": 295.12,
      "end": 297.42,
      "text": "女生也在给老周分享自己的照片"
    },
    {
      "sid": "S00203",
      "start": 297.42,
      "end": 298.3,
      "text": "比如喝咖啡"
    },
    {
      "sid": "S00204",
      "start": 298.3,
      "end": 298.82,
      "text": "健身"
    },
    {
      "sid": "S00205",
      "start": 298.82,
      "end": 299.74,
      "text": "还有日常生活"
    },
    {
      "sid": "S00206",
      "start": 299.74,
      "end": 300.06,
      "text": "好"
    },
    {
      "sid": "S00207",
      "start": 300.06,
      "end": 301.54,
      "text": "那我们继续来看二约"
    },
    {
      "sid": "S00208",
      "start": 301.54,
      "end": 303.18,
      "text": "女生这里有主动问老周"
    },
    {
      "sid": "S00209",
      "start": 303.18,
      "end": 304.18,
      "text": "要不要出来走一走"
    },
    {
      "sid": "S00210",
      "start": 304.18,
      "end": 305.06,
      "text": "然后后面又问"
    },
    {
      "sid": "S00211",
      "start": 305.06,
      "end": 306.1,
      "text": "待会想去哪逛"
    },
    {
      "sid": "S00212",
      "start": 306.1,
      "end": 307.24,
      "text": "那么第一次约会呢"
    },
    {
      "sid": "S00213",
      "start": 307.24,
      "end": 308.6,
      "text": "这个女生她坚持回去"
    },
    {
      "sid": "S00214",
      "start": 308.6,
      "end": 309.54,
      "text": "第二次见面呢"
    },
    {
      "sid": "S00215",
      "start": 309.54,
      "end": 310.8,
      "text": "是她主动邀约"
    },
    {
      "sid": "S00216",
      "start": 310.8,
      "end": 311.48,
      "text": "这叫什么"
    },
    {
      "sid": "S00217",
      "start": 311.48,
      "end": 312.68,
      "text": "这叫可观察"
    },
    {
      "sid": "S00218",
      "start": 312.68,
      "end": 313.26,
      "text": "投入"
    },
    {
      "sid": "S00219",
      "start": 313.26,
      "end": 314.0,
      "text": "一个女生呢"
    },
    {
      "sid": "S00220",
      "start": 314.0,
      "end": 315.5,
      "text": "愿意拿出自己的时间"
    },
    {
      "sid": "S00221",
      "start": 315.5,
      "end": 316.7,
      "text": "发出主动见面"
    },
    {
      "sid": "S00222",
      "start": 316.7,
      "end": 318.64,
      "text": "还把接下来的安排交给你"
    },
    {
      "sid": "S00223",
      "start": 318.64,
      "end": 319.52,
      "text": "这比你分析"
    },
    {
      "sid": "S00224",
      "start": 319.52,
      "end": 321.46,
      "text": "一百句前台词都有用"
    },
    {
      "sid": "S00225",
      "start": 321.46,
      "end": 322.52,
      "text": "但学员这个时候呢"
    },
    {
      "sid": "S00226",
      "start": 322.52,
      "end": 323.94,
      "text": "一直在问我要去哪里"
    },
    {
      "sid": "S00227",
      "start": 323.94,
      "end": 324.7,
      "text": "要不要喝酒"
    },
    {
      "sid": "S00228",
      "start": 324.7,
      "end": 325.82,
      "text": "如果她再问我谭尼亚"
    },
    {
      "sid": "S00229",
      "start": 325.82,
      "end": 326.36,
      "text": "该怎么办"
    },
    {
      "sid": "S00230",
      "start": 326.36,
      "end": 328.32,
      "text": "她又陷入了那种拧巴的情绪"
    },
    {
      "sid": "S00231",
      "start": 328.32,
      "end": 329.38,
      "text": "她已经开始焦虑"
    },
    {
      "sid": "S00232",
      "start": 329.38,
      "end": 330.44,
      "text": "如果见了面之后"
    },
    {
      "sid": "S00233",
      "start": 330.44,
      "end": 331.46,
      "text": "会出现什么问题了"
    },
    {
      "sid": "S00234",
      "start": 331.46,
      "end": 332.96,
      "text": "这也是很多小白兄弟们"
    },
    {
      "sid": "S00235",
      "start": 332.96,
      "end": 334.2,
      "text": "经常会犯的一个问题"
    },
    {
      "sid": "S00236",
      "start": 334.2,
      "end": 336.5,
      "text": "他们认为任何一个小问题"
    },
    {
      "sid": "S00237",
      "start": 336.5,
      "end": 338.62,
      "text": "都会把这次约会搞砸"
    },
    {
      "sid": "S00238",
      "start": 338.62,
      "end": 339.62,
      "text": "但其实不是的"
    },
    {
      "sid": "S00239",
      "start": 339.62,
      "end": 341.22,
      "text": "很多时候你们搞砸一场约会"
    },
    {
      "sid": "S00240",
      "start": 341.22,
      "end": 342.64,
      "text": "是因为你们犯的错"
    },
    {
      "sid": "S00241",
      "start": 342.64,
      "end": 344.32,
      "text": "你们的小问题太多了"
    },
    {
      "sid": "S00242",
      "start": 344.32,
      "end": 345.26,
      "text": "累积到后面"
    },
    {
      "sid": "S00243",
      "start": 345.26,
      "end": 346.58,
      "text": "打到了一个失败的约会"
    },
    {
      "sid": "S00244",
      "start": 346.58,
      "end": 347.72,
      "text": "它就跟打游戏一样"
    },
    {
      "sid": "S00245",
      "start": 347.72,
      "end": 349.22,
      "text": "很多时候一点点失误"
    },
    {
      "sid": "S00246",
      "start": 349.22,
      "end": 350.42,
      "text": "其实是没有问题的"
    },
    {
      "sid": "S00247",
      "start": 350.42,
      "end": 351.88,
      "text": "但是如果失误过多了"
    },
    {
      "sid": "S00248",
      "start": 351.88,
      "end": 353.02,
      "text": "那就是很有问题"
    },
    {
      "sid": "S00249",
      "start": 353.02,
      "end": 353.88,
      "text": "所以说我觉得"
    },
    {
      "sid": "S00250",
      "start": 353.88,
      "end": 354.92,
      "text": "约会中有失误"
    },
    {
      "sid": "S00251",
      "start": 354.92,
      "end": 355.9,
      "text": "其实是很正常的"
    },
    {
      "sid": "S00252",
      "start": 355.9,
      "end": 357.3,
      "text": "不需要有太大的心理压力"
    },
    {
      "sid": "S00253",
      "start": 357.3,
      "end": 357.96,
      "text": "如果你抱着"
    },
    {
      "sid": "S00254",
      "start": 357.96,
      "end": 359.52,
      "text": "我不想有任何差子"
    },
    {
      "sid": "S00255",
      "start": 359.52,
      "end": 361.28,
      "text": "不想有任何失误的状态去约会"
    },
    {
      "sid": "S00256",
      "start": 361.28,
      "end": 363.22,
      "text": "那么你在整个约会的过程中"
    },
    {
      "sid": "S00257",
      "start": 363.22,
      "end": 364.78,
      "text": "你的状态一定是非常拧巴"
    },
    {
      "sid": "S00258",
      "start": 364.78,
      "end": 365.58,
      "text": "非常焦虑的"
    },
    {
      "sid": "S00259",
      "start": 365.58,
      "end": 367.38,
      "text": "那么这里我们可以看学员的反馈"
    },
    {
      "sid": "S00260",
      "start": 367.38,
      "end": 369.46,
      "text": "这里女生她最后选择了"
    },
    {
      "sid": "S00261",
      "start": 369.46,
      "end": 370.3,
      "text": "五酒精饮品"
    },
    {
      "sid": "S00262",
      "start": 370.3,
      "end": 371.48,
      "text": "然后我们再看看"
    },
    {
      "sid": "S00263",
      "start": 371.48,
      "end": 372.76,
      "text": "这个学员她之前说的"
    },
    {
      "sid": "S00264",
      "start": 372.76,
      "end": 373.72,
      "text": "一约没有约成"
    },
    {
      "sid": "S00265",
      "start": 373.72,
      "end": 375.18,
      "text": "可能是因为酒不够"
    },
    {
      "sid": "S00266",
      "start": 375.18,
      "end": 376.4,
      "text": "或者是转场方式不对"
    },
    {
      "sid": "S00267",
      "start": 376.4,
      "end": 377.56,
      "text": "可二约女生"
    },
    {
      "sid": "S00268",
      "start": 377.56,
      "end": 379.42,
      "text": "不喝酒照样主动出来"
    },
    {
      "sid": "S00269",
      "start": 379.42,
      "end": 380.74,
      "text": "照样愿意和她接触"
    },
    {
      "sid": "S00270",
      "start": 380.74,
      "end": 383.64,
      "text": "所以吸引完全不是酒灌出来的"
    },
    {
      "sid": "S00271",
      "start": 383.64,
      "end": 384.94,
      "text": "很多导师都推崇"
    },
    {
      "sid": "S00272",
      "start": 384.94,
      "end": 385.62,
      "text": "约会的时候"
    },
    {
      "sid": "S00273",
      "start": 385.62,
      "end": 387.42,
      "text": "一定要去拿酒去灌女生"
    },
    {
      "sid": "S00274",
      "start": 387.42,
      "end": 388.72,
      "text": "他们认为只有这样子"
    },
    {
      "sid": "S00275",
      "start": 388.72,
      "end": 389.84,
      "text": "才可以拿到结果"
    },
    {
      "sid": "S00276",
      "start": 389.84,
      "end": 391.84,
      "text": "但是我认为这是不对的"
    },
    {
      "sid": "S00277",
      "start": 391.84,
      "end": 393.92,
      "text": "并且这也是有法律风险的"
    },
    {
      "sid": "S00278",
      "start": 393.92,
      "end": 394.8,
      "text": "像我的学员"
    },
    {
      "sid": "S00279",
      "start": 394.8,
      "end": 395.84,
      "text": "我从来不会说"
    },
    {
      "sid": "S00280",
      "start": 395.84,
      "end": 397.72,
      "text": "你们一定要去约一个酒吧"
    },
    {
      "sid": "S00281",
      "start": 397.72,
      "end": 398.86,
      "text": "你们可以去约咖啡"
    },
    {
      "sid": "S00282",
      "start": 398.86,
      "end": 399.74,
      "text": "可以约喝酒"
    },
    {
      "sid": "S00283",
      "start": 399.74,
      "end": 400.48,
      "text": "也可以约吃饭"
    },
    {
      "sid": "S00284",
      "start": 400.48,
      "end": 401.08,
      "text": "也可以约看店"
    },
    {
      "sid": "S00285",
      "start": 401.08,
      "end": 402.48,
      "text": "也可以约任何场景"
    },
    {
      "sid": "S00286",
      "start": 402.48,
      "end": 403.16,
      "text": "因为吸引"
    },
    {
      "sid": "S00287",
      "start": 403.16,
      "end": 405.0,
      "text": "它从来都不是靠酒产生的"
    },
    {
      "sid": "S00288",
      "start": 405.0,
      "end": 406.18,
      "text": "你们即便靠酒"
    },
    {
      "sid": "S00289",
      "start": 406.18,
      "end": 406.88,
      "text": "趁人之危"
    },
    {
      "sid": "S00290",
      "start": 406.88,
      "end": 408.92,
      "text": "最后拿到了你们认为的结果"
    },
    {
      "sid": "S00291",
      "start": 408.92,
      "end": 410.44,
      "text": "但是这种甚至不武的结果"
    },
    {
      "sid": "S00292",
      "start": 410.44,
      "end": 411.6,
      "text": "它对你个人的魅力"
    },
    {
      "sid": "S00293",
      "start": 411.6,
      "end": 412.94,
      "text": "是不会有任何帮助的"
    },
    {
      "sid": "S00294",
      "start": 412.94,
      "end": 415.08,
      "text": "并且还会让你产生一个路径依赖"
    },
    {
      "sid": "S00295",
      "start": 415.08,
      "end": 416.94,
      "text": "如果你今后遇到不喝酒的女生"
    },
    {
      "sid": "S00296",
      "start": 416.94,
      "end": 417.96,
      "text": "那你岂不是完蛋了"
    },
    {
      "sid": "S00297",
      "start": 417.96,
      "end": 418.78,
      "text": "我一直认为"
    },
    {
      "sid": "S00298",
      "start": 418.78,
      "end": 421.18,
      "text": "最终拿到结果的是你这个人的吸引"
    },
    {
      "sid": "S00299",
      "start": 421.18,
      "end": 422.88,
      "text": "而酒它可有可无"
    },
    {
      "sid": "S00300",
      "start": 422.88,
      "end": 423.8,
      "text": "那么话说回来"
    },
    {
      "sid": "S00301",
      "start": 423.8,
      "end": 424.98,
      "text": "在2月开始之前"
    },
    {
      "sid": "S00302",
      "start": 424.98,
      "end": 427.04,
      "text": "我已经给她留好了一个合理空间"
    },
    {
      "sid": "S00303",
      "start": 427.04,
      "end": 428.46,
      "text": "不管这个女生喝不喝酒"
    },
    {
      "sid": "S00304",
      "start": 428.46,
      "end": 428.96,
      "text": "做什么"
    },
    {
      "sid": "S00305",
      "start": 428.96,
      "end": 429.5,
      "text": "去哪里"
    },
    {
      "sid": "S00306",
      "start": 429.5,
      "end": 430.44,
      "text": "其实都不重要"
    },
    {
      "sid": "S00307",
      "start": 430.44,
      "end": 432.34,
      "text": "一定要关注于现场反馈"
    },
    {
      "sid": "S00308",
      "start": 432.34,
      "end": 433.38,
      "text": "场景是可以变"
    },
    {
      "sid": "S00309",
      "start": 433.38,
      "end": 435.36,
      "text": "但是你的个人吸引力"
    },
    {
      "sid": "S00310",
      "start": 435.36,
      "end": 436.54,
      "text": "一定要保持恒定"
    },
    {
      "sid": "S00311",
      "start": 436.54,
      "end": 438.46,
      "text": "不要因为没有按照原计划走"
    },
    {
      "sid": "S00312",
      "start": 438.46,
      "end": 439.62,
      "text": "然后你就开始慌了"
    },
    {
      "sid": "S00313",
      "start": 439.62,
      "end": 441.06,
      "text": "最后导致吸引力掉下去"
    },
    {
      "sid": "S00314",
      "start": 441.06,
      "end": 442.44,
      "text": "那么到了晚上的女生"
    },
    {
      "sid": "S00315",
      "start": 442.44,
      "end": 443.46,
      "text": "依然要回酒店"
    },
    {
      "sid": "S00316",
      "start": 443.46,
      "end": 445.14,
      "text": "这里我就让老周让她回去"
    },
    {
      "sid": "S00317",
      "start": 445.14,
      "end": 445.96,
      "text": "因为2月不行"
    },
    {
      "sid": "S00318",
      "start": 445.96,
      "end": 446.62,
      "text": "还有3月"
    },
    {
      "sid": "S00319",
      "start": 446.62,
      "end": 448.0,
      "text": "那么一月有拥抱"
    },
    {
      "sid": "S00320",
      "start": 448.0,
      "end": 448.6,
      "text": "有亲吻"
    },
    {
      "sid": "S00321",
      "start": 448.6,
      "end": 449.3,
      "text": "没有成功"
    },
    {
      "sid": "S00322",
      "start": 449.3,
      "end": 451.06,
      "text": "2月是女生主动发起的"
    },
    {
      "sid": "S00323",
      "start": 451.06,
      "end": 452.18,
      "text": "但是还是没有成功"
    },
    {
      "sid": "S00324",
      "start": 452.18,
      "end": 453.22,
      "text": "如果只盯结果"
    },
    {
      "sid": "S00325",
      "start": 453.22,
      "end": 453.88,
      "text": "那么这个时候"
    },
    {
      "sid": "S00326",
      "start": 453.88,
      "end": 455.8,
      "text": "可能有很多从事要破防了"
    },
    {
      "sid": "S00327",
      "start": 455.8,
      "end": 456.56,
      "text": "会觉得这个女生"
    },
    {
      "sid": "S00328",
      "start": 456.56,
      "end": 457.44,
      "text": "是不是在吊着我"
    },
    {
      "sid": "S00329",
      "start": 457.44,
      "end": 458.52,
      "text": "是不是把我当备胎"
    },
    {
      "sid": "S00330",
      "start": 458.52,
      "end": 459.9,
      "text": "是不是我还不够强势"
    },
    {
      "sid": "S00331",
      "start": 459.9,
      "end": 461.34,
      "text": "那么能问出这种问题"
    },
    {
      "sid": "S00332",
      "start": 461.34,
      "end": 463.32,
      "text": "都是没有抓住重点"
    },
    {
      "sid": "S00333",
      "start": 463.32,
      "end": 464.76,
      "text": "一个女生主动见你"
    },
    {
      "sid": "S00334",
      "start": 464.76,
      "end": 466.06,
      "text": "持续性地分享生活"
    },
    {
      "sid": "S00335",
      "start": 466.06,
      "end": 467.4,
      "text": "也明确表达喜欢"
    },
    {
      "sid": "S00336",
      "start": 467.4,
      "end": 468.6,
      "text": "同时又守住自己"
    },
    {
      "sid": "S00337",
      "start": 468.6,
      "end": 470.18,
      "text": "不愿意跨过的边界"
    },
    {
      "sid": "S00338",
      "start": 470.18,
      "end": 471.06,
      "text": "那么这些行为"
    },
    {
      "sid": "S00339",
      "start": 471.06,
      "end": 471.8,
      "text": "在我看来"
    },
    {
      "sid": "S00340",
      "start": 471.8,
      "end": 473.48,
      "text": "都是非常具备一致性的"
    },
    {
      "sid": "S00341",
      "start": 473.48,
      "end": 474.9,
      "text": "那到底是什么原因呢"
    },
    {
      "sid": "S00342",
      "start": 474.9,
      "end": 475.54,
      "text": "真正的答案"
    },
    {
      "sid": "S00343",
      "start": 475.54,
      "end": 476.54,
      "text": "出现在二月之后"
    },
    {
      "sid": "S00344",
      "start": 476.54,
      "end": 478.54,
      "text": "女生跟学院打电话里面"
    },
    {
      "sid": "S00345",
      "start": 478.54,
      "end": 479.82,
      "text": "根据学院的事后反馈"
    },
    {
      "sid": "S00346",
      "start": 479.82,
      "end": 480.7,
      "text": "她在电话里"
    },
    {
      "sid": "S00347",
      "start": 480.7,
      "end": 482.7,
      "text": "把自己的情史和真实想法"
    },
    {
      "sid": "S00348",
      "start": 482.7,
      "end": 483.88,
      "text": "跟这个女生讲清楚了"
    },
    {
      "sid": "S00349",
      "start": 483.88,
      "end": 485.4,
      "text": "女生也把话说得很明白"
    },
    {
      "sid": "S00350",
      "start": 485.4,
      "end": 486.56,
      "text": "她非常的喜欢学院"
    },
    {
      "sid": "S00351",
      "start": 486.56,
      "end": 488.52,
      "text": "但是她觉得学院太过于神秘"
    },
    {
      "sid": "S00352",
      "start": 488.52,
      "end": 490.02,
      "text": "担心自己以后会受伤"
    },
    {
      "sid": "S00353",
      "start": 490.02,
      "end": 491.7,
      "text": "为什么女人会出现这种心理"
    },
    {
      "sid": "S00354",
      "start": 491.7,
      "end": 492.48,
      "text": "因为很多人"
    },
    {
      "sid": "S00355",
      "start": 492.48,
      "end": 493.38,
      "text": "特别是学了很多"
    },
    {
      "sid": "S00356",
      "start": 493.38,
      "end": 494.44,
      "text": "错误理论的兄弟"
    },
    {
      "sid": "S00357",
      "start": 494.44,
      "end": 496.1,
      "text": "他们会偏激地认为"
    },
    {
      "sid": "S00358",
      "start": 496.1,
      "end": 497.7,
      "text": "把不解释当成框架"
    },
    {
      "sid": "S00359",
      "start": 497.7,
      "end": 499.46,
      "text": "把不给回应当成价值"
    },
    {
      "sid": "S00360",
      "start": 499.46,
      "end": 500.2,
      "text": "当成神秘"
    },
    {
      "sid": "S00361",
      "start": 500.2,
      "end": 500.88,
      "text": "结果呢"
    },
    {
      "sid": "S00362",
      "start": 500.88,
      "end": 502.68,
      "text": "吸引从客观意义上来讲"
    },
    {
      "sid": "S00363",
      "start": 502.68,
      "end": 503.8,
      "text": "确实会上身"
    },
    {
      "sid": "S00364",
      "start": 503.8,
      "end": 506.04,
      "text": "但是女人不敢和你深入接触"
    },
    {
      "sid": "S00365",
      "start": 506.04,
      "end": 507.34,
      "text": "因为她看得见你的价值"
    },
    {
      "sid": "S00366",
      "start": 507.34,
      "end": 508.6,
      "text": "却看不懂你的目的"
    },
    {
      "sid": "S00367",
      "start": 508.6,
      "end": 509.48,
      "text": "某些时候呢"
    },
    {
      "sid": "S00368",
      "start": 509.48,
      "end": 511.38,
      "text": "主动去暴露自己的一些观点"
    },
    {
      "sid": "S00369",
      "start": 511.38,
      "end": 511.96,
      "text": "想法"
    },
    {
      "sid": "S00370",
      "start": 511.96,
      "end": 513.28,
      "text": "反而会比一味的神秘"
    },
    {
      "sid": "S00371",
      "start": 513.28,
      "end": 514.04,
      "text": "要好很多"
    },
    {
      "sid": "S00372",
      "start": 514.04,
      "end": 515.46,
      "text": "那么回到学院的案例上"
    },
    {
      "sid": "S00373",
      "start": 515.46,
      "end": 516.84,
      "text": "在打完电话之后呢"
    },
    {
      "sid": "S00374",
      "start": 516.84,
      "end": 518.72,
      "text": "两个人敲定了下周三见面"
    },
    {
      "sid": "S00375",
      "start": 518.72,
      "end": 520.22,
      "text": "并且女生也确定了"
    },
    {
      "sid": "S00376",
      "start": 520.22,
      "end": 521.64,
      "text": "下周三帮学院拍照"
    },
    {
      "sid": "S00377",
      "start": 521.64,
      "end": 521.98,
      "text": "注意"
    },
    {
      "sid": "S00378",
      "start": 521.98,
      "end": 523.26,
      "text": "这才是关系"
    },
    {
      "sid": "S00379",
      "start": 523.26,
      "end": 524.96,
      "text": "真正发生变化的证据"
    },
    {
      "sid": "S00380",
      "start": 524.96,
      "end": 526.48,
      "text": "女生愿意继续安排见面"
    },
    {
      "sid": "S00381",
      "start": 526.48,
      "end": 527.88,
      "text": "也愿意把自己的时间"
    },
    {
      "sid": "S00382",
      "start": 527.88,
      "end": 529.54,
      "text": "和专业能力投入进来"
    },
    {
      "sid": "S00383",
      "start": 529.54,
      "end": 530.92,
      "text": "那么第一次约会有吸引"
    },
    {
      "sid": "S00384",
      "start": 530.92,
      "end": 532.14,
      "text": "第二次约会有可得性"
    },
    {
      "sid": "S00385",
      "start": 532.14,
      "end": 533.34,
      "text": "第三次约会的时候"
    },
    {
      "sid": "S00386",
      "start": 533.34,
      "end": 534.92,
      "text": "自然而然就有了结果"
    },
    {
      "sid": "S00387",
      "start": 534.92,
      "end": 535.56,
      "text": "好 兄弟们"
    },
    {
      "sid": "S00388",
      "start": 535.56,
      "end": 537.32,
      "text": "那我们现在回头看这个故事"
    },
    {
      "sid": "S00389",
      "start": 537.32,
      "end": 539.24,
      "text": "学院原本只是去拍一组"
    },
    {
      "sid": "S00390",
      "start": 539.24,
      "end": 540.54,
      "text": "用来吸引女人的展示面"
    },
    {
      "sid": "S00391",
      "start": 540.54,
      "end": 542.28,
      "text": "结果照片还没有来得及"
    },
    {
      "sid": "S00392",
      "start": 542.28,
      "end": 543.98,
      "text": "替她认识更多的新女生"
    },
    {
      "sid": "S00393",
      "start": 543.98,
      "end": 545.36,
      "text": "负责拍照的女摄影师"
    },
    {
      "sid": "S00394",
      "start": 545.36,
      "end": 546.9,
      "text": "反而先被她给拿下了"
    },
    {
      "sid": "S00395",
      "start": 546.9,
      "end": 547.72,
      "text": "这个案例呢"
    },
    {
      "sid": "S00396",
      "start": 547.72,
      "end": 548.16,
      "text": "说实话"
    },
    {
      "sid": "S00397",
      "start": 548.16,
      "end": 549.86,
      "text": "其实是非常有代表性的"
    },
    {
      "sid": "S00398",
      "start": 549.86,
      "end": 550.1,
      "text": "第一"
    },
    {
      "sid": "S00399",
      "start": 550.1,
      "end": 550.92,
      "text": "它代表着"
    },
    {
      "sid": "S00400",
      "start": 550.92,
      "end": 552.28,
      "text": "如果你是一个有魅力的人"
    },
    {
      "sid": "S00401",
      "start": 552.28,
      "end": 553.16,
      "text": "你在生活中"
    },
    {
      "sid": "S00402",
      "start": 553.16,
      "end": 554.42,
      "text": "跟任何异性相处"
    },
    {
      "sid": "S00403",
      "start": 554.42,
      "end": 556.5,
      "text": "你都有可能跟她产生结果"
    },
    {
      "sid": "S00404",
      "start": 556.5,
      "end": 557.42,
      "text": "同时第二点"
    },
    {
      "sid": "S00405",
      "start": 557.42,
      "end": 558.46,
      "text": "它也代表着"
    },
    {
      "sid": "S00406",
      "start": 558.46,
      "end": 559.58,
      "text": "为什么很多学员"
    },
    {
      "sid": "S00407",
      "start": 559.58,
      "end": 560.84,
      "text": "她明明条件不差"
    },
    {
      "sid": "S00408",
      "start": 560.84,
      "end": 562.26,
      "text": "女生对她的反馈也很好"
    },
    {
      "sid": "S00409",
      "start": 562.26,
      "end": 563.7,
      "text": "可是每到关键节点"
    },
    {
      "sid": "S00410",
      "start": 563.7,
      "end": 564.66,
      "text": "女生就是不愿意"
    },
    {
      "sid": "S00411",
      "start": 564.66,
      "end": 565.78,
      "text": "跟她修成证据"
    },
    {
      "sid": "S00412",
      "start": 565.78,
      "end": 567.38,
      "text": "如果你现在也时常没有结果"
    },
    {
      "sid": "S00413",
      "start": 567.38,
      "end": 569.68,
      "text": "那你缺的可能不是更多的话术"
    },
    {
      "sid": "S00414",
      "start": 569.68,
      "end": 571.34,
      "text": "你需要有人把你的聊天记录"
    },
    {
      "sid": "S00415",
      "start": 571.34,
      "end": 572.12,
      "text": "你的约会录音"
    },
    {
      "sid": "S00416",
      "start": 572.12,
      "end": 573.06,
      "text": "你的现场反馈"
    },
    {
      "sid": "S00417",
      "start": 573.06,
      "end": 574.04,
      "text": "放在一起"
    },
    {
      "sid": "S00418",
      "start": 574.04,
      "end": 576.6,
      "text": "找到你到底哪一步做错了"
    },
    {
      "sid": "S00419",
      "start": 576.6,
      "end": 577.92,
      "text": "很多时候发现问题"
    },
    {
      "sid": "S00420",
      "start": 577.92,
      "end": 579.84,
      "text": "往往比解决问题更有价值"
    },
