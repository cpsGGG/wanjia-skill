{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-005",
  "youtube_id": "vA3vZJa00qM",
  "media_sha256": "a35ebfb76295ceab9ac046501cc6bf03f5442dded84a53211120411a2c22982e",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 3.44,
      "text": "85亿花5000万相当于100块钱花五毛八"
    },
    {
      "sid": "S00002",
      "start": 3.44,
      "end": 4.6,
      "text": "如果我有85亿"
    },
    {
      "sid": "S00003",
      "start": 4.6,
      "end": 7.1,
      "text": "我就全给某某某男明星花多少多少钱"
    },
    {
      "sid": "S00004",
      "start": 7.1,
      "end": 9.28,
      "text": "说这些话的人显得自己多大放言"
    },
    {
      "sid": "S00005",
      "start": 9.28,
      "end": 12.06,
      "text": "但这就是2026年最傻的一句话"
    },
    {
      "sid": "S00006",
      "start": 12.06,
      "end": 12.8,
      "text": "这种人呢"
    },
    {
      "sid": "S00007",
      "start": 12.8,
      "end": 14.36,
      "text": "79三支每笔都嫌贵"
    },
    {
      "sid": "S00008",
      "start": 14.36,
      "end": 15.6,
      "text": "每个月3000块钱"
    },
    {
      "sid": "S00009",
      "start": 15.6,
      "end": 17.12,
      "text": "叫他给父母打1000块钱"
    },
    {
      "sid": "S00010",
      "start": 17.12,
      "end": 17.84,
      "text": "他都不愿意"
    },
    {
      "sid": "S00011",
      "start": 17.84,
      "end": 19.94,
      "text": "因为他们是真的有79和1000"
    },
    {
      "sid": "S00012",
      "start": 19.94,
      "end": 20.52,
      "text": "人呢"
    },
    {
      "sid": "S00013",
      "start": 20.52,
      "end": 22.84,
      "text": "总是会对自己没有的东西格外慷慨"
    },
    {
      "sid": "S00014",
      "start": 22.84,
      "end": 23.7,
      "text": "表面上看"
    },
    {
      "sid": "S00015",
      "start": 23.7,
      "end": 24.62,
      "text": "他们说这些话"
    },
    {
      "sid": "S00016",
      "start": 24.62,
      "end": 25.6,
      "text": "像是在庭景田"
    },
    {
      "sid": "S00017",
      "start": 25.6,
      "end": 26.4,
      "text": "采顺玉城"
    },
    {
      "sid": "S00018",
      "start": 26.4,
      "end": 27.5,
      "text": "但本质而言"
    },
    {
      "sid": "S00019",
      "start": 27.5,
      "end": 29.44,
      "text": "他们只是在维持一个群体共识"
    },
    {
      "sid": "S00020",
      "start": 29.44,
      "end": 33.88,
      "text": "也就是对富人使用高贵的百分比伤害"
    },
    {
      "sid": "S00021",
      "start": 33.88,
      "end": 34.7,
      "text": "对穷人呢"
    },
    {
      "sid": "S00022",
      "start": 34.7,
      "end": 36.9,
      "text": "又打出30%的绝对值"
    },
    {
      "sid": "S00023",
      "start": 36.9,
      "end": 37.58,
      "text": "同时呢"
    },
    {
      "sid": "S00024",
      "start": 37.58,
      "end": 38.48,
      "text": "这种索取逻辑"
    },
    {
      "sid": "S00025",
      "start": 38.48,
      "end": 40.1,
      "text": "直接导致了他们对男人的钱"
    },
    {
      "sid": "S00026",
      "start": 40.1,
      "end": 41.84,
      "text": "有着异常强烈的占有余"
    },
    {
      "sid": "S00027",
      "start": 41.84,
      "end": 42.56,
      "text": "他们认为"
    },
    {
      "sid": "S00028",
      "start": 42.56,
      "end": 44.22,
      "text": "即使钱存在男人的账户里"
    },
    {
      "sid": "S00029",
      "start": 44.22,
      "end": 46.5,
      "text": "但分配权并不完全属于男人"
    },
    {
      "sid": "S00030",
      "start": 46.5,
      "end": 48.36,
      "text": "而且他们已经进化到了什么地步呢"
    },
    {
      "sid": "S00031",
      "start": 48.36,
      "end": 49.68,
      "text": "他们想要花男人的钱"
    },
    {
      "sid": "S00032",
      "start": 49.68,
      "end": 50.66,
      "text": "不仅要花"
    },
    {
      "sid": "S00033",
      "start": 50.66,
      "end": 51.58,
      "text": "还要挑人"
    },
    {
      "sid": "S00034",
      "start": 51.58,
      "end": 53.1,
      "text": "网上攻击孙哥这个事情"
    },
    {
      "sid": "S00035",
      "start": 53.1,
      "end": 54.7,
      "text": "有一个非常突出的观点"
    },
    {
      "sid": "S00036",
      "start": 54.7,
      "end": 55.2,
      "text": "就是说"
    },
    {
      "sid": "S00037",
      "start": 55.2,
      "end": 56.68,
      "text": "不要花穷男人的钱"
    },
    {
      "sid": "S00038",
      "start": 56.68,
      "end": 58.52,
      "text": "以前穷现在有钱的男人的钱"
    },
    {
      "sid": "S00039",
      "start": 58.52,
      "end": 59.3,
      "text": "也不能花"
    },
    {
      "sid": "S00040",
      "start": 59.3,
      "end": 60.02,
      "text": "要花就花"
    },
    {
      "sid": "S00041",
      "start": 60.02,
      "end": 61.0,
      "text": "主上三代有钱"
    },
    {
      "sid": "S00042",
      "start": 61.0,
      "end": 62.52,
      "text": "自己也有钱的男人的钱"
    },
    {
      "sid": "S00043",
      "start": 62.52,
      "end": 63.14,
      "text": "总之"
    },
    {
      "sid": "S00044",
      "start": 63.14,
      "end": 64.68,
      "text": "就是要花男人钱"
    },
    {
      "sid": "S00045",
      "start": 64.68,
      "end": 65.76,
      "text": "我们话说回来"
    },
    {
      "sid": "S00046",
      "start": 65.76,
      "end": 68.18,
      "text": "孙宇成当然具备支付5000万美金的实力"
    },
    {
      "sid": "S00047",
      "start": 68.18,
      "end": 70.14,
      "text": "但这5000万美金值不值得给"
    },
    {
      "sid": "S00048",
      "start": 70.14,
      "end": 71.96,
      "text": "则需要孙宇成他自己判断"
    },
    {
      "sid": "S00049",
      "start": 71.96,
      "end": 74.56,
      "text": "可现在有一群人偏偏跳过了这个男人的预约"
    },
    {
      "sid": "S00050",
      "start": 74.56,
      "end": 75.52,
      "text": "直接替他宣布"
    },
    {
      "sid": "S00051",
      "start": 75.52,
      "end": 76.52,
      "text": "这笔钱对你不多"
    },
    {
      "sid": "S00052",
      "start": 76.52,
      "end": 77.68,
      "text": "所以说你必须给"
    },
    {
      "sid": "S00053",
      "start": 77.68,
      "end": 79.06,
      "text": "为了维护这套索取逻辑"
    },
    {
      "sid": "S00054",
      "start": 79.06,
      "end": 79.62,
      "text": "这群人"
    },
    {
      "sid": "S00055",
      "start": 79.62,
      "end": 81.12,
      "text": "他们先扣帽子后战队"
    },
    {
      "sid": "S00056",
      "start": 81.12,
      "end": 82.34,
      "text": "打法依旧老一辈"
    },
    {
      "sid": "S00057",
      "start": 82.34,
      "end": 82.84,
      "text": "就比如"
    },
    {
      "sid": "S00058",
      "start": 82.84,
      "end": 84.28,
      "text": "他们会说孙宇成写小作文"
    },
    {
      "sid": "S00059",
      "start": 84.28,
      "end": 85.5,
      "text": "曝光了女性的隐私"
    },
    {
      "sid": "S00060",
      "start": 85.5,
      "end": 86.08,
      "text": "那么好"
    },
    {
      "sid": "S00061",
      "start": 86.08,
      "end": 87.16,
      "text": "我这里想问一下"
    },
    {
      "sid": "S00062",
      "start": 87.16,
      "end": 89.22,
      "text": "小作文这套是谁先开始的"
    },
    {
      "sid": "S00063",
      "start": 89.22,
      "end": 90.26,
      "text": "在过去十几年"
    },
    {
      "sid": "S00064",
      "start": 90.26,
      "end": 92.08,
      "text": "某群体的小作文网爆前任"
    },
    {
      "sid": "S00065",
      "start": 92.08,
      "end": 94.0,
      "text": "已经形成了一套非常熟练的流程"
    },
    {
      "sid": "S00066",
      "start": 94.0,
      "end": 95.0,
      "text": "聊天记录拿出来"
    },
    {
      "sid": "S00067",
      "start": 95.0,
      "end": 96.04,
      "text": "转账截图摆出来"
    },
    {
      "sid": "S00068",
      "start": 96.04,
      "end": 97.76,
      "text": "再写一篇几千字的小作文"
    },
    {
      "sid": "S00069",
      "start": 97.76,
      "end": 99.56,
      "text": "把两个人之间最私密的事情"
    },
    {
      "sid": "S00070",
      "start": 99.56,
      "end": 100.58,
      "text": "全放到网上"
    },
    {
      "sid": "S00071",
      "start": 100.58,
      "end": 102.4,
      "text": "这种女性主动先做的时候"
    },
    {
      "sid": "S00072",
      "start": 102.4,
      "end": 103.2,
      "text": "是渣男的行为"
    },
    {
      "sid": "S00073",
      "start": 103.2,
      "end": 104.96,
      "text": "在过去绝大多数的时候"
    },
    {
      "sid": "S00074",
      "start": 104.96,
      "end": 105.8,
      "text": "舆论都会夸"
    },
    {
      "sid": "S00075",
      "start": 105.8,
      "end": 109.76,
      "text": "可如今"
    },
    {
      "sid": "S00076",
      "start": 109.76,
      "end": 111.26,
      "text": "孙哥失仪长继"
    },
    {
      "sid": "S00077",
      "start": 111.26,
      "end": 111.86,
      "text": "以质疑"
    },
    {
      "sid": "S00078",
      "start": 111.86,
      "end": 113.4,
      "text": "怎么舆论就突然开始想起"
    },
    {
      "sid": "S00079",
      "start": 113.4,
      "end": 114.62,
      "text": "体面这两个字了呢"
    },
    {
      "sid": "S00080",
      "start": 114.62,
      "end": 115.52,
      "text": "那么我想请问"
    },
    {
      "sid": "S00081",
      "start": 115.52,
      "end": 116.62,
      "text": "这真的公平吗"
    },
    {
      "sid": "S00082",
      "start": 116.62,
      "end": 117.64,
      "text": "还是说有些人"
    },
    {
      "sid": "S00083",
      "start": 117.64,
      "end": 119.0,
      "text": "他只想让自己公平"
    },
    {
      "sid": "S00084",
      "start": 119.0,
      "end": 123.26,
      "text": "孙宇春他是不是好人"
    },
    {
      "sid": "S00085",
      "start": 123.26,
      "end": 123.96,
      "text": "我暂不评价"
    },
    {
      "sid": "S00086",
      "start": 123.96,
      "end": 124.6,
      "text": "但我觉得"
    },
    {
      "sid": "S00087",
      "start": 124.6,
      "end": 125.66,
      "text": "他为了和你结婚"
    },
    {
      "sid": "S00088",
      "start": 125.66,
      "end": 126.68,
      "text": "付了三千万财力"
    },
    {
      "sid": "S00089",
      "start": 126.68,
      "end": 128.1,
      "text": "这个时候你不想结了"
    },
    {
      "sid": "S00090",
      "start": 128.1,
      "end": 128.98,
      "text": "你要坐地起家"
    },
    {
      "sid": "S00091",
      "start": 128.98,
      "end": 130.18,
      "text": "结果给人家惹毛了"
    },
    {
      "sid": "S00092",
      "start": 130.18,
      "end": 130.86,
      "text": "也不想结了"
    },
    {
      "sid": "S00093",
      "start": 130.86,
      "end": 132.24,
      "text": "他让你把这三千万退回来"
    },
    {
      "sid": "S00094",
      "start": 132.24,
      "end": 133.22,
      "text": "就退钱这个行为"
    },
    {
      "sid": "S00095",
      "start": 133.22,
      "end": 134.16,
      "text": "我觉得没啥问题"
    },
    {
      "sid": "S00096",
      "start": 134.16,
      "end": 134.94,
      "text": "有些人会说"
    },
    {
      "sid": "S00097",
      "start": 134.94,
      "end": 136.6,
      "text": "这种事情上法庭解决就行了"
    },
    {
      "sid": "S00098",
      "start": 136.6,
      "end": 138.26,
      "text": "何必拿到网上来说呢"
    },
    {
      "sid": "S00099",
      "start": 138.26,
      "end": 140.32,
      "text": "那么这依然是典型的索取逻辑"
    },
    {
      "sid": "S00100",
      "start": 140.32,
      "end": 141.82,
      "text": "毕竟按照正常人的思维来讲"
    },
    {
      "sid": "S00101",
      "start": 141.82,
      "end": 143.44,
      "text": "应该是收了钱既然不办事"
    },
    {
      "sid": "S00102",
      "start": 143.44,
      "end": 144.54,
      "text": "退还三千万财力"
    },
    {
      "sid": "S00103",
      "start": 144.54,
      "end": 145.5,
      "text": "不是应该的吗"
    },
    {
      "sid": "S00104",
      "start": 145.5,
      "end": 146.78,
      "text": "那为什么连这种事情"
    },
    {
      "sid": "S00105",
      "start": 146.78,
      "end": 147.62,
      "text": "都要闹到法院"
    },
    {
      "sid": "S00106",
      "start": 147.62,
      "end": 149.16,
      "text": "这就像是你去地摊买瓜"
    },
    {
      "sid": "S00107",
      "start": 149.16,
      "end": 150.46,
      "text": "结果这瓜不保熟"
    },
    {
      "sid": "S00108",
      "start": 150.46,
      "end": 151.66,
      "text": "你要把这瓜给退了"
    },
    {
      "sid": "S00109",
      "start": 151.66,
      "end": 153.68,
      "text": "结果老板这个不保熟的瓜不给你"
    },
    {
      "sid": "S00110",
      "start": 153.68,
      "end": 154.72,
      "text": "连钱也不给你"
    },
    {
      "sid": "S00111",
      "start": 154.72,
      "end": 155.3,
      "text": "路人起哄"
    },
    {
      "sid": "S00112",
      "start": 155.3,
      "end": 156.58,
      "text": "叫你去法院起数去"
    },
    {
      "sid": "S00113",
      "start": 156.58,
      "end": 157.36,
      "text": "那我就在想"
    },
    {
      "sid": "S00114",
      "start": 157.36,
      "end": 159.46,
      "text": "欠债还钱不是天经地义吗"
    },
    {
      "sid": "S00115",
      "start": 159.46,
      "end": 161.16,
      "text": "怎么这种事情都要闹到法院去"
    },
    {
      "sid": "S00116",
      "start": 161.16,
      "end": 163.22,
      "text": "这不是典型的浪费公共资源吗"
    },
    {
      "sid": "S00117",
      "start": 163.22,
      "end": 164.54,
      "text": "因为索取毫无成本"
    },
    {
      "sid": "S00118",
      "start": 164.54,
      "end": 165.32,
      "text": "还追逃着"
    },
    {
      "sid": "S00119",
      "start": 165.32,
      "end": 166.96,
      "text": "需要付出极大的时间精力"
    },
    {
      "sid": "S00120",
      "start": 166.96,
      "end": 168.18,
      "text": "一定要闹到法院去"
    },
    {
      "sid": "S00121",
      "start": 168.18,
      "end": 169.26,
      "text": "才有概率拿回"
    },
    {
      "sid": "S00122",
      "start": 169.26,
      "end": 169.94,
      "text": "那听到这里"
    },
    {
      "sid": "S00123",
      "start": 169.94,
      "end": 171.66,
      "text": "可能很多兄弟们都汗流浃背了"
    },
    {
      "sid": "S00124",
      "start": 171.66,
      "end": 173.8,
      "text": "那我这里要悄悄给兄弟们讲一个小秘密"
    },
    {
      "sid": "S00125",
      "start": 173.8,
      "end": 174.88,
      "text": "那就是索取逻辑"
    },
    {
      "sid": "S00126",
      "start": 174.88,
      "end": 176.44,
      "text": "有时候遇到特定人群"
    },
    {
      "sid": "S00127",
      "start": 176.44,
      "end": 177.44,
      "text": "他会失灵"
    },
    {
      "sid": "S00128",
      "start": 177.44,
      "end": 178.54,
      "text": "这种特定人群呢"
    },
    {
      "sid": "S00129",
      "start": 178.54,
      "end": 179.84,
      "text": "就是那种高适要姿态"
    },
    {
      "sid": "S00130",
      "start": 179.84,
      "end": 180.72,
      "text": "让女人敬畏"
    },
    {
      "sid": "S00131",
      "start": 180.72,
      "end": 182.42,
      "text": "让女人生理性喜欢的男人"
    },
    {
      "sid": "S00132",
      "start": 182.42,
      "end": 183.06,
      "text": "女人对待男人"
    },
    {
      "sid": "S00133",
      "start": 183.06,
      "end": 184.32,
      "text": "他们有两种不同的标准"
    },
    {
      "sid": "S00134",
      "start": 184.32,
      "end": 186.06,
      "text": "一种是可以采取索取逻辑的"
    },
    {
      "sid": "S00135",
      "start": 186.06,
      "end": 186.76,
      "text": "供养着男人"
    },
    {
      "sid": "S00136",
      "start": 186.76,
      "end": 187.44,
      "text": "还有一种呢"
    },
    {
      "sid": "S00137",
      "start": 187.44,
      "end": 189.14,
      "text": "是激发他生理性喜欢的"
    },
    {
      "sid": "S00138",
      "start": 189.14,
      "end": 190.34,
      "text": "情人属性的男人"
    },
    {
      "sid": "S00139",
      "start": 190.34,
      "end": 191.2,
      "text": "那么这种男人呢"
    },
    {
      "sid": "S00140",
      "start": 191.2,
      "end": 192.96,
      "text": "不是说他们遇到索取逻辑之后"
    },
    {
      "sid": "S00141",
      "start": 192.96,
      "end": 194.1,
      "text": "处理的方式有多得当"
    },
    {
      "sid": "S00142",
      "start": 194.1,
      "end": 196.32,
      "text": "而是他们根本就不会遇到索取逻辑"
    },
    {
      "sid": "S00143",
      "start": 196.32,
      "end": 197.38,
      "text": "女人在遇到他们之后"
    },
    {
      "sid": "S00144",
      "start": 197.38,
      "end": 198.5,
      "text": "会变得非常的内好"
    },
    {
      "sid": "S00145",
      "start": 198.5,
      "end": 199.68,
      "text": "因为他们的底层代码"
    },
    {
      "sid": "S00146",
      "start": 199.68,
      "end": 200.68,
      "text": "就是要找男人要钱"
    },
    {
      "sid": "S00147",
      "start": 200.68,
      "end": 201.96,
      "text": "但是遇到这种男人之后"
    },
    {
      "sid": "S00148",
      "start": 201.96,
      "end": 202.74,
      "text": "他们又不敢"
    },
    {
      "sid": "S00149",
      "start": 202.74,
      "end": 204.16,
      "text": "于是他们只能在这个男人身上"
    },
    {
      "sid": "S00150",
      "start": 204.16,
      "end": 205.32,
      "text": "投入更多的沉默成本"
    },
    {
      "sid": "S00151",
      "start": 205.32,
      "end": 206.62,
      "text": "所以生活中有些人"
    },
    {
      "sid": "S00152",
      "start": 206.62,
      "end": 208.32,
      "text": "他们会花着供养者的钱"
    },
    {
      "sid": "S00153",
      "start": 208.32,
      "end": 210.48,
      "text": "去包养他生理性喜欢的情人"
    },
    {
      "sid": "S00154",
      "start": 210.48,
      "end": 212.52,
      "text": "那个情人对他可能还不怎么好"
    },
    {
      "sid": "S00155",
      "start": 212.52,
      "end": 213.92,
      "text": "但是他就是很喜欢"
    },
    {
      "sid": "S00156",
      "start": 213.92,
      "end": 214.98,
      "text": "就像景田在背后"
    },
    {
      "sid": "S00157",
      "start": 214.98,
      "end": 216.4,
      "text": "闻了个乒乓球球拍一样"
    },
    {
      "sid": "S00158",
      "start": 216.4,
      "end": 217.4,
      "text": "网上很多人都在讲"
    },
    {
      "sid": "S00159",
      "start": 217.4,
      "end": 218.48,
      "text": "孙宇春这件事情"
    },
    {
      "sid": "S00160",
      "start": 218.48,
      "end": 219.56,
      "text": "再一次体现了"
    },
    {
      "sid": "S00161",
      "start": 219.56,
      "end": 220.88,
      "text": "黄毛体育生的含金量"
    },
    {
      "sid": "S00162",
      "start": 220.88,
      "end": 222.46,
      "text": "当然我这里说的黄毛体育生"
    },
    {
      "sid": "S00163",
      "start": 222.46,
      "end": 223.38,
      "text": "只是一种调侃"
    },
    {
      "sid": "S00164",
      "start": 223.38,
      "end": 224.12,
      "text": "这类特质呢"
    },
    {
      "sid": "S00165",
      "start": 224.12,
      "end": 226.2,
      "text": "未必只出现黄毛体育生身上"
    },
    {
      "sid": "S00166",
      "start": 226.2,
      "end": 228.48,
      "text": "他们更多的形容的是一种人群特质"
    },
    {
      "sid": "S00167",
      "start": 228.48,
      "end": 229.9,
      "text": "就比如说孙哥在对待"
    },
    {
      "sid": "S00168",
      "start": 229.9,
      "end": 231.58,
      "text": "除景田之外的其他钱人身上"
    },
    {
      "sid": "S00169",
      "start": 231.58,
      "end": 232.76,
      "text": "他都具备这种特质"
    },
    {
      "sid": "S00170",
      "start": 232.76,
      "end": 234.04,
      "text": "只是遇到景田之后"
    },
    {
      "sid": "S00171",
      "start": 234.04,
      "end": 236.06,
      "text": "他没有保持以往的一致性"
    },
    {
      "sid": "S00172",
      "start": 236.06,
      "end": 237.04,
      "text": "他区别对待了"
    },
    {
      "sid": "S00173",
      "start": 237.04,
      "end": 238.86,
      "text": "这就会导致他在景田这里"
    },
    {
      "sid": "S00174",
      "start": 238.86,
      "end": 240.54,
      "text": "无法满足女人的目枪走"
    },
    {
      "sid": "S00175",
      "start": 240.54,
      "end": 241.88,
      "text": "反观很多黄毛体育生"
    },
    {
      "sid": "S00176",
      "start": 241.88,
      "end": 242.56,
      "text": "精神小伙"
    },
    {
      "sid": "S00177",
      "start": 242.56,
      "end": 243.66,
      "text": "包括黑人rapper"
    },
    {
      "sid": "S00178",
      "start": 243.66,
      "end": 244.84,
      "text": "他们在面对女人的时候"
    },
    {
      "sid": "S00179",
      "start": 244.84,
      "end": 246.06,
      "text": "始终是很自我"
    },
    {
      "sid": "S00180",
      "start": 246.06,
      "end": 247.0,
      "text": "不会被女人影响"
    },
    {
      "sid": "S00181",
      "start": 247.0,
      "end": 247.68,
      "text": "这种特质"
    },
    {
      "sid": "S00182",
      "start": 247.68,
      "end": 248.76,
      "text": "在张继科身上"
    },
    {
      "sid": "S00183",
      "start": 248.76,
      "end": 249.9,
      "text": "体现的淋漓尽致"
    },
    {
      "sid": "S00184",
      "start": 249.9,
      "end": 251.2,
      "text": "如果你真的要对比起来"
    },
    {
      "sid": "S00185",
      "start": 251.2,
      "end": 252.22,
      "text": "张继科的数值"
    },
    {
      "sid": "S00186",
      "start": 252.22,
      "end": 253.5,
      "text": "是远比不上景田的"
    },
    {
      "sid": "S00187",
      "start": 253.5,
      "end": 254.74,
      "text": "更不用说和孙宇春"
    },
    {
      "sid": "S00188",
      "start": 254.74,
      "end": 255.86,
      "text": "这个币圈大老比了"
    },
    {
      "sid": "S00189",
      "start": 255.86,
      "end": 260.69,
      "text": "所以就像我在周世民那一集讲的那样"
    },
    {
      "sid": "S00190",
      "start": 260.69,
      "end": 261.31,
      "text": "女人目枪"
    },
    {
      "sid": "S00191",
      "start": 261.31,
      "end": 262.69,
      "text": "目的从来都不是数值钱"
    },
    {
      "sid": "S00192",
      "start": 262.69,
      "end": 264.05,
      "text": "更多的是他们身上那种"
    },
    {
      "sid": "S00193",
      "start": 264.05,
      "end": 265.77,
      "text": "不被世俗束缚的气质"
    },
    {
      "sid": "S00194",
      "start": 265.77,
      "end": 267.99,
      "text": "这种男人即使他们品行上有些不断"
    },
    {
      "sid": "S00195",
      "start": 267.99,
      "end": 269.89,
      "text": "但他们能够让女人无条件的"
    },
    {
      "sid": "S00196",
      "start": 269.89,
      "end": 271.19,
      "text": "愿意跟他们在一起的能力"
    },
    {
      "sid": "S00197",
      "start": 271.19,
      "end": 273.21,
      "text": "确实让大部分男人羡慕"
    },
    {
      "sid": "S00198",
      "start": 273.21,
      "end": 274.33,
      "text": "普通黄毛体育生"
    },
    {
      "sid": "S00199",
      "start": 274.33,
      "end": 275.77,
      "text": "他们最吸引人的东西是什么"
    },
    {
      "sid": "S00200",
      "start": 275.77,
      "end": 276.27,
      "text": "胆子大"
    },
    {
      "sid": "S00201",
      "start": 276.27,
      "end": 277.03,
      "text": "行动直接"
    },
    {
      "sid": "S00202",
      "start": 277.03,
      "end": 277.73,
      "text": "有攻击性"
    },
    {
      "sid": "S00203",
      "start": 277.73,
      "end": 278.81,
      "text": "不太服管将"
    },
    {
      "sid": "S00204",
      "start": 278.81,
      "end": 280.17,
      "text": "也不怎么等待女人批准"
    },
    {
      "sid": "S00205",
      "start": 280.17,
      "end": 281.21,
      "text": "他可能没有多少钱"
    },
    {
      "sid": "S00206",
      "start": 281.21,
      "end": 281.87,
      "text": "学历也不高"
    },
    {
      "sid": "S00207",
      "start": 281.87,
      "end": 283.63,
      "text": "可他身上的男性枪行为线索"
    },
    {
      "sid": "S00208",
      "start": 283.63,
      "end": 284.49,
      "text": "非常的多"
    },
    {
      "sid": "S00209",
      "start": 284.49,
      "end": 286.05,
      "text": "那既然提到孙宇春景田"
    },
    {
      "sid": "S00210",
      "start": 286.05,
      "end": 287.49,
      "text": "那就一定会聊到张继科"
    },
    {
      "sid": "S00211",
      "start": 287.49,
      "end": 288.59,
      "text": "很多人都在问"
    },
    {
      "sid": "S00212",
      "start": 288.59,
      "end": 290.75,
      "text": "张继科到底哪点比孙宇春强了"
    },
    {
      "sid": "S00213",
      "start": 290.75,
      "end": 291.61,
      "text": "有些博主会说"
    },
    {
      "sid": "S00214",
      "start": 291.61,
      "end": 292.29,
      "text": "因为薄机"
    },
    {
      "sid": "S00215",
      "start": 292.29,
      "end": 293.53,
      "text": "那么我觉得有点道理"
    },
    {
      "sid": "S00216",
      "start": 293.53,
      "end": 293.95,
      "text": "但不多"
    },
    {
      "sid": "S00217",
      "start": 293.95,
      "end": 296.05,
      "text": "张继科之所以能拿捏景田"
    },
    {
      "sid": "S00218",
      "start": 296.05,
      "end": 298.91,
      "text": "是因为张继科压根就没有把景田当回事"
    },
    {
      "sid": "S00219",
      "start": 298.91,
      "end": 300.63,
      "text": "他甚至有一点看不上景田"
    },
    {
      "sid": "S00220",
      "start": 300.63,
      "end": 302.83,
      "text": "进而导致了他与景田相处时"
    },
    {
      "sid": "S00221",
      "start": 302.83,
      "end": 304.19,
      "text": "他会更加的自我"
    },
    {
      "sid": "S00222",
      "start": 304.19,
      "end": 306.37,
      "text": "而自我恰好是强的基础"
    },
    {
      "sid": "S00223",
      "start": 306.37,
      "end": 308.67,
      "text": "正是因为张继科身上那种不服管"
    },
    {
      "sid": "S00224",
      "start": 308.67,
      "end": 310.13,
      "text": "对女人一视同仁的气质"
    },
    {
      "sid": "S00225",
      "start": 310.13,
      "end": 311.67,
      "text": "才会让他在关系中"
    },
    {
      "sid": "S00226",
      "start": 311.67,
      "end": 313.31,
      "text": "占据一个更强势的位置"
    },
    {
      "sid": "S00227",
      "start": 313.31,
      "end": 314.71,
      "text": "而女人也很难决定"
    },
    {
      "sid": "S00228",
      "start": 314.71,
      "end": 315.67,
      "text": "他接下来会做什么"
    },
    {
      "sid": "S00229",
      "start": 315.67,
      "end": 317.87,
      "text": "也很难保证自己一定能够留住他"
    },
    {
      "sid": "S00230",
      "start": 317.87,
      "end": 319.53,
      "text": "张继科在这些特质上"
    },
    {
      "sid": "S00231",
      "start": 319.53,
      "end": 320.77,
      "text": "又叠加了世界冠军"
    },
    {
      "sid": "S00232",
      "start": 320.77,
      "end": 323.11,
      "text": "与经济能力 全国知名度等条件"
    },
    {
      "sid": "S00233",
      "start": 323.11,
      "end": 324.29,
      "text": "那么他的自我评价"
    },
    {
      "sid": "S00234",
      "start": 324.29,
      "end": 326.83,
      "text": "长期以来来自于赛场和自身的事业"
    },
    {
      "sid": "S00235",
      "start": 326.83,
      "end": 328.01,
      "text": "所以他进入关系以后"
    },
    {
      "sid": "S00236",
      "start": 328.01,
      "end": 330.19,
      "text": "他很难把女人变成自己唯一的裁判"
    },
    {
      "sid": "S00237",
      "start": 330.19,
      "end": 332.07,
      "text": "所以张继科有没有私人飞机"
    },
    {
      "sid": "S00238",
      "start": 332.07,
      "end": 333.01,
      "text": "银行里有多少钱"
    },
    {
      "sid": "S00239",
      "start": 333.01,
      "end": 335.29,
      "text": "对他的核心吸引力并没有太大影响"
    },
    {
      "sid": "S00240",
      "start": 335.29,
      "end": 336.87,
      "text": "自然而然这种索其逻辑"
    },
    {
      "sid": "S00241",
      "start": 336.87,
      "end": 338.71,
      "text": "在张继科身上他就不奏效"
    },
    {
      "sid": "S00242",
      "start": 338.71,
      "end": 341.49,
      "text": "那么难道孙宇成的内核就不是一个强者了吗"
    },
    {
      "sid": "S00243",
      "start": 341.49,
      "end": 342.67,
      "text": "孙宇成客观来讲"
    },
    {
      "sid": "S00244",
      "start": 342.67,
      "end": 344.45,
      "text": "他不管是内核还是数值"
    },
    {
      "sid": "S00245",
      "start": 344.45,
      "end": 345.75,
      "text": "都是一个强者"
    },
    {
      "sid": "S00246",
      "start": 345.75,
      "end": 347.75,
      "text": "一个能在币圈那种地方活到今天"
    },
    {
      "sid": "S00247",
      "start": 347.75,
      "end": 349.11,
      "text": "还能积累这么大财富"
    },
    {
      "sid": "S00248",
      "start": 349.11,
      "end": 351.19,
      "text": "他的智商 胆量 野心 手段"
    },
    {
      "sid": "S00249",
      "start": 351.19,
      "end": 352.55,
      "text": "绝对远超常人"
    },
    {
      "sid": "S00250",
      "start": 352.55,
      "end": 355.01,
      "text": "同样 孙宇成和之前周世民那种老实人"
    },
    {
      "sid": "S00251",
      "start": 355.01,
      "end": 356.23,
      "text": "也可以说是毫不沾兵"
    },
    {
      "sid": "S00252",
      "start": 356.23,
      "end": 357.99,
      "text": "他敢花几千万买一根香蕉"
    },
    {
      "sid": "S00253",
      "start": 357.99,
      "end": 359.29,
      "text": "也敢把自己送上太空"
    },
    {
      "sid": "S00254",
      "start": 359.29,
      "end": 360.13,
      "text": "这样的孙宇成"
    },
    {
      "sid": "S00255",
      "start": 360.13,
      "end": 362.99,
      "text": "本来就完全符合女性目强中的很多条件"
    },
    {
      "sid": "S00256",
      "start": 362.99,
      "end": 364.57,
      "text": "但是他遇到景田之后"
    },
    {
      "sid": "S00257",
      "start": 364.57,
      "end": 366.55,
      "text": "他做了一件非常危险的事"
    },
    {
      "sid": "S00258",
      "start": 366.55,
      "end": 368.45,
      "text": "就是他把这个女人给特殊化了"
    },
    {
      "sid": "S00259",
      "start": 368.45,
      "end": 371.59,
      "text": "他没有保持他对待他那些前任一样的一致性"
    },
    {
      "sid": "S00260",
      "start": 371.59,
      "end": 373.33,
      "text": "他开始对女人区别对待了"
    },
    {
      "sid": "S00261",
      "start": 373.33,
      "end": 375.21,
      "text": "我在上期那期视频里我就有讲过"
    },
    {
      "sid": "S00262",
      "start": 375.21,
      "end": 376.75,
      "text": "一旦你为某一个女人改变"
    },
    {
      "sid": "S00263",
      "start": 376.75,
      "end": 378.33,
      "text": "那么女人就不会再喜欢你"
    },
    {
      "sid": "S00264",
      "start": 378.33,
      "end": 380.35,
      "text": "女人喜欢的是最初的那个你"
    },
    {
      "sid": "S00265",
      "start": 380.35,
      "end": 381.69,
      "text": "因为你已经被他驯化了"
    },
    {
      "sid": "S00266",
      "start": 381.69,
      "end": 384.07,
      "text": "女人在逻辑上喜欢去驯化强者"
    },
    {
      "sid": "S00267",
      "start": 384.07,
      "end": 385.57,
      "text": "可强者一旦被驯化"
    },
    {
      "sid": "S00268",
      "start": 385.57,
      "end": 387.83,
      "text": "女人的潜意识里会觉得他不是强者"
    },
    {
      "sid": "S00269",
      "start": 387.83,
      "end": 390.29,
      "text": "然后抛弃他继续开始找强者"
    },
    {
      "sid": "S00270",
      "start": 390.29,
      "end": 393.31,
      "text": "直到找到那个真正的能够cover住他的强者"
    },
    {
      "sid": "S00271",
      "start": 393.31,
      "end": 394.85,
      "text": "那么这就是他们的底层代码"
    },
    {
      "sid": "S00272",
      "start": 394.85,
      "end": 397.13,
      "text": "这也就是为什么景田会叫张继科爸爸"
    },
    {
      "sid": "S00273",
      "start": 397.13,
      "end": 398.79,
      "text": "但孙宇成只能喊景田妈妈"
    },
    {
      "sid": "S00274",
      "start": 398.79,
      "end": 399.85,
      "text": "奴下奴了属于是"
    },
    {
      "sid": "S00275",
      "start": 399.85,
      "end": 402.21,
      "text": "孙宇成在自己的故事里也接受了妈妈这个称呼"
    },
    {
      "sid": "S00276",
      "start": 402.21,
      "end": 404.47,
      "text": "无论景田主观上有没有测试他的意思"
    },
    {
      "sid": "S00277",
      "start": 404.47,
      "end": 406.15,
      "text": "这个称呼最终产生的效果"
    },
    {
      "sid": "S00278",
      "start": 406.15,
      "end": 407.55,
      "text": "都很像一种浮生性测试"
    },
    {
      "sid": "S00279",
      "start": 407.55,
      "end": 409.15,
      "text": "一个在外面唯我独尊的男人"
    },
    {
      "sid": "S00280",
      "start": 409.15,
      "end": 410.81,
      "text": "到他面前愿意扮演儿子"
    },
    {
      "sid": "S00281",
      "start": 410.81,
      "end": 412.43,
      "text": "愿意接受他给出的关系位置"
    },
    {
      "sid": "S00282",
      "start": 412.43,
      "end": 413.75,
      "text": "他叫出妈妈的那一刻"
    },
    {
      "sid": "S00283",
      "start": 413.75,
      "end": 415.69,
      "text": "证明了自己可以为这个女儿改变"
    },
    {
      "sid": "S00284",
      "start": 415.69,
      "end": 418.31,
      "text": "而那一刻就是他丢失男性魅力的开始"
    },
    {
      "sid": "S00285",
      "start": 418.31,
      "end": 419.35,
      "text": "因为女性目强"
    },
    {
      "sid": "S00286",
      "start": 419.35,
      "end": 421.11,
      "text": "他看的恰恰就是一个男人"
    },
    {
      "sid": "S00287",
      "start": 421.11,
      "end": 422.77,
      "text": "能否守住原来的自己"
    },
    {
      "sid": "S00288",
      "start": 422.77,
      "end": 424.69,
      "text": "孙宇成越想证明景田特殊"
    },
    {
      "sid": "S00289",
      "start": 424.69,
      "end": 427.19,
      "text": "则越容易丢失自己身的吸引力"
    },
    {
      "sid": "S00290",
      "start": 427.19,
      "end": 431.48,
      "text": "不过孙宇成和普通老实人"
    },
    {
      "sid": "S00291",
      "start": 431.48,
      "end": 432.68,
      "text": "终究还是有一点区别的"
    },
    {
      "sid": "S00292",
      "start": 432.68,
      "end": 433.82,
      "text": "按照他文章里的说法"
    },
    {
      "sid": "S00293",
      "start": 433.82,
      "end": 434.92,
      "text": "5000万美金这一关"
    },
    {
      "sid": "S00294",
      "start": 434.92,
      "end": 435.98,
      "text": "他最后是拒绝的"
    },
    {
      "sid": "S00295",
      "start": 435.98,
      "end": 437.46,
      "text": "现实里的3000万财力纠纷"
    },
    {
      "sid": "S00296",
      "start": 437.46,
      "end": 438.98,
      "text": "他也走向法院开始追讨"
    },
    {
      "sid": "S00297",
      "start": 438.98,
      "end": 440.58,
      "text": "这就意味着索取逻辑"
    },
    {
      "sid": "S00298",
      "start": 440.58,
      "end": 442.18,
      "text": "确实让他付出了很多"
    },
    {
      "sid": "S00299",
      "start": 442.18,
      "end": 444.28,
      "text": "但是没有彻底把他给绑死"
    },
    {
      "sid": "S00300",
      "start": 444.28,
      "end": 445.7,
      "text": "因为孙宇成他骨子里"
    },
    {
      "sid": "S00301",
      "start": 445.7,
      "end": 446.94,
      "text": "他就不是一个弱者"
    },
    {
      "sid": "S00302",
      "start": 446.94,
      "end": 448.24,
      "text": "所以说孙宇成他会翻脸"
    },
    {
      "sid": "S00303",
      "start": 448.24,
      "end": 448.94,
      "text": "他会停手"
    },
    {
      "sid": "S00304",
      "start": 448.94,
      "end": 450.82,
      "text": "他会去让索取产生代价"
    },
    {
      "sid": "S00305",
      "start": 450.82,
      "end": 452.16,
      "text": "所以我们大家回头看看"
    },
    {
      "sid": "S00306",
      "start": 452.16,
      "end": 452.98,
      "text": "那5000万美金"
    },
    {
      "sid": "S00307",
      "start": 452.98,
      "end": 454.04,
      "text": "就会发现这笔钱"
    },
    {
      "sid": "S00308",
      "start": 454.04,
      "end": 455.44,
      "text": "为什么会被那么多网友"
    },
    {
      "sid": "S00309",
      "start": 455.44,
      "end": 456.8,
      "text": "认为理所当然"
    },
    {
      "sid": "S00310",
      "start": 456.8,
      "end": 458.4,
      "text": "他们觉得孙宇成得到景田"
    },
    {
      "sid": "S00311",
      "start": 461.48,
      "end": 463.12,
      "text": "那么你就没有资格"
    },
    {
      "sid": "S00312",
      "start": 463.12,
      "end": 464.64,
      "text": "在中途嫌票价太贵"
    },
    {
      "sid": "S00313",
      "start": 464.64,
      "end": 466.22,
      "text": "这才是普通男人"
    },
    {
      "sid": "S00314",
      "start": 466.22,
      "end": 467.3,
      "text": "最应该看懂的地方"
    },
    {
      "sid": "S00315",
      "start": 467.3,
      "end": 468.14,
      "text": "男人没有钱"
    },
    {
      "sid": "S00316",
      "start": 468.14,
      "end": 469.62,
      "text": "当然会失去很多选择"
    },
    {
      "sid": "S00317",
      "start": 469.62,
      "end": 471.48,
      "text": "可一个男人最可悲的情况是"
    },
    {
      "sid": "S00318",
      "start": 471.48,
      "end": 473.12,
      "text": "女人对他本身没有欲望"
    },
    {
      "sid": "S00319",
      "start": 473.12,
      "end": 474.18,
      "text": "但他却还相信"
    },
    {
      "sid": "S00320",
      "start": 474.18,
      "end": 475.74,
      "text": "通过加钱可以解决问题"
    },
    {
      "sid": "S00321",
      "start": 475.74,
      "end": 477.4,
      "text": "孙宇成在临门一角的那一刻"
    },
    {
      "sid": "S00322",
      "start": 477.4,
      "end": 478.26,
      "text": "幻然醒悟了"
    },
    {
      "sid": "S00323",
      "start": 478.26,
      "end": 479.98,
      "text": "他避免了后来更大的危机"
    },
    {
      "sid": "S00324",
      "start": 479.98,
      "end": 481.06,
      "text": "但是现实生活中"
    },
    {
      "sid": "S00325",
      "start": 481.06,
      "end": 481.88,
      "text": "还有很多男人"
    },
    {
      "sid": "S00326",
      "start": 481.88,
      "end": 482.56,
      "text": "他们不知道"
    },
    {
      "sid": "S00327",
      "start": 482.56,
      "end": 483.84,
      "text": "他们依然在层层家"
    },
    {
      "sid": "S00328",
      "start": 483.84,
      "end": 485.22,
      "text": "这也是为什么我说"
    },
    {
      "sid": "S00329",
      "start": 485.22,
      "end": 486.14,
      "text": "男性觉醒"
    },
    {
      "sid": "S00330",
      "start": 486.14,
      "end": 487.16,
      "text": "道逐且长"
    },
    {
      "sid": "S00331",
      "start": 487.16,
      "end": 488.34,
      "text": "如果你不能让女人"
    },
    {
      "sid": "S00332",
      "start": 488.34,
      "end": 489.32,
      "text": "生理性喜欢你"
    },
    {
      "sid": "S00333",
      "start": 489.32,
      "end": 490.48,
      "text": "那么你对他付出的一切"
    },
    {
      "sid": "S00334",
      "start": 490.48,
      "end": 491.96,
      "text": "最后都会变成他的"
    },
    {
      "sid": "S00335",
      "start": 491.96,
      "end": 492.92,
      "text": "精神损失费"
    },
    {
      "sid": "S00336",
      "start": 492.92,
      "end": 493.56,
      "text": "我是Mike"
    },
    {
      "sid": "S00337",
      "start": 493.56,
      "end": 494.38,
      "text": "救赎知道"
    },
    {
      "sid": "S00338",
      "start": 494.38,
      "end": 495.12,
      "text": "就在其中"
    },
    {
      "sid": "S00339",
      "start": 495.12,
      "end": 496.1,
      "text": "我们下期见"
    },
    {
      "sid": "S00340",
      "start": 496.1,
      "end": 496.72,
      "text": "请问一下"
    },
    {
      "sid": "S00341",
      "start": 496.72,
      "end": 497.8,
      "text": "娶你需要花多少彩点"
    },
    {
      "sid": "S00342",
      "start": 497.8,
      "end": 498.5,
      "text": "妈说的"
    },
    {
      "sid": "S00343",
      "start": 498.5,
      "end": 498.8,
      "text": "30"
    }
  ]
}
