{
  "schema_version": 1,
  "stable_id": "mikey-youtube-video-008",
  "youtube_id": "tkDjl6MSYoA",
  "media_sha256": "9e04a0266536bdf3ed672425e1f1750d0fbef078685c74c553a1cce5bfd2d991",
  "language": "zh",
  "segments": [
    {
      "sid": "S00001",
      "start": 0.0,
      "end": 2.46,
      "text": "或許網爆米娜的人和現在網爆西村莉的人"
    },
    {
      "sid": "S00002",
      "start": 2.46,
      "end": 4.76,
      "text": "他們本質上都同屬於一群人"
    },
    {
      "sid": "S00003",
      "start": 4.76,
      "end": 6.5,
      "text": "他們的共性就是沒有腦子"
    },
    {
      "sid": "S00004",
      "start": 6.5,
      "end": 7.24,
      "text": "都是二級管"
    },
    {
      "sid": "S00005",
      "start": 7.24,
      "end": 8.4,
      "text": "缺乏辯證思維"
    },
    {
      "sid": "S00006",
      "start": 8.4,
      "end": 10.1,
      "text": "最終所呈現的行為就是會"
    },
    {
      "sid": "S00007",
      "start": 10.1,
      "end": 11.4,
      "text": "不分青紅皂白的"
    },
    {
      "sid": "S00008",
      "start": 11.4,
      "end": 12.6,
      "text": "無差別攻擊任何人"
    },
    {
      "sid": "S00009",
      "start": 12.6,
      "end": 14.7,
      "text": "最近西村莉事件在網上鬧得沸沸揚揚"
    },
    {
      "sid": "S00010",
      "start": 14.7,
      "end": 16.5,
      "text": "我先來簡單講一下大概情況"
    },
    {
      "sid": "S00011",
      "start": 16.5,
      "end": 19.1,
      "text": "起因是西村莉7月26號的一次演出上"
    },
    {
      "sid": "S00012",
      "start": 19.1,
      "end": 20.9,
      "text": "女粉米娜帶花拋給她的隊友"
    },
    {
      "sid": "S00013",
      "start": 20.9,
      "end": 22.2,
      "text": "讓其轉交給西村莉"
    },
    {
      "sid": "S00014",
      "start": 22.2,
      "end": 24.1,
      "text": "但西村莉專注表演就沒有理會"
    },
    {
      "sid": "S00015",
      "start": 24.1,
      "end": 26.1,
      "text": "而在7月30號西村莉直播的時候"
    },
    {
      "sid": "S00016",
      "start": 26.1,
      "end": 27.1,
      "text": "她聊到了這個事情"
    },
    {
      "sid": "S00017",
      "start": 27.1,
      "end": 41.8,
      "text": "看完我覺得西村莉說的話"
    },
    {
      "sid": "S00018",
      "start": 41.8,
      "end": 42.5,
      "text": "不能說壞"
    },
    {
      "sid": "S00019",
      "start": 42.5,
      "end": 43.9,
      "text": "但確實挺沒有情商的"
    },
    {
      "sid": "S00020",
      "start": 43.9,
      "end": 47.0,
      "text": "因為在當今二級管群星閃耀的網路世界"
    },
    {
      "sid": "S00021",
      "start": 47.0,
      "end": 48.6,
      "text": "她這番帶有埋怨的吐槽"
    },
    {
      "sid": "S00022",
      "start": 48.6,
      "end": 50.2,
      "text": "對於飯圈集團粉絲來說"
    },
    {
      "sid": "S00023",
      "start": 50.2,
      "end": 51.4,
      "text": "那簡直就是神域"
    },
    {
      "sid": "S00024",
      "start": 51.4,
      "end": 53.2,
      "text": "那就是天神降旨"
    },
    {
      "sid": "S00025",
      "start": 53.2,
      "end": 55.7,
      "text": "那就是名正言順殺人的核心論據"
    },
    {
      "sid": "S00026",
      "start": 55.7,
      "end": 57.2,
      "text": "當然也有人說她是故意的"
    },
    {
      "sid": "S00027",
      "start": 57.2,
      "end": 58.2,
      "text": "但我覺得不至於"
    },
    {
      "sid": "S00028",
      "start": 58.2,
      "end": 61.1,
      "text": "因為她本人沒有必要做這種蠢事長期飯票"
    },
    {
      "sid": "S00029",
      "start": 61.1,
      "end": 62.3,
      "text": "還會帶來輿論的行為"
    },
    {
      "sid": "S00030",
      "start": 62.3,
      "end": 64.1,
      "text": "充其量就是沒腦子加愚蠢"
    },
    {
      "sid": "S00031",
      "start": 64.1,
      "end": 66.5,
      "text": "雖然直播里西村莉沒有說具體是誰"
    },
    {
      "sid": "S00032",
      "start": 66.5,
      "end": 67.3,
      "text": "但有意思的是"
    },
    {
      "sid": "S00033",
      "start": 67.3,
      "end": 69.7,
      "text": "極端女粉們她們竟然能回始神差的"
    },
    {
      "sid": "S00034",
      "start": 69.7,
      "end": 72.3,
      "text": "集體解碼為西村莉本人對米娜不滿"
    },
    {
      "sid": "S00035",
      "start": 72.3,
      "end": 74.5,
      "text": "然後佔領米娜的社交帳號和評論區"
    },
    {
      "sid": "S00036",
      "start": 74.5,
      "end": 75.9,
      "text": "並且開始大規模網報"
    },
    {
      "sid": "S00037",
      "start": 75.9,
      "end": 77.7,
      "text": "而那兩天拋花送禮物的"
    },
    {
      "sid": "S00038",
      "start": 77.7,
      "end": 79.0,
      "text": "並不只有米娜一個人"
    },
    {
      "sid": "S00039",
      "start": 79.0,
      "end": 79.9,
      "text": "更有極端粉絲"
    },
    {
      "sid": "S00040",
      "start": 79.9,
      "end": 82.2,
      "text": "因為拋花這些行為顯現亮澄踩踩事故"
    },
    {
      "sid": "S00041",
      "start": 82.2,
      "end": 84.0,
      "text": "結果事實上卻只有米娜一個人"
    },
    {
      "sid": "S00042",
      "start": 84.0,
      "end": 85.7,
      "text": "因為送花這時而被網報"
    },
    {
      "sid": "S00043",
      "start": 85.7,
      "end": 88.0,
      "text": "最後米娜在8月5號的凌晨直播道歉"
    },
    {
      "sid": "S00044",
      "start": 88.0,
      "end": 89.0,
      "text": "並且自殺"
    },
    {
      "sid": "S00045",
      "start": 89.0,
      "end": 94.19,
      "text": "可為什麼偏偏是米娜成為了這個受害者"
    },
    {
      "sid": "S00046",
      "start": 94.19,
      "end": 97.09,
      "text": "而不是那些差點引發更嚴重後果的其他粉絲"
    },
    {
      "sid": "S00047",
      "start": 97.09,
      "end": 97.99,
      "text": "原因就在於"
    },
    {
      "sid": "S00048",
      "start": 97.99,
      "end": 100.49,
      "text": "米娜長得確確實實太好看了"
    },
    {
      "sid": "S00049",
      "start": 100.49,
      "end": 101.89,
      "text": "我們這樣做一個思想實驗"
    },
    {
      "sid": "S00050",
      "start": 101.89,
      "end": 103.79,
      "text": "如果米娜的長相並沒有那麼出眾"
    },
    {
      "sid": "S00051",
      "start": 103.79,
      "end": 105.19,
      "text": "甚至還不如一個普通人"
    },
    {
      "sid": "S00052",
      "start": 105.19,
      "end": 106.19,
      "text": "那結果會怎麼樣"
    },
    {
      "sid": "S00053",
      "start": 106.19,
      "end": 107.59,
      "text": "她必然不會被網報"
    },
    {
      "sid": "S00054",
      "start": 107.59,
      "end": 109.49,
      "text": "相反那些極端女粉反而會說"
    },
    {
      "sid": "S00055",
      "start": 109.49,
      "end": 110.89,
      "text": "哇極美好勇敢"
    },
    {
      "sid": "S00056",
      "start": 110.89,
      "end": 113.09,
      "text": "可以做自己極美好棒太棒了"
    },
    {
      "sid": "S00057",
      "start": 113.09,
      "end": 114.29,
      "text": "這就是女性力量"
    },
    {
      "sid": "S00058",
      "start": 114.29,
      "end": 115.39,
      "text": "我們女孩真棒"
    },
    {
      "sid": "S00059",
      "start": 115.39,
      "end": 117.49,
      "text": "為什麼她們在面對普通長相的女生"
    },
    {
      "sid": "S00060",
      "start": 117.49,
      "end": 118.49,
      "text": "會有這種反應呢"
    },
    {
      "sid": "S00061",
      "start": 118.49,
      "end": 120.89,
      "text": "這就是女人群體潛意識中所攜帶的"
    },
    {
      "sid": "S00062",
      "start": 120.89,
      "end": 121.69,
      "text": "慈禁心理"
    },
    {
      "sid": "S00063",
      "start": 121.69,
      "end": 123.19,
      "text": "如果米娜長得不好看"
    },
    {
      "sid": "S00064",
      "start": 123.19,
      "end": 123.89,
      "text": "那麼這些女的"
    },
    {
      "sid": "S00065",
      "start": 123.89,
      "end": 125.09,
      "text": "她們就會覺得這個女生"
    },
    {
      "sid": "S00066",
      "start": 125.09,
      "end": 126.59,
      "text": "對她們產生不了威脅"
    },
    {
      "sid": "S00067",
      "start": 126.59,
      "end": 128.09,
      "text": "也就不會引發嫉妒心"
    },
    {
      "sid": "S00068",
      "start": 128.09,
      "end": 129.39,
      "text": "進而升級成網報"
    },
    {
      "sid": "S00069",
      "start": 129.39,
      "end": 130.99,
      "text": "本質上這些女生她們知道"
    },
    {
      "sid": "S00070",
      "start": 130.99,
      "end": 131.99,
      "text": "長相普通的女生"
    },
    {
      "sid": "S00071",
      "start": 131.99,
      "end": 133.59,
      "text": "無法給她們帶來任何威脅"
    },
    {
      "sid": "S00072",
      "start": 133.59,
      "end": 134.29,
      "text": "所以明白沒"
    },
    {
      "sid": "S00073",
      "start": 134.29,
      "end": 135.09,
      "text": "米娜的悲劇"
    },
    {
      "sid": "S00074",
      "start": 135.09,
      "end": 136.39,
      "text": "其中一個原因就在於"
    },
    {
      "sid": "S00075",
      "start": 136.39,
      "end": 138.09,
      "text": "她長得在客觀意義上"
    },
    {
      "sid": "S00076",
      "start": 138.09,
      "end": 139.39,
      "text": "真的很好看"
    },
    {
      "sid": "S00077",
      "start": 139.39,
      "end": 141.69,
      "text": "當然我知道女粉她們自然是不會承認的"
    },
    {
      "sid": "S00078",
      "start": 141.69,
      "end": 143.09,
      "text": "但她們內心的怨氣"
    },
    {
      "sid": "S00079",
      "start": 143.09,
      "end": 144.79,
      "text": "已然暗自滋生"
    },
    {
      "sid": "S00080",
      "start": 144.79,
      "end": 145.79,
      "text": "她們只是在等一個"
    },
    {
      "sid": "S00081",
      "start": 145.79,
      "end": 146.99,
      "text": "詩出有名的timing"
    },
    {
      "sid": "S00082",
      "start": 146.99,
      "end": 148.79,
      "text": "而西村莉這是直播發言"
    },
    {
      "sid": "S00083",
      "start": 148.79,
      "end": 150.29,
      "text": "恰好成為了她們可以"
    },
    {
      "sid": "S00084",
      "start": 150.29,
      "end": 151.19,
      "text": "詩出有名"
    },
    {
      "sid": "S00085",
      "start": 151.19,
      "end": 153.09,
      "text": "發洩自身怨氣的突破口"
    },
    {
      "sid": "S00086",
      "start": 153.09,
      "end": 153.49,
      "text": "同時"
    },
    {
      "sid": "S00087",
      "start": 153.49,
      "end": 154.79,
      "text": "西村莉最錯的地方"
    },
    {
      "sid": "S00088",
      "start": 154.79,
      "end": 156.79,
      "text": "就是她不懂女性的慈禁心理"
    },
    {
      "sid": "S00089",
      "start": 156.79,
      "end": 157.69,
      "text": "她永遠不會明白"
    },
    {
      "sid": "S00090",
      "start": 157.69,
      "end": 159.69,
      "text": "女人在慈禁地位受到威脅的時候"
    },
    {
      "sid": "S00091",
      "start": 159.69,
      "end": 161.59,
      "text": "永遠會最優先攻擊那個"
    },
    {
      "sid": "S00092",
      "start": 161.59,
      "end": 163.29,
      "text": "長得最漂亮的女人"
    },
    {
      "sid": "S00093",
      "start": 163.29,
      "end": 164.09,
      "text": "換句話說"
    },
    {
      "sid": "S00094",
      "start": 164.09,
      "end": 166.39,
      "text": "這場網報本質上是極端女粉"
    },
    {
      "sid": "S00095",
      "start": 166.39,
      "end": 167.79,
      "text": "因容貌慈禁危機感"
    },
    {
      "sid": "S00096",
      "start": 167.79,
      "end": 169.89,
      "text": "集體針對高顏值對象發起的"
    },
    {
      "sid": "S00097",
      "start": 169.89,
      "end": 171.89,
      "text": "集體無意識泄憤行為"
    },
    {
      "sid": "S00098",
      "start": 171.89,
      "end": 173.89,
      "text": "這其實跟網上那些打拳的女生"
    },
    {
      "sid": "S00099",
      "start": 173.89,
      "end": 174.69,
      "text": "是一個道理"
    },
    {
      "sid": "S00100",
      "start": 174.69,
      "end": 176.39,
      "text": "她們從小就沒有因為顏值"
    },
    {
      "sid": "S00101",
      "start": 176.39,
      "end": 178.29,
      "text": "而受到過任何社會資源的傾斜"
    },
    {
      "sid": "S00102",
      "start": 178.29,
      "end": 179.69,
      "text": "她們一系列的攻擊行為"
    },
    {
      "sid": "S00103",
      "start": 179.69,
      "end": 180.89,
      "text": "本身都是出自於"
    },
    {
      "sid": "S00104",
      "start": 180.89,
      "end": 182.59,
      "text": "自身缺乏安全感所導致的"
    },
    {
      "sid": "S00105",
      "start": 182.59,
      "end": 183.69,
      "text": "所以說句題外話"
    },
    {
      "sid": "S00106",
      "start": 183.69,
      "end": 185.09,
      "text": "如果你想分辨一個女生"
    },
    {
      "sid": "S00107",
      "start": 185.09,
      "end": 186.89,
      "text": "在客觀意義上到底好不好看"
    },
    {
      "sid": "S00108",
      "start": 186.89,
      "end": 187.89,
      "text": "那你就直接問她"
    },
    {
      "sid": "S00109",
      "start": 187.89,
      "end": 189.79,
      "text": "小時候有沒有被女生小團體排擠"
    },
    {
      "sid": "S00110",
      "start": 189.79,
      "end": 190.79,
      "text": "或者到過黃瑤"
    },
    {
      "sid": "S00111",
      "start": 190.79,
      "end": 191.39,
      "text": "當然"
    },
    {
      "sid": "S00112",
      "start": 191.39,
      "end": 192.19,
      "text": "綜上所說"
    },
    {
      "sid": "S00113",
      "start": 192.19,
      "end": 193.99,
      "text": "我並不是在貶低任何一個性別"
    },
    {
      "sid": "S00114",
      "start": 193.99,
      "end": 195.89,
      "text": "我只是身為一個進化心理學導師"
    },
    {
      "sid": "S00115",
      "start": 195.89,
      "end": 197.29,
      "text": "基於我多年的專業知識"
    },
    {
      "sid": "S00116",
      "start": 197.29,
      "end": 198.49,
      "text": "所推理出來的結論"
    },
    {
      "sid": "S00117",
      "start": 198.49,
      "end": 199.29,
      "text": "如果你幹了"
    },
    {
      "sid": "S00118",
      "start": 199.29,
      "end": 199.99,
      "text": "那就是你贏"
    },
    {
      "sid": "S00119",
      "start": 199.99,
      "end": 200.79,
      "text": "那話說回來"
    },
    {
      "sid": "S00120",
      "start": 200.79,
      "end": 202.99,
      "text": "那為什麼現在的網報時間越來越多了"
    },
    {
      "sid": "S00121",
      "start": 205.76,
      "end": 206.36,
      "text": "我覺得"
    },
    {
      "sid": "S00122",
      "start": 206.36,
      "end": 207.96,
      "text": "無良媒體和流量平台"
    },
    {
      "sid": "S00123",
      "start": 207.96,
      "end": 209.36,
      "text": "扮演了非常重要的角色"
    },
    {
      "sid": "S00124",
      "start": 209.36,
      "end": 210.56,
      "text": "那麼這裡的無良媒體"
    },
    {
      "sid": "S00125",
      "start": 210.56,
      "end": 212.46,
      "text": "我說的就是當下在各大平台"
    },
    {
      "sid": "S00126",
      "start": 212.46,
      "end": 214.26,
      "text": "鋪天蓋地的用著AI女生"
    },
    {
      "sid": "S00127",
      "start": 214.26,
      "end": 215.86,
      "text": "聲討息村利的正義"
    },
    {
      "sid": "S00128",
      "start": 215.86,
      "end": 216.46,
      "text": "銀銷號"
    },
    {
      "sid": "S00129",
      "start": 216.46,
      "end": 217.66,
      "text": "她們所有的輸出"
    },
    {
      "sid": "S00130",
      "start": 217.66,
      "end": 219.86,
      "text": "都是以流量為目的的情緒化輸出"
    },
    {
      "sid": "S00131",
      "start": 219.86,
      "end": 221.66,
      "text": "她們並不在乎網報本身"
    },
    {
      "sid": "S00132",
      "start": 221.76,
      "end": 223.26,
      "text": "她們在互聯網散播的內容"
    },
    {
      "sid": "S00133",
      "start": 223.26,
      "end": 225.06,
      "text": "正在把越來越多的正常人"
    },
    {
      "sid": "S00134",
      "start": 225.06,
      "end": 227.16,
      "text": "腐化成非黑即白的二級管"
    },
    {
      "sid": "S00135",
      "start": 227.16,
      "end": 229.66,
      "text": "而二級管才是網報事件得以形成的"
    },
    {
      "sid": "S00136",
      "start": 229.66,
      "end": 230.86,
      "text": "先決條件"
    },
    {
      "sid": "S00137",
      "start": 230.86,
      "end": 231.86,
      "text": "也是本質原因"
    },
    {
      "sid": "S00138",
      "start": 231.86,
      "end": 232.76,
      "text": "說句題外話"
    },
    {
      "sid": "S00139",
      "start": 232.76,
      "end": 234.36,
      "text": "那些急頭白臉罵西村利的"
    },
    {
      "sid": "S00140",
      "start": 234.36,
      "end": 235.46,
      "text": "不要只盯著西村利"
    },
    {
      "sid": "S00141",
      "start": 235.46,
      "end": 236.36,
      "text": "順帶把這個"
    },
    {
      "sid": "S00142",
      "start": 236.36,
      "end": 238.46,
      "text": "遍布無良媒體的網絡輿論環境"
    },
    {
      "sid": "S00143",
      "start": 238.46,
      "end": 239.46,
      "text": "也順帶一塊罵"
    },
    {
      "sid": "S00144",
      "start": 239.46,
      "end": 241.06,
      "text": "不然會顯得有失偏頗"
    },
    {
      "sid": "S00145",
      "start": 241.06,
      "end": 242.86,
      "text": "顯得不夠痛恨網報"
    },
    {
      "sid": "S00146",
      "start": 242.86,
      "end": 245.16,
      "text": "多少顯得有點假呆個人怨了"
    },
    {
      "sid": "S00147",
      "start": 245.16,
      "end": 246.56,
      "text": "那我們再把話說回來"
    },
    {
      "sid": "S00148",
      "start": 246.56,
      "end": 247.46,
      "text": "這些整天"
    },
    {
      "sid": "S00149",
      "start": 247.46,
      "end": 249.26,
      "text": "閒得沒事幹的無良營銷號"
    },
    {
      "sid": "S00150",
      "start": 249.26,
      "end": 250.26,
      "text": "為什麼要這樣"
    },
    {
      "sid": "S00151",
      "start": 250.26,
      "end": 252.16,
      "text": "因為憤怒比理性更容易傳播"
    },
    {
      "sid": "S00152",
      "start": 252.16,
      "end": 253.26,
      "text": "一個複雜的問題"
    },
    {
      "sid": "S00153",
      "start": 253.26,
      "end": 254.26,
      "text": "需要幾十分鐘"
    },
    {
      "sid": "S00154",
      "start": 254.26,
      "end": 255.76,
      "text": "甚至幾個小時去了解"
    },
    {
      "sid": "S00155",
      "start": 255.76,
      "end": 256.96,
      "text": "但一句簡單的標籤"
    },
    {
      "sid": "S00156",
      "start": 256.96,
      "end": 258.76,
      "text": "在傳播更廣的短視頻平台里"
    },
    {
      "sid": "S00157",
      "start": 258.76,
      "end": 259.66,
      "text": "只需要幾秒鐘"
    },
    {
      "sid": "S00158",
      "start": 259.66,
      "end": 260.16,
      "text": "渣男"
    },
    {
      "sid": "S00159",
      "start": 260.16,
      "end": 260.66,
      "text": "惡女"
    },
    {
      "sid": "S00160",
      "start": 260.66,
      "end": 261.16,
      "text": "受害者"
    },
    {
      "sid": "S00161",
      "start": 261.16,
      "end": 261.86,
      "text": "加害者"
    },
    {
      "sid": "S00162",
      "start": 261.86,
      "end": 262.86,
      "text": "這些詞像是一個"
    },
    {
      "sid": "S00163",
      "start": 262.86,
      "end": 263.66,
      "text": "快捷按鈕"
    },
    {
      "sid": "S00164",
      "start": 263.66,
      "end": 264.46,
      "text": "按下去之後"
    },
    {
      "sid": "S00165",
      "start": 264.46,
      "end": 265.56,
      "text": "人就不需要思考了"
    },
    {
      "sid": "S00166",
      "start": 265.56,
      "end": 266.26,
      "text": "而這恰恰是"
    },
    {
      "sid": "S00167",
      "start": 266.26,
      "end": 267.66,
      "text": "無良營銷號內容產生著"
    },
    {
      "sid": "S00168",
      "start": 267.66,
      "end": 268.66,
      "text": "最喜歡看到的"
    },
    {
      "sid": "S00169",
      "start": 268.66,
      "end": 269.76,
      "text": "因為思考不會帶來"
    },
    {
      "sid": "S00170",
      "start": 269.76,
      "end": 270.56,
      "text": "巨大的流量"
    },
    {
      "sid": "S00171",
      "start": 270.56,
      "end": 271.66,
      "text": "爭吵才會"
    },
    {
      "sid": "S00172",
      "start": 271.66,
      "end": 272.56,
      "text": "而更複雜的"
    },
    {
      "sid": "S00173",
      "start": 272.56,
      "end": 273.86,
      "text": "帶有辯證思維的內容"
    },
    {
      "sid": "S00174",
      "start": 273.86,
      "end": 275.56,
      "text": "在互聯網輿論敘事體系里"
    },
    {
      "sid": "S00175",
      "start": 275.56,
      "end": 276.66,
      "text": "天生就不符合"
    },
    {
      "sid": "S00176",
      "start": 276.66,
      "end": 277.86,
      "text": "傳播學的基本原理"
    },
    {
      "sid": "S00177",
      "start": 277.86,
      "end": 279.06,
      "text": "所以很多媒體敘事"
    },
    {
      "sid": "S00178",
      "start": 279.06,
      "end": 280.36,
      "text": "開始逐漸傾向於"
    },
    {
      "sid": "S00179",
      "start": 280.36,
      "end": 281.96,
      "text": "製造一種簡單的道德故事"
    },
    {
      "sid": "S00180",
      "start": 281.96,
      "end": 283.26,
      "text": "故事里必須要有英雄"
    },
    {
      "sid": "S00181",
      "start": 283.26,
      "end": 284.26,
      "text": "必須要有受害者"
    },
    {
      "sid": "S00182",
      "start": 284.26,
      "end": 285.16,
      "text": "必須要有惡龍"
    },
    {
      "sid": "S00183",
      "start": 285.16,
      "end": 286.26,
      "text": "最好還能帶上性別"
    },
    {
      "sid": "S00184",
      "start": 286.26,
      "end": 286.76,
      "text": "階層"
    },
    {
      "sid": "S00185",
      "start": 286.76,
      "end": 287.36,
      "text": "身份"
    },
    {
      "sid": "S00186",
      "start": 287.36,
      "end": 289.16,
      "text": "這些天然具有爭議性的話題"
    },
    {
      "sid": "S00187",
      "start": 289.16,
      "end": 290.06,
      "text": "因為只有這樣"
    },
    {
      "sid": "S00188",
      "start": 290.06,
      "end": 291.16,
      "text": "才容易形成傳播"
    },
    {
      "sid": "S00189",
      "start": 291.16,
      "end": 291.96,
      "text": "但問題是"
    },
    {
      "sid": "S00190",
      "start": 291.96,
      "end": 293.66,
      "text": "當人們長期生活在這樣的"
    },
    {
      "sid": "S00191",
      "start": 293.66,
      "end": 294.96,
      "text": "輿論環境裡會發生什麼"
    },
    {
      "sid": "S00192",
      "start": 294.96,
      "end": 295.66,
      "text": "顯而易見"
    },
    {
      "sid": "S00193",
      "start": 295.66,
      "end": 296.66,
      "text": "一個人會慢慢的"
    },
    {
      "sid": "S00194",
      "start": 296.66,
      "end": 298.06,
      "text": "失去獨立思考的能力"
    },
    {
      "sid": "S00195",
      "start": 298.06,
      "end": 299.56,
      "text": "因為複雜意味著不確定"
    },
    {
      "sid": "S00196",
      "start": 299.56,
      "end": 300.86,
      "text": "而情緒最大的特點"
    },
    {
      "sid": "S00197",
      "start": 300.86,
      "end": 302.56,
      "text": "就是能給人帶來一種確定感"
    },
    {
      "sid": "S00198",
      "start": 302.56,
      "end": 304.06,
      "text": "你不需要知道全部真相"
    },
    {
      "sid": "S00199",
      "start": 304.06,
      "end": 304.86,
      "text": "你只需要知道"
    },
    {
      "sid": "S00200",
      "start": 304.86,
      "end": 305.96,
      "text": "西村利該被嗎"
    },
    {
      "sid": "S00201",
      "start": 305.96,
      "end": 307.16,
      "text": "Mina該被平反"
    },
    {
      "sid": "S00202",
      "start": 307.16,
      "end": 307.96,
      "text": "那麼久而久之"
    },
    {
      "sid": "S00203",
      "start": 307.96,
      "end": 309.96,
      "text": "人們會越來越依賴這種簡單答案"
    },
    {
      "sid": "S00204",
      "start": 309.96,
      "end": 311.66,
      "text": "而這就是當下大部分人"
    },
    {
      "sid": "S00205",
      "start": 311.66,
      "end": 316.49,
      "text": "辯證思維正在消失的過程"
    },
    {
      "sid": "S00206",
      "start": 316.49,
      "end": 317.59,
      "text": "所謂辯證思維"
    },
    {
      "sid": "S00207",
      "start": 317.59,
      "end": 319.49,
      "text": "並不是要求每個人都保持中立"
    },
    {
      "sid": "S00208",
      "start": 319.49,
      "end": 321.59,
      "text": "也不是說任何事情都不能批判"
    },
    {
      "sid": "S00209",
      "start": 321.59,
      "end": 322.59,
      "text": "真正的辯證思維"
    },
    {
      "sid": "S00210",
      "start": 322.59,
      "end": 325.19,
      "text": "是你能夠同時看到多個層面的事實"
    },
    {
      "sid": "S00211",
      "start": 325.19,
      "end": 326.79,
      "text": "你可以承認Mina受到傷害"
    },
    {
      "sid": "S00212",
      "start": 326.79,
      "end": 328.49,
      "text": "也可以追問到底是誰"
    },
    {
      "sid": "S00213",
      "start": 328.49,
      "end": 329.49,
      "text": "製造了這種傷害"
    },
    {
      "sid": "S00214",
      "start": 329.49,
      "end": 331.39,
      "text": "你可以同情女性遭遇網絡暴力"
    },
    {
      "sid": "S00215",
      "start": 331.39,
      "end": 332.19,
      "text": "也可以思考"
    },
    {
      "sid": "S00216",
      "start": 332.19,
      "end": 334.19,
      "text": "某些輿論是否正在利用女性身份"
    },
    {
      "sid": "S00217",
      "start": 334.19,
      "end": 335.19,
      "text": "製造新的工資"
    },
    {
      "sid": "S00218",
      "start": 335.19,
      "end": 336.29,
      "text": "這兩件事並不矛盾"
    },
    {
      "sid": "S00219",
      "start": 336.29,
      "end": 337.89,
      "text": "但遺憾的是現在越來越多人"
    },
    {
      "sid": "S00220",
      "start": 337.89,
      "end": 339.69,
      "text": "無法接受這種事物的複雜性"
    },
    {
      "sid": "S00221",
      "start": 339.69,
      "end": 340.99,
      "text": "現在被輿論洗腦的人"
    },
    {
      "sid": "S00222",
      "start": 340.99,
      "end": 341.69,
      "text": "他們會認為"
    },
    {
      "sid": "S00223",
      "start": 341.69,
      "end": 343.49,
      "text": "如果你替另外一個群體說話"
    },
    {
      "sid": "S00224",
      "start": 343.49,
      "end": 344.89,
      "text": "就是在背叛自己的群體"
    },
    {
      "sid": "S00225",
      "start": 344.89,
      "end": 346.29,
      "text": "如果你提出不同意見"
    },
    {
      "sid": "S00226",
      "start": 346.29,
      "end": 347.99,
      "text": "那麼你就是站在敵人那邊"
    },
    {
      "sid": "S00227",
      "start": 347.99,
      "end": 349.19,
      "text": "這就是我一開始說的"
    },
    {
      "sid": "S00228",
      "start": 349.19,
      "end": 350.09,
      "text": "二極管思維"
    },
    {
      "sid": "S00229",
      "start": 350.09,
      "end": 352.39,
      "text": "世界必須被切割成黑和白"
    },
    {
      "sid": "S00230",
      "start": 352.39,
      "end": 355.09,
      "text": "人必須被劃分成好人和壞人"
    },
    {
      "sid": "S00231",
      "start": 355.09,
      "end": 357.19,
      "text": "否則他們在心理上就會覺得不安全"
    },
    {
      "sid": "S00232",
      "start": 357.19,
      "end": 357.99,
      "text": "在道德上"
    },
    {
      "sid": "S00233",
      "start": 357.99,
      "end": 360.39,
      "text": "也會一直懸著一把達莫克里斯之劍"
    },
    {
      "sid": "S00234",
      "start": 360.39,
      "end": 361.39,
      "text": "所以直到現在"
    },
    {
      "sid": "S00235",
      "start": 361.39,
      "end": 363.09,
      "text": "這些依舊在行使網爆的人"
    },
    {
      "sid": "S00236",
      "start": 363.09,
      "end": 364.19,
      "text": "他們的想法就是這樣"
    },
    {
      "sid": "S00237",
      "start": 364.19,
      "end": 365.89,
      "text": "那麼我相信我這些視頻做完"
    },
    {
      "sid": "S00238",
      "start": 365.89,
      "end": 367.99,
      "text": "我肯定會因為罵西村里罵的不夠賣力"
    },
    {
      "sid": "S00239",
      "start": 367.99,
      "end": 368.79,
      "text": "不夠絕對正義"
    },
    {
      "sid": "S00240",
      "start": 368.79,
      "end": 370.19,
      "text": "還被很多人口誅比伐"
    },
    {
      "sid": "S00241",
      "start": 370.19,
      "end": 371.59,
      "text": "但如果因為害怕被罵"
    },
    {
      "sid": "S00242",
      "start": 371.59,
      "end": 372.19,
      "text": "就跟分"
    },
    {
      "sid": "S00243",
      "start": 372.19,
      "end": 374.69,
      "text": "那跟分這個行為的本身就是在孕育網爆"
    },
    {
      "sid": "S00244",
      "start": 374.69,
      "end": 375.89,
      "text": "為什麼這些情緒"
    },
    {
      "sid": "S00245",
      "start": 375.89,
      "end": 377.59,
      "text": "現在越來越容易被輿論放大"
    },
    {
      "sid": "S00246",
      "start": 377.59,
      "end": 379.99,
      "text": "為什麼很多人不再試圖控制自己的情緒"
    },
    {
      "sid": "S00247",
      "start": 379.99,
      "end": 381.99,
      "text": "還是試圖把情緒包裝成正義"
    },
    {
      "sid": "S00248",
      "start": 381.99,
      "end": 384.69,
      "text": "我認為這才是我們應該真正關注的重點"
    },
    {
      "sid": "S00249",
      "start": 384.69,
      "end": 385.79,
      "text": "根本原因在於"
    },
    {
      "sid": "S00250",
      "start": 385.79,
      "end": 388.49,
      "text": "我們正在進入一個先定性再找證據的時代"
    },
    {
      "sid": "S00251",
      "start": 388.49,
      "end": 390.19,
      "text": "過去主流媒體定調的時候"
    },
    {
      "sid": "S00252",
      "start": 390.19,
      "end": 391.39,
      "text": "人們會面對一個事件"
    },
    {
      "sid": "S00253",
      "start": 391.39,
      "end": 392.99,
      "text": "會先問到底發生了什麼"
    },
    {
      "sid": "S00254",
      "start": 392.99,
      "end": 393.79,
      "text": "誰做了什麼"
    },
    {
      "sid": "S00255",
      "start": 393.79,
      "end": 395.09,
      "text": "責任應該如何劃分"
    },
    {
      "sid": "S00256",
      "start": 395.09,
      "end": 396.79,
      "text": "但如今的互聯網輿論蓄勢下"
    },
    {
      "sid": "S00257",
      "start": 396.79,
      "end": 398.39,
      "text": "很多人的思考順序變成了"
    },
    {
      "sid": "S00258",
      "start": 398.39,
      "end": 399.39,
      "text": "我應該支持誰"
    },
    {
      "sid": "S00259",
      "start": 399.39,
      "end": 400.39,
      "text": "我應該反對誰"
    },
    {
      "sid": "S00260",
      "start": 400.39,
      "end": 402.29,
      "text": "什麼觀點可以顯得我更加正確"
    },
    {
      "sid": "S00261",
      "start": 402.29,
      "end": 402.79,
      "text": "於是"
    },
    {
      "sid": "S00262",
      "start": 402.79,
      "end": 405.29,
      "text": "事實反而成為了最後才考慮的東西"
    },
    {
      "sid": "S00263",
      "start": 405.29,
      "end": 406.99,
      "text": "這也就是為什麼很多網絡事件"
    },
    {
      "sid": "S00264",
      "start": 406.99,
      "end": 408.79,
      "text": "最後都會變成回合制遊戲"
    },
    {
      "sid": "S00265",
      "start": 408.79,
      "end": 410.09,
      "text": "分屏和輿論導向"
    },
    {
      "sid": "S00266",
      "start": 410.09,
      "end": 410.99,
      "text": "不斷地反轉"
    },
    {
      "sid": "S00267",
      "start": 410.99,
      "end": 412.09,
      "text": "反轉再反轉"
    },
    {
      "sid": "S00268",
      "start": 412.09,
      "end": 412.79,
      "text": "最開始"
    },
    {
      "sid": "S00269",
      "start": 412.79,
      "end": 413.99,
      "text": "一個群體攻擊另一個人"
    },
    {
      "sid": "S00270",
      "start": 413.99,
      "end": 414.99,
      "text": "後來事情發酵"
    },
    {
      "sid": "S00271",
      "start": 414.99,
      "end": 415.59,
      "text": "輿論反轉"
    },
    {
      "sid": "S00272",
      "start": 415.59,
      "end": 417.49,
      "text": "於是原本的攻擊者不再重要"
    },
    {
      "sid": "S00273",
      "start": 417.49,
      "end": 418.79,
      "text": "大家開始尋找新的敵人"
    },
    {
      "sid": "S00274",
      "start": 418.79,
      "end": 420.39,
      "text": "攻擊鏈條永遠不會停止"
    },
    {
      "sid": "S00275",
      "start": 420.39,
      "end": 422.39,
      "text": "因為很多人需要的不是解決問題"
    },
    {
      "sid": "S00276",
      "start": 422.39,
      "end": 424.59,
      "text": "他們需要的是一個新的情緒出口"
    },
    {
      "sid": "S00277",
      "start": 424.59,
      "end": 426.69,
      "text": "這種思維正在通過某些媒體的敘事"
    },
    {
      "sid": "S00278",
      "start": 426.69,
      "end": 427.59,
      "text": "被不斷強化"
    },
    {
      "sid": "S00279",
      "start": 427.59,
      "end": 428.79,
      "text": "但真實的世界"
    },
    {
      "sid": "S00280",
      "start": 428.79,
      "end": 429.99,
      "text": "他並不是這樣運轉的"
    },
    {
      "sid": "S00281",
      "start": 429.99,
      "end": 431.49,
      "text": "一個女性她可能是受害者"
    },
    {
      "sid": "S00282",
      "start": 431.49,
      "end": 432.79,
      "text": "她也有可能是施害者"
    },
    {
      "sid": "S00283",
      "start": 432.79,
      "end": 434.49,
      "text": "一個男性可能擁有優勢"
    },
    {
      "sid": "S00284",
      "start": 434.49,
      "end": 435.99,
      "text": "也可能遭遇不公平"
    },
    {
      "sid": "S00285",
      "start": 435.99,
      "end": 438.89,
      "text": "一個事件可能同時存在多個責任主體"
    },
    {
      "sid": "S00286",
      "start": 438.89,
      "end": 440.79,
      "text": "這才是真實世界的複雜性"
    },
    {
      "sid": "S00287",
      "start": 440.79,
      "end": 443.09,
      "text": "可是互聯網最害怕的就是複雜"
    },
    {
      "sid": "S00288",
      "start": 443.09,
      "end": 445.09,
      "text": "因為複雜無法快速傳播"
    },
    {
      "sid": "S00289",
      "start": 445.09,
      "end": 446.29,
      "text": "無法製造統一情緒"
    },
    {
      "sid": "S00290",
      "start": 446.29,
      "end": 447.49,
      "text": "無法讓人迅速站隊"
    },
    {
      "sid": "S00291",
      "start": 447.49,
      "end": 448.59,
      "text": "所以越來越多的內容"
    },
    {
      "sid": "S00292",
      "start": 448.59,
      "end": 449.89,
      "text": "開始主動放棄複雜"
    },
    {
      "sid": "S00293",
      "start": 449.89,
      "end": 451.09,
      "text": "他們開始把現實"
    },
    {
      "sid": "S00294",
      "start": 451.09,
      "end": 453.09,
      "text": "裁剪成一個適合傳播的形狀"
    },
    {
      "sid": "S00295",
      "start": 453.09,
      "end": 455.09,
      "text": "把一個具體的人變成一個符號"
    },
    {
      "sid": "S00296",
      "start": 455.09,
      "end": 457.69,
      "text": "把一個具體的衝突變成一個群體戰爭"
    },
    {
      "sid": "S00297",
      "start": 457.69,
      "end": 459.09,
      "text": "最終人不再是人"
    },
    {
      "sid": "S00298",
      "start": 459.09,
      "end": 460.69,
      "text": "舊社會把人變成鬼"
    },
    {
      "sid": "S00299",
      "start": 460.69,
      "end": 465.13,
      "text": "不過如此"
    },
    {
      "sid": "S00300",
      "start": 465.13,
      "end": 466.33,
      "text": "蕋村莉和Mina事件"
    },
    {
      "sid": "S00301",
      "start": 466.33,
      "end": 467.53,
      "text": "其實只是一個縮影"
    },
    {
      "sid": "S00302",
      "start": 467.53,
      "end": 469.83,
      "text": "它反映的其實是一個更大的時代問題"
    },
    {
      "sid": "S00303",
      "start": 469.83,
      "end": 472.23,
      "text": "我們正在進入一個情緒越來越容易被製造"
    },
    {
      "sid": "S00304",
      "start": 472.23,
      "end": 473.93,
      "text": "思考越來越難堅持的時代"
    },
    {
      "sid": "S00305",
      "start": 473.93,
      "end": 475.23,
      "text": "過去人們獲取信息"
    },
    {
      "sid": "S00306",
      "start": 475.23,
      "end": 476.53,
      "text": "需要閱讀完整的報導"
    },
    {
      "sid": "S00307",
      "start": 476.53,
      "end": 477.83,
      "text": "需要等待調查結果"
    },
    {
      "sid": "S00308",
      "start": 477.83,
      "end": 479.43,
      "text": "像在一個幾十秒的短視頻"
    },
    {
      "sid": "S00309",
      "start": 479.43,
      "end": 480.33,
      "text": "一句話截圖"
    },
    {
      "sid": "S00310",
      "start": 480.33,
      "end": 481.13,
      "text": "一段剪輯"
    },
    {
      "sid": "S00311",
      "start": 481.13,
      "end": 482.83,
      "text": "就可以決定一個人的社會評價"
    },
    {
      "sid": "S00312",
      "start": 482.83,
      "end": 485.43,
      "text": "一個人的形象可以在幾個小時內被重新定義"
    },
    {
      "sid": "S00313",
      "start": 485.43,
      "end": 486.33,
      "text": "而這種錯誤"
    },
    {
      "sid": "S00314",
      "start": 486.33,
      "end": 488.03,
      "text": "對任何人來說都是危險的"
    },
    {
      "sid": "S00315",
      "start": 488.03,
      "end": 490.33,
      "text": "因為人類的大腦天然喜歡簡單答案"
    },
    {
      "sid": "S00316",
      "start": 490.33,
      "end": 491.43,
      "text": "面對複雜問題"
    },
    {
      "sid": "S00317",
      "start": 491.43,
      "end": 493.43,
      "text": "我們本能的希望有人告訴我們"
    },
    {
      "sid": "S00318",
      "start": 493.43,
      "end": 494.23,
      "text": "誰是好人"
    },
    {
      "sid": "S00319",
      "start": 494.23,
      "end": 495.13,
      "text": "誰是壞人"
    },
    {
      "sid": "S00320",
      "start": 495.13,
      "end": 496.33,
      "text": "誰應該受到懲罰"
    },
    {
      "sid": "S00321",
      "start": 496.33,
      "end": 497.93,
      "text": "這種心理本身並不可耻"
    },
    {
      "sid": "S00322",
      "start": 497.93,
      "end": 498.63,
      "text": "但問題是"
    },
    {
      "sid": "S00323",
      "start": 498.63,
      "end": 501.53,
      "text": "當整個互聯網都在獎勵這種簡單答案時"
    },
    {
      "sid": "S00324",
      "start": 501.53,
      "end": 503.03,
      "text": "人們就會逐漸喪失"
    },
    {
      "sid": "S00325",
      "start": 503.03,
      "end": 504.63,
      "text": "對於複雜現實的耐心"
    },
    {
      "sid": "S00326",
      "start": 504.63,
      "end": 505.73,
      "text": "於是沒有調查"
    },
    {
      "sid": "S00327",
      "start": 505.73,
      "end": 506.73,
      "text": "就開始了審判"
    },
    {
      "sid": "S00328",
      "start": 506.73,
      "end": 507.53,
      "text": "沒有了解"
    },
    {
      "sid": "S00329",
      "start": 507.53,
      "end": 508.33,
      "text": "就開始攻擊"
    },
    {
      "sid": "S00330",
      "start": 508.33,
      "end": 509.13,
      "text": "沒有證據"
    },
    {
      "sid": "S00331",
      "start": 509.13,
      "end": 510.03,
      "text": "就開始站隊"
    },
    {
      "sid": "S00332",
      "start": 510.03,
      "end": 511.23,
      "text": "最後我們製造出來的"
    },
    {
      "sid": "S00333",
      "start": 511.23,
      "end": 513.03,
      "text": "不是一個更加公平的"
    },
    {
      "sid": "S00334",
      "start": 513.03,
      "end": 515.33,
      "text": "而是一群更容易被情緒操控的人"
    },
    {
      "sid": "S00335",
      "start": 515.33,
      "end": 516.53,
      "text": "所以Mina這件事情"
    },
    {
      "sid": "S00336",
      "start": 516.53,
      "end": 517.53,
      "text": "最後留給我們的"
    },
    {
      "sid": "S00337",
      "start": 517.53,
      "end": 519.53,
      "text": "不應該是一場新的互相攻擊"
    },
    {
      "sid": "S00338",
      "start": 519.53,
      "end": 521.93,
      "text": "而應該是一場對於互聯網生態的反思"
    },
    {
      "sid": "S00339",
      "start": 521.93,
      "end": 524.23,
      "text": "我們到底希望看到一個怎樣的輿論環境"
    },
    {
      "sid": "S00340",
      "start": 524.23,
      "end": 527.13,
      "text": "是一個所有人都被訓練成尋找敵人的輿論環境"
    },
    {
      "sid": "S00341",
      "start": 527.13,
      "end": 528.83,
      "text": "還是一個所有人都能擁有"
    },
    {
      "sid": "S00342",
      "start": 528.83,
      "end": 530.43,
      "text": "獨立判斷能力的輿論環境"
    },
    {
      "sid": "S00343",
      "start": 530.43,
      "end": 531.93,
      "text": "一個健康的輿論環境"
    },
    {
      "sid": "S00344",
      "start": 531.93,
      "end": 533.53,
      "text": "應該是允許所有人表達"
    },
    {
      "sid": "S00345",
      "start": 533.53,
      "end": 534.03,
      "text": "質疑"
    },
    {
      "sid": "S00346",
      "start": 534.03,
      "end": 534.43,
      "text": "思考"
    },
    {
      "sid": "S00347",
      "start": 534.43,
      "end": 534.93,
      "text": "犯粗"
    },
    {
      "sid": "S00348",
      "start": 534.93,
      "end": 535.43,
      "text": "修正"
    },
    {
      "sid": "S00349",
      "start": 535.43,
      "end": 536.33,
      "text": "因為只有這樣"
    },
    {
      "sid": "S00350",
      "start": 536.33,
      "end": 538.33,
      "text": "人才能真正成為一個完整的人"
    },
    {
      "sid": "S00351",
      "start": 538.33,
      "end": 540.63,
      "text": "而不是某種輿論敘事裡的工具"
    },
    {
      "sid": "S00352",
      "start": 540.63,
      "end": 542.63,
      "text": "今天我們看到的是西村里和Mina"
    },
    {
      "sid": "S00353",
      "start": 542.63,
      "end": 544.13,
      "text": "但明天任何一個普通人"
    },
    {
      "sid": "S00354",
      "start": 544.13,
      "end": 546.33,
      "text": "都有可能成為下一個被簡單定義"
    },
    {
      "sid": "S00355",
      "start": 546.33,
      "end": 547.03,
      "text": "被掛上網"
    },
    {
      "sid": "S00356",
      "start": 547.03,
      "end": 548.13,
      "text": "被情緒審判的人"
    },
    {
      "sid": "S00357",
      "start": 548.13,
      "end": 549.73,
      "text": "所以我們真正應該警惕的"
    },
    {
      "sid": "S00358",
      "start": 549.73,
      "end": 551.13,
      "text": "從來不是某一個群體"
    },
    {
      "sid": "S00359",
      "start": 551.13,
      "end": 553.03,
      "text": "而是一種正在吞噬所有人的東西"
    },
    {
      "sid": "S00360",
      "start": 553.03,
      "end": 553.53,
      "text": "那就是"
    },
    {
      "sid": "S00361",
      "start": 553.53,
      "end": 554.83,
      "text": "當情緒取代思考"
    },
    {
      "sid": "S00362",
      "start": 554.83,
      "end": 556.33,
      "text": "當標籤取代事實"
    },
    {
      "sid": "S00363",
      "start": 556.33,
      "end": 557.93,
      "text": "當立場取代理性"
    },
    {
      "sid": "S00364",
      "start": 557.93,
      "end": 559.63,
      "text": "最終失去的是所有人"
    },
    {
      "sid": "S00365",
      "start": 559.63,
      "end": 560.93,
      "text": "突立思考的能力"
    },
    {
      "sid": "S00366",
      "start": 560.93,
      "end": 561.63,
      "text": "我是Mike"
    },
    {
      "sid": "S00367",
      "start": 561.63,
      "end": 562.43,
      "text": "只有數字道"
    },
    {
      "sid": "S00368",
      "start": 562.43,
      "end": 563.33,
      "text": "就在其中"
    },
    {
      "sid": "S00369",
      "start": 563.33,
      "end": 564.33,
      "text": "我們下期見"
    }
  ]
}
